procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure dicebase 0DIM Q, S, V: INTEGERA := 0.0B := 0.0Q := 0R := 0.0S := 0V := 0X := 0.0Z$ := ""type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(35.0); "DICE"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT DIM arr_F(13): INTEGERFOR tmp_1 = 0 TO 12 \ arr_F(tmp_1) := 0 \ NEXT tmp_1(*  DANNY FREIDUS *)PRINT "THIS PROGRAM SIMULATES THE ROLLING OF A"PRINT "PAIR OF DICE."PRINT "YOU ENTER THE NUMBER OF TIMES YOU WANT THE COMPUTER TO"PRINT "'ROLL' THE DICE.  WATCH OUT, VERY LARGE NUMBERS TAKE"PRINT "A LONG TIME.  IN PARTICULAR, NUMBERS OVER 5000."80 FOR Q = 1 TO 12  arr_F(Q) := 0NEXT QPRINT PRINT "HOW MANY ROLLS";RUN _ecb_input_prefix_t \ INPUT "? ", X \ RUN _ecb_input_suffix_tFOR S = 1 TO X  RUN ecb_int(6.0 * RND(1.0) + 1.0, A)  RUN ecb_int(6.0 * RND(1.0) + 1.0, B)  R := A + B  arr_F(INT(R)) := arr_F(INT(R)) + 1NEXT SPRINT PRINT "TOTAL SPOTS", "NUMBER OF TIMES"FOR V = 2 TO 12  run ecb_str(float(V), tmp_1$) \ run ecb_str(float(arr_F(V)), tmp_2$) \ PRINT tmp_1$, tmp_2$NEXT VPRINT PRINT PRINT "TRY AGAIN";RUN _ecb_input_prefix_t \ INPUT "? ", Z$ \ RUN _ecb_input_suffix_tIF Z$ = "YES" THEN 80END