procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure nimbase 0DIM C, G, I, J, Z: INTEGERC := 0E := 0.0F := 0.0G := 0H := 0.0I := 0J := 0N := 0.0Q9$ := ""W := 0.0X := 0.0Y := 0.0Z := 0Z$ := ""type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(34.0); "NIM"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT DIM arr_D(3): INTEGERFOR tmp_1 = 0 TO 2 \ arr_D(tmp_1) := 0 \ NEXT tmp_1DIM arr_A(101), arr_B(101, 11)FOR tmp_1 = 0 TO 100 \ arr_A(tmp_1) := 0 \ NEXT tmp_1FOR tmp_1 = 0 TO 100 \ FOR tmp_2 = 0 TO 10 \ arr_B(tmp_1, tmp_2) := 0 \ NEXT tmp_2 \ NEXT tmp_1PRINT "THIS IS THE GAME OF NIM."PRINT "DO YOU WANT INSTRUCTIONS";240 RUN _ecb_input_prefix_t \ INPUT "? ", Z$ \ RUN _ecb_input_suffix_tIF Z$ = "NO" THEN 440IF Z$ = "no" THEN 440IF Z$ = "YES" THEN 310IF Z$ = "yes" THEN 310PRINT "PLEASE ANSWER YES OR NO"GOTO 240310 PRINT "THE GAME IS PLAYED WITH A NUMBER OF PILES OF OBJECTS."PRINT "ANY NUMBER OF OBJECTS ARE REMOVED FROM ONE PILE BY YOU AND"PRINT "THE MACHINE ALTERNATELY.  ON YOUR TURN, YOU MAY TAKE"PRINT "ALL THE OBJECTS THAT REMAIN IN ANY PILE, BUT YOU MUST"PRINT "TAKE AT LEAST ONE OBJECT, AND YOU MAY TAKE OBJECTS FROM"PRINT "ONLY ONE PILE ON A SINGLE TURN.  YOU MUST SPECIFY WHETHER"PRINT "WINNING IS DEFINED AS TAKING OR NOT TAKING THE LAST OBJECT,"PRINT "THE NUMBER OF PILES IN THE GAME, AND HOW MANY OBJECTS ARE"PRINT "ORIGINALLY IN EACH PILE.  EACH PILE MAY CONTAIN A"PRINT "DIFFERENT NUMBER OF OBJECTS."PRINT "THE MACHINE WILL SHOW ITS MOVE BY LISTING EACH PILE AND THE"PRINT "NUMBER OF OBJECTS REMAINING IN THE PILES AFTER  EACH OF ITS"PRINT "MOVES."440 PRINT 450 PRINT "ENTER WIN OPTION - 1 TO TAKE LAST, 2 TO AVOID LAST";RUN _ecb_input_prefix_t \ INPUT "? ", W \ RUN _ecb_input_suffix_tIF W = 1.0 THEN 490IF W <> 2.0 THEN 450490 PRINT "ENTER NUMBER OF PILES";RUN _ecb_input_prefix_t \ INPUT "? ", N \ RUN _ecb_input_suffix_tIF N > 100.0 THEN 490IF N < 1.0 THEN 490RUN ecb_int(N, tmp_1) \ IF N <> tmp_1 THEN 490PRINT "ENTER PILE SIZES"FOR I = 1 TO N560   run ecb_str(float(I), tmp_1$) \ PRINT tmp_1$;  RUN _ecb_input_prefix_t \ INPUT "? ", arr_A(I) \ RUN _ecb_input_suffix_t  IF arr_A(I) > 2000.0 THEN 560  IF arr_A(I) < 1.0 THEN 560  RUN ecb_int(arr_A(I), tmp_1) \ IF arr_A(I) <> tmp_1 THEN 560NEXT IPRINT "DO YOU WANT TO MOVE FIRST";630 RUN _ecb_input_prefix_t \ INPUT "? ", Q9$ \ RUN _ecb_input_suffix_tIF Q9$ = "YES" THEN 1450IF Q9$ = "yes" THEN 1450IF Q9$ = "NO" THEN 700IF Q9$ = "no" THEN 700PRINT "PLEASE ANSWER YES OR NO."GOTO 630700 IF W = 1.0 THEN 940LET C := 0FOR I = 1 TO N  IF arr_A(I) = 0.0 THEN 770  LET C := C + 1  IF C = 3.0 THEN 840  LET arr_D(C) := I770 NEXT IIF C = 2.0 THEN 920IF arr_A(arr_D(1)) > 1.0 THEN 820800 PRINT "MACHINE LOSES"GOTO 1640820 PRINT "MACHINE WINS"GOTO 1640840 LET C := 0FOR I = 1 TO N  IF arr_A(I) > 1.0 THEN 940  IF arr_A(I) = 0.0 THEN 890  LET C := C + 1890 NEXT IRUN ecb_int(C / 2.0, tmp_1) \ IF C / 2.0 <> tmp_1 THEN 800GOTO 940920 IF arr_A(arr_D(1)) = 1.0 THEN 820IF arr_A(arr_D(2)) = 1.0 THEN 820940 FOR I = 1 TO N  LET E := arr_A(I)  FOR J = 0 TO 10    LET F := E / 2.0    RUN ecb_int(F, tmp_1) \ LET arr_B(I, J) := 2.0 * (F - tmp_1)    RUN ecb_int(F, E)  NEXT JNEXT IFOR J = 10 TO 0 STEP -1  LET C := 0  LET H := 0.0  FOR I = 1 TO N    IF arr_B(I, J) = 0.0 THEN 1110    LET C := C + 1    IF arr_A(I) <= H THEN 1110    LET H := arr_A(I)    LET G := I1110   NEXT I  RUN ecb_int(C / 2.0, tmp_1) \ IF C / 2.0 <> tmp_1 THEN 1190NEXT J1140 RUN ecb_int(N * RND(1.0) + 1.0, E)IF arr_A(INT(E)) = 0.0 THEN 1140RUN ecb_int(arr_A(INT(E)) * RND(1.0) + 1.0, F)LET arr_A(INT(E)) := arr_A(INT(E)) - FGOTO 13801190 LET arr_A(G) := 0.0FOR J = 0 TO 10  LET arr_B(G, J) := 0.0  LET C := 0  FOR I = 1 TO N    IF arr_B(I, J) = 0.0 THEN 1260    LET C := C + 11260   NEXT I  RUN ecb_int(C / 2.0, tmp_1) \ LET arr_A(G) := arr_A(G) + 2.0 * (C / 2.0 - tmp_1) * 2.0 ^ JNEXT JIF W = 1.0 THEN 1380LET C := 0FOR I = 1 TO N  IF arr_A(I) > 1.0 THEN 1380  IF arr_A(I) = 0.0 THEN 1350  LET C := C + 11350 NEXT IRUN ecb_int(C / 2.0, tmp_1) \ IF C / 2.0 <> tmp_1 THEN 1380LET arr_A(G) := 1.0 - arr_A(G)1380 PRINT "PILE  SIZE"FOR I = 1 TO N  run ecb_str(float(I), tmp_1$) \ run ecb_str(arr_A(I), tmp_2$) \ PRINT tmp_1$; tmp_2$NEXT IIF W = 2.0 THEN 1450GOSUB 1570IF Z = 1.0 THEN 8201450 PRINT "YOUR MOVE - PILE, NUMBER TO BE REMOVED";RUN _ecb_input_prefix_t \ INPUT "? ", X, Y \ RUN _ecb_input_suffix_tIF X > N THEN 1450IF X < 1.0 THEN 1450RUN ecb_int(X, tmp_1) \ IF X <> tmp_1 THEN 1450IF Y > arr_A(INT(X)) THEN 1450IF Y < 1.0 THEN 1450RUN ecb_int(Y, tmp_1) \ IF Y <> tmp_1 THEN 1450LET arr_A(INT(X)) := arr_A(INT(X)) - YGOSUB 1570IF Z = 1.0 THEN 800GOTO 7001570 LET Z := 0FOR I = 1 TO N  IF arr_A(I) = 0.0 THEN 1610  RETURN1610 NEXT ILET Z := 1RETURN1640 PRINT "do you want to play another game";1650 RUN _ecb_input_prefix_t \ INPUT "? ", Q9$ \ RUN _ecb_input_suffix_tIF Q9$ = "YES" THEN 1720IF Q9$ = "yes" THEN 1720IF Q9$ = "NO" THEN 1730IF Q9$ = "no" THEN 1730PRINT "PLEASE.  YES OR NO."GOTO 16501720 GOTO 4401730 END