procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure chiefbase 0DIM X, Y: INTEGERA$ := ""B := 0.0C := 0.0D$ := ""F := 0.0G := 0.0H := 0.0I := 0.0J := 0.0K := 0.0X := 0Y := 0Z$ := ""type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(31.0); "CHIEF"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT PRINT "I AM CHIEF NUMBERS FREEK, THE GREAT INDIAN MATH GOD."PRINT "ARE YOU READY TO TAKE THE TEST YOU CALLED ME OUT FOR";RUN _ecb_input_prefix_t \ INPUT "? ", A$ \ RUN _ecb_input_suffix_tIF A$ = "YES" THEN 60PRINT "SHUT UP, PALE FACE WITH WISE TONGUE."60 PRINT " TAKE A NUMBER AND ADD 3. DIVIDE THIS NUMBER BY 5 AND"PRINT "MULTIPLY BY 8. DIVIDE BY 5 AND ADD THE SAME. SUBTRACT 1."PRINT "  WHAT DO YOU HAVE";RUN _ecb_input_prefix_t \ INPUT "? ", B \ RUN _ecb_input_suffix_tLET C := (B + 1.0 - 5.0) * 5.0 / 8.0 * 5.0 - 3.0run ecb_str(C, tmp_1$) \ PRINT "I BET YOUR NUMBER WAS"; tmp_1$; ". AM I RIGHT";RUN _ecb_input_prefix_t \ INPUT "? ", D$ \ RUN _ecb_input_suffix_tIF D$ = "YES" THEN 500PRINT "WHAT WAS YOUR ORIGINAL NUMBER";RUN _ecb_input_prefix_t \ INPUT "? ", K \ RUN _ecb_input_suffix_tLET F := K + 3.0LET G := F / 5.0LET H := G * 8.0LET I := H / 5.0 + 5.0LET J := I - 1.0PRINT "SO YOU THINK YOU'RE SO SMART, EH?"PRINT "NOW WATCH."run ecb_str(K, tmp_1$) \ run ecb_str(F, tmp_2$) \ run ecb_str(G, tmp_3$) \ PRINT tmp_1$; "PLUS 3 EQUALS"; tmp_2$; ". THIS DIVIDED BY 5 EQUALS"; tmp_3$; ";"run ecb_str(H, tmp_1$) \ PRINT "THIS TIMES 8 EQUALS"; tmp_1$; ". IF WE DIVIDE BY 5 AND ADD 5,"run ecb_str(I, tmp_1$) \ run ecb_str(J, tmp_2$) \ PRINT "WE GET"; tmp_1$; ", WHICH, MINUS 1, EQUALS"; tmp_2$; "."PRINT "NOW DO YOU BELIEVE ME";RUN _ecb_input_prefix_t \ INPUT "? ", Z$ \ RUN _ecb_input_suffix_tIF Z$ = "YES" THEN 500PRINT "YOU HAVE MADE ME MAD!!!"PRINT "THERE MUST BE A GREAT LIGHTNING BOLT!"PRINT PRINT FOR X = 30 TO 22 STEP -1  PRINT TAB(X + 1.0); "X X"NEXT XPRINT TAB(22.0); "X XXX"PRINT TAB(21.0); "X   X"PRINT TAB(20.0); "XX X"FOR Y = 20 TO 13 STEP -1  PRINT TAB(Y + 1.0); "X X"NEXT YPRINT TAB(13.0); "XX"PRINT TAB(12.0); "X"PRINT TAB(11.0); "*"PRINT PRINT "#########################"PRINT PRINT "I HOPE YOU BELIEVE ME NOW, FOR YOUR SAKE!!"GOTO 520500 PRINT "BYE!!!"520 END