procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure basketballbase 0DIM P, T: INTEGERD := 0.0O$ := ""P := 0T := 0Z := 0.0Z1 := 0.0DIM arr_S(11): INTEGERFOR tmp_1 = 0 TO 10 \ arr_S(tmp_1) := 0 \ NEXT tmp_1type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(32.0); "BASKETBALL"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT PRINT "THIS IS DARTMOUTH COLLEGE BASKETBALL.  YOU WILL BE DARTMOUTH"PRINT " CAPTAIN AND PLAYMAKER.  CALL SHOTS AS FOLLOWS:  1. LONG"PRINT " (30 FT.) JUMP SHOT; 2. SHORT (15 FT.) JUMP SHOT; 3. LAY"PRINT " UP; 4. SET SHOT."PRINT "BOTH TEAMS WILL USE THE SAME DEFENSE.  CALL DEFENSE AS"PRINT "FOLLOWS:  6. PRESS; 6.5 MAN-TO MAN; 7. ZONE; 7.5 NONE."PRINT "TO CHANGE DEFENSE, JUST TYPE 0 AS YOUR NEXT SHOT."RUN _ecb_input_prefix_t \ INPUT "YOUR STARTING DEFENSE WILL BE? ", D \ RUN _ecb_input_suffix_tIF D < 6.0 THEN 2010PRINT RUN _ecb_input_prefix_t \ INPUT "CHOOSE YOUR OPPONENT? ", O$ \ RUN _ecb_input_suffix_t370 PRINT "CENTER JUMP"IF RND(1.0) > 3.0 / 5.0 THEN 420PRINT O$; " CONTROLS THE TAP."GOTO 3000420 PRINT "DARTMOUTH CONTROLS THE TAP."425 PRINT 430 RUN _ecb_input_prefix_t \ INPUT "YOUR SHOT? ", Z \ RUN _ecb_input_suffix_tP := 0RUN ecb_int(Z, tmp_1) \ IF Z <> tmp_1 THEN 455IF Z < 0.0 OR Z > 4.0 THEN 455GOTO 460455 PRINT "INCORRECT ANSWER.  RETYPE IT. ";GOTO 430460 IF RND(1.0) < 0.5 THEN 1000IF T < 100.0 THEN 1000PRINT IF arr_S(1) <> arr_S(0) THEN 510PRINT PRINT "   ***** END OF SECOND HALF *****"PRINT PRINT "SCORE AT END OF REGULATION TIME:"run ecb_str(float(arr_S(1)), tmp_1$) \ run ecb_str(float(arr_S(0)), tmp_2$) \ PRINT "        DARTMOUTH:"; tmp_1$; "  "; O$; ":"; tmp_2$PRINT PRINT "BEGIN TWO MINUTE OVERTIME PERIOD"T := 93GOTO 370510 PRINT "   ***** END OF GAME *****"run ecb_str(float(arr_S(1)), tmp_1$) \ run ecb_str(float(arr_S(0)), tmp_2$) \ PRINT "FINAL SCORE: DARTMOUTH:"; tmp_1$; "  "; O$; ":"; tmp_2$STOP600 PRINT PRINT "   *** TWO MINUTES LEFT IN THE GAME ***"PRINT RETURN1000 ON INT(Z) GOTO 1040, 1040GOTO 13001040 T := T + 1IF T = 50.0 THEN 8000IF T = 92.0 THEN 1046GOTO 10501046 GOSUB 6001050 PRINT "JUMP SHOT"IF RND(1.0) > 0.341 * D / 8.0 THEN 1090PRINT "SHOT IS GOOD."GOSUB 7000GOTO 30001090 IF RND(1.0) > 0.682 * D / 8.0 THEN 1200PRINT "SHOT IS OFF TARGET."IF D / 6.0 * RND(1.0) > 0.45 THEN 1130PRINT "DARTMOUTH CONTROLS THE REBOUND."GOTO 11451130 PRINT "REBOUND TO "; O$GOTO 30001145 IF RND(1.0) > 0.4 THEN 1158GOTO 13001158 IF D = 6.0 THEN 51001160 PRINT "BALL PASSED BACK TO YOU. ";GOTO 430IF RND(1.0) > 0.9 THEN 1190PRINT "PLAYER FOULED, TWO SHOTS."GOSUB 4000GOTO 30001190 PRINT "BALL STOLEN. "; O$; "'S BALL."GOTO 30001200 IF RND(1.0) > 0.782 * D / 8.0 THEN 1250PRINT "SHOT IS BLOCKED.  BALL CONTROLLED BY ";IF RND(1.0) > 0.5 THEN 1242PRINT "DARTMOUTH."GOTO 4301242 PRINT O$; "."GOTO 30001250 IF RND(1.0) > 0.843 * D / 8.0 THEN 1270PRINT "SHOOTER IS FOULED.  TWO SHOTS."GOSUB 4000GOTO 30001270 PRINT "CHARGING FOUL.  DARTMOUTH LOSES BALL."GOTO 30001300 T := T + 1IF T = 50.0 THEN 8000IF T = 92.0 THEN 1304GOTO 13051304 GOSUB 6001305 IF Z = 0.0 THEN 2010IF Z > 3.0 THEN 1700PRINT "LAY UP."1330 IF 7.0 / D * RND(1.0) > 0.4 THEN 1360PRINT "SHOT IS GOOD.  TWO POINTS."GOSUB 7000GOTO 30001360 IF 7.0 / D * RND(1.0) > 0.7 THEN 1500PRINT "SHOT IS OFF THE RIM."IF RND(1.0) > 2.0 / 3.0 THEN 1415PRINT O$; " CONTROLS THE REBOUND."GOTO 30001415 PRINT "DARTMOUTH CONTROLS THE REBOUND."IF RND(1.0) > 0.4 THEN 1440GOTO 13001440 PRINT "BALL PASSED BACK TO YOU.";GOTO 4301500 IF 7.0 / D * RND(1.0) > 0.875 THEN 1600PRINT "SHOOTER FOULED.  TWO SHOTS."GOSUB 4000GOTO 30001600 IF 7.0 / D * RND(1.0) > 0.925 THEN 1630PRINT "SHOT BLOCKED. "; O$; "'S BALL."GOTO 30001630 PRINT "CHARGING FOUL.  DARTMOUTH LOSES THE BALL."GOTO 30001700 PRINT "SET SHOT."GOTO 13302010 RUN _ecb_input_prefix_t \ INPUT "YOUR NEW DEFENSIVE ALLIGNMENT IS? ", D \ RUN _ecb_input_suffix_tIF D < 6.0 THEN 2010GOTO 4253000 P := 1T := T + 1IF T = 50.0 THEN 8000GOTO 3018GOSUB 6003018 PRINT Z1 := 10.0 / 4.0 * RND(1.0) + 1.0IF Z1 > 2.0 THEN 3500PRINT "JUMP SHOT."IF 8.0 / D * RND(1.0) > 0.35 THEN 3100PRINT "SHOT IS GOOD."GOSUB 6000GOTO 4253100 IF 8.0 / D * RND(1.0) > 0.75 THEN 3200PRINT "SHOT IS OFF RIM."3110 IF D / 6.0 * RND(1.0) > 0.5 THEN 3150PRINT "DARTMOUTH CONTROLS THE REBOUND."GOTO 4253150 PRINT O$; " CONTROLS THE REBOUND."IF D = 6.0 THEN 50003165 IF RND(1.0) > 0.5 THEN 3175PRINT "PASS BACK TO "; O$; " GUARD."GOTO 30003175 GOTO 35003200 IF 8.0 / D * RND(1.0) > 0.9 THEN 3310PRINT "PLAYER FOULED.  TWO SHOTS."GOSUB 4000GOTO 4253310 PRINT "OFFENSIVE FOUL.  DARTMOUTH'S BALL."GOTO 4253500 IF Z1 > 3.0 THEN 3800PRINT "LAY UP."3520 IF 7.0 / D * RND(1.0) > 0.413 THEN 3600PRINT "SHOT IS GOOD."GOSUB 6000GOTO 4253600 PRINT "SHOT IS MISSED."GOTO 31103800 PRINT "SET SHOT."GOTO 35204000 (* FOUL SHOOTING *)IF RND(1.0) > 0.49 THEN 4050PRINT "SHOOTER MAKES BOTH SHOTS."arr_S(1 - P) := arr_S(1 - P) + 24040 GOSUB 6010RETURN4050 IF RND(1.0) > 0.75 THEN 4100PRINT "SHOOTER MAKES ONE SHOT AND MISSES ONE."arr_S(1 - P) := arr_S(1 - P) + 1GOTO 40404100 PRINT "BOTH SHOTS MISSED."GOTO 40405000 IF RND(1.0) > 0.75 THEN 5010GOTO 31655010 PRINT "BALL STOLEN.  EASY LAY UP FOR DARTMOUTH."GOSUB 7000GOTO 30005100 IF RND(1.0) > 0.6 THEN 5120GOTO 11605120 PRINT "PASS STOLEN BY "; O$; " EASY LAYUP."GOSUB 6000GOTO 4256000 arr_S(0) := arr_S(0) + 26010 run ecb_str(float(arr_S(1)), tmp_1$) \ run ecb_str(float(arr_S(0)), tmp_2$) \ PRINT "SCORE: "; tmp_1$; "TO"; tmp_2$RETURN7000 arr_S(1) := arr_S(1) + 2GOSUB 6010RETURN8000 PRINT PRINT "   ***** END OF FIRST HALF *****"PRINT run ecb_str(float(arr_S(1)), tmp_1$) \ run ecb_str(float(arr_S(0)), tmp_2$) \ PRINT "SCORE: DARTMOUTH:"; tmp_1$; "  "; O$; ":"; tmp_2$PRINT PRINT GOTO 370END