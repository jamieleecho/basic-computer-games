procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure kinemabase 0DIM Q, V: INTEGERA := 0.0G := 0.0Q := 0T := 0.0V := 0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(34.0); "KINEMA"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT 100 PRINT PRINT Q := 0RUN ecb_int(35.0 * RND(1.0), tmp_1) \ V := 5 + tmp_1run ecb_str(float(V), tmp_1$) \ PRINT "A BALL IS THROWN UPWARDS AT"; tmp_1$; "METERS PER SECOND."PRINT A := 0.05 * V ^ 2.0PRINT "HOW HIGH WILL IT GO (IN METERS)";GOSUB 500A := V / 5.0PRINT "HOW LONG UNTIL IT RETURNS (IN SECONDS)";GOSUB 500RUN ecb_int(2.0 * V * RND(1.0), tmp_1) \ T := 1.0 + tmp_1 / 10.0A := V - 10.0 * Trun ecb_str(T, tmp_1$) \ PRINT "WHAT WILL ITS VELOCITY BE AFTER"; tmp_1$; "SECONDS";GOSUB 500PRINT run ecb_str(float(Q), tmp_1$) \ PRINT tmp_1$; "RIGHT OUT OF 3.";IF Q < 2.0 THEN 100PRINT "  NOT BAD."GOTO 100500 RUN _ecb_input_prefix_t \ INPUT "? ", G \ RUN _ecb_input_suffix_tIF ABS((G - A) / A) < 0.15 THEN 510PRINT "NOT EVEN CLOSE...."GOTO 512510 PRINT "CLOSE ENOUGH."Q := Q + 1512 run ecb_str(A, tmp_1$) \ PRINT "CORRECT ANSWER IS "; tmp_1$PRINT RETURNEND