procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure hellobase 0DIM I: INTEGERB$ := ""C$ := ""D$ := ""E$ := ""G$ := ""I := 0N$ := ""type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(34.0); "HELLO"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT PRINT "HELLO.  MY NAME IS CREATIVE COMPUTER."PRINT PRINT RUN _ecb_input_prefix_t \ INPUT "WHAT'S YOUR NAME? ", N$ \ RUN _ecb_input_suffix_tPRINT PRINT "HI THERE, "; N$; ", ARE YOU ENJOYING YOURSELF HERE";40 RUN _ecb_input_prefix_t \ INPUT "? ", B$ \ RUN _ecb_input_suffix_tPRINT IF B$ = "YES" THEN 70IF B$ = "NO" THEN 80PRINT N$; ", I DON'T UNDERSTAND YOUR ANSWER OF '"; B$; "'."PRINT "PLEASE ANSWER 'YES' OR 'NO'.  DO YOU LIKE IT HERE";GOTO 4070 PRINT "I'M GLAD TO HEAR THAT, "; N$; "."PRINT GOTO 10080 PRINT "OH, I'M SORRY TO HEAR THAT, "; N$; ". MAYBE WE CAN"PRINT "BRIGHTEN UP YOUR VISIT A BIT."100 PRINT PRINT "SAY, "; N$; ", I CAN SOLVE ALL KINDS OF PROBLEMS EXCEPT"PRINT "THOSE DEALING WITH GREECE.  WHAT KIND OF PROBLEMS DO"PRINT "YOU HAVE (ANSWER SEX, HEALTH, MONEY, OR JOB)";125 RUN _ecb_input_prefix_t \ INPUT "? ", C$ \ RUN _ecb_input_suffix_tPRINT IF C$ = "SEX" THEN 200IF C$ = "HEALTH" THEN 180IF C$ = "MONEY" THEN 160IF C$ = "JOB" THEN 145PRINT "OH, "; N$; ", YOUR ANSWER OF "; C$; " IS GREEK TO ME."GOTO 250145 PRINT "I CAN SYMPATHIZE WITH YOU "; N$; ".  I HAVE TO WORK"PRINT "VERY LONG HOURS FOR NO PAY -- AND SOME OF MY BOSSES"PRINT "REALLY BEAT ON MY KEYBOARD.  MY ADVICE TO YOU, "; N$; ","PRINT "IS TO OPEN A RETAIL COMPUTER STORE.  IT'S GREAT FUN."GOTO 250160 PRINT "SORRY, "; N$; ", I'M BROKE TOO.  WHY DON'T YOU SELL"PRINT "ENCYCLOPEADIAS OR MARRY SOMEONE RICH OR STOP EATING"PRINT "SO YOU WON'T NEED SO MUCH MONEY?"GOTO 250180 PRINT "MY ADVICE TO YOU "; N$; " IS:"PRINT "     1.  TAKE TWO ASPRIN"PRINT "     2.  DRINK PLENTY OF FLUIDS (ORANGE JUICE, NOT BEER!)"PRINT "     3.  GO TO BED (ALONE)"GOTO 250200 RUN _ecb_input_prefix_t \ INPUT "IS YOUR PROBLEM TOO MUCH OR TOO LITTLE? ", D$ \ RUN _ecb_input_suffix_tPRINT 210 IF D$ = "TOO MUCH" THEN 220IF D$ = "TOO LITTLE" THEN 230PRINT "DON'T GET ALL SHOOK, "; N$; ", JUST ANSWER THE QUESTION"RUN _ecb_input_prefix_t \ INPUT "WITH 'TOO MUCH' OR 'TOO LITTLE'.  WHICH IS IT? ", D$ \ RUN _ecb_input_suffix_tGOTO 210220 PRINT "YOU CALL THAT A PROBLEM?!!  I SHOULD HAVE SUCH PROBLEMS!"PRINT "IF IT BOTHERS YOU, "; N$; ", TAKE A COLD SHOWER."GOTO 250230 PRINT "WHY ARE YOU HERE IN SUFFERN, "; N$; "?  YOU SHOULD BE"PRINT "IN TOKYO OR NEW YORK OR AMSTERDAM OR SOMEPLACE WITH SOME"PRINT "REAL ACTION."250 PRINT 255 PRINT "ANY MORE PROBLEMS YOU WANT SOLVED, "; N$;RUN _ecb_input_prefix_t \ INPUT "? ", E$ \ RUN _ecb_input_suffix_tPRINT IF E$ = "YES" THEN 280IF E$ = "NO" THEN 300PRINT "JUST A SIMPLE 'YES' OR 'NO' PLEASE, "; N$; "."GOTO 255280 PRINT "WHAT KIND (SEX, MONEY, HEALTH, JOB)";GOTO 125300 PRINT PRINT "THAT WILL BE $5.00 FOR THE ADVICE, "; N$; "."PRINT "PLEASE LEAVE THE MONEY ON THE TERMINAL."FOR I = 1 TO 2000NEXT IPRINT PRINT PRINT 315 PRINT "DID YOU LEAVE THE MONEY";RUN _ecb_input_prefix_t \ INPUT "? ", G$ \ RUN _ecb_input_suffix_tPRINT IF G$ = "YES" THEN 350IF G$ = "NO" THEN 370PRINT "YOUR ANSWER OF '"; G$; "' CONFUSES ME, "; N$; "."PRINT "PLEASE RESPOND WITH 'YES' OR 'NO'."GOTO 315350 PRINT "HEY, "; N$; "??? YOU LEFT NO MONEY AT ALL!"PRINT "YOU ARE CHEATING ME OUT OF MY HARD-EARNED LIVING."PRINT PRINT "WHAT A RIP OFF, "; N$; "!!!"PRINT GOTO 385370 PRINT "THAT'S HONEST, "; N$; ", BUT HOW DO YOU EXPECT"PRINT "ME TO GO ON WITH MY PSYCHOLOGY STUDIES IF MY PATIENTS"PRINT "DON'T PAY THEIR BILLS?"385 PRINT PRINT "TAKE A WALK, "; N$; "."PRINT PRINT GOTO 999PRINT "NICE MEETING YOU, "; N$; ", HAVE A NICE DAY."(* *)999 END