procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifPROCEDURE ecb_valPARAM str: STRING(* Out *)PARAM valout: REALvalout = 0.0ON ERROR GOTO 10valout = VAL(str)10 REMprocedure animalbase 0DIM I, X, Y, Z: INTEGERA$ := ""B$ := ""C$ := ""I := 0K := 0.0N := 0.0Q$ := ""T$ := ""V$ := ""X := 0X$ := ""Y := 0Z := 0Z1 := 0.0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(33.0); "ANIMAL"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT PRINT "PLAY 'GUESS THE ANIMAL'"PRINT PRINT "THINK OF AN ANIMAL AND THE COMPUTER WILL TRY TO GUESS IT."PRINT DIM arr_A$(201)FOR tmp_1 = 0 TO 200 \ arr_A$(tmp_1) := "" \ NEXT tmp_1FOR I = 0 TO 3  READ arr_A$(I)NEXT IRUN ecb_val(arr_A$(0.0), N)120 (*          MAIN CONTROL SECTION *)RUN _ecb_input_prefix_t \ INPUT "ARE YOU THINKING OF AN ANIMAL? ", A$ \ RUN _ecb_input_suffix_tIF A$ = "LIST" THEN 600IF LEFT$(A$, 1.0) <> "Y" THEN 120K := 1.0170 GOSUB 390IF LEN(arr_A$(INT(K))) = 0.0 THEN 999IF LEFT$(arr_A$(INT(K)), 2.0) = "\Q" THEN 170PRINT "IS IT A "; RIGHT$(arr_A$(INT(K)), LEN(arr_A$(INT(K))) - 2.0);RUN _ecb_input_prefix_t \ INPUT "? ", A$ \ RUN _ecb_input_suffix_tA$ := LEFT$(A$, 1.0)IF LEFT$(A$, 1.0) = "Y" THEN  PRINT "WHY NOT TRY ANOTHER ANIMAL?"  GOTO 120ENDIFRUN _ecb_input_prefix_t \ INPUT "THE ANIMAL YOU WERE THINKING OF WAS A ? ", V$ \ RUN _ecb_input_suffix_tPRINT "PLEASE TYPE IN A QUESTION THAT WOULD DISTINGUISH A"PRINT V$; " FROM A "; RIGHT$(arr_A$(INT(K)), LEN(arr_A$(INT(K))) - 2.0)RUN _ecb_input_prefix_t \ INPUT "? ", X$ \ RUN _ecb_input_suffix_t280 PRINT "FOR A "; V$; " THE ANSWER WOULD BE ";RUN _ecb_input_prefix_t \ INPUT "? ", A$ \ RUN _ecb_input_suffix_tA$ := LEFT$(A$, 1.0)IF A$ <> "Y" AND A$ <> "N" THEN 280IF A$ = "Y" THEN  B$ := "N"ENDIFIF A$ = "N" THEN  B$ := "Y"ENDIFRUN ecb_val(arr_A$(0.0), Z1)RUN ecb_str(Z1 + 2.0, arr_A$(0.0))arr_A$(INT(Z1)) := arr_A$(INT(K))arr_A$(INT(Z1 + 1.0)) := "\A" + V$RUN ecb_str(Z1 + 1.0, tmp_1$) \ RUN ecb_str(Z1, tmp_2$) \ arr_A$(INT(K)) := "\Q" + X$ + "\" + A$ + tmp_1$ + "\" + B$ + tmp_2$ + "\"GOTO 120390 (*     SUBROUTINE TO PRINT QUESTIONS *)Q$ := arr_A$(INT(K))410 FOR Z = 3 TO LEN(Q$)  IF MID$(Q$, Z, 1.0) <> "\" THEN    PRINT MID$(Q$, Z, 1.0);  ELSE    GOTO 420  ENDIFNEXT Z420 RUN _ecb_input_prefix_t \ INPUT "? ", C$ \ RUN _ecb_input_suffix_tC$ := LEFT$(C$, 1.0)IF C$ <> "Y" AND C$ <> "N" THEN 410T$ := "\" + C$FOR X = 3 TO LEN(Q$) - 1  IF MID$(Q$, X, 2.0) = T$ THEN 480NEXT XSTOP480 FOR Y = X + 1 TO LEN(Q$)  IF MID$(Q$, Y, 1.0) = "\" THEN 510NEXT YSTOP510 RUN ecb_val(MID$(Q$, X + 2.0, Y - X - 2.0), K)RETURNDATA "4", "\QDOES IT SWIM\Y2\N3\", "\AFISH", "\ABIRD"600 PRINT PRINT "ANIMALS I ALREADY KNOW ARE:"X := 0FOR I = 1 TO 200  IF LEFT$(arr_A$(I), 2.0) <> "\A" THEN 650  PRINT TAB((15.0 * X) + 1.0);  FOR Z = 3 TO LEN(arr_A$(I))    IF MID$(arr_A$(I), Z, 1.0) <> "\" THEN      PRINT MID$(arr_A$(I), Z, 1.0);    ELSE      GOTO 645    ENDIF  NEXT Z645   X := X + 1  IF X = 4.0 THEN    X := 0    PRINT ENDIF650 NEXT IPRINT PRINT GOTO 120999 END