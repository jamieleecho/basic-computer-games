procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure bouncebase 0DIM I: INTEGERC := 0.0H := 0.0I := 0L := 0.0S1 := 0.0S2 := 0.0T := 0.0V := 0.0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(34.0); "BOUNCE"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT DIM arr_T(21)FOR tmp_1 = 0 TO 20 \ arr_T(tmp_1) := 0 \ NEXT tmp_1PRINT "THIS SIMULATION LETS YOU SPECIFY THE INITIAL VELOCITY"PRINT "OF A BALL THROWN STRAIGHT UP, AND THE COEFFICIENT OF"PRINT "ELASTICITY OF THE BALL.  PLEASE USE A DECIMAL FRACTION"PRINT "COEFFICIENCY (LESS THAN 1)."PRINT PRINT "YOU ALSO SPECIFY THE TIME INCREMENT TO BE USED IN"PRINT "'STROBING' THE BALL'S FLIGHT (TRY .1 INITIALLY)."PRINT 135 RUN _ecb_input_prefix_t \ INPUT "TIME INCREMENT (SEC)? ", S2 \ RUN _ecb_input_suffix_tPRINT RUN _ecb_input_prefix_t \ INPUT "VELOCITY (FPS)? ", V \ RUN _ecb_input_suffix_tPRINT RUN _ecb_input_prefix_t \ INPUT "COEFFICIENT? ", C \ RUN _ecb_input_suffix_tPRINT PRINT "FEET"PRINT RUN ecb_int(70.0 / (V / (16.0 * S2)), S1)FOR I = 1 TO S1  arr_T(I) := V * C ^ (I - 1.0) / 16.0NEXT IRUN ecb_int(-16.0 * (V / 32.0) ^ 2.0 + V ^ 2.0 / 32.0 + 0.5, tmp_1) \ FOR H = tmp_1 TO 0.0 STEP -0.5  RUN ecb_int(H, tmp_1) \ IF tmp_1 <> H THEN 225  run ecb_str(H, tmp_1$) \ PRINT tmp_1$;225   L := 0.0  FOR I = 1 TO S1    FOR T = 0.0 TO arr_T(I) STEP S2      L := L + S2      IF ABS(H - (0.5 * (-32.0) * T ^ 2.0 + V * C ^ (I - 1.0) * T)) > 0.25 THEN 270      PRINT TAB(INT(L / S2) + 1.0); "0";270     NEXT T    T := arr_T(I + 1.0) / 2.0    IF -16.0 * T ^ 2.0 + V * C ^ (I - 1.0) * T < H THEN 290  NEXT I290   PRINT NEXT HPRINT TAB(2.0);RUN ecb_int(L + 1.0, tmp_1) \ FOR I = 1 TO tmp_1 / S2 + 1  PRINT ".";NEXT IPRINT PRINT " 0";RUN ecb_int(L + 0.9995, tmp_1) \ FOR I = 1 TO tmp_1  RUN ecb_int(I / S2, tmp_1) \ run ecb_str(float(I), tmp_1$) \ PRINT TAB(tmp_1 + 1.0); tmp_1$;NEXT IPRINT RUN ecb_int(L + 1.0, tmp_1) \ PRINT TAB(INT(tmp_1 / (2.0 * S2) - 2.0) + 1.0); "SECONDS"PRINT GOTO 135END