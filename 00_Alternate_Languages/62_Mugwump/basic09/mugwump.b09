procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure mugwumpbase 0DIM I, J, T: INTEGERD := 0.0I := 0J := 0M := 0.0N := 0.0T := 0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(34.0); "MUGWUMP"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT (*     COURTESY PEOPLE'S COMPUTER COMPANY *)DIM arr_P(5, 3)FOR tmp_1 = 0 TO 4 \ FOR tmp_2 = 0 TO 2 \ arr_P(tmp_1, tmp_2) := 0 \ NEXT tmp_2 \ NEXT tmp_1PRINT "THE OBJECT OF THIS GAME IS TO FIND FOUR MUGWUMPS"PRINT "HIDDEN ON A 10 BY 10 GRID.  HOMEBASE IS POSITION 0,0."PRINT "ANY GUESS YOU MAKE MUST BE TWO NUMBERS WITH EACH"PRINT "NUMBER BETWEEN 0 AND 9, INCLUSIVE.  FIRST NUMBER"PRINT "IS DISTANCE TO RIGHT OF HOMEBASE AND SECOND NUMBER"PRINT "IS DISTANCE ABOVE HOMEBASE."PRINT PRINT "YOU GET 10 TRIES.  AFTER EACH TRY, I WILL TELL"PRINT "YOU HOW FAR YOU ARE FROM EACH MUGWUMP."PRINT 240 GOSUB 1000T := 0260 T := T + 1PRINT PRINT run ecb_str(float(T), tmp_1$) \ PRINT "TURN NO."; tmp_1$; "-- WHAT IS YOUR GUESS";RUN _ecb_input_prefix_t \ INPUT "? ", M, N \ RUN _ecb_input_suffix_tFOR I = 1 TO 4  IF arr_P(I, 1.0) = -1.0 THEN 400  IF arr_P(I, 1.0) <> M THEN 380  IF arr_P(I, 2.0) <> N THEN 380  arr_P(I, 1.0) := -1.0  run ecb_str(float(I), tmp_1$) \ PRINT "YOU HAVE FOUND MUGWUMP"; tmp_1$  GOTO 400380   D := SQR((arr_P(I, 1.0) - M) ^ 2.0 + (arr_P(I, 2.0) - N) ^ 2.0)  RUN ecb_int(D * 10.0, tmp_1) \ run ecb_str(float(I), tmp_1$) \ PRINT "YOU ARE"; (tmp_1) / 10.0; "UNITS FROM MUGWUMP"; tmp_1$400 NEXT IFOR J = 1 TO 4  IF arr_P(J, 1.0) <> -1.0 THEN 470NEXT JPRINT run ecb_str(float(T), tmp_1$) \ PRINT "YOU GOT THEM ALL IN"; tmp_1$; "TURNS!"GOTO 580470 IF T < 10.0 THEN 260PRINT PRINT "SORRY, THAT'S 10 TRIES.  HERE IS WHERE THEY'RE HIDING:"FOR I = 1 TO 4  IF arr_P(I, 1.0) = -1.0 THEN 570  run ecb_str(float(I), tmp_1$) \ run ecb_str(arr_P(I, 1.0), tmp_2$) \ run ecb_str(arr_P(I, 2.0), tmp_3$) \ PRINT "MUGWUMP"; tmp_1$; "IS AT ("; tmp_2$; ","; tmp_3$; ")"570 NEXT I580 PRINT PRINT "THAT WAS FUN! LET'S PLAY AGAIN......."PRINT "FOUR MORE MUGWUMPS ARE NOW IN HIDING."GOTO 2401000 FOR J = 1 TO 2  FOR I = 1 TO 4    RUN ecb_int(10.0 * RND(1.0), arr_P(I, J))  NEXT INEXT JRETURNEND