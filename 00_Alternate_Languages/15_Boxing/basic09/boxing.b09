procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure boxingbase 0DIM J, L, R, R1, X, Y: INTEGERB := 0.0B1 := 0.0C := 0.0D := 0.0D1 := 0.0D5 := 0.0H1 := 0.0I := 0.0J := 0J$ := ""J7 := 0.0L := 0L$ := ""P := 0.0Q4 := 0.0R := 0R1 := 0R6 := 0.0X := 0X3 := 0.0Y := 0Z4 := 0.0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(34.0); "BOXING"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT PRINT "BOXING OLYMPIC STYLE (3 ROUNDS -- 2 OUT OF 3 WINS)"J := 0L := 0PRINT PRINT "WHAT IS YOUR OPPONENT'S NAME";RUN _ecb_input_prefix_t \ INPUT "? ", J$ \ RUN _ecb_input_suffix_tPRINT "INPUT YOUR MAN'S NAME";RUN _ecb_input_prefix_t \ INPUT "? ", L$ \ RUN _ecb_input_suffix_tPRINT "DIFFERENT PUNCHES ARE: (1) FULL SWING; (2) HOOK; (3) UPPERCUT; (4) JAB."PRINT "WHAT IS YOUR MANS BEST";RUN _ecb_input_prefix_t \ INPUT "? ", B \ RUN _ecb_input_suffix_tPRINT "WHAT IS HIS VULNERABILITY";RUN _ecb_input_prefix_t \ INPUT "? ", D \ RUN _ecb_input_suffix_t90 RUN ecb_int(4.0 * RND(1.0) + 1.0, B1)RUN ecb_int(4.0 * RND(1.0) + 1.0, D1)IF B1 = D1 THEN 90run ecb_str(B1, tmp_1$) \ PRINT J$; "'S ADVANTAGE IS"; tmp_1$; "AND VULNERABILITY IS SECRET."PRINT FOR R = 1 TO 3  IF J >= 2.0 THEN 1040  IF L >= 2.0 THEN 1060  X := 0  Y := 0  run ecb_str(float(R), tmp_1$) \ PRINT "ROUND"; tmp_1$; "BEGINS..."  FOR R1 = 1 TO 7    RUN ecb_int(10.0 * RND(1.0) + 1.0, I)    IF I > 5.0 THEN 600    PRINT L$; "'S PUNCH";    RUN _ecb_input_prefix_t \ INPUT "? ", P \ RUN _ecb_input_suffix_t    IF P = B THEN 225    GOTO 230225     X := X + 2230     IF P = 1.0 THEN 340    IF P = 2.0 THEN 450    IF P = 3.0 THEN 520    PRINT L$; " JABS AT "; J$; "'S HEAD ";    IF D1 = 4.0 THEN 290    RUN ecb_int(8.0 * RND(1.0) + 1.0, C)    IF C < 4.0 THEN 310290     X := X + 3300     GOTO 950310     PRINT "IT'S BLOCKED."    GOTO 950340     PRINT L$; " SWINGS AND ";    IF D1 = 4.0 THEN 410    RUN ecb_int(30.0 * RND(1.0) + 1.0, X3)    IF X3 < 10.0 THEN 410    PRINT "HE MISSES ";    PRINT     IF X = 1.0 THEN 950    PRINT     PRINT     GOTO 300410     PRINT "HE CONNECTS!"    IF X > 35.0 THEN 980    X := X + 15    GOTO 300450     PRINT L$; " GIVES THE HOOK... ";    IF D1 = 2.0 THEN 480    RUN ecb_int(2.0 * RND(1.0) + 1.0, H1)    IF H1 = 1.0 THEN 500    PRINT "CONNECTS..."480     X := X + 7    GOTO 300500     PRINT "BUT IT'S BLOCKED!!!!!!!!!!!!!"    GOTO 300520     PRINT L$; " TRIES AN UPPERCUT ";    IF D1 = 3.0 THEN 570    RUN ecb_int(100.0 * RND(1.0) + 1.0, D5)    IF D5 < 51.0 THEN 570    PRINT "AND IT'S BLOCKED (LUCKY BLOCK!)"    GOTO 300570     PRINT "AND HE CONNECTS!"    X := X + 4    GOTO 300600     RUN ecb_int(4.0 * RND(1.0) + 1.0, J7)    IF J7 = B1 THEN 605    GOTO 610605     Y := Y + 2610     IF J7 = 1.0 THEN 720    IF J7 = 2.0 THEN 810    IF J7 = 3.0 THEN 860    PRINT J$; " JABS AND ";    IF D = 4.0 THEN 700    RUN ecb_int(7.0 * RND(1.0) + 1.0, Z4)    IF Z4 > 4.0 THEN 690    PRINT "IT'S BLOCKED!"    GOTO 300690     PRINT " BLOOD SPILLS !!!"700     Y := Y + 5    GOTO 300720     PRINT J$; " TAKES A FULL SWING AND";    IF D = 1.0 THEN 770    RUN ecb_int(60.0 * RND(1.0) + 1.0, R6)    IF R6 < 30.0 THEN 770    PRINT " IT'S BLOCKED!"    GOTO 300770     PRINT " POW!!!!! HE HITS HIM RIGHT IN THE FACE!"    IF Y > 35.0 THEN 1010    Y := Y + 15    GOTO 300810     PRINT J$; " GETS "; L$; " IN THE JAW (OUCH!)"    Y := Y + 7    PRINT "....AND AGAIN!"    Y := Y + 5    IF Y > 35.0 THEN 1010    PRINT 860     PRINT L$; " IS ATTACKED BY AN UPPERCUT (OH,OH)..."    IF D = 3.0 THEN 890    RUN ecb_int(200.0 * RND(1.0) + 1.0, Q4)    IF Q4 > 75.0 THEN 920890     PRINT "AND "; J$; " CONNECTS..."    Y := Y + 8    GOTO 300920     PRINT " BLOCKS AND HITS "; J$; " WITH A HOOK."    X := X + 5    GOTO 300950   NEXT R1  IF X > Y THEN 955  PRINT   run ecb_str(float(R), tmp_1$) \ PRINT J$; " WINS ROUND"; tmp_1$  J := J + 1  GOTO 960955   PRINT   run ecb_str(float(R), tmp_1$) \ PRINT L$; " WINS ROUND"; tmp_1$  L := L + 1960 NEXT RIF J >= 2.0 THEN 1040IF L >= 2.0 THEN 1060980 PRINT J$; " IS KNOCKED COLD AND "; L$; " IS THE WINNER AND CHAMP!";1000 GOTO 10801010 PRINT L$; " IS KNOCKED COLD AND "; J$; " IS THE WINNER AND CHAMP!";GOTO 10001040 PRINT J$; " WINS (NICE GOING,"; J$; ")."GOTO 10001060 PRINT L$; " AMAZINGLY WINS!!"GOTO 10001080 PRINT PRINT PRINT "AND NOW GOODBYE FROM THE OLYMPIC ARENA."PRINT END