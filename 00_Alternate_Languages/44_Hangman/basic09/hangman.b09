procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure hangmanbase 0DIM C, I, J, L, M, N, Q, R, T1: INTEGERA$ := ""B$ := ""C := 0G$ := ""I := 0J := 0L := 0M := 0N := 0Q := 0R := 0T1 := 0W$ := ""Y$ := ""type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(33.0); "HANGMAN"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT DIM arr_P$(13, 13), arr_L$(21), arr_D$(21), arr_N$(27)FOR tmp_1 = 0 TO 12 \ FOR tmp_2 = 0 TO 12 \ arr_P$(tmp_1, tmp_2) := "" \ NEXT tmp_2 \ NEXT tmp_1FOR tmp_1 = 0 TO 20 \ arr_L$(tmp_1) := "" \ NEXT tmp_1FOR tmp_1 = 0 TO 20 \ arr_D$(tmp_1) := "" \ NEXT tmp_1FOR tmp_1 = 0 TO 26 \ arr_N$(tmp_1) := "" \ NEXT tmp_1DIM arr_U(51): INTEGERFOR tmp_1 = 0 TO 50 \ arr_U(tmp_1) := 0 \ NEXT tmp_1C := 1N := 5050 FOR I = 1 TO 20arr_D$(I) := "-"NEXT IM := 0FOR I = 1 TO 26arr_N$(I) := ""NEXT IFOR I = 1 TO 12FOR J = 1 TO 12arr_P$(I, J) := " "NEXT JNEXT IFOR I = 1 TO 12arr_P$(I, 1.0) := "X"NEXT IFOR I = 1 TO 7arr_P$(1.0, I) := "X"NEXT Iarr_P$(2.0, 7.0) := "X"IF C < N THEN 100PRINT "YOU DID ALL THE WORDS!!"STOP100 RUN ecb_int(N * RND(1.0), tmp_1) \ Q := tmp_1 + 1IF arr_U(Q) = 1.0 THEN 100arr_U(Q) := 1C := C + 1RESTORET1 := 0FOR I = 1 TO QREAD A$NEXT IL := LEN(A$)FOR I = 1 TO LEN(A$)arr_L$(I) := MID$(A$, I, 1.0)NEXT I170 PRINT "HERE ARE THE LETTERS YOU USED:"FOR I = 1 TO 26  PRINT arr_N$(I);  IF arr_N$(I + 1.0) = "" THEN 200PRINT ",";NEXT I200 PRINT PRINT FOR I = 1 TO LPRINT arr_D$(I);NEXT IPRINT PRINT RUN _ecb_input_prefix_t \ INPUT "WHAT IS YOUR GUESS? ", G$ \ RUN _ecb_input_suffix_tR := 0FOR I = 1 TO 26  IF arr_N$(I) = "" THEN 250  IF G$ = arr_N$(I) THEN    PRINT "YOU GUESSED THAT LETTER BEFORE!"    GOTO 170ENDIFNEXT IPRINT "PROGRAM ERROR.  RUN AGAIN."STOP250 arr_N$(I) := G$T1 := T1 + 1FOR I = 1 TO L  IF arr_L$(I) = G$ THEN 280270 NEXT IIF R = 0.0 THEN 290GOTO 300280 arr_D$(I) := G$R := R + 1GOTO 270290 M := M + 1GOTO 400300 FOR I = 1 TO L  IF arr_D$(I) = "-" THEN 320NEXT IGOTO 390320 PRINT FOR I = 1 TO LPRINT arr_D$(I);NEXT IPRINT PRINT RUN _ecb_input_prefix_t \ INPUT "WHAT IS YOUR GUESS FOR THE WORD? ", B$ \ RUN _ecb_input_suffix_tIF A$ = B$ THEN 360PRINT "WRONG.  TRY ANOTHER LETTER."PRINT GOTO 170360 run ecb_str(float(T1), tmp_1$) \ PRINT "RIGHT!!  IT TOOK YOU"; tmp_1$; "GUESSES!"370 RUN _ecb_input_prefix_t \ INPUT "WANT ANOTHER WORD? ", W$ \ RUN _ecb_input_suffix_tIF W$ = "YES" THEN 50PRINT PRINT "IT'S BEEN FUN!  BYE FOR NOW."GOTO 999390 PRINT "YOU FOUND THE WORD!"GOTO 370400 PRINT PRINT PRINT "SORRY, THAT LETTER ISN'T IN THE WORD."ON M GOTO 415, 420, 425, 430, 435, 440, 445, 450, 455, 460415 PRINT "FIRST, WE DRAW A HEAD"GOTO 470420 PRINT "NOW WE DRAW A BODY."GOTO 470425 PRINT "NEXT WE DRAW AN ARM."GOTO 470430 PRINT "THIS TIME IT'S THE OTHER ARM."GOTO 470435 PRINT "NOW, LET'S DRAW THE RIGHT LEG."GOTO 470440 PRINT "THIS TIME WE DRAW THE LEFT LEG."GOTO 470445 PRINT "NOW WE PUT UP A HAND."GOTO 470450 PRINT "NEXT THE OTHER HAND."GOTO 470455 PRINT "NOW WE DRAW ONE FOOT"GOTO 470460 PRINT "HERE'S THE OTHER FOOT -- YOU'RE HUNG!!"470 ON M GOTO 480, 490, 500, 510, 520, 530, 540, 550, 560, 570480 arr_P$(3.0, 6.0) := "-"arr_P$(3.0, 7.0) := "-"arr_P$(3.0, 8.0) := "-"arr_P$(4.0, 5.0) := "("arr_P$(4.0, 6.0) := "."arr_P$(4.0, 8.0) := "."arr_P$(4.0, 9.0) := ")"arr_P$(5.0, 6.0) := "-"arr_P$(5.0, 7.0) := "-"arr_P$(5.0, 8.0) := "-"GOTO 580490 FOR I = 6 TO 9arr_P$(I, 7.0) := "X"NEXT IGOTO 580500 FOR I = 4 TO 7arr_P$(I, I - 1.0) := "\"NEXT IGOTO 580510 arr_P$(4.0, 11.0) := "/"arr_P$(5.0, 10.0) := "/"arr_P$(6.0, 9.0) := "/"arr_P$(7.0, 8.0) := "/"GOTO 580520 arr_P$(10.0, 6.0) := "/"arr_P$(11.0, 5.0) := "/"GOTO 580530 arr_P$(10.0, 8.0) := "\"arr_P$(11.0, 9.0) := "\"GOTO 580540 arr_P$(3.0, 11.0) := "\"GOTO 580550 arr_P$(3.0, 3.0) := "/"GOTO 580560 arr_P$(12.0, 10.0) := "\"arr_P$(12.0, 11.0) := "-"GOTO 580570 arr_P$(12.0, 3.0) := "-"arr_P$(12.0, 4.0) := "/"580 FOR I = 1 TO 12FOR J = 1 TO 12  PRINT arr_P$(I, J);  NEXT JPRINT NEXT IPRINT PRINT IF M <> 10.0 THEN 170PRINT "SORRY, YOU LOSE.  THE WORD WAS "; A$PRINT "YOU MISSED THAT ONE.  DO YOU ";GOTO 370RUN _ecb_input_prefix_t \ INPUT "TYPE YES OR NO? ", Y$ \ RUN _ecb_input_suffix_tIF LEFT$(Y$, 1.0) = "Y" THEN 50DATA "GUM", "SIN", "FOR", "CRY", "LUG", "BYE", "FLY"DATA "UGLY", "EACH", "FROM", "WORK", "TALK", "WITH", "SELF"DATA "PIZZA", "THING", "FEIGN", "FIEND", "ELBOW", "FAULT", "DIRTY"DATA "BUDGET", "SPIRIT", "QUAINT", "MAIDEN", "ESCORT", "PICKAX"DATA "EXAMPLE", "TENSION", "QUININE", "KIDNEY", "REPLICA", "SLEEPER"DATA "TRIANGLE", "KANGAROO", "MAHOGANY", "SERGEANT", "SEQUENCE"DATA "MOUSTACHE", "DANGEROUS", "SCIENTIST", "DIFFERENT", "QUIESCENT"DATA "MAGISTRATE", "ERRONEOUSLY", "LOUDSPEAKER", "PHYTOTOXIC"DATA "MATRIMONIAL", "PARASYMPATHOMIMETIC", "THIGMOTROPISM"PRINT "BYE NOW"999 END