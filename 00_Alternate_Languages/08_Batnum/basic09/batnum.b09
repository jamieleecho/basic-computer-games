procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure batnumbase 0DIM I, W: INTEGERA := 0.0B := 0.0C := 0.0I := 0M := 0.0N := 0.0P := 0.0Q := 0.0S := 0.0W := 0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(34.0); "BATNUM"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT PRINT "THIS PROGRAM IS A 'BATTLE OF NUMBERS' GAME, WHERE THE"PRINT "COMPUTER IS YOUR OPPONENT."PRINT PRINT "THE GAME STARTS WITH AN ASSUMED PILE OF OBJECTS. YOU"PRINT "AND YOUR OPPONENT ALTERNATELY REMOVE OBJECTS FROM THE PILE."PRINT "WINNING IS DEFINED IN ADVANCE AS TAKING THE LAST OBJECT OR"PRINT "NOT. YOU CAN ALSO SPECIFY SOME OTHER BEGINNING CONDITIONS."PRINT "DON'T USE ZERO, HOWEVER, IN PLAYING THE GAME."PRINT "ENTER A NEGATIVE NUMBER FOR NEW PILE SIZE TO STOP PLAYING."PRINT GOTO 330220 FOR I = 1 TO 10  PRINT NEXT I330 RUN _ecb_input_prefix_t \ INPUT "ENTER PILE SIZE? ", N \ RUN _ecb_input_suffix_tIF N >= 1.0 THEN 370GOTO 330370 RUN ecb_int(N, tmp_1) \ IF N <> tmp_1 THEN 220IF N < 1.0 THEN 220390 RUN _ecb_input_prefix_t \ INPUT "ENTER WIN OPTION - 1 TO TAKE LAST, 2 TO AVOID LAST: ? ", M \ RUN _ecb_input_suffix_tIF M = 1.0 THEN 430IF M <> 2.0 THEN 390430 RUN _ecb_input_prefix_t \ INPUT "ENTER MIN AND MAX ? ", A, B \ RUN _ecb_input_suffix_tIF A > B THEN 430IF A < 1.0 THEN 430RUN ecb_int(A, tmp_1) \ IF A <> tmp_1 THEN 430RUN ecb_int(B, tmp_1) \ IF B <> tmp_1 THEN 430490 RUN _ecb_input_prefix_t \ INPUT "ENTER START OPTION - 1 COMPUTER FIRST, 2 YOU FIRST ? ", S \ RUN _ecb_input_suffix_tPRINT PRINT IF S = 1.0 THEN 530IF S <> 2.0 THEN 490530 C := A + BIF S = 2.0 THEN 570550 GOSUB 600IF W = 1.0 THEN 220570 GOSUB 810IF W = 1.0 THEN 220GOTO 550600 Q := NIF M = 1.0 THEN 630Q := Q - 1.0630 IF M = 1.0 THEN 680IF N > A THEN 720W := 1run ecb_str(N, tmp_1$) \ PRINT "COMPUTER TAKES"; tmp_1$; "AND LOSES."RETURN680 IF N > B THEN 720W := 1run ecb_str(N, tmp_1$) \ PRINT "COMPUTER TAKES"; tmp_1$; "AND WINS."RETURN720 RUN ecb_int(Q / C, tmp_1) \ P := Q - C * tmp_1IF P >= A THEN 750P := A750 IF P <= B THEN 770P := B770 N := N - Prun ecb_str(P, tmp_1$) \ run ecb_str(N, tmp_2$) \ PRINT "COMPUTER TAKES"; tmp_1$; "AND LEAVES"; tmp_2$W := 0RETURN810 PRINT PRINT "YOUR MOVE ";820 RUN _ecb_input_prefix_t \ INPUT "? ", P \ RUN _ecb_input_suffix_tIF P <> 0.0 THEN 870PRINT "I TOLD YOU NOT TO USE ZERO! COMPUTER WINS BY FORFEIT."W := 1RETURN870 RUN ecb_int(P, tmp_1) \ IF P <> tmp_1 THEN 920IF P >= A THEN 910IF P = N THEN 960GOTO 920910 IF P <= B THEN 940920 PRINT "ILLEGAL MOVE, REENTER IT ";GOTO 820940 N := N - PIF N <> 0.0 THEN 1030960 IF M = 1.0 THEN 1000PRINT "TOUGH LUCK, YOU LOSE."W := 1RETURN1000 PRINT "CONGRATULATIONS, YOU WIN."W := 1RETURN1030 IF N >= 0.0 THEN 1060N := N + PGOTO 9201060 W := 0RETURNEND