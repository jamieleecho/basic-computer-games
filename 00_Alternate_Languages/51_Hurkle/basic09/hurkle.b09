procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure hurklebase 0DIM G, K, N: INTEGERA := 0.0B := 0.0G := 0K := 0N := 0X := 0.0Y := 0.0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(34.0); "HURKLE"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT N := 5G := 10PRINT run ecb_str(float(G), tmp_1$) \ run ecb_str(float(G), tmp_2$) \ PRINT "A HURKLE IS HIDING ON A"; tmp_1$; "BY"; tmp_2$; "GRID. HOMEBASE"PRINT "ON THE GRID IS POINT 0,0 IN THE SOUTHWEST CORNER,"PRINT "AND ANY POINT ON THE GRID IS DESIGNATED BY A"PRINT "PAIR OF WHOLE NUMBERS SEPERATED BY A COMMA. THE FIRST"PRINT "NUMBER IS THE HORIZONTAL POSITION AND THE SECOND NUMBER"PRINT "IS THE VERTICAL POSITION. YOU MUST TRY TO"run ecb_str(float(N), tmp_1$) \ PRINT "GUESS THE HURKLE'S GRIDPOINT. YOU GET"; tmp_1$; "TRIES."PRINT "AFTER EACH TRY, I WILL TELL YOU THE APPROXIMATE"PRINT "DIRECTION TO GO TO LOOK FOR THE HURKLE."PRINT 285 RUN ecb_int(G * RND(1.0), A)RUN ecb_int(G * RND(1.0), B)FOR K = 1 TO N  run ecb_str(float(K), tmp_1$) \ PRINT "GUESS #"; tmp_1$;  RUN _ecb_input_prefix_t \ INPUT "? ", X, Y \ RUN _ecb_input_suffix_t  IF ABS(X - A) + ABS(Y - B) = 0.0 THEN 500(* PRINT INFO *)  GOSUB 610  PRINT NEXT KPRINT run ecb_str(float(N), tmp_1$) \ PRINT "SORRY, THAT'S"; tmp_1$; "GUESSES."run ecb_str(A, tmp_1$) \ run ecb_str(B, tmp_2$) \ PRINT "THE HURKLE IS AT "; tmp_1$; ","; tmp_2$440 PRINT PRINT "LET'S PLAY AGAIN, HURKLE IS HIDING."PRINT GOTO 285500 (* *)PRINT run ecb_str(float(K), tmp_1$) \ PRINT "YOU FOUND HIM IN"; tmp_1$; "GUESSES!"GOTO 440610 PRINT "GO ";IF Y = B THEN 670IF Y < B THEN 660PRINT "SOUTH";GOTO 670660 PRINT "NORTH";670 IF X = A THEN 720IF X < A THEN 710PRINT "WEST";GOTO 720710 PRINT "EAST";720 PRINT RETURNEND