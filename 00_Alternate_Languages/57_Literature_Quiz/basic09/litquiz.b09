procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure litquizbase 0DIM R: INTEGERA := 0.0R := 0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(26.0); "LITERATURE QUIZ"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT R := 0PRINT "TEST YOUR KNOWLEDGE OF CHILDREN'S LITERATURE."PRINT PRINT "THIS IS A MULTIPLE-CHOICE QUIZ."PRINT "TYPE A 1, 2, 3, OR 4 AFTER THE QUESTION MARK."PRINT PRINT "GOOD LUCK!"PRINT PRINT PRINT "IN PINOCCHIO, WHAT WAS THE NAME OF THE CAT"PRINT "1)TIGGER, 2)CICERO, 3)FIGARO, 4)GUIPETTO";RUN _ecb_input_prefix_t \ INPUT "? ", A \ RUN _ecb_input_suffix_tIF A = 3.0 THEN 46PRINT "SORRY...FIGARO WAS HIS NAME."GOTO 5046 PRINT "VERY GOOD!  HERE'S ANOTHER."R := R + 150 PRINT PRINT PRINT "FROM WHOSE GARDEN DID BUGS BUNNY STEAL THE CARROTS?"PRINT "1)MR. NIXON'S, 2)ELMER FUDD'S, 3)CLEM JUDD'S, 4)STROMBOLI'S";RUN _ecb_input_prefix_t \ INPUT "? ", A \ RUN _ecb_input_suffix_tIF A = 2.0 THEN 56PRINT "TOO BAD...IT WAS ELMER FUDD'S GARDEN."GOTO 6056 PRINT "PRETTY GOOD!"R := R + 160 PRINT PRINT PRINT "IN THE WIZARD OF OS, DOROTHY'S DOG WAS NAMED"PRINT "1)CICERO, 2)TRIXIA, 3)KING, 4)TOTO";RUN _ecb_input_prefix_t \ INPUT "? ", A \ RUN _ecb_input_suffix_tIF A = 4.0 THEN 66PRINT "BACK TO THE BOOKS,...TOTO WAS HIS NAME."GOTO 7066 PRINT "YEA!  YOU'RE A REAL LITERATURE GIANT."R := R + 170 PRINT PRINT PRINT "WHO WAS THE FAIR MAIDEN WHO ATE THE POISON APPLE"PRINT "1)SLEEPING BEAUTY, 2)CINDERELLA, 3)SNOW WHITE, 4)WENDY";RUN _ecb_input_prefix_t \ INPUT "? ", A \ RUN _ecb_input_suffix_tIF A = 3.0 THEN 76PRINT "OH, COME ON NOW...IT WAS SNOW WHITE."GOTO 8076 PRINT "GOOD MEMORY!"R := R + 180 PRINT PRINT IF R = 4.0 THEN 100IF R < 2.0 THEN 200PRINT "NOT BAD, BUT YOU MIGHT SPEND A LITTLE MORE TIME"PRINT "READING THE NURSERY GREATS."STOP100 PRINT "WOW!  THAT'S SUPER!  YOU REALLY KNOW YOUR NURSERY"PRINT "YOUR NEXT QUIZ WILL BE ON 2ND CENTURY CHINESE"PRINT "LITERATURE (HA, HA, HA)"STOP200 PRINT "UGH.  THAT WAS DEFINITELY NOT TOO SWIFT.  BACK TO"PRINT "NURSERY SCHOOL FOR YOU, MY FRIEND."END