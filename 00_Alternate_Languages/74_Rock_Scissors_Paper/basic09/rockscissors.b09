procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure rockscissorsbase 0DIM C, G, H: INTEGERC := 0G := 0H := 0K := 0.0Q := 0.0X := 0.0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(22.0); "GAME OF ROCK, SCISSORS, PAPER"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT 30 RUN _ecb_input_prefix_t \ INPUT "HOW MANY GAMES? ", Q \ RUN _ecb_input_suffix_tIF Q < 11.0 THEN 60PRINT "SORRY, BUT WE AREN'T ALLOWED TO PLAY THAT MANY."GOTO 3060 FOR G = 1 TO Q  PRINT   run ecb_str(float(G), tmp_1$) \ PRINT "GAME NUMBER"; tmp_1$  RUN ecb_int(RND(1.0) * 3.0 + 1.0, X)90   PRINT "3=ROCK...2=SCISSORS...1=PAPER"  RUN _ecb_input_prefix_t \ INPUT "1...2...3...WHAT'S YOUR CHOICE? ", K \ RUN _ecb_input_suffix_t  IF (K - 1.0) * (K - 2.0) * (K - 3.0) <> 0.0 THEN    PRINT "INVALID."    GOTO 90ENDIF  PRINT "THIS IS MY CHOICE..."  ON INT(X) GOTO 140, 150, 160140   PRINT "...PAPER"  GOTO 170150   PRINT "...SCISSORS"  GOTO 170160   PRINT "...ROCK"170   IF X = K THEN 250  IF X > K THEN 230  IF X = 1.0 THEN 210200   PRINT "YOU WIN!!!"  H := H + 1  GOTO 260210   IF K <> 3.0 THEN 200220   PRINT "WOW!  I WIN!!!"  C := C + 1  GOTO 260230   IF K <> 1.0 OR X <> 3.0 THEN 220  GOTO 200250   PRINT "TIE GAME.  NO WINNER."260 NEXT GPRINT PRINT "HERE IS THE FINAL GAME SCORE:"run ecb_str(float(C), tmp_1$) \ PRINT "I HAVE WON"; tmp_1$; "GAME(S)."run ecb_str(float(H), tmp_1$) \ PRINT "YOU HAVE WON"; tmp_1$; "GAME(S)."PRINT "AND"; Q - (C + H); "GAME(S) ENDED IN A TIE."PRINT PRINT "THANKS FOR PLAYING!!"END