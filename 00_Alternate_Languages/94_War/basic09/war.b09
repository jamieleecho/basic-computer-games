procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure warbase 0DIM A1, B1, I, J, K, M1, M2, P: INTEGERA1 := 0B$ := ""B1 := 0I := 0J := 0K := 0M1 := 0M2 := 0N1 := 0.0N2 := 0.0P := 0V$ := ""type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(34.0); "WAR"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT PRINT "THIS IS THE CARD GAME OF WAR.  EACH CARD IS GIVEN BY SUIT-#"PRINT "AS S-7 FOR SPADE 7.  ";120 PRINT "DO YOU WANT DIRECTIONS";RUN _ecb_input_prefix_t \ INPUT "? ", B$ \ RUN _ecb_input_suffix_tIF B$ = "NO" THEN 210IF B$ = "YES" THEN 180PRINT "YES OR NO, PLEASE.  ";GOTO 120180 PRINT "THE COMPUTER GIVES YOU AND IT A 'CARD'.  THE HIGHER CARD"PRINT "(NUMERICALLY) WINS.  THE GAME ENDS WHEN YOU CHOOSE NOT TO"PRINT "CONTINUE OR WHEN YOU HAVE FINISHED THE PACK."210 PRINT PRINT DIM arr_A$(53)FOR tmp_1 = 0 TO 52 \ arr_A$(tmp_1) := "" \ NEXT tmp_1DIM arr_L(55): INTEGERFOR tmp_1 = 0 TO 54 \ arr_L(tmp_1) := 0 \ NEXT tmp_1FOR I = 1 TO 52  READ arr_A$(I)NEXT I(* *)FOR J = 1 TO 52290   RUN ecb_int(52.0 * RND(1.0), tmp_1) \ LET arr_L(J) := tmp_1 + 1  IF J = 1.0 THEN 350  FOR K = 1 TO J - 1    IF arr_L(K) <> arr_L(J) THEN 340(* *)    GOTO 290340   NEXT K350 NEXT J360 P := P + 1M1 := arr_L(P)P := P + 1M2 := arr_L(P)PRINT PRINT "YOU: "; arr_A$(M1), "COMPUTER: "; arr_A$(M2)RUN ecb_int((M1 - 0.5) / 4.0, N1)RUN ecb_int((M2 - 0.5) / 4.0, N2)IF N1 >= N2 THEN 490A1 := A1 + 1run ecb_str(float(B1), tmp_1$) \ run ecb_str(float(A1), tmp_2$) \ PRINT "THE COMPUTER WINS!!! YOU HAVE"; tmp_1$; "AND THE COMPUTER HAS"; tmp_2$GOTO 540490 IF N1 = N2 THEN 530B1 := B1 + 1run ecb_str(float(B1), tmp_1$) \ run ecb_str(float(A1), tmp_2$) \ PRINT "YOU WIN. YOU HAVE"; tmp_1$; "AND THE COMPUTER HAS"; tmp_2$GOTO 540530 PRINT "TIE.  NO SCORE CHANGE."540 IF arr_L(P + 1) = 0.0 THEN 610PRINT "DO YOU WANT TO CONTINUE";RUN _ecb_input_prefix_t \ INPUT "? ", V$ \ RUN _ecb_input_suffix_tIF V$ = "YES" THEN 360IF V$ = "NO" THEN 650PRINT "YES OR NO, PLEASE.  ";GOTO 540610 PRINT PRINT run ecb_str(float(B1), tmp_1$) \ PRINT "WE HAVE RUN OUT OF CARDS.  FINAL SCORE:  YOU: "; tmp_1$;run ecb_str(float(A1), tmp_1$) \ PRINT "  THE COMPUTER: "; tmp_1$PRINT 650 PRINT "THANKS FOR PLAYING.  IT WAS FUN."PRINT DATA "S-2", "H-2", "C-2", "D-2", "S-3", "H-3", "C-3", "D-3"DATA "S-4", "H-4", "C-4", "D-4", "S-5", "H-5", "C-5", "D-5"DATA "S-6", "H-6", "C-6", "D-6", "S-7", "H-7", "C-7", "D-7"DATA "S-8", "H-8", "C-8", "D-8", "S-9", "H-9", "C-9", "D-9"DATA "S-10", "H-10", "C-10", "D-10", "S-J", "H-J", "C-J", "D-J"DATA "S-Q", "H-Q", "C-Q", "D-Q", "S-K", "H-K", "C-K", "D-K"DATA "S-A", "H-A", "C-A", "D-A"END