procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure tictactoe2base 0DIM G, H, I, J, K: INTEGERC$ := ""G := 0H := 0I := 0J := 0K := 0M := 0.0P$ := ""Q$ := ""type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(31.0); "TIC-TAC-TOE"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT PRINT "THE BOARD IS NUMBERED:"PRINT " 1  2  3"PRINT " 4  5  6"PRINT " 7  8  9"PRINT PRINT PRINT DIM arr_S(10): INTEGERFOR tmp_1 = 0 TO 9 \ arr_S(tmp_1) := 0 \ NEXT tmp_1RUN _ecb_input_prefix_t \ INPUT "DO YOU WANT 'X' OR 'O'? ", C$ \ RUN _ecb_input_suffix_tIF C$ = "X" THEN 475P$ := "O"Q$ := "X"100 G := -1H := 1IF arr_S(5) <> 0.0 THEN 103arr_S(5) := -1GOTO 195103 IF arr_S(5) <> 1.0 THEN 106IF arr_S(1) <> 0.0 THEN 110arr_S(1) := -1GOTO 195106 IF arr_S(2) = 1.0 AND arr_S(1) = 0.0 THEN 181IF arr_S(4) = 1.0 AND arr_S(1) = 0.0 THEN 181IF arr_S(6) = 1.0 AND arr_S(9) = 0.0 THEN 189IF arr_S(8) = 1.0 AND arr_S(9) = 0.0 THEN 189110 IF G = 1.0 THEN 112GOTO 118112 RUN ecb_int((M - 1.0) / 3.0, tmp_1) \ J := 3 * tmp_1 + 1RUN ecb_int((M - 1.0) / 3.0, tmp_1) \ IF 3.0 * tmp_1 + 1.0 = M THEN  K := 1ENDIFRUN ecb_int((M - 1.0) / 3.0, tmp_1) \ IF 3.0 * tmp_1 + 2.0 = M THEN  K := 2ENDIFRUN ecb_int((M - 1.0) / 3.0, tmp_1) \ IF 3.0 * tmp_1 + 3.0 = M THEN  K := 3ENDIFGOTO 120118   FOR J = 1 TO 7 STEP 3  FOR K = 1 TO 3120     IF arr_S(J) <> G THEN 130    IF arr_S(J + 2) <> G THEN 135    IF arr_S(J + 1) <> 0.0 THEN 150    arr_S(J + 1) := -1    GOTO 195130     IF arr_S(J) = H THEN 150    IF arr_S(J + 2) <> G THEN 150    IF arr_S(J + 1) <> G THEN 150    arr_S(J) := -1    GOTO 195135     IF arr_S(J + 2) <> 0.0 THEN 150    IF arr_S(J + 1) <> G THEN 150    arr_S(J + 2) := -1    GOTO 195150     IF arr_S(K) <> G THEN 160    IF arr_S(K + 6) <> G THEN 165    IF arr_S(K + 3) <> 0.0 THEN 170    arr_S(K + 3) := -1    GOTO 195160     IF arr_S(K) = H THEN 170    IF arr_S(K + 6) <> G THEN 170    IF arr_S(K + 3) <> G THEN 170    arr_S(K) := -1    GOTO 195165     IF arr_S(K + 6) <> 0.0 THEN 170    IF arr_S(K + 3) <> G THEN 170    arr_S(K + 6) := -1    GOTO 195170     GOTO 450171     IF arr_S(3) = G AND arr_S(7) = 0.0 THEN 187    IF arr_S(9) = G AND arr_S(1) = 0.0 THEN 181    IF arr_S(7) = G AND arr_S(3) = 0.0 THEN 183    IF arr_S(9) = 0.0 AND arr_S(1) = G THEN 189175     IF G = -1.0 THEN      G := 1      H := -1      GOTO 110ENDIF    IF arr_S(9) = 1.0 AND arr_S(3) = 0.0 THEN 182177     FOR I = 2 TO 9      IF arr_S(I) <> 0.0 THEN 179      arr_S(I) := -1      GOTO 195179     NEXT I181     arr_S(1) := -1    GOTO 195182     IF arr_S(1) = 1.0 THEN 177183     arr_S(3) := -1    GOTO 195187     arr_S(7) := -1    GOTO 195189     arr_S(9) := -1195     PRINT     PRINT "THE COMPUTER MOVES TO..."    GOSUB 1000    GOTO 500450     IF G = 1.0 THEN 465    IF J = 7.0 AND K = 3.0 THEN 465NEXT K \ NEXT J465 IF arr_S(5) = G THEN 171GOTO 175475 P$ := "X"Q$ := "O"500 PRINT RUN _ecb_input_prefix_t \ INPUT "WHERE DO YOU MOVE? ", M \ RUN _ecb_input_suffix_tIF M = 0.0 THEN  PRINT "THANKS FOR THE GAME."  GOTO 2000ENDIFIF M > 9.0 THEN 506IF arr_S(INT(M)) = 0.0 THEN 510506 PRINT "THAT SQUARE IS OCCUPIED."PRINT PRINT GOTO 500510 G := 1arr_S(INT(M)) := 1GOSUB 1000GOTO 1001000   PRINT FOR I = 1 TO 9  PRINT " ";  IF arr_S(I) <> -1.0 THEN 1014  PRINT Q$; " ";  GOTO 10201014   IF arr_S(I) <> 0.0 THEN 1018  PRINT "  ";  GOTO 10201018   PRINT P$; " ";1020   IF I <> 3.0 AND I <> 6.0 THEN 1050  PRINT   PRINT "---+---+---"  GOTO 10801050   IF I = 9.0 THEN 1080  PRINT "!";1080 NEXT IPRINT PRINT PRINT FOR I = 1 TO 7 STEP 3  IF arr_S(I) <> arr_S(I + 1) THEN 1115  IF arr_S(I) <> arr_S(I + 2) THEN 1115  IF arr_S(I) = -1.0 THEN 1350  IF arr_S(I) = 1.0 THEN 12001115   NEXT IFOR I = 1 TO 3  IF arr_S(I) <> arr_S(I + 3) THEN 1150  IF arr_S(I) <> arr_S(I + 6) THEN 1150  IF arr_S(I) = -1.0 THEN 1350  IF arr_S(I) = 1.0 THEN 12001150   NEXT IFOR I = 1 TO 9  IF arr_S(I) = 0.0 THEN 1155NEXT IGOTO 14001155 IF arr_S(5) <> G THEN 1170IF arr_S(1) = G AND arr_S(9) = G THEN 1180IF arr_S(3) = G AND arr_S(7) = G THEN 11801170 RETURN1180 IF G = -1.0 THEN 13501200 PRINT "YOU BEAT ME!! GOOD GAME."GOTO 20001350 PRINT "I WIN, TURKEY!!!"GOTO 20001400 PRINT "IT'S A DRAW. THANK YOU."2000 END