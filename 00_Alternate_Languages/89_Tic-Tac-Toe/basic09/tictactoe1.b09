procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure tictactoe1base 0DIM A: INTEGERA := 0B := 0.0C := 0.0D := 0.0E := 0.0M := 0.0P := 0.0Q := 0.0R := 0.0S := 0.0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(31.0); "TIC TAC TOE"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT (* *)(*   THIS PROGRAM PLAYS TIC TAC TOE *)(*   THE MACHINE GOES FIRST *)PRINT "THE GAME BOARD IS NUMBERED:"PRINT PRINT "1  2  3"PRINT "8  9  4"PRINT "7  6  5"PRINT (* *)(* *)(* *)(* DEF FNM(X)=X-8*INT((X-1)/8) *)(* *)(*  MAIN PROGRAM *)210 PRINT PRINT A := 9M := AGOSUB 650P := MfnM_1 := P + 1.0 \ RUN ecb_int((fnM_1 - 1.0) / 8.0, tmp_1) \ B := (fnM_1 - 8.0 * tmp_1)M := BGOSUB 650Q := MfnM_1 := B + 4.0 \ RUN ecb_int((fnM_1 - 1.0) / 8.0, tmp_1) \ IF Q = (fnM_1 - 8.0 * tmp_1) THEN 360fnM_1 := B + 4.0 \ RUN ecb_int((fnM_1 - 1.0) / 8.0, tmp_1) \ C := (fnM_1 - 8.0 * tmp_1)M := CGOSUB 700GOTO 730360 fnM_1 := B + 2.0 \ RUN ecb_int((fnM_1 - 1.0) / 8.0, tmp_1) \ C := (fnM_1 - 8.0 * tmp_1)M := CGOSUB 650R := MfnM_1 := C + 4.0 \ RUN ecb_int((fnM_1 - 1.0) / 8.0, tmp_1) \ IF R = (fnM_1 - 8.0 * tmp_1) THEN 450fnM_1 := C + 4.0 \ RUN ecb_int((fnM_1 - 1.0) / 8.0, tmp_1) \ D := (fnM_1 - 8.0 * tmp_1)M := DGOSUB 700GOTO 730450 RUN ecb_int(P / 2.0, tmp_1) \ IF P / 2.0 <> tmp_1 THEN 500fnM_1 := C + 7.0 \ RUN ecb_int((fnM_1 - 1.0) / 8.0, tmp_1) \ D := (fnM_1 - 8.0 * tmp_1)M := DGOSUB 700GOTO 730500 fnM_1 := C + 3.0 \ RUN ecb_int((fnM_1 - 1.0) / 8.0, tmp_1) \ D := (fnM_1 - 8.0 * tmp_1)M := DGOSUB 650S := MfnM_1 := D + 4.0 \ RUN ecb_int((fnM_1 - 1.0) / 8.0, tmp_1) \ IF S = (fnM_1 - 8.0 * tmp_1) THEN 590fnM_1 := D + 4.0 \ RUN ecb_int((fnM_1 - 1.0) / 8.0, tmp_1) \ E := (fnM_1 - 8.0 * tmp_1)M := EGOSUB 700(* *)590 fnM_1 := D + 6.0 \ RUN ecb_int((fnM_1 - 1.0) / 8.0, tmp_1) \ E := (fnM_1 - 8.0 * tmp_1)M := EGOSUB 700PRINT "THE GAME IS A DRAW."GOTO 210(* *)650 GOSUB 700PRINT "YOUR MOVE";RUN _ecb_input_prefix_t \ INPUT "? ", M \ RUN _ecb_input_suffix_tRETURN700 run ecb_str(M, tmp_1$) \ PRINT "COMPUTER MOVES"; tmp_1$RETURN(* *)730 PRINT "AND WINS ********"GOTO 210END