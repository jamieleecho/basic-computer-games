procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure synonymbase 0DIM C, G, I, J, K: INTEGERA$ := ""C := 0G := 0G1 := 0.0I := 0J := 0K := 0N := 0.0N1 := 0.0N2 := 0.0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(34.0); "SYNONYM"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT DIM arr_R$(6), arr_W$(11)FOR tmp_1 = 0 TO 5 \ arr_R$(tmp_1) := "" \ NEXT tmp_1FOR tmp_1 = 0 TO 10 \ arr_W$(tmp_1) := "" \ NEXT tmp_1DIM arr_R(31): INTEGERFOR tmp_1 = 0 TO 30 \ arr_R(tmp_1) := 0 \ NEXT tmp_1DIM arr_L(31)FOR tmp_1 = 0 TO 30 \ arr_L(tmp_1) := 0 \ NEXT tmp_1arr_R$(1.0) := "RIGHT"arr_R$(2.0) := "CORRECT"arr_R$(3.0) := "FINE"arr_R$(4.0) := "GOOD!"arr_R$(5.0) := "CHECK"C := 0PRINT "A SYNONYM OF A WORD MEANS ANOTHER WORD IN THE ENGLISH"PRINT "LANGUAGE WHICH HAS THE SAME OR VERY NEARLY THE SAME";PRINT " MEANING."PRINT "I CHOOSE A WORD -- YOU TYPE A SYNONYM."PRINT "IF YOU CAN'T THINK OF A SYNONYM, TYPE THE WORD 'HELP'"PRINT "AND I WILL TELL YOU A SYNONYM."PRINT 150 RESTOREC := C + 1READ NIF C > N THEN 420170 RUN ecb_int(RND(1.0) * N + 1.0, N1)IF arr_R(INT(N1)) = 1.0 THEN 170arr_R(INT(N1)) := 1FOR I = 1 TO N1  READ N2  FOR J = 1 TO N2    READ arr_W$(J)  NEXT JNEXT IFOR J = 1 TO N2arr_L(J) := JNEXT Jarr_L(0.0) := N2G := 1PRINT arr_L(G) := arr_L(INT(arr_L(0.0)))arr_L(0.0) := N2 - 1.0PRINT 240 PRINT "     WHAT IS A SYNONYM OF "; arr_W$(G);RUN _ecb_input_prefix_t \ INPUT "? ", A$ \ RUN _ecb_input_suffix_tIF A$ = "HELP" THEN 340FOR K = 1 TO N2  IF G = K THEN 290  IF A$ = arr_W$(K) THEN 320290 NEXT KPRINT "     TRY AGAIN."GOTO 240320 RUN ecb_int(RND(1.0) * 5.0 + 1.0, tmp_1) \ PRINT arr_R$(tmp_1)GOTO 150340 RUN ecb_int(RND(1.0) * arr_L(0.0) + 1.0, G1)PRINT "**** A SYNONYM OF "; arr_W$(G); " IS "; arr_W$(INT(arr_L(INT(G1)))); "."PRINT arr_L(INT(G1)) := arr_L(INT(arr_L(0.0)))arr_L(0.0) := arr_L(0.0) - 1.0GOTO 240420 PRINT PRINT "SYNONYM DRILL COMPLETED."GOTO 999DATA 10.0DATA 5.0, "FIRST", "START", "BEGINNING", "ONSET", "INITIAL"DATA 5.0, "SIMILAR", "ALIKE", "SAME", "LIKE", "RESEMBLING"DATA 5.0, "MODEL", "PATTERN", "PROTOTYPE", "STANDARD", "CRITERION"DATA 5.0, "SMALL", "INSIGNIFICANT", "LITTLE", "TINY", "MINUTE"DATA 6.0, "STOP", "HALT", "STAY", "ARREST", "CHECK", "STANDSTILL"DATA 6.0, "HOUSE", "DWELLING", "RESIDENCE", "DOMICILE", "LODGING"DATA "HABITATION"DATA 7.0, "PIT", "HOLE", "HOLLOW", "WELL", "GULF", "CHASM", "ABYSS"DATA 7.0, "PUSH", "SHOVE", "THRUST", "PROD", "POKE", "BUTT", "PRESS"DATA 6.0, "RED", "ROUGE", "SCARLET", "CRIMSON", "FLAME", "RUBY"DATA 7.0, "PAIN", "SUFFERING", "HURT", "MISERY", "DISTRESS", "ACHE"DATA "DISCOMFORT"999 END