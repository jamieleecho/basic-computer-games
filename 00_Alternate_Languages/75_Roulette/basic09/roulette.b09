procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure roulettebase 0DIM C, I, I1: INTEGERA$ := ""B$ := ""C := 0D := 0.0D$ := ""E$ := ""I := 0I1 := 0M$ := ""P := 0.0R := 0.0S := 0.0X := 0.0Y := 0.0Y$ := ""Z := 0.0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(33.0); "ROULETTE"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT PRINT "ENTER THE CURRENT DATE (AS IN 'JANUARY 23, 1979') -";RUN _ecb_input_prefix_t \ INPUT "? ", D$, E$ \ RUN _ecb_input_suffix_t(*-ROULETTE *)(*-DAVID JOSLIN *)PRINT "WELCOME TO THE ROULETTE TABLE"PRINT PRINT "DO YOU WANT INSTRUCTIONS";RUN _ecb_input_prefix_t \ INPUT "? ", Y$ \ RUN _ecb_input_suffix_tIF LEFT$(Y$, 1.0) = "N" THEN 1550PRINT PRINT "THIS IS THE BETTING LAYOUT"PRINT "  (*=RED)"PRINT PRINT " 1*    2     3*"PRINT " 4     5*    6 "PRINT " 7*    8     9*"PRINT "10    11    12*"PRINT "---------------"PRINT "13    14*   15 "PRINT "16*   17    18*"PRINT "19*   20    21*"PRINT "22    23*   24 "PRINT "---------------"PRINT "25*   26    27*"PRINT "28    29    30*"PRINT "31    32*   33 "PRINT "34*   35    36*"PRINT "---------------"PRINT "    00    0    "PRINT PRINT "TYPES OF BETS"PRINT PRINT "THE NUMBERS 1 TO 36 SIGNIFY A STRAIGHT BET"PRINT "ON THAT NUMBER."PRINT "THESE PAY OFF 35:1"PRINT PRINT "THE 2:1 BETS ARE:"PRINT " 37) 1-12     40) FIRST COLUMN"PRINT " 38) 13-24    41) SECOND COLUMN"PRINT " 39) 25-36    42) THIRD COLUMN"PRINT PRINT "THE EVEN MONEY BETS ARE:"PRINT " 43) 1-18     46) ODD"PRINT " 44) 19-36    47) RED"PRINT " 45) EVEN     48) BLACK"PRINT PRINT " 49)0 AND 50)00 PAY OFF 35:1"PRINT " NOTE: 0 AND 00 DO NOT COUNT UNDER ANY"PRINT "       BETS EXCEPT THEIR OWN."PRINT PRINT "WHEN I ASK FOR EACH BET, TYPE THE NUMBER"PRINT "AND THE AMOUNT, SEPARATED BY A COMMA."PRINT "FOR EXAMPLE: TO BET $500 ON BLACK, TYPE 48,500"PRINT "WHEN I ASK FOR A BET."PRINT PRINT "THE MINIMUM BET IS $5, THE MAXIMUM IS $500."PRINT 1550 (*-PROGRAM BEGINS HERE *)(*-TYPE OF BET(NUMBER) ODDS *)(*  DON'T NEED TO DIMENSION STRINGS *)DIM arr_X(39): INTEGERFOR tmp_1 = 0 TO 38 \ arr_X(tmp_1) := 0 \ NEXT tmp_1DIM arr_B(101), arr_C(101), arr_T(101)FOR tmp_1 = 0 TO 100 \ arr_B(tmp_1) := 0 \ NEXT tmp_1FOR tmp_1 = 0 TO 100 \ arr_C(tmp_1) := 0 \ NEXT tmp_1FOR tmp_1 = 0 TO 100 \ arr_T(tmp_1) := 0 \ NEXT tmp_1DIM arr_A(51): INTEGERFOR tmp_1 = 0 TO 50 \ arr_A(tmp_1) := 0 \ NEXT tmp_1FOR I = 1 TO 38arr_X(I) := 0NEXT I(*  MAT X=ZER *)P := 1000.0D := 100000.01630 PRINT "HOW MANY BETS";RUN _ecb_input_prefix_t \ INPUT "? ", Y \ RUN _ecb_input_suffix_tRUN ecb_int(Y, tmp_1) \ IF Y < 1.0 OR Y <> tmp_1 THEN 1630FOR I = 1 TO 50arr_A(I) := 0NEXT I(*  MAT A=ZER *)FOR C = 1 TO Y1680   run ecb_str(float(C), tmp_1$) \ PRINT "NUMBER"; tmp_1$;  RUN _ecb_input_prefix_t \ INPUT "? ", X, Z \ RUN _ecb_input_suffix_t  arr_B(C) := Z  arr_T(C) := X  RUN ecb_int(X, tmp_1) \ IF X < 1.0 OR X > 50.0 OR X <> tmp_1 THEN 1680  RUN ecb_int(Z, tmp_1) \ IF Z < 1.0 OR Z <> tmp_1 THEN 1680  IF Z < 5.0 OR Z > 500.0 THEN 1680  IF arr_A(INT(X)) = 0.0 THEN 1780  PRINT "YOU MADE THAT BET ONCE ALREADY,DUM-DUM"  GOTO 16801780   arr_A(INT(X)) := 1NEXT CPRINT "SPINNING"PRINT PRINT 1830 RUN ecb_int(RND(1.0) * 100.0, S)IF S = 0.0 OR S > 38.0 THEN 1830arr_X(INT(S)) := arr_X(INT(S)) + 1IF S < 37.0 THEN 1920IF S = 37.0 THEN 1900PRINT "00"GOTO 20201900 PRINT "0"GOTO 20201920 RESTOREFOR I1 = 1 TO 18  READ R  IF R = S THEN 2000NEXT I1A$ := "BLACK"1980 run ecb_str(S, tmp_1$) \ PRINT tmp_1$; A$GOTO 20202000 A$ := "RED"GOTO 19802020 PRINT FOR C = 1 TO Y  IF arr_T(C) < 37.0 THEN 2710  ON INT(arr_T(C) - 36.0) GOTO 2090, 2190, 2220, 2250, 2300, 2350, 2400, 2470, 2500  ON INT(arr_T(C) - 45.0) GOTO 2530, 2560, 2630  GOTO 2710  STOP2090 (*  1-12(37) 2:1 *)  IF S <= 12.0 THEN 21502110   run ecb_str(arr_B(C), tmp_1$) \ run ecb_str(float(C), tmp_2$) \ PRINT "YOU LOSE"; tmp_1$; "DOLLARS ON BET"; tmp_2$  D := D + arr_B(C)  P := P - arr_B(C)  GOTO 21802150   run ecb_str(float(C), tmp_1$) \ PRINT "YOU WIN"; arr_B(C) * 2.0; "DOLLARS ON BET"; tmp_1$  D := D - arr_B(C) * 2.0  P := P + arr_B(C) * 2.02180   GOTO 28102190 (*  13-24(38) 2:1 *)  IF S > 12.0 AND S < 25.0 THEN 2150  GOTO 21102220 (*  25-36(39) 2:1 *)  IF S > 24.0 AND S < 37.0 THEN 2150  GOTO 21102250 (*  FIRST COLUMN(40) 2:1 *)  FOR I = 1 TO 34 STEP 3    IF S = I THEN 2150  NEXT I  GOTO 21102300 (*  SECOND COLUMN(41) 2:1 *)  FOR I = 2 TO 35 STEP 3    IF S = I THEN 2150  NEXT I  GOTO 21102350 (*  THIRD COLUMN(42) 2:1 *)  FOR I = 3 TO 36 STEP 3    IF S = I THEN 2150  NEXT I  GOTO 21102400 (*  1-18(43) 1:1 *)  IF S < 19.0 THEN 2430  GOTO 21102430   run ecb_str(arr_B(C), tmp_1$) \ run ecb_str(float(C), tmp_2$) \ PRINT "YOU WIN"; tmp_1$; "DOLLARS ON BET"; tmp_2$  D := D - arr_B(C)  P := P + arr_B(C)  GOTO 28102470 (*  19-36(44) 1:1 *)  IF S < 37.0 AND S > 18.0 THEN 2430  GOTO 21102500 (*  EVEN(45) 1:1 *)  RUN ecb_int(S / 2.0, tmp_1) \ IF S / 2.0 = tmp_1 AND S < 37.0 THEN 2430  GOTO 21102530 (*  ODD(46) 1:1 *)  RUN ecb_int(S / 2.0, tmp_1) \ IF S / 2.0 <> tmp_1 AND S < 37.0 THEN 2430  GOTO 21102560 (*  RED(47) 1:1 *)  RESTORE  FOR I = 1 TO 18    READ R    IF S = R THEN 2430  NEXT I  GOTO 21102630 (*  BLACK(48) 1:1 *)  RESTORE  FOR I = 1 TO 18    READ R    IF S = R THEN 2110  NEXT I  IF S > 36.0 THEN 2110  GOTO 24302710 (*--1TO36,0,00(1-36,49,50)35:1 *)  IF arr_T(C) < 49.0 THEN 2760  IF arr_T(C) = 49.0 AND S = 37.0 THEN 2780  IF arr_T(C) = 50.0 AND S = 38.0 THEN 2780  GOTO 21102760   IF arr_T(C) = S THEN 2780  GOTO 21102780   run ecb_str(float(C), tmp_1$) \ PRINT "YOU WIN"; arr_B(C) * 35.0; "DOLLARS ON BET"; tmp_1$  D := D - arr_B(C) * 35.0  P := P + arr_B(C) * 35.02810 NEXT CPRINT PRINT "TOTALS:", "ME", "YOU"run ecb_str(D, tmp_1$) \ run ecb_str(P, tmp_2$) \ PRINT " ", tmp_1$, tmp_2$IF P > 0.0 THEN 2880PRINT "OOPS! YOU JUST SPENT YOUR LAST DOLLAR!"GOTO 31902880 IF D > 0.0 THEN 2920PRINT "YOU BROKE THE HOUSE!"P := 101000.0GOTO 29602920 PRINT "AGAIN";RUN _ecb_input_prefix_t \ INPUT "? ", Y$ \ RUN _ecb_input_suffix_tIF LEFT$(Y$, 1.0) = "Y" THEN 1630DATA 1.0, 3.0, 5.0, 7.0, 9.0, 12.0, 14.0, 16.0, 18.0, 19.0, 21.0, 23.0, 25.0, 27.0, 30.0, 32.0, 34.0, 36.02960 IF P < 1.0 THEN 3190PRINT "TO WHOM SHALL I MAKE THE CHECK";RUN _ecb_input_prefix_t \ INPUT "? ", B$ \ RUN _ecb_input_suffix_tPRINT FOR I = 1 TO 72PRINT "-";NEXT I(* PRINT 72 DASHES *)RUN ecb_int(RND(1.0) * 100.0, tmp_1) \ run ecb_str(tmp_1, tmp_1$) \ PRINT TAB(51.0); "CHECK NO. "; tmp_1$PRINT GOSUB 3230PRINT TAB(41.0); M$PRINT PRINT PRINT "PAY TO THE ORDER OF-----"; B$; "-----$ ";run ecb_str(P, tmp_1$) \ PRINT tmp_1$PRINT PRINT PRINT TAB(11.0), "THE MEMORY BANK OF NEW YORK"PRINT PRINT TAB(41.0), "THE COMPUTER"PRINT TAB(41.0); "----------X-----"PRINT FOR I = 1 TO 62PRINT "-";NEXT IPRINT "COME BACK SOON!"GOTO 32103190 PRINT "THANKS FOR YOUR MONEY."PRINT "I'LL USE IT TO BUY A SOLID GOLD ROULETTE WHEEL"3210 PRINT GOTO 34203230 (* *)(*     THIS ROUTINE RETURNS THE CURRENT DATE IN M$ *)(*     IF YOU HAVE SYSTEM FUNCTIONS TO HANDLE THIS *)(*     THEY CAN BE USED HERE.  HOWEVER IN THIS *)(*     PROGRAM, WE JUST INPUT THE DATE AT THE START *)(*     THE GAME *)(* *)(*     THE DATE IS RETURNED IN VARIABLE M$ *)M$ := D$ + ", " + E$RETURN3420 END