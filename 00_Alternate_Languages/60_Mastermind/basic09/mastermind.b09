procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure mastermindbase 0DIM B, C, F, H, M, Q, R, S, T, W, Y, Z: INTEGERA := 0.0B := 0B1 := 0.0C := 0C9 := 0.0F := 0G := 0.0H := 0L$ := ""M := 0P := 0.0P9 := 0.0Q := 0R := 0R9 := 0.0S := 0T := 0W := 0W1 := 0.0X := 0.0X$ := ""Y := 0Z := 0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(31.0); "MASTERMIND"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT (* *)(*     MASTERMIND II *)(*     STEVE NORTH *)(*     CREATIVE COMPUTING *)(*     PO BOX 789-M MORRISTOWN NEW JERSEY 07960 *)(* *)(* *)80 RUN _ecb_input_prefix_t \ INPUT "NUMBER OF COLORS? ", C9 \ RUN _ecb_input_suffix_tIF C9 > 8.0 THEN  PRINT "NO MORE THAN 8, PLEASE!"  GOTO 80ENDIFRUN _ecb_input_prefix_t \ INPUT "NUMBER OF POSITIONS? ", P9 \ RUN _ecb_input_suffix_tRUN _ecb_input_prefix_t \ INPUT "NUMBER OF ROUNDS? ", R9 \ RUN _ecb_input_suffix_tP := C9 ^ P9run ecb_str(P, tmp_1$) \ PRINT "TOTAL POSSIBILITIES ="; tmp_1$H := 0C := 0DIM arr_S$(11), arr_A$(11), arr_G$(11), arr_H$(11)FOR tmp_1 = 0 TO 10 \ arr_S$(tmp_1) := "" \ NEXT tmp_1FOR tmp_1 = 0 TO 10 \ arr_A$(tmp_1) := "" \ NEXT tmp_1FOR tmp_1 = 0 TO 10 \ arr_G$(tmp_1) := "" \ NEXT tmp_1FOR tmp_1 = 0 TO 10 \ arr_H$(tmp_1) := "" \ NEXT tmp_1DIM arr_Q(11), arr_S(11, 3), arr_I(4097): INTEGERFOR tmp_1 = 0 TO 10 \ arr_Q(tmp_1) := 0 \ NEXT tmp_1FOR tmp_1 = 0 TO 10 \ FOR tmp_2 = 0 TO 2 \ arr_S(tmp_1, tmp_2) := 0 \ NEXT tmp_2 \ NEXT tmp_1FOR tmp_1 = 0 TO 4096 \ arr_I(tmp_1) := 0 \ NEXT tmp_1L$ := "BWRGOYPT"PRINT PRINT PRINT "COLOR     LETTER"PRINT "=====     ======"FOR X = 1.0 TO C9  READ X$  PRINT X$; TAB(14.0); MID$(L$, INT(X), 1.0)NEXT XPRINT FOR R = 1 TO R9  PRINT   run ecb_str(float(R), tmp_1$) \ PRINT "ROUND NUMBER"; tmp_1$; "----"  PRINT   PRINT "GUESS MY COMBINATION."  PRINT (*     GET A COMBINATION *)  RUN ecb_int(P * RND(1.0) + 1.0, A)  GOSUB 3000  FOR X = 1.0 TO A    GOSUB 3500  NEXT X  FOR M = 1 TO 10380     run ecb_str(float(M), tmp_1$) \ PRINT "MOVE # "; tmp_1$; " GUESS ";RUN _ecb_input_prefix_t \ INPUT "? ", X$ \ RUN _ecb_input_suffix_t    IF X$ = "BOARD" THEN 2000    IF X$ = "QUIT" THEN 2500    IF LEN(X$) <> P9 THEN      PRINT "BAD NUMBER OF POSITIONS."      GOTO 380ENDIF(*     UNPACK X$ INTO G$(1-P9) *)    FOR X = 1.0 TO P9      FOR Y = 1 TO C9        IF MID$(X$, INT(X), 1.0) = MID$(L$, Y, 1.0) THEN 480      NEXT Y      PRINT "'"; MID$(X$, INT(X), 1.0); "' IS UNRECOGNIZED."      GOTO 380480       arr_G$(INT(X)) := MID$(X$, INT(X), 1.0)    NEXT X(*     NOW WE CONVERT Q(1-P9) INTO A$(1-P9) [ACTUAL GUESS] *)    GOSUB 4000(*     AND GET NUMBER OF BLACKS AND WHITES *)    GOSUB 4500    IF B = P9 THEN 630(*     TELL HUMAN RESULTS *)    run ecb_str(float(B), tmp_1$) \ run ecb_str(float(W), tmp_2$) \ PRINT "YOU HAVE "; tmp_1$; " BLACKS AND "; tmp_2$; " WHITES."(*     SAVE ALL THIS STUFF FOR BOARD PRINTOUT LATER *)    arr_S$(M) := X$    arr_S(M, 1) := B    arr_S(M, 2) := W  NEXT M  PRINT "YOU RAN OUT OF MOVES!  THAT'S ALL YOU GET!"  GOTO 640  GOSUB 4000  PRINT "THE ACTUAL COMBINATION WAS: ";  FOR X = 1.0 TO P9    PRINT arr_A$(INT(X));  NEXT X  PRINT 630   run ecb_str(float(M), tmp_1$) \ PRINT "YOU GUESSED IT IN "; tmp_1$; " MOVES!"640   H := H + M  GOSUB 5000660 (* *)(*     NOW COMPUTER GUESSES *)(* *)  FOR X = 1.0 TO P    arr_I(INT(X)) := 1  NEXT X  PRINT "NOW I GUESS.  THINK OF A COMBINATION."  RUN _ecb_input_prefix_t \ INPUT "HIT RETURN WHEN READY:? ", X$ \ RUN _ecb_input_suffix_t  FOR M = 1 TO 10    GOSUB 3000(*     FIND A GUESS *)    RUN ecb_int(P * RND(1.0) + 1.0, G)    IF arr_I(INT(G)) = 1.0 THEN 890    FOR X = G TO P      IF arr_I(INT(X)) = 1.0 THEN 880    NEXT X    FOR X = 1.0 TO G      IF arr_I(INT(X)) = 1.0 THEN 880    NEXT X    PRINT "YOU HAVE GIVEN ME INCONSISTENT INFORMATION."    PRINT "TRY AGAIN, AND THIS TIME PLEASE BE MORE CAREFUL."    GOTO 660880     G := X890 (*     NOW WE CONVERT GUESS #G INTO G$ *)    FOR X = 1.0 TO G      GOSUB 3500    NEXT X    GOSUB 6000    PRINT "MY GUESS IS: ";    FOR X = 1.0 TO P9      PRINT arr_H$(INT(X));    NEXT X    RUN _ecb_input_prefix_t \ INPUT "  BLACKS, WHITES ? ", B1, W1 \ RUN _ecb_input_suffix_t    IF B1 = P9 THEN 1120    GOSUB 3000    FOR X = 1.0 TO P      GOSUB 3500      IF arr_I(INT(X)) = 0.0 THEN 1070      GOSUB 6500      GOSUB 4000      GOSUB 4500      IF B1 <> B OR W1 <> W THEN        arr_I(INT(X)) := 0ENDIF1070     NEXT X  NEXT M  PRINT "I USED UP ALL MY MOVES!"  PRINT "I GUESS MY CPU IS JUST HAVING AN OFF DAY."  GOTO 11301120   run ecb_str(float(M), tmp_1$) \ PRINT "I GOT IT IN "; tmp_1$; " MOVES!"1130   C := C + M  GOSUB 5000NEXT RPRINT "GAME OVER"PRINT "FINAL SCORE:"GOSUB 5040STOP2000 (* *)(*     BOARD PRINTOUT ROUTINE *)(* *)PRINT PRINT "BOARD"PRINT "MOVE     GUESS          BLACK     WHITE"FOR Z = 1 TO M - 1  run ecb_str(float(Z), tmp_1$) \ run ecb_str(float(arr_S(Z, 1)), tmp_2$) \ run ecb_str(float(arr_S(Z, 2)), tmp_3$) \ PRINT tmp_1$; TAB(10.0); arr_S$(Z); TAB(26.0); tmp_2$; TAB(36.0); tmp_3$NEXT ZPRINT GOTO 3802500 (* *)(*     QUIT ROUTINE *)(* *)PRINT "QUITTER!  MY COMBINATION WAS: ";GOSUB 4000FOR X = 1.0 TO P9  PRINT arr_A$(INT(X));NEXT XPRINT PRINT "GOOD BYE"STOP3000 (* *)(*     INITIALIZE Q(1-P9) TO ZEROS *)(* *)FOR S = 1 TO P9  arr_Q(S) := 0NEXT SRETURN3500 (* *)(*     INCREMENT Q(1-P9) *)(* *)IF arr_Q(1) > 0.0 THEN 3530(*  IF ZERO, THIS IS OUR FIRST INCREMENT: MAKE ALL ONES *)FOR S = 1 TO P9  arr_Q(S) := 1NEXT SRETURN3530 Q := 13540 arr_Q(Q) := arr_Q(Q) + 1IF arr_Q(Q) <= C9 THEN  RETURNENDIFarr_Q(Q) := 1Q := Q + 1GOTO 35404000 (* *)(*     CONVERT Q(1-P9) TO A$(1-P9) *)(* *)FOR S = 1 TO P9  arr_A$(S) := MID$(L$, arr_Q(S), 1.0)NEXT SRETURN4500 (* *)(*     GET NUMBER OF BLACKS (B) AND WHITES (W) *)(*     MASHES G$ AND A$ IN THE PROCESS *)(* *)B := 0W := 0F := 0FOR S = 1 TO P9  IF arr_G$(S) <> arr_A$(S) THEN 4620  B := B + 1  arr_G$(S) := CHR$(F)  arr_A$(S) := CHR$(F + 1.0)  F := F + 2  GOTO 46604620   FOR T = 1 TO P9    IF arr_G$(S) <> arr_A$(T) THEN 4650    IF arr_G$(T) = arr_A$(T) THEN 4650    W := W + 1    arr_A$(T) := CHR$(F)    arr_G$(S) := CHR$(F + 1.0)    F := F + 2    GOTO 46604650   NEXT T4660 NEXT SRETURN5000 (* *)(*     PRINT SCORE *)(* *)PRINT "SCORE:"5040 run ecb_str(float(C), tmp_1$) \ PRINT "     COMPUTER "; tmp_1$run ecb_str(float(H), tmp_1$) \ PRINT "     HUMAN    "; tmp_1$PRINT RETURN(* *)(*     CONVERT Q(1-P9) INTO G$(1-P9) *)(* *)FOR S = 1 TO P9  arr_G$(S) := MID$(L$, arr_Q(S), 1.0)NEXT SRETURN6000 (* *)(*     CONVERT Q(1-P9) TO H$(1-P9) *)(* *)FOR S = 1 TO P9  arr_H$(S) := MID$(L$, arr_Q(S), 1.0)NEXT SRETURN6500 (* *)(*     COPY H$ INTO G$ *)(* *)FOR S = 1 TO P9  arr_G$(S) := arr_H$(S)NEXT SRETURN(*     PROGRAM DATA FOR COLOR NAMES *)DATA "BLACK", "WHITE", "RED", "GREEN", "ORANGE", "YELLOW", "PURPLE", "TAN"(*   ...WE'RE SORRY BUT IT'S TIME TO GO... *)END