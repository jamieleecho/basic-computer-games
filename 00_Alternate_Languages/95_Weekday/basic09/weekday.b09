procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure weekdaybase 0DIM B, I: INTEGERA := 0.0A8 := 0.0B := 0D := 0.0D1 := 0.0E := 0.0F := 0.0I := 0I1 := 0.0I2 := 0.0I5 := 0.0I6 := 0.0I7 := 0.0K1 := 0.0K5 := 0.0K6 := 0.0K7 := 0.0M := 0.0M1 := 0.0T1 := 0.0Y := 0.0Y1 := 0.0Y2 := 0.0Y3 := 0.0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(33.0); "WEEKDAY"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT PRINT "WEEKDAY IS A COMPUTER DEMONSTRATION THAT"PRINT "GIVES FACTS ABOUT A DATE OF INTEREST TO YOU."PRINT PRINT "ENTER TODAY'S DATE IN THE FORM: 3,24,1979  ";RUN _ecb_input_prefix_t \ INPUT "? ", M1, D1, Y1 \ RUN _ecb_input_suffix_t(* THIS PROGRAM DETERMINES THE DAY OF THE WEEK *)(*  FOR A DATE AFTER 1582 *)(* DEF FNA(A)=INT(A/4) *)DIM arr_T(13)FOR tmp_1 = 0 TO 12 \ arr_T(tmp_1) := 0 \ NEXT tmp_1(* DEF FNB(A)=INT(A/7) *)(* SPACE OUTPUT AND READ IN INITIAL VALUES FOR MONTHS. *)FOR I = 1 TO 12  READ arr_T(I)NEXT IPRINT "ENTER DAY OF BIRTH (OR OTHER DAY OF INTEREST)";RUN _ecb_input_prefix_t \ INPUT "? ", M, D, Y \ RUN _ecb_input_suffix_tPRINT RUN ecb_int((Y - 1500.0) / 100.0, I1)(* TEST FOR DATE BEFORE CURRENT CALENDAR. *)IF Y - 1582.0 < 0.0 THEN 1300LET A := I1 * 5.0 + (I1 + 3.0) / 4.0fnB_1 := A \ RUN ecb_int(fnB_1 / 7.0, tmp_1) \ RUN ecb_int(A - tmp_1 * 7.0, I2)RUN ecb_int(Y / 100.0, Y2)RUN ecb_int(Y - Y2 * 100.0, Y3)LET A := Y3 / 4.0 + Y3 + D + arr_T(INT(M)) + I2fnB_1 := A \ RUN ecb_int(fnB_1 / 7.0, tmp_1) \ RUN ecb_int(A - tmp_1 * 7.0, tmp_2) \ LET B := tmp_2 + 1IF M > 2.0 THEN 470IF Y3 = 0.0 THEN 440fnA_1 := Y \ RUN ecb_int(fnA_1 / 4.0, tmp_1) \ RUN ecb_int(Y - tmp_1 * 4.0, T1)IF T1 <> 0.0 THEN 470400 IF B <> 0.0 THEN 420LET B := 6420 LET B := B - 1GOTO 470440 LET A := I1 - 1.0fnA_1 := A \ RUN ecb_int(fnA_1 / 4.0, tmp_1) \ RUN ecb_int(A - tmp_1 * 4.0, T1)IF T1 = 0.0 THEN 400470 IF B <> 0.0 THEN 490LET B := 7490 IF (Y1 * 12.0 + M1) * 31.0 + D1 < (Y * 12.0 + M) * 31.0 + D THEN 550IF (Y1 * 12.0 + M1) * 31.0 + D1 = (Y * 12.0 + M) * 31.0 + D THEN 530run ecb_str(M, tmp_1$) \ run ecb_str(D, tmp_2$) \ run ecb_str(Y, tmp_3$) \ PRINT tmp_1$; "/"; tmp_2$; "/"; tmp_3$; " WAS A ";GOTO 570530 run ecb_str(M, tmp_1$) \ run ecb_str(D, tmp_2$) \ run ecb_str(Y, tmp_3$) \ PRINT tmp_1$; "/"; tmp_2$; "/"; tmp_3$; " IS A ";GOTO 570550 run ecb_str(M, tmp_1$) \ run ecb_str(D, tmp_2$) \ run ecb_str(Y, tmp_3$) \ PRINT tmp_1$; "/"; tmp_2$; "/"; tmp_3$; " WILL BE A ";(* PRINT THE DAY OF THE WEEK THE DATE FALLS ON. *)570 IF B <> 1.0 THEN 590PRINT "SUNDAY."590 IF B <> 2.0 THEN 610PRINT "MONDAY."610 IF B <> 3.0 THEN 630PRINT "TUESDAY."630 IF B <> 4.0 THEN 650PRINT "WEDNESDAY."650 IF B <> 5.0 THEN 670PRINT "THURSDAY."670 IF B <> 6.0 THEN 690GOTO 1250690 IF B <> 7.0 THEN 710PRINT "SATURDAY."710 IF (Y1 * 12.0 + M1) * 31.0 + D1 = (Y * 12.0 + M) * 31.0 + D THEN 1120LET I5 := Y1 - YPRINT LET I6 := M1 - MLET I7 := D1 - DIF I7 >= 0.0 THEN 790LET I6 := I6 - 1.0LET I7 := I7 + 30.0790 IF I6 >= 0.0 THEN 820LET I5 := I5 - 1.0LET I6 := I6 + 12.0820 IF I5 < 0.0 THEN 1310IF I7 <> 0.0 THEN 850IF I6 <> 0.0 THEN 850PRINT "***HAPPY BIRTHDAY***"850 PRINT " ", " ", "YEARS", "MONTHS", "DAYS"PRINT " ", " ", "-----", "------", "----"run ecb_str(I5, tmp_1$) \ run ecb_str(I6, tmp_2$) \ run ecb_str(I7, tmp_3$) \ PRINT "YOUR AGE (IF BIRTHDATE) ", tmp_1$, tmp_2$, tmp_3$RUN ecb_int(I6 / 2.0, tmp_1) \ LET A8 := (I5 * 365.0) + (I6 * 30.0) + I7 + tmp_1LET K5 := I5LET K6 := I6LET K7 := I7(* CALCULATE RETIREMENT DATE. *)LET E := Y + 65.0(* CALCULATE TIME SPENT IN THE FOLLOWING FUNCTIONS. *)LET F := 0.35PRINT "YOU HAVE SLEPT ",GOSUB 1370LET F := 0.17PRINT "YOU HAVE EATEN ",GOSUB 1370LET F := 0.23IF K5 > 3.0 THEN 1040PRINT "YOU HAVE PLAYED",GOTO 10801040 IF K5 > 9.0 THEN 1070PRINT "YOU HAVE PLAYED/STUDIED",GOTO 10801070 PRINT "YOU HAVE WORKED/PLAYED",1080 GOSUB 1370GOTO 15301090 run ecb_str(K5, tmp_1$) \ run ecb_str(K6, tmp_2$) \ run ecb_str(K7, tmp_3$) \ PRINT "YOU HAVE RELAXED ", tmp_1$, tmp_2$, tmp_3$PRINT run ecb_str(E, tmp_1$) \ PRINT TAB(17.0); "***  YOU MAY RETIRE IN"; tmp_1$; " ***"1120 PRINT 1140 PRINT PRINT PRINT PRINT PRINT END1250 IF D = 13.0 THEN 1280PRINT "FRIDAY."GOTO 7101280 PRINT "FRIDAY THE THIRTEENTH---BEWARE!"GOTO 7101300 PRINT "NOT PREPARED TO GIVE DAY OF WEEK PRIOR TO MDLXXXII. "1310 GOTO 1140(* TABLE OF VALUES FOR THE MONTHS TO BE USED IN CALCULATIONS. *)DATA 0.0, 3.0, 3.0, 6.0, 1.0, 4.0, 6.0, 2.0, 5.0, 0.0, 3.0, 5.0(* THIS IS THE CURRENT DATE USED IN THE CALCULATIONS. *)(* THIS IS THE DATE TO BE CALCULATED ON. *)(* CALCULATE TIME IN YEARS, MONTHS, AND DAYS *)1370 RUN ecb_int(F * A8, K1)RUN ecb_int(K1 / 365.0, I5)LET K1 := K1 - (I5 * 365.0)RUN ecb_int(K1 / 30.0, I6)LET I7 := K1 - (I6 * 30.0)LET K5 := K5 - I5LET K6 := K6 - I6LET K7 := K7 - I7IF K7 >= 0.0 THEN 1480LET K7 := K7 + 30.0LET K6 := K6 - 1.01480 IF K6 > 0.0 THEN 1510LET K6 := K6 + 12.0LET K5 := K5 - 1.01510 run ecb_str(I5, tmp_1$) \ run ecb_str(I6, tmp_2$) \ run ecb_str(I7, tmp_3$) \ PRINT tmp_1$, tmp_2$, tmp_3$RETURN1530 IF K6 = 12.0 THEN 1550GOTO 10901550 LET K5 := K5 + 1.0LET K6 := 0.0GOTO 1090(* *)END