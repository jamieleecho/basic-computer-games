procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure slalombase 0DIM B, O: INTEGERA := 0.0A$ := ""B := 0B$ := ""M := 0.0O := 0O1 := 0.0Q := 0.0S := 0.0S1 := 0.0T := 0.0V := 0.0DIM arr_B(11): INTEGERFOR tmp_1 = 0 TO 10 \ arr_B(tmp_1) := 0 \ NEXT tmp_1DIM arr_G(11): INTEGERFOR tmp_1 = 0 TO 10 \ arr_G(tmp_1) := 0 \ NEXT tmp_1DIM arr_S(11): INTEGERFOR tmp_1 = 0 TO 10 \ arr_S(tmp_1) := 0 \ NEXT tmp_1type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(34.0); "SLALOM"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT 310 PRINT "HOW MANY GATES DOES THIS COURSE HAVE (1 TO 25)";RUN _ecb_input_prefix_t \ INPUT "? ", V \ RUN _ecb_input_suffix_tIF V > 25.0 THEN 360IF V < 1.0 THEN 390GOTO 1440360 PRINT "25 IS THE LIMIT."LET V := 25.0GOTO 1440390 PRINT "TRY AGAIN,"GOTO 310410 PRINT "RATE YOURSELF AS A SKIER, (1=WORST, 3=BEST)";RUN _ecb_input_prefix_t \ INPUT "? ", A \ RUN _ecb_input_suffix_tIF A < 1.0 THEN 460IF A > 3.0 THEN 460GOTO 480460 PRINT "THE BOUNDS ARE 1-3"GOTO 410480 PRINT "THE STARTER COUNTS DOWN...5...4...3...2...1...GO!";(* *)LET T := 0.0RUN ecb_int(RND(1.0) * (18.0 - 9.0) + 9.0, S)PRINT PRINT "YOU'RE OFF!"FOR O = 1 TO V  READ Q550   PRINT   RUN ecb_str(float(O), tmp_1$) \ PRINT "HERE COMES GATE #"; tmp_1$; ":"  run ecb_str(S, tmp_1$) \ PRINT tmp_1$; "M.P.H."  LET S1 := S580   PRINT "OPTION";  RUN _ecb_input_prefix_t \ INPUT "? ", O1 \ RUN _ecb_input_suffix_t  IF O1 = 0.0 THEN 970  IF O1 > 8.0 THEN 1420  IF O1 < 1.0 THEN 1420  GOSUB 990  IF S < 7.0 THEN 1390  LET T := T + (Q - S + 1.0)  IF S > Q THEN 1630670 NEXT OPRINT PRINT "YOU TOOK"; (T + RND(1.0)); "SECONDS."LET M := TLET M := M / VIF M < 1.5 - (A * 0.1) THEN 1650IF M < 2.9 - (A * 0.1) THEN 1680IF M < 4.4 - (A * 0.01) THEN 1710740 PRINT PRINT "DO YOU WANT TO RACE AGAIN";RUN _ecb_input_prefix_t \ INPUT "? ", B$ \ RUN _ecb_input_suffix_t(* *)IF B$ = "NO" THEN 1740IF B$ = "YES" THEN 480PRINT "PLEASE TYPE 'YES' OR 'NO'"GOTO 740STOP820 PRINT PRINT "*** SLALOM: THIS IS THE 1976 WINTER OLYMPIC GIANT SLALOM.  YOU ARE"PRINT "            THE AMERICAN TEAM'S ONLY HOPE OF A GOLD MEDAL."PRINT PRINT "     0 -- TYPE THIS IF YOU WANT TO SEE HOW LONG YOU'VE TAKEN."PRINT "     1 -- TYPE THIS IF YOU WANT TO SPEED UP A LOT."PRINT "     2 -- TYPE THIS IF YOU WANT TO SPEED UP A LITTLE."PRINT "     3 -- TYPE THIS IF YOU WANT TO SPEED UP A TEENSY."PRINT "     4 -- TYPE THIS IF YOU WANT TO KEEP GOING THE SAME SPEED."PRINT "     5 -- TYPE THIS IF YOU WANT TO CHECK A TEENSY."PRINT "     6 -- TYPE THIS IF YOU WANT TO CHECK A LITTLE."PRINT "     7 -- TYPE THIS IF YOU WANT TO CHECK A LOT."PRINT "     8 -- TYPE THIS IF YOU WANT TO CHEAT AND TRY TO SKIP A GATE."PRINT PRINT " THE PLACE TO USE THESE OPTIONS IS WHEN THE COMPUTER ASKS:"PRINT PRINT "OPTION?"PRINT PRINT "                GOOD LUCK!"PRINT GOTO 1470970 PRINT "YOU'VE TAKEN"; (T + RND(1.0)); "SECONDS."GOTO 580990 ON INT(O1) GOTO 1130, 1010, 1170, 1080, 1190, 1100, 1150, 1210STOP1010 RUN ecb_int(RND(1.0) * (5.0 - 3.0) + 3.0, tmp_1) \ LET S := S + tmp_1run ecb_str(S, tmp_1$) \ PRINT tmp_1$; "M.P.H."1030 IF S > Q THEN 1290IF S > Q - 1.0 THEN 1060RETURN1060 PRINT "CLOSE ONE!"RETURN1080 run ecb_str(S, tmp_1$) \ PRINT tmp_1$; "M.P.H."GOTO 10301100 RUN ecb_int(RND(1.0) * (5.0 - 3.0) + 3.0, tmp_1) \ LET S := S - tmp_11110 run ecb_str(S, tmp_1$) \ PRINT tmp_1$; "M.P.H."GOTO 10301130 RUN ecb_int(RND(1.0) * (10.0 - 5.0) + 5.0, tmp_1) \ LET S := S + tmp_1GOTO 10801150 RUN ecb_int(RND(1.0) * (10.0 - 5.0) + 5.0, tmp_1) \ LET S := S - tmp_1GOTO 11101170 RUN ecb_int(RND(1.0) * (4.0 - 1.0) + 1.0, tmp_1) \ LET S := S + tmp_1GOTO 11101190 RUN ecb_int(RND(1.0) * (4.0 - 1.0) + 1.0, tmp_1) \ LET S := S - tmp_1GOTO 11101210 PRINT "***CHEAT"IF RND(1.0) < 0.7 THEN 1260PRINT "YOU MADE IT!"LET T := T + 1.5RETURN1260 PRINT "AN OFFICIAL CAUGHT YOU!"PRINT "YOU TOOK"; (T + RND(1.0)); "SECONDS."GOTO 7401290 IF RND(1.0) < ((S - Q) * 0.1) + 0.2 THEN 1320PRINT "YOU WENT OVER THE NAXIMUM SPEED AND MADE IT!"RETURN1320 PRINT "YOU WENT OVER THE MAXIMUM SPEED AND ";IF RND(1.0) < 0.5 THEN 1370PRINT "WIPED OUT!"1350 PRINT "YOU TOOK"; (T + RND(1.0)); "SECONDS"GOTO 7401370 PRINT "SNAGGED A FLAG!"GOTO 13501390 PRINT "LET'S BE REALISTIC, OK?  LET'S GO BACK AND TRY AGAIN..."LET S := S1GOTO 5501420 PRINT "WHAT?"GOTO 5801440 PRINT PRINT "TYPE "; CHR$(34.0); "INS"; CHR$(34.0); " FOR INSTRUCTIONS"PRINT "TYPE "; CHR$(34.0); "MAX"; CHR$(34.0); " FOR APPROXIMATE MAXIMUM SPEEDS"PRINT "TYPE "; CHR$(34.0); "RUN"; CHR$(34.0); " FOR THE BEGINNING OF THE RACE"1470 PRINT "COMMAND--";1480 RUN _ecb_input_prefix_t \ INPUT "? ", A$ \ RUN _ecb_input_suffix_t(* *)IF A$ = "INS" THEN 820IF A$ = "MAX" THEN 1550IF A$ = "RUN" THEN 410PRINT CHR$(34.0); A$; CHR$(34.0); " IS AN ILLEGAL COMMAND--RETRY";GOTO 14801550 PRINT "GATE MAX"PRINT " #  M.P.H."PRINT "----------"FOR B = 1 TO V  READ Q  run ecb_str(float(B), tmp_1$) \ run ecb_str(Q, tmp_2$) \ PRINT tmp_1$; "  "; tmp_2$NEXT BGOTO 14701630 LET T := T + 0.5GOTO 6701650 PRINT "YOU WON A GOLD MEDAL!"LET arr_G(1) := arr_G(1) + 1GOTO 17301680 PRINT "YOU WON A SILVER MEDAL"LET arr_S(1) := arr_S(1) + 1GOTO 17301710 PRINT "YOU WON A BRONZE MEDAL"LET arr_B(1) := arr_B(1) + 11730 GOTO 7401740 PRINT "THANKS FOR THE RACE"IF arr_G(1) < 1.0 THEN 1770run ecb_str(float(arr_G(1)), tmp_1$) \ PRINT "GOLD MEDALS:"; tmp_1$1770 IF arr_S(1) < 1.0 THEN 1790run ecb_str(float(arr_S(1)), tmp_1$) \ PRINT "SILVER MEDALS:"; tmp_1$1790 IF arr_B(1) < 1.0 THEN 1830run ecb_str(float(arr_B(1)), tmp_1$) \ PRINT "BRONZE MEDALS:"; tmp_1$DATA 14.0, 18.0, 26.0, 29.0, 18.0, 25.0, 28.0, 32.0, 29.0, 20.0, 29.0, 29.0, 25.0, 21.0, 26.0, 29.0, 20.0, 21.0, 20.0DATA 18.0, 26.0, 25.0, 33.0, 31.0, 22.01830 END