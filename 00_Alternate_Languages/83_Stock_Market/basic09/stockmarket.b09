procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure stockmarketbase 0DIM E1, E2, I, W3, X, X9: INTEGERA := 0.0B5 := 0.0C := 0.0C5 := 0.0D := 0.0E1 := 0E2 := 0I := 0I1 := 0.0I2 := 0.0N1 := 0.0N2 := 0.0P5 := 0.0Q9 := 0.0S4 := 0.0S5 := 0.0T := 0.0T5 := 0.0T8 := 0.0W3 := 0X := 0X1 := 0.0X9 := 0Z4 := 0.0Z5 := 0.0Z6 := 0.0Z9 := 0.0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(31.0); "STOCK MARKET"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT (* STOCK MARKET SIMULATION     -STOCK- *)(* REVISED 8/18/70 (D. PESSEL, L. BRAUN, C. LOSIK) *)(* IMP VRBLS: A-MRKT TRND SLP; B5-BRKRGE FEE; C-TTL CSH ASSTS; *)(* C5-TTL CSH ASSTS (TEMP); C(I)-CHNG IN STK VAL; D-TTL ASSTS; *)(* E1,E2-LRG CHNG MISC; I-STCK #; I1,I2-STCKS W LRG CHNG; *)(* N1,N2-LRG CHNG DAY CNTS; P5-TTL DAYS PRCHSS; P(I)-PRTFL CNTNTS; *)(* Q9-NEW CYCL?; S4-SGN OF A; S5-TTL DYS SLS; S(I)-VALUE/SHR; *)(* T-TTL STCK ASSTS; T5-TTL VAL OF TRNSCTNS; *)(* W3-LRG CHNG; X1-SMLL CHNG(<$1); Z4,Z5,Z6-NYSE AVE.; Z(I)-TRNSCT *)DIM arr_S(6), arr_P(6), arr_Z(6), arr_C(6)FOR tmp_1 = 0 TO 5 \ arr_S(tmp_1) := 0 \ NEXT tmp_1FOR tmp_1 = 0 TO 5 \ arr_P(tmp_1) := 0 \ NEXT tmp_1FOR tmp_1 = 0 TO 5 \ arr_Z(tmp_1) := 0 \ NEXT tmp_1FOR tmp_1 = 0 TO 5 \ arr_C(tmp_1) := 0 \ NEXT tmp_1(* SLOPE OF MARKET TREND:A  (SAME FOR ALL STOCKS) *)LET X := 1RUN ecb_int((RND(X) / 10.0) * 100.0 + 0.5, tmp_1) \ LET A := tmp_1 / 100.0LET T5 := 0.0LET X9 := 0LET N1 := 0.0LET N2 := 0.0LET E1 := 0LET E2 := 0(* INTRODUCTION *)PRINT "DO YOU WANT THE INSTRUCTIONS (YES-TYPE 1, NO-TYPE 0)";RUN _ecb_input_prefix_t \ INPUT "? ", Z9 \ RUN _ecb_input_suffix_tPRINT PRINT IF Z9 < 1.0 THEN 200PRINT "THIS PROGRAM PLAYS THE STOCK MARKET.  YOU WILL BE GIVEN"PRINT "$10,000 AND MAY BUY OR SELL STOCKS.  THE STOCK PRICES WILL"PRINT "BE GENERATED RANDOMLY AND THEREFORE THIS MODEL DOES NOT"PRINT "REPRESENT EXACTLY WHAT HAPPENS ON THE EXCHANGE.  A TABLE"PRINT "OF AVAILABLE STOCKS, THEIR PRICES, AND THE NUMBER OF SHARES"PRINT "IN YOUR PORTFOLIO WILL BE PRINTED.  FOLLOWING THIS, THE"PRINT "INITIALS OF EACH STOCK WILL BE PRINTED WITH A QUESTION"PRINT "MARK.  HERE YOU INDICATE A TRANSACTION.  TO BUY A STOCK"PRINT "TYPE +NNN, TO SELL A STOCK TYPE -NNN, WHERE NNN IS THE"PRINT "NUMBER OF SHARES.  A BROKERAGE FEE OF 1% WILL BE CHARGED"PRINT "ON ALL TRANSACTIONS.  NOTE THAT IF A STOCK'S VALUE DROPS"PRINT "TO ZERO IT MAY REBOUND TO A POSITIVE VALUE AGAIN.  YOU"PRINT "HAVE $10,000 TO INVEST.  USE INTEGERS FOR ALL YOUR INPUTS."PRINT "(NOTE:  TO GET A 'FEEL' FOR THE MARKET RUN FOR AT LEAST"PRINT "10 DAYS)"PRINT "-----GOOD LUCK!-----"200 (* GENERATION OF STOCK TABLE; INPUT REQUESTS *)(* INITIAL STOCK VALUES *)LET arr_S(1.0) := 100.0LET arr_S(2.0) := 85.0LET arr_S(3.0) := 150.0LET arr_S(4.0) := 140.0LET arr_S(5.0) := 110.0(* INITIAL T8 - # DAYS FOR FIRST TREND SLOPE (A) *)RUN ecb_int(4.99 * RND(X) + 1.0, T8)(* RANDOMIZE SIGN OF FIRST TREND SLOPE (A) *)IF RND(X) > 0.5 THEN 270LET A := - A270 (* RANDOMIZE INITIAL VALUES *)GOSUB 830(* INITIAL PORTFOLIO CONTENTS *)FOR I = 1 TO 5  LET arr_P(I) := 0.0  LET arr_Z(I) := 0.0NEXT IPRINT PRINT (* INITIALIZE CASH ASSETS:C *)LET C := 10000.0(* PRINT INITIAL PORTFOLIO *)PRINT "STOCK", " ", "INITIALS", "PRICE/SHARE"run ecb_str(arr_S(1.0), tmp_1$) \ PRINT "INT. BALLISTIC MISSILES", "  IBM", tmp_1$run ecb_str(arr_S(2.0), tmp_1$) \ PRINT "RED CROSS OF AMERICA", "  RCA", tmp_1$run ecb_str(arr_S(3.0), tmp_1$) \ PRINT "LICHTENSTEIN, BUMRAP & JOKE", "  LBJ", tmp_1$run ecb_str(arr_S(4.0), tmp_1$) \ PRINT "AMERICAN BANKRUPT CO.", "  ABC", tmp_1$run ecb_str(arr_S(5.0), tmp_1$) \ PRINT "CENSURED BOOKS STORE", "  CBS", tmp_1$360 PRINT (* NYSE AVERAGE:Z5; TEMP. VALUE:Z4; NET CHANGE:Z6 *)LET Z4 := Z5LET Z5 := 0.0LET T := 0.0FOR I = 1 TO 5  LET Z5 := Z5 + arr_S(I)  LET T := T + arr_S(I) * arr_P(I)NEXT IRUN ecb_int(100.0 * (Z5 / 5.0) + 0.5, tmp_1) \ LET Z5 := tmp_1 / 100.0RUN ecb_int((Z5 - Z4) * 100.0 + 0.5, tmp_1) \ LET Z6 := tmp_1 / 100.0(* TOTAL ASSETS:D *)LET D := T + CIF X9 > 0.0 THEN 398run ecb_str(Z5, tmp_1$) \ PRINT "NEW YORK STOCK EXCHANGE AVERAGE: "; tmp_1$GOTO 399398 run ecb_str(Z5, tmp_1$) \ run ecb_str(Z6, tmp_2$) \ PRINT "NEW YORK STOCK EXCHANGE AVERAGE: "; tmp_1$; "NET CHANGE"; tmp_2$399 PRINT RUN ecb_int(100.0 * T + 0.5, tmp_1) \ LET T := tmp_1 / 100.0run ecb_str(T, tmp_1$) \ PRINT "TOTAL STOCK ASSETS ARE   $"; tmp_1$RUN ecb_int(100.0 * C + 0.5, tmp_1) \ LET C := tmp_1 / 100.0run ecb_str(C, tmp_1$) \ PRINT "TOTAL CASH ASSETS ARE    $"; tmp_1$RUN ecb_int(100.0 * D + 0.5, tmp_1) \ LET D := tmp_1 / 100.0run ecb_str(D, tmp_1$) \ PRINT "TOTAL ASSETS ARE         $"; tmp_1$PRINT IF X9 = 0.0 THEN 416PRINT "DO YOU WISH TO CONTINUE (YES-TYPE 1, NO-TYPE 0)";RUN _ecb_input_prefix_t \ INPUT "? ", Q9 \ RUN _ecb_input_suffix_tIF Q9 < 1.0 THEN 998416 (* INPUT TRANSACTIONS *)420 PRINT "WHAT IS YOUR TRANSACTION IN"PRINT "IBM";RUN _ecb_input_prefix_t \ INPUT "? ", arr_Z(1.0) \ RUN _ecb_input_suffix_tPRINT "RCA";RUN _ecb_input_prefix_t \ INPUT "? ", arr_Z(2.0) \ RUN _ecb_input_suffix_tPRINT "LBJ";RUN _ecb_input_prefix_t \ INPUT "? ", arr_Z(3.0) \ RUN _ecb_input_suffix_tPRINT "ABC";RUN _ecb_input_prefix_t \ INPUT "? ", arr_Z(4.0) \ RUN _ecb_input_suffix_tPRINT "CBS";RUN _ecb_input_prefix_t \ INPUT "? ", arr_Z(5.0) \ RUN _ecb_input_suffix_tPRINT (* TOTAL DAY'S PURCHASES IN $:P5 *)LET P5 := 0.0(* TOTAL DAY'S SALES IN $:S5 *)LET S5 := 0.0FOR I = 1 TO 5  RUN ecb_int(arr_Z(I) + 0.5, arr_Z(I))  IF arr_Z(I) <= 0.0 THEN 610  LET P5 := P5 + arr_Z(I) * arr_S(I)  GOTO 620610   LET S5 := S5 - arr_Z(I) * arr_S(I)  IF - arr_Z(I) <= arr_P(I) THEN 620  PRINT "YOU HAVE OVERSOLD A STOCK; TRY AGAIN."  GOTO 420620 NEXT I(* TOTAL VALUE OF TRANSACTIONS:T5 *)LET T5 := P5 + S5(* BROKERAGE FEE:B5 *)RUN ecb_int(0.01 * T5 * 100.0 + 0.5, tmp_1) \ LET B5 := tmp_1 / 100.0(* CASH ASSETS=OLD CASH ASSETS-TOTAL PURCHASES *)(* -BROKERAGE FEES+TOTAL SALES:C5 *)LET C5 := C - P5 - B5 + S5IF C5 >= 0.0 THEN 674run ecb_str(- C5, tmp_1$) \ PRINT "YOU HAVE USED $"; tmp_1$; " MORE THAN YOU HAVE."GOTO 420674 LET C := C5(* CALCULATE NEW PORTFOLIO *)FOR I = 1 TO 5  LET arr_P(I) := arr_P(I) + arr_Z(I)NEXT I(* CALCULATE NEW STOCK VALUES *)GOSUB 830(* PRINT PORTFOLIO *)(* BELL RINGING-DIFFERENT ON MANY COMPUTERS *)PRINT PRINT "**********     END OF DAY'S TRADING     **********"PRINT PRINT IF X9 < 1.0 THEN 769769 PRINT "STOCK", "PRICE/SHARE", "HOLDINGS", "VALUE", "NET PRICE CHANGE"run ecb_str(arr_S(1.0), tmp_1$) \ run ecb_str(arr_P(1.0), tmp_2$) \ run ecb_str(arr_C(1.0), tmp_3$) \ PRINT "IBM", tmp_1$, tmp_2$, arr_S(1.0) * arr_P(1.0), tmp_3$run ecb_str(arr_S(2.0), tmp_1$) \ run ecb_str(arr_P(2.0), tmp_2$) \ run ecb_str(arr_C(2.0), tmp_3$) \ PRINT "RCA", tmp_1$, tmp_2$, arr_S(2.0) * arr_P(2.0), tmp_3$run ecb_str(arr_S(3.0), tmp_1$) \ run ecb_str(arr_P(3.0), tmp_2$) \ run ecb_str(arr_C(3.0), tmp_3$) \ PRINT "LBJ", tmp_1$, tmp_2$, arr_S(3.0) * arr_P(3.0), tmp_3$run ecb_str(arr_S(4.0), tmp_1$) \ run ecb_str(arr_P(4.0), tmp_2$) \ run ecb_str(arr_C(4.0), tmp_3$) \ PRINT "ABC", tmp_1$, tmp_2$, arr_S(4.0) * arr_P(4.0), tmp_3$run ecb_str(arr_S(5.0), tmp_1$) \ run ecb_str(arr_P(5.0), tmp_2$) \ run ecb_str(arr_C(5.0), tmp_3$) \ PRINT "CBS", tmp_1$, tmp_2$, arr_S(5.0) * arr_P(5.0), tmp_3$LET X9 := 1PRINT PRINT GOTO 360(* NEW STOCK VALUES - SUBROUTINE *)830 (* RANDOMLY PRODUCE NEW STOCK VALUES BASED ON PREVIOUS *)(* DAY'S VALUES *)(* N1,N2 ARE RANDOM NUMBERS OF DAYS WHICH RESPECTIVELY *)(* DETERMINE WHEN STOCK I1 WILL INCREASE 10 PTS. AND STOCK *)(* I2 WILL DECREASE 10 PTS. *)(* IF N1 DAYS HAVE PASSED, PICK AN I1, SET E1, DETERMINE NEW N1 *)IF N1 > 0.0 THEN 850RUN ecb_int(4.99 * RND(X) + 1.0, I1)RUN ecb_int(4.99 * RND(X) + 1.0, N1)LET E1 := 1850 (* IF N2 DAYS HAVE PASSED, PICK AN I2, SET E2, DETERMINE NEW N2 *)IF N2 > 0.0 THEN 860RUN ecb_int(4.99 * RND(X) + 1.0, I2)RUN ecb_int(4.99 * RND(X) + 1.0, N2)LET E2 := 1860 (* DEDUCT ONE DAY FROM N1 AND N2 *)LET N1 := N1 - 1.0LET N2 := N2 - 1.0(* LOOP THROUGH ALL STOCKS *)FOR I = 1 TO 5  LET X1 := RND(X)  IF X1 > 0.25 THEN 920  LET X1 := 0.25  GOTO 935920   IF X1 > 0.5 THEN 925  LET X1 := 0.5  GOTO 935925   IF X1 > 0.75 THEN 930  LET X1 := 0.75  GOTO 935930   LET X1 := 0.0(* BIG CHANGE CONSTANT:W3  (SET TO ZERO INITIALLY) *)935   LET W3 := 0  IF E1 < 1.0 THEN 945  RUN ecb_int(I1 + 0.5, tmp_1) \ RUN ecb_int(I + 0.5, tmp_2) \ IF tmp_1 <> tmp_2 THEN 945(* ADD 10 PTS. TO THIS STOCK;  RESET E1 *)  LET W3 := 10  LET E1 := 0945   IF E2 < 1.0 THEN 955  RUN ecb_int(I2 + 0.5, tmp_1) \ RUN ecb_int(I + 0.5, tmp_2) \ IF tmp_1 <> tmp_2 THEN 955(* SUBTRACT 10 PTS. FROM THIS STOCK;  RESET E2 *)  LET W3 := W3 - 10  LET E2 := 0(* C(I) IS CHANGE IN STOCK VALUE *)955   RUN ecb_int(A * arr_S(I), tmp_1) \ RUN ecb_int(3.0 - 6.0 * RND(X) + 0.5, tmp_2) \ LET arr_C(I) := tmp_1 + X1 + tmp_2 + W3  RUN ecb_int(100.0 * arr_C(I) + 0.5, tmp_1) \ LET arr_C(I) := tmp_1 / 100.0  LET arr_S(I) := arr_S(I) + arr_C(I)  IF arr_S(I) > 0.0 THEN 967  LET arr_C(I) := 0.0  LET arr_S(I) := 0.0  GOTO 970967   RUN ecb_int(100.0 * arr_S(I) + 0.5, tmp_1) \ LET arr_S(I) := tmp_1 / 100.0970 NEXT I(* AFTER T8 DAYS RANDOMLY CHANGE TREND SIGN AND SLOPE *)LET T8 := T8 - 1.0IF T8 < 1.0 THEN 985RETURN985 (* RANDOMLY CHANGE TREND SIGN AND SLOPE (A), AND DURATION *)(* OF TREND (T8) *)RUN ecb_int(4.99 * RND(X) + 1.0, T8)RUN ecb_int((RND(X) / 10.0) * 100.0 + 0.5, tmp_1) \ LET A := tmp_1 / 100.0LET S4 := RND(X)IF S4 <= 0.5 THEN 997LET A := - A997 RETURN998 PRINT "HOPE YOU HAD FUN!!"END