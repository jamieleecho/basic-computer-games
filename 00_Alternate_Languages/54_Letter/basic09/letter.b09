procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure letterbase 0DIM A, G, L, N: INTEGERA := 0A$ := ""G := 0L := 0N := 0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(34.0); "LETTER"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT PRINT "LETTER GUESSING GAME"PRINT PRINT "I'LL THINK OF A LETTER OF THE ALPHABET, A TO Z."PRINT "TRY TO GUESS MY LETTER AND I'LL GIVE YOU CLUES"PRINT "AS TO HOW CLOSE YOU'RE GETTING TO MY LETTER."310 RUN ecb_int(RND(1.0) * 26.0, tmp_1) \ L := 65 + tmp_1G := 0PRINT PRINT "O.K., I HAVE A LETTER.  START GUESSING."410 PRINT PRINT "WHAT IS YOUR GUESS";G := G + 1RUN _ecb_input_prefix_t \ INPUT "? ", A$ \ RUN _ecb_input_suffix_tA := ASC(A$)PRINT IF A = L THEN 500IF A > L THEN 480PRINT "TOO LOW.  TRY A HIGHER LETTER."GOTO 410480 PRINT "TOO HIGH.  TRY A LOWER LETTER."GOTO 410500 PRINT run ecb_str(float(G), tmp_1$) \ PRINT "YOU GOT IT IN"; tmp_1$; "GUESSES!!"IF G <= 5.0 THEN 508PRINT "BUT IT SHOULDN'T TAKE MORE THAN 5 GUESSES!"GOTO 515508 PRINT "GOOD JOB !!!!!"FOR N = 1 TO 15PRINT CHR$(7.0);NEXT N515 PRINT PRINT "LET'S PLAY AGAIN....."GOTO 310END