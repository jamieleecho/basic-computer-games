procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure crapsbase 0DIM T: INTEGERE := 0.0F := 0.0H := 0.0M := 0.0O := 0.0Q := 0.0R := 0.0S := 0.0T := 0X := 0.0Z := 0.0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(34.0); "CRAPS"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT LET R := 0.0PRINT "2,3,12 ARE LOSERS; 4,5,6,8,9,10 ARE POINTS; 7,11 ARE NATURAL WINNERS."LET T := 1PRINT "PICK A NUMBER AND INPUT TO ROLL DICE";RUN _ecb_input_prefix_t \ INPUT "? ", Z \ RUN _ecb_input_suffix_t24 LET X := (RND(0.0))LET T := T + 1IF T <= Z THEN 2427 PRINT "INPUT THE AMOUNT OF YOUR WAGER.";RUN _ecb_input_prefix_t \ INPUT "? ", F \ RUN _ecb_input_suffix_tPRINT "I WILL NOW THROW THE DICE"40 RUN ecb_int(7.0 * RND(1.0), E)RUN ecb_int(7.0 * RND(1.0), S)LET X := E + SIF X = 7.0 THEN 180IF X = 11.0 THEN 180IF X = 1.0 THEN 40IF X = 2.0 THEN 195IF X = 0.0 THEN 40IF X = 2.0 THEN 200IF X = 3.0 THEN 200IF X = 12.0 THEN 200IF X = 5.0 THEN 220IF X = 6.0 THEN 220IF X = 8.0 THEN 220IF X = 9.0 THEN 220IF X = 10.0 THEN 220IF X = 4.0 THEN 220180 run ecb_str(X, tmp_1$) \ PRINT tmp_1$; "- NATURAL....A WINNER!!!!"run ecb_str(X, tmp_1$) \ run ecb_str(F, tmp_2$) \ PRINT tmp_1$; "PAYS EVEN MONEY, YOU WIN"; tmp_2$; "DOLLARS"GOTO 210195 run ecb_str(X, tmp_1$) \ PRINT tmp_1$; "- SNAKE EYES....YOU LOSE."run ecb_str(F, tmp_1$) \ PRINT "YOU LOSE"; tmp_1$; "DOLLARS."LET F := 0.0 - FGOTO 210200 run ecb_str(X, tmp_1$) \ PRINT tmp_1$; " - CRAPS...YOU LOSE."run ecb_str(F, tmp_1$) \ PRINT "YOU LOSE"; tmp_1$; "DOLLARS."LET F := 0.0 - F210 LET R := R + FGOTO 320220 run ecb_str(X, tmp_1$) \ PRINT tmp_1$; "IS THE POINT. I WILL ROLL AGAIN"230 RUN ecb_int(7.0 * RND(1.0), H)RUN ecb_int(7.0 * RND(1.0), Q)LET O := H + QIF O = 1.0 THEN 230IF O = 7.0 THEN 290IF O = 0.0 THEN 230IF O = X THEN 310run ecb_str(O, tmp_1$) \ PRINT tmp_1$; " - NO POINT. I WILL ROLL AGAIN"GOTO 230290 run ecb_str(O, tmp_1$) \ PRINT tmp_1$; "- CRAPS. YOU LOSE."run ecb_str(F, tmp_1$) \ PRINT "YOU LOSE $"; tmp_1$F := 0.0 - FGOTO 210GOTO 320310 run ecb_str(X, tmp_1$) \ PRINT tmp_1$; "- A WINNER.........CONGRATS!!!!!!!!"run ecb_str(X, tmp_1$) \ PRINT tmp_1$; "AT 2 TO 1 ODDS PAYS YOU...LET ME SEE..."; 2.0 * F; "DOLLARS"LET F := 2.0 * FGOTO 210320 PRINT " IF YOU WANT TO PLAY AGAIN PRINT 5 IF NOT PRINT 2";RUN _ecb_input_prefix_t \ INPUT "? ", M \ RUN _ecb_input_suffix_tIF R < 0.0 THEN 334IF R > 0.0 THEN 336IF R = 0.0 THEN 338334 run ecb_str(- R, tmp_1$) \ PRINT "YOU ARE NOW UNDER $"; tmp_1$GOTO 340336 run ecb_str(R, tmp_1$) \ PRINT "YOU ARE NOW AHEAD $"; tmp_1$GOTO 340338 PRINT "YOU ARE NOW EVEN AT 0"340 IF M = 5.0 THEN 27IF R < 0.0 THEN 350IF R > 0.0 THEN 353IF R = 0.0 THEN 355350 PRINT "TOO BAD, YOU ARE IN THE HOLE. COME AGAIN."GOTO 360353 PRINT "CONGRATULATIONS---YOU CAME OUT A WINNER. COME AGAIN!"GOTO 360355 PRINT "CONGRATULATIONS---YOU CAME OUT EVEN, NOT BAD FOR AN AMATEUR"360 END