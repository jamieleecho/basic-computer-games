procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure distributionsbase 0DIM D3, D4, I, S2: INTEGERD1 := 0.0D2 := 0.0D3 := 0D4 := 0I := 0S1 := 0.0S2 := 0X := 0.0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT "DISTRIBUTION OF DICE ROLLS WITH  INT(7*RND(1))  VS  INT(6*RND(1)+1)"DIM arr_A(13): INTEGERFOR tmp_1 = 0 TO 12 \ arr_A(tmp_1) := 0 \ NEXT tmp_1DIM arr_B(13): INTEGERFOR tmp_1 = 0 TO 12 \ arr_B(tmp_1) := 0 \ NEXT tmp_1FOR X = 1.0 TO 100000.0(* CHOOSE A LARGE NUMBER TO GET A FINER GRAINED HISTOGRAM *)(* GET A NUMBER FROM 0 TO 6 INCLUSIVE WITH THE INTENT TO THROW AWAY ZEROES. *)150   RUN ecb_int(7.0 * RND(1.0), D1)  RUN ecb_int(7.0 * RND(1.0), D2)  LET S1 := D1 + D2(* IF THIS SUM IS LESS THAN TWO THEN TRY AGAIN. *)  IF S1 < 2.0 THEN 150(* GET A NUMBER FROM 0 TO 5 THEN ADD 1 TO IT TO MAKE IT 1 TO 6 *)  RUN ecb_int(6.0 * RND(1.0), tmp_1) \ LET D3 := tmp_1 + 1  RUN ecb_int(6.0 * RND(1.0), tmp_1) \ LET D4 := tmp_1 + 1  LET S2 := D3 + D4(* USE OUR ARRAY AS A HISTOGRAM, COUNTING EACH OCCURRENCE OF DICE ROLL *)  arr_A(INT(S1)) := arr_A(INT(S1)) + 1  arr_B(S2) := arr_B(S2) + 1NEXT XPRINT "THE INT(7*RND(1)) DISTRIBUTION:"FOR I = 2 TO 12run ecb_str(float(I), tmp_1$) \ PRINT tmp_1$,NEXT IPRINT FOR I = 2 TO 12run ecb_str(float(arr_A(I)), tmp_1$) \ PRINT tmp_1$,NEXT IPRINT PRINT "THE INT(6*RND(1)+1) DISTRIBUTION"FOR I = 2 TO 12run ecb_str(float(I), tmp_1$) \ PRINT tmp_1$,NEXT IPRINT FOR I = 2 TO 12run ecb_str(float(arr_B(I)), tmp_1$) \ PRINT tmp_1$,NEXT IPRINT