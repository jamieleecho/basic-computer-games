procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure bowlingbase 0DIM B, D, F, I, J, K, M, P, Q: INTEGERA$ := ""B := 0D := 0F := 0I := 0J := 0K := 0M := 0N$ := ""P := 0Q := 0R := 0.0X := 0.0Z$ := ""type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(35.0); "BOWL"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT DIM arr_C(16), arr_A(101, 7): INTEGERFOR tmp_1 = 0 TO 15 \ arr_C(tmp_1) := 0 \ NEXT tmp_1FOR tmp_1 = 0 TO 100 \ FOR tmp_2 = 0 TO 6 \ arr_A(tmp_1, tmp_2) := 0 \ NEXT tmp_2 \ NEXT tmp_1PRINT "WELCOME TO THE ALLEY"PRINT "BRING YOUR FRIENDS"PRINT "OKAY LET'S FIRST GET ACQUAINTED"PRINT ""PRINT "THE INSTRUCTIONS (Y/N)"RUN _ecb_input_prefix_t \ INPUT "? ", Z$ \ RUN _ecb_input_suffix_tIF Z$ = "Y" THEN 990IF Z$ = "N" THEN 1530990 PRINT "THE GAME OF BOWLING TAKES MIND AND SKILL.DURING THE GAME"PRINT "THE COMPUTER WILL KEEP SCORE.YOU MAY COMPETE WITH"PRINT "OTHER PLAYERS[UP TO FOUR].YOU WILL BE PLAYING TEN FRAMES"PRINT "ON THE PIN DIAGRAM 'O' MEANS THE PIN IS DOWN...'+' MEANS THE"PRINT "PIN IS STANDING.AFTER THE GAME THE COMPUTER WILL SHOW YOUR"PRINT "SCORES ."1530 PRINT "FIRST OF ALL...HOW MANY ARE PLAYING";RUN _ecb_input_prefix_t \ INPUT "? ", R \ RUN _ecb_input_suffix_tPRINT PRINT "VERY GOOD..."FOR I = 1 TO 100FOR J = 1 TO 6arr_A(I, J) := 0NEXT JNEXT IF := 12070 FOR P = 1 TO R  M := 0  B := 1  M := 0  Q := 0FOR I = 1 TO 15  arr_C(I) := 0  NEXT I2520 (* ARK BALL GENERATOR USING MOD '15' SYSTEM *)2610   PRINT "TYPE ROLL TO GET THE BALL GOING."  RUN _ecb_input_prefix_t \ INPUT "? ", N$ \ RUN _ecb_input_suffix_t  K := 0  D := 0  FOR I = 1 TO 20    RUN ecb_int(RND(1.0) * 100.0, X)    FOR J = 1 TO 10      IF X < 15.0 * J THEN 3330    NEXT J3330     arr_C(INT(15.0 * J - X)) := 1  NEXT I(* ARK PIN DIAGRAM *)  run ecb_str(float(P), tmp_1$) \ run ecb_str(float(F), tmp_2$) \ run ecb_str(float(B), tmp_3$) \ PRINT "PLAYER:"; tmp_1$; "FRAME:"; tmp_2$; "BALL:"; tmp_3$  FOR I = 0 TO 3    PRINT     FOR J = 1 TO 4 - I      K := K + 1      IF arr_C(K) = 1.0 THEN 4320      PRINT TAB(I + 1.0); "+ ";      GOTO 44104320       PRINT TAB(I + 1.0); "O ";4410     NEXT J  NEXT I  PRINT ""(* ARK ROLL ANALYSIS *)  FOR I = 1 TO 10    D := D + arr_C(I)  NEXT I  IF D - M <> 0.0 THEN 5220  PRINT "GUTTER!!"5220   IF B <> 1.0 OR D <> 10.0 THEN 5490  PRINT "STRIKE!!!!!"  Q := 35490   IF B <> 2.0 OR D <> 10.0 THEN 5760  PRINT "SPARE!!!!"  Q := 25760   IF B <> 2.0 OR D >= 10.0 THEN 6030  PRINT "ERROR!!!"  Q := 16030   IF B <> 1.0 OR D >= 10.0 THEN 6210  PRINT "ROLL YOUR 2ND BALL"6210 (* ARK STORAGE OF THE SCORES *)  PRINT   arr_A(F * P, B) := D  IF B = 2.0 THEN 7020  B := 2  M := D  IF Q = 3.0 THEN 6210  arr_A(F * P, B) := D - M  IF Q = 0.0 THEN 25207020   arr_A(F * P, 3) := QNEXT PF := F + 1IF F < 11.0 THEN 2070PRINT "FRAMES"FOR I = 1 TO 10  run ecb_str(float(I), tmp_1$) \ PRINT tmp_1$;NEXT IPRINT FOR P = 1 TO R  FOR I = 1 TO 3    FOR J = 1 TO 10      run ecb_str(float(arr_A(J * P, I)), tmp_1$) \ PRINT tmp_1$;    NEXT J    PRINT   NEXT I  PRINT NEXT PPRINT "DO YOU WANT ANOTHER GAME"RUN _ecb_input_prefix_t \ INPUT "? ", A$ \ RUN _ecb_input_suffix_tIF LEFT$(A$, 1.0) = "Y" THEN 2610END