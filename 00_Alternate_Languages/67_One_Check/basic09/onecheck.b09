procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure onecheckbase 0DIM I, J, M, S: INTEGERA$ := ""F := 0.0F1 := 0.0F2 := 0.0I := 0J := 0M := 0S := 0T := 0.0T1 := 0.0T2 := 0.0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(31.0); "ONE CHECK"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT DIM arr_A(65): INTEGERFOR tmp_1 = 0 TO 64 \ arr_A(tmp_1) := 0 \ NEXT tmp_1PRINT "SOLITAIRE CHECKER PUZZLE BY DAVID AHL"PRINT PRINT "48 CHECKERS ARE PLACED ON THE 2 OUTSIDE SPACES OF A"PRINT "STANDARD 64-SQUARE CHECKERBOARD.  THE OBJECT IS TO"PRINT "REMOVE AS MANY CHECKERS AS POSSIBLE BY DIAGONAL JUMPS"PRINT "(AS IN STANDARD CHECKERS).  USE THE NUMBERED BOARD TO"PRINT "INDICATE THE SQUARE YOU WISH TO JUMP FROM AND TO.  ON"PRINT "THE BOARD PRINTED OUT ON EACH TURN '1' INDICATES A"PRINT "CHECKER AND '0' AN EMPTY SQUARE.  WHEN YOU HAVE NO"PRINT "POSSIBLE JUMPS REMAINING, INPUT A '0' IN RESPONSE TO"PRINT "QUESTION 'JUMP FROM ?'"PRINT PRINT "HERE IS THE NUMERICAL BOARD:"PRINT 70 FOR J = 1 TO 57 STEP 8  run ecb_str(float(J), tmp_1$) \ PRINT tmp_1$; TAB(5.0); J + 1.0; TAB(9.0); J + 2.0; TAB(13.0); J + 3.0; TAB(17.0); J + 4.0; TAB(21.0); J + 5.0;  PRINT TAB(25.0); J + 6.0; TAB(29.0); J + 7.0NEXT JPRINT PRINT "AND HERE IS THE OPENING POSITION OF THE CHECKERS."PRINT FOR J = 1 TO 64  arr_A(J) := 1NEXT JFOR J = 19 TO 43 STEP 8  FOR I = J TO J + 3    arr_A(I) := 0  NEXT INEXT JM := 0GOTO 340100 RUN _ecb_input_prefix_t \ INPUT "JUMP FROM? ", F \ RUN _ecb_input_suffix_tIF F = 0.0 THEN 500RUN _ecb_input_prefix_t \ INPUT "TO? ", T \ RUN _ecb_input_suffix_tPRINT (* *** CHECK LEGALITY OF MOVE *)RUN ecb_int((F - 1.0) / 8.0, F1)F2 := F - 8.0 * F1RUN ecb_int((T - 1.0) / 8.0, T1)T2 := T - 8.0 * T1IF F1 > 7.0 THEN 230IF T1 > 7.0 THEN 230IF F2 > 8.0 THEN 230IF T2 > 8.0 THEN 230IF ABS(F1 - T1) <> 2.0 THEN 230IF ABS(F2 - T2) <> 2.0 THEN 230IF arr_A(INT((T + F) / 2.0)) = 0.0 THEN 230IF arr_A(INT(F)) = 0.0 THEN 230IF arr_A(INT(T)) = 1.0 THEN 230GOTO 250230 PRINT "ILLEGAL MOVE.  TRY AGAIN..."GOTO 100(* *** UPDATE BOARD *)250 arr_A(INT(T)) := 1arr_A(INT(F)) := 0arr_A(INT((T + F) / 2.0)) := 0M := M + 1(* *** PRINT BOARD *)340 FOR J = 1 TO 57 STEP 8  FOR I = J TO J + 7    run ecb_str(float(arr_A(I)), tmp_1$) \ PRINT tmp_1$;  NEXT I  PRINT NEXT JPRINT GOTO 100(* *** END GAME SUMMARY *)500 S := 0FOR I = 1 TO 64  S := S + arr_A(I)NEXT IPRINT run ecb_str(float(M), tmp_1$) \ run ecb_str(float(S), tmp_2$) \ PRINT "YOU MADE"; tmp_1$; "JUMPS AND HAD"; tmp_2$; "PIECES"PRINT "REMAINING ON THE BOARD."PRINT 562 RUN _ecb_input_prefix_t \ INPUT "TRY AGAIN? ", A$ \ RUN _ecb_input_suffix_tIF A$ = "YES" THEN 70IF A$ = "NO" THEN 600PRINT "PLEASE ANSWER 'YES' OR 'NO'."GOTO 562600 PRINT PRINT "O.K.  HOPE YOU HAD FUN!!"END