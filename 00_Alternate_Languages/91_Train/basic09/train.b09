procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure trainbase 0DIM C, D, T: INTEGERA := 0.0A$ := ""C := 0D := 0E := 0.0T := 0V := 0.0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(34.0); "TRAIN"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT PRINT "TIME - SPEED DISTANCE EXERCISE"PRINT 10 RUN ecb_int(25.0 * RND(1.0), tmp_1) \ C := tmp_1 + 40RUN ecb_int(15.0 * RND(1.0), tmp_1) \ D := tmp_1 + 5RUN ecb_int(19.0 * RND(1.0), tmp_1) \ T := tmp_1 + 20run ecb_str(float(C), tmp_1$) \ PRINT " A CAR TRAVELING"; tmp_1$; "MPH CAN MAKE A CERTAIN TRIP IN"run ecb_str(float(D), tmp_1$) \ run ecb_str(float(T), tmp_2$) \ PRINT tmp_1$; "HOURS LESS THAN A TRAIN TRAVELING AT"; tmp_2$; "MPH."PRINT "HOW LONG DOES THE TRIP TAKE BY CAR";RUN _ecb_input_prefix_t \ INPUT "? ", A \ RUN _ecb_input_suffix_tV := D * T / (C - T)RUN ecb_int(ABS((V - A) * 100.0 / A) + 0.5, E)IF E > 5.0 THEN 70run ecb_str(E, tmp_1$) \ PRINT "GOOD! ANSWER WITHIN"; tmp_1$; "PERCENT."GOTO 8070 run ecb_str(E, tmp_1$) \ PRINT "SORRY.  YOU WERE OFF BY"; tmp_1$; "PERCENT."80 run ecb_str(V, tmp_1$) \ PRINT "CORRECT ANSWER IS"; tmp_1$; "HOURS."PRINT PRINT "ANOTHER PROBLEM (YES OR NO)";RUN _ecb_input_prefix_t \ INPUT "? ", A$ \ RUN _ecb_input_suffix_tPRINT IF A$ = "YES" THEN 10END