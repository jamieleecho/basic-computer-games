procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure bullseyebase 0DIM B, I, M, R: INTEGERB := 0I := 0M := 0N := 0.0P1 := 0.0P2 := 0.0P3 := 0.0P4 := 0.0R := 0T := 0.0U := 0.0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(33.0); "BULLSEYE"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT PRINT "IN THIS GAME, UP TO 20 PLAYERS THROW DARTS AT A TARGET"PRINT "WITH 10, 20, 30, AND 40 POINT ZONES.  THE OBJECTIVE IS"PRINT "TO GET 200 POINTS."PRINT PRINT "THROW", TAB(21.0); "DESCRIPTION"; TAB(46.0); "PROBABLE SCORE"PRINT " 1"; TAB(21.0); "FAST OVERARM"; TAB(46.0); "BULLSEYE OR COMPLETE MISS"PRINT " 2"; TAB(21.0); "CONTROLLED OVERARM"; TAB(46.0); "10, 20 OR 30 POINTS"PRINT " 3"; TAB(21.0); "UNDERARM"; TAB(46.0); "ANYTHING"PRINT DIM arr_A$(21)FOR tmp_1 = 0 TO 20 \ arr_A$(tmp_1) := "" \ NEXT tmp_1DIM arr_S(21), arr_W(11): INTEGERFOR tmp_1 = 0 TO 20 \ arr_S(tmp_1) := 0 \ NEXT tmp_1FOR tmp_1 = 0 TO 10 \ arr_W(tmp_1) := 0 \ NEXT tmp_1M := 0R := 0FOR I = 1 TO 20arr_S(I) := 0NEXT IRUN _ecb_input_prefix_t \ INPUT "HOW MANY PLAYERS? ", N \ RUN _ecb_input_suffix_tPRINT FOR I = 1 TO N  run ecb_str(float(I), tmp_1$) \ PRINT "NAME OF PLAYER #"; tmp_1$;RUN _ecb_input_prefix_t \ INPUT "? ", arr_A$(I) \ RUN _ecb_input_suffix_tNEXT I150 R := R + 1PRINT run ecb_str(float(R), tmp_1$) \ PRINT "ROUND"; tmp_1$PRINT "---------"FOR I = 1 TO N170   PRINT   PRINT arr_A$(I); "'S THROW";RUN _ecb_input_prefix_t \ INPUT "? ", T \ RUN _ecb_input_suffix_t  IF T < 1.0 OR T > 3.0 THEN    PRINT "INPUT 1, 2, OR 3!"    GOTO 170ENDIF  ON INT(T) GOTO 200, 210, 200200   P1 := 0.65  P2 := 0.55  P3 := 0.5  P4 := 0.5  GOTO 230210   P1 := 0.99  P2 := 0.77  P3 := 0.43  P4 := 0.01  GOTO 230  P1 := 0.95  P2 := 0.75  P3 := 0.45  P4 := 0.05230   U := RND(1.0)  IF U >= P1 THEN    PRINT "BULLSEYE!!  40 POINTS!"    B := 40    GOTO 290ENDIF  IF U >= P2 THEN    PRINT "30-POINT ZONE!"    B := 30    GOTO 290ENDIF  IF U >= P3 THEN    PRINT "20-POINT ZONE"    B := 20    GOTO 290ENDIF  IF U >= P4 THEN    PRINT "WHEW!  10 POINTS."    B := 10    GOTO 290ENDIF  PRINT "MISSED THE TARGET!  TOO BAD."  B := 0290 arr_S(I) := arr_S(I) + Brun ecb_str(float(arr_S(I)), tmp_1$) \ PRINT "TOTAL SCORE ="; tmp_1$NEXT IFOR I = 1 TO N  IF arr_S(I) >= 200.0 THEN    M := M + 1    arr_W(M) := IENDIFNEXT IIF M = 0.0 THEN 150PRINT PRINT "WE HAVE A WINNER!!"PRINT FOR I = 1 TO Mrun ecb_str(float(arr_S(arr_W(I))), tmp_1$) \ PRINT arr_A$(arr_W(I)); " SCORED"; tmp_1$; "POINTS."NEXT IPRINT PRINT "THANKS FOR THE GAME."END