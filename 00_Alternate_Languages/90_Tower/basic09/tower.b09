procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure towerbase 0DIM C, E, J, K, M, Q, R, U, V, W, Y, Z: INTEGERA$ := ""C := 0D := 0.0E := 0J := 0K := 0M := 0N := 0.0Q := 0R := 0S := 0.0U := 0V := 0W := 0X := 0.0Y := 0Z := 0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(34.0); "TOWERS"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT 90 PRINT (**** INITIALIZE *)DIM arr_T(8, 4)FOR tmp_1 = 0 TO 7 \ FOR tmp_2 = 0 TO 3 \ arr_T(tmp_1, tmp_2) := 0 \ NEXT tmp_2 \ NEXT tmp_1E := 0FOR D = 1.0 TO 7.0  FOR N = 1.0 TO 3.0    arr_T(INT(D), INT(N)) := 0.0  NEXT NNEXT DPRINT "TOWERS OF HANOI PUZZLE."PRINT PRINT "YOU MUST TRANSFER THE DISKS FROM THE LEFT TO THE RIGHT"PRINT "TOWER, ONE AT A TIME, NEVER PUTTING A LARGER DISK ON A"PRINT "SMALLER DISK."PRINT 215 RUN _ecb_input_prefix_t \ INPUT "HOW MANY DISKS DO YOU WANT TO MOVE (7 IS MAX)? ", S \ RUN _ecb_input_suffix_tPRINT M := 0FOR Q = 1 TO 7  IF Q = S THEN 350NEXT QE := E + 1IF E > 2.0 THEN 310PRINT "SORRY, BUT I CAN'T DO THAT JOB FOR YOU."GOTO 215310 PRINT "ALL RIGHT, WISE GUY, IF YOU CAN'T PLAY THE GAME RIGHT, I'LL"PRINT "JUST TAKE MY PUZZLE AND GO HOME.  SO LONG."STOP(* *** STORE DISKS FROM SMALLEST TO LARGEST *)350 PRINT "IN THIS PROGRAM, WE SHALL REFER TO DISKS BY NUMERICAL CODE."PRINT "3 WILL REPRESENT THE SMALLEST DISK, 5 THE NEXT SIZE,"PRINT "7 THE NEXT, AND SO ON, UP TO 15.  IF YOU DO THE PUZZLE WITH"PRINT "2 DISKS, THEIR CODE NAMES WOULD BE 13 AND 15.  WITH 3 DISKS"PRINT "THE CODE NAMES WOULD BE 11, 13 AND 15, ETC.  THE NEEDLES"PRINT "ARE NUMBERED FROM LEFT TO RIGHT, 1 TO 3.  WE WILL"PRINT "START WITH THE DISKS ON NEEDLE 1, AND ATTEMPT TO MOVE THEM"PRINT "TO NEEDLE 3."PRINT PRINT "GOOD LUCK!"PRINT Y := 7D := 15.0FOR X = S TO 1.0 STEP -1.0  arr_T(Y, 1.0) := D  D := D - 2.0  Y := Y - 1NEXT XGOSUB 1230480 PRINT "WHICH DISK WOULD YOU LIKE TO MOVE";E := 0500 RUN _ecb_input_prefix_t \ INPUT "? ", D \ RUN _ecb_input_suffix_tIF (D - 3.0) * (D - 5.0) * (D - 7.0) * (D - 9.0) * (D - 11.0) * (D - 13.0) * (D - 15.0) = 0.0 THEN 580PRINT "ILLEGAL ENTRY... YOU MAY ONLY TYPE 3,5,7,9,11,13, OR 15."E := E + 1IF E > 1.0 THEN 560GOTO 500560 PRINT "STOP WASTING MY TIME.  GO BOTHER SOMEONE ELSE."STOP580 (* *** CHECK IF REQUESTED DISK IS BELOW ANOTHER *)FOR R = 1 TO 7  FOR C = 1 TO 3    IF arr_T(R, C) = D THEN 640NEXT CNEXT R640 FOR Q = R TO 1 STEP -1  IF arr_T(Q, C) = 0.0 THEN 660  IF arr_T(Q, C) < D THEN 680660 NEXT QGOTO 700680 PRINT "THAT DISK IS BELOW ANOTHER ONE.  MAKE ANOTHER CHOICE."GOTO 480700 E := 0705 RUN _ecb_input_prefix_t \ INPUT "PLACE DISK ON WHICH NEEDLE? ", N \ RUN _ecb_input_suffix_tIF (N - 1.0) * (N - 2.0) * (N - 3.0) = 0.0 THEN 800E := E + 1IF E > 1.0 THEN 780PRINT "I'LL ASSUME YOU HIT THE WRONG KEY THIS TIME.  BUT WATCH IT,"PRINT "I ONLY ALLOW ONE MISTAKE."GOTO 705780 PRINT "I TRIED TO WARN YOU, BUT YOU WOULDN'T LISTEN."PRINT "BYE BYE, BIG SHOT."STOP800 FOR R = 1 TO 7  IF arr_T(R, INT(N)) <> 0.0 THEN 840NEXT RGOTO 880(* *** CHECK IF DISK TO BE PLACED ON A LARGER ONE *)840 IF D < arr_T(R, INT(N)) THEN 880PRINT "YOU CAN'T PLACE A LARGER DISK ON TOP OF A SMALLER ONE,"PRINT "IT MIGHT CRUSH IT!"PRINT "NOW THEN, ";GOTO 480(* *** MOVE RELOCATED DISK *)880   FOR V = 1 TO 7  FOR W = 1 TO 3    IF arr_T(V, W) = D THEN 930NEXT WNEXT V(* *** LOCATE EMPTY SPACE ON NEEDLE N *)930 FOR U = 1 TO 7  IF arr_T(U, INT(N)) <> 0.0 THEN 970NEXT UU := 7GOTO 980(* *** MOVE DISK AND SET OLD LOCATION TO 0 *)970 U := U - 1980 arr_T(U, INT(N)) := arr_T(V, W)arr_T(V, W) := 0.0(* *** PRINT OUT CURRENT STATUS *)GOSUB 1230(* *** CHECK IF DONE *)M := M + 1  FOR R = 1 TO 7  FOR C = 1 TO 2    IF arr_T(R, C) <> 0.0 THEN 1090NEXT CNEXT RGOTO 11201090 IF M <= 128.0 THEN 480PRINT "SORRY, BUT I HAVE ORDERS TO STOP IF YOU MAKE MORE THAN"PRINT "128 MOVES."STOP1120 IF M <> 2.0 ^ S - 1.0 THEN 1140PRINT PRINT "CONGRATULATIONS!!"PRINT 1140 run ecb_str(float(M), tmp_1$) \ PRINT "YOU HAVE PERFORMED THE TASK IN"; tmp_1$; "MOVES."PRINT PRINT "TRY AGAIN (YES OR NO)";RUN _ecb_input_prefix_t \ INPUT "? ", A$ \ RUN _ecb_input_suffix_t1160 IF A$ = "NO" THEN 1390IF A$ = "YES" THEN 90PRINT PRINT "'YES' OR 'NO' PLEASE";RUN _ecb_input_prefix_t \ INPUT "? ", A$ \ RUN _ecb_input_suffix_tGOTO 11601230 (* *** PRINT SUBROUTINE *)FOR K = 1 TO 7  Z := 10  FOR J = 1 TO 3    IF arr_T(K, J) = 0.0 THEN 1330    RUN ecb_int(arr_T(K, J) / 2.0, tmp_1) \ PRINT TAB((Z - tmp_1) + 1.0);    FOR V = 1 TO arr_T(K, J)      PRINT "*";    NEXT V    GOTO 13401330     PRINT TAB(Z + 1.0); "*";1340     Z := Z + 21  NEXT J  PRINT NEXT KRETURN1390 PRINT PRINT "THANKS FOR THE GAME!"PRINT END