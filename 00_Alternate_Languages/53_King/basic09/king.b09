procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure kingbase 0DIM N5, T1, X: INTEGERA := 0.0A4 := 0.0B := 0.0B5 := 0.0C := 0.0C1 := 0.0D := 0.0F1 := 0.0G1 := 0.0H := 0.0I := 0.0J := 0.0K := 0.0M6 := 0.0N5 := 0P1 := 0.0Q := 0.0T1 := 0U1 := 0.0U2 := 0.0V1 := 0.0V2 := 0.0V3 := 0.0V9 := 0.0W := 0.0X := 0X5 := 0.0Z$ := ""type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(35.0); "KING"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT PRINT "DO YOU WANT INSTRUCTIONS";RUN _ecb_input_prefix_t \ INPUT "? ", Z$ \ RUN _ecb_input_suffix_tN5 := 8IF LEFT$(Z$, 1.0) = "N" THEN 47IF Z$ = "AGAIN" THEN 1960PRINT PRINT PRINT PRINT "CONGRATULATIONS! YOU'VE JUST BEEN ELECTED PREMIER OF SETATS"PRINT "DETINU, A SMALL COMMUNIST ISLAND 30 BY 70 MILES LONG. YOUR"PRINT "JOB IS TO DECIDE UPON THE CONTRY'S BUDGET AND DISTRIBUTE"PRINT "MONEY TO YOUR COUNTRYMEN FROM THE COMMUNAL TREASURY."PRINT "THE MONEY SYSTEM IS RALLODS, AND EACH PERSON NEEDS 100"PRINT "RALLODS PER YEAR TO SURVIVE. YOUR COUNTRY'S INCOME COMES"PRINT "FROM FARM PRODUCE AND TOURISTS VISITING YOUR MAGNIFICENT"PRINT "FORESTS, HUNTING, FISHING, ETC. HALF YOUR LAND IS FARM LAND"PRINT "WHICH ALSO HAS AN EXCELLENT MINERAL CONTENT AND MAY BE SOLD"PRINT "TO FOREIGN INDUSTRY (STRIP MINING) WHO IMPORT AND SUPPORT"PRINT "THEIR OWN WORKERS. CROPS COST BETWEEN 10 AND 15 RALLODS PER"PRINT "SQUARE MILE TO PLANT."run ecb_str(float(N5), tmp_1$) \ PRINT "YOUR GOAL IS TO COMPLETE YOUR"; tmp_1$; "YEAR TERM OF OFFICE."PRINT "GOOD LUCK!"47 PRINT RUN ecb_int(60000.0 + (1000.0 * RND(1.0)) - (1000.0 * RND(1.0)), A)RUN ecb_int(500.0 + (10.0 * RND(1.0)) - (10.0 * RND(1.0)), B)D := 2000.0100 RUN ecb_int(10.0 * RND(1.0) + 95.0, W)PRINT run ecb_str(A, tmp_1$) \ PRINT "YOU NOW HAVE "; tmp_1$; " RALLODS IN THE TREASURY."RUN ecb_int(B, tmp_1) \ run ecb_str(tmp_1, tmp_1$) \ PRINT tmp_1$;PRINT "COUNTRYMEN, ";RUN ecb_int(((RND(1.0) / 2.0) * 10.0 + 10.0), V9)IF C = 0.0 THEN 140RUN ecb_int(C, tmp_1) \ run ecb_str(tmp_1, tmp_1$) \ PRINT tmp_1$; "FOREIGN WORKERS, ";140 RUN ecb_int(D, tmp_1) \ run ecb_str(tmp_1, tmp_1$) \ PRINT "AND"; tmp_1$; "SQ. MILES OF LAND."run ecb_str(W, tmp_1$) \ PRINT "THIS YEAR INDUSTRY WILL BUY LAND FOR"; tmp_1$;PRINT "RALLODS PER SQUARE MILE."run ecb_str(V9, tmp_1$) \ PRINT "LAND CURRENTLY COSTS"; tmp_1$; "RALLODS PER SQUARE MILE TO PLANT."PRINT 200 PRINT "HOW MANY SQUARE MILES DO YOU WISH TO SELL TO INDUSTRY";RUN _ecb_input_prefix_t \ INPUT "? ", H \ RUN _ecb_input_suffix_tIF H < 0.0 THEN 200IF H <= D - 1000.0 THEN 300PRINT "***  THINK AGAIN. YOU ONLY HAVE"; D - 1000.0; "SQUARE MILES OF FARM LAND."IF X <> 0.0 THEN 200PRINT PRINT "(FOREIGN INDUSTRY WILL ONLY BUY FARM LAND BECAUSE"PRINT "FOREST LAND IS UNECONOMICAL TO STRIP MINE DUE TO TREES,"PRINT "THICKER TOP SOIL, ETC.)"X := 1GOTO 200300 RUN ecb_int(D - H, D)RUN ecb_int(A + (H * W), A)320 PRINT "HOW MANY RALLODS WILL YOU DISTRIBUTE AMONG YOUR COUNTRYMEN";RUN _ecb_input_prefix_t \ INPUT "? ", I \ RUN _ecb_input_suffix_tIF I < 0.0 THEN 320IF I < A THEN 400IF I = A THEN 380run ecb_str(A, tmp_1$) \ PRINT "   THINK AGAIN. YOU'VE ONLY"; tmp_1$; " RALLODS IN THE TREASURY"GOTO 320380 J := 0.0K := 0.0A := 0.0GOTO 1000400 RUN ecb_int(A - I, A)410 PRINT "HOW MANY SQUARE MILES DO YOU WISH TO PLANT";RUN _ecb_input_prefix_t \ INPUT "? ", J \ RUN _ecb_input_suffix_tIF J < 0.0 THEN 410IF J <= B * 2.0 THEN 426PRINT "   SORRY, BUT EACH COUNTRYMAN CAN ONLY PLANT 2 SQ. MILES."GOTO 410426 IF J <= D - 1000.0 THEN 430PRINT "   SORRY, BUT YOU'VE ONLY"; D - 1000.0; "SQ. MILES OF FARM LAND."GOTO 410430 RUN ecb_int(J * V9, U1)IF U1 < A THEN 500IF U1 = A THEN 490run ecb_str(A, tmp_1$) \ PRINT "   THINK AGAIN. YOU'VE ONLY"; tmp_1$; " RALLODS LEFT IN THE TREASURY."GOTO 410490 K := 0.0A := 0.0GOTO 1000500 A := A - U1510 PRINT "HOW MANY RALLODS DO YOU WISH TO SPEND ON POLLUTION CONTROL";RUN _ecb_input_prefix_t \ INPUT "? ", K \ RUN _ecb_input_suffix_tIF K < 0.0 THEN 510IF K <= A THEN 1000run ecb_str(A, tmp_1$) \ PRINT "   THINK AGAIN. YOU ONLY HAVE "; tmp_1$; " RALLODS REMAINING."GOTO 510600 IF H <> 0.0 THEN 1002IF I <> 0.0 THEN 1002IF J <> 0.0 THEN 1002IF K <> 0.0 THEN 1002PRINT PRINT "GOODBYE."PRINT "(IF YOU WISH TO CONTINUE THIS GAME AT A LATER DATE, ANSWER"PRINT "'AGAIN' WHEN ASKED IF YOU WANT INSTRUCTIONS AT THE START"PRINT "OF THE GAME)."STOP1000 GOTO 6001002 PRINT PRINT RUN ecb_int(A - K, A)A4 := ARUN ecb_int(I / 100.0 - B, tmp_1) \ IF tmp_1 >= 0.0 THEN 1120IF I / 100.0 < 50.0 THEN 1700RUN ecb_int(B - (I / 100.0), tmp_1) \ run ecb_str(tmp_1, tmp_1$) \ PRINT tmp_1$; "COUNTRYMEN DIED OF STARVATION"1120 RUN ecb_int(RND(1.0) * (2000.0 - D), F1)IF K < 25.0 THEN 1130RUN ecb_int(F1 / (K / 25.0), F1)1130 IF F1 <= 0.0 THEN 1150run ecb_str(F1, tmp_1$) \ PRINT tmp_1$; "COUNTRYMEN DIED OF CARBON-MONOXIDE AND DUST INHALATION"1150 RUN ecb_int((I / 100.0) - B, tmp_1) \ IF tmp_1 < 0.0 THEN 1170IF F1 > 0.0 THEN 1180GOTO 12001170 RUN ecb_int((F1 + (B - (I / 100.0))) * 9.0, tmp_1) \ run ecb_str(tmp_1, tmp_1$) \ PRINT "   YOU WERE FORCED TO SPEND"; tmp_1$;PRINT "RALLODS ON FUNERAL EXPENSES"RUN ecb_int(F1 + (B - (I / 100.0)), B5)RUN ecb_int(A - ((F1 + (B - (I / 100.0))) * 9.0), A)GOTO 11851180 RUN ecb_int(F1 * 9.0, tmp_1) \ run ecb_str(tmp_1, tmp_1$) \ PRINT "   YOU WERE FORCED TO SPEND "; tmp_1$; "RALLODS ON ";PRINT "FUNERAL EXPENSES."B5 := F1RUN ecb_int(A - (F1 * 9.0), A)1185 IF A >= 0.0 THEN 1194PRINT "   INSUFFICIENT RESERVES TO COVER COST - LAND WAS SOLD"RUN ecb_int(D + (A / W), D)A := 0.01194 RUN ecb_int(B - B5, B)1200 IF H = 0.0 THEN 1250RUN ecb_int(H + (RND(1.0) * 10.0) - (RND(1.0) * 20.0), C1)IF C > 0.0 THEN 1230C1 := C1 + 20.01230 run ecb_str(C1, tmp_1$) \ PRINT tmp_1$; "WORKERS CAME TO THE COUNTRY AND";1250 RUN ecb_int(((I / 100.0 - B) / 10.0) + (K / 25.0) - ((2000.0 - D) / 50.0) - (F1 / 2.0), P1)run ecb_str(ABS(P1), tmp_1$) \ PRINT tmp_1$; "COUNTRYMEN ";IF P1 < 0.0 THEN 1275PRINT "CAME TO";GOTO 12801275 PRINT "LEFT";1280 PRINT " THE ISLAND."RUN ecb_int(B + P1, B)RUN ecb_int(C + C1, C)RUN ecb_int(((2000.0 - D) * ((RND(1.0) + 1.5) / 2.0)), U2)IF C = 0.0 THEN 1324RUN ecb_int(J, tmp_1) \ run ecb_str(tmp_1, tmp_1$) \ PRINT "OF "; tmp_1$; "SQ. MILES PLANTED,";1324 IF J > U2 THEN 1330U2 := J1330 RUN ecb_int(J - U2, tmp_1) \ run ecb_str(tmp_1, tmp_1$) \ PRINT " YOU HARVESTED "; tmp_1$; "SQ. MILES OF CROPS."IF U2 = 0.0 THEN 1370IF T1 >= 2.0 THEN 1370PRINT "   (DUE TO ";IF T1 = 0.0 THEN 1365PRINT "INCREASED ";1365 PRINT "AIR AND WATER POLLUTION FROM FOREIGN INDUSTRY.)"1370 RUN ecb_int((J - U2) * (W / 2.0), Q)RUN ecb_int(Q, tmp_1) \ run ecb_str(tmp_1, tmp_1$) \ PRINT "MAKING"; tmp_1$; "RALLODS."RUN ecb_int(A + Q, A)RUN ecb_int(((B - P1) * 22.0) + (RND(1.0) * 500.0), V1)RUN ecb_int((2000.0 - D) * 15.0, V2)RUN ecb_int(V1 - V2, tmp_1) \ run ecb_str(ABS(tmp_1), tmp_1$) \ PRINT " YOU MADE"; tmp_1$; "RALLODS FROM TOURIST TRADE."IF V2 = 0.0 THEN 1450IF V1 - V2 >= V3 THEN 1450PRINT "   DECREASE BECAUSE ";G1 := 10.0 * RND(1.0)IF G1 <= 2.0 THEN 1460IF G1 <= 4.0 THEN 1465IF G1 <= 6.0 THEN 1470IF G1 <= 8.0 THEN 1475IF G1 <= 10.0 THEN 14801450 RUN ecb_int(A + V3, V3)RUN ecb_int(A + V3, A)GOTO 15001460 PRINT "FISH POPULATION HAS DWINDLED DUE TO WATER POLLUTION."GOTO 14501465 PRINT "AIR POLLUTION IS KILLING GAME BIRD POPULATION."GOTO 14501470 PRINT "MINERAL BATHS ARE BEING RUINED BY WATER POLLUTION."GOTO 14501475 PRINT "UNPLEASANT SMOG IS DISCOURAGING SUN BATHERS."GOTO 14501480 PRINT "HOTELS ARE LOOKING SHABBY DUE TO SMOG GRIT."GOTO 14501500 IF B5 > 200.0 THEN 1600IF B < 343.0 THEN 1700IF (A4 / 100.0) > 5.0 THEN 18001515 IF C > B THEN 1550IF N5 - 1.0 = X5 THEN 1900GOTO 20001550 PRINT PRINT PRINT "THE NUMBER OF FOREIGN WORKERS HAS EXCEEDED THE NUMBER"PRINT "OF COUNTRYMEN. AS A MINORITY, THEY HAVE REVOLTED AND"PRINT "TAKEN OVER THE COUNTRY."1570 IF RND(1.0) <= 0.5 THEN 1580PRINT "YOU HAVE BEEN THROWN OUT OF OFFICE AND ARE NOW"PRINT "RESIDING IN PRISON."GOTO 15901580 PRINT "YOU HAVE BEEN ASSASSINATED."1590 PRINT PRINT STOP1600 PRINT PRINT run ecb_str(B5, tmp_1$) \ PRINT tmp_1$; "COUNTRYMEN DIED IN ONE YEAR!!!!!"PRINT "DUE TO THIS EXTREME MISMANAGEMENT, YOU HAVE NOT ONLY"PRINT "BEEN IMPEACHED AND THROWN OUT OF OFFICE, BUT YOU"RUN ecb_int(RND(1.0) * 10.0, M6)IF M6 <= 3.0 THEN 1670IF M6 <= 6.0 THEN 1680IF M6 <= 10.0 THEN 16901670 PRINT "ALSO HAD YOUR LEFT EYE GOUGED OUT!"GOTO 15901680 PRINT "HAVE ALSO GAINED A VERY BAD REPUTATION."GOTO 15901690 PRINT "HAVE ALSO BEEN DECLARED NATIONAL FINK."GOTO 15901700 PRINT PRINT PRINT "OVER ONE THIRD OF THE POPULTATION HAS DIED SINCE YOU"PRINT "WERE ELECTED TO OFFICE. THE PEOPLE (REMAINING)"PRINT "HATE YOUR GUTS."GOTO 15701800 IF B5 - F1 < 2.0 THEN 1515PRINT PRINT "MONEY WAS LEFT OVER IN THE TREASURY WHICH YOU DID"PRINT "NOT SPEND. AS A RESULT, SOME OF YOUR COUNTRYMEN DIED"PRINT "OF STARVATION. THE PUBLIC IS ENRAGED AND YOU HAVE"PRINT "BEEN FORCED TO EITHER RESIGN OR COMMIT SUICIDE."PRINT "THE CHOICE IS YOURS."PRINT "IF YOU CHOOSE THE LATTER, PLEASE TURN OFF YOUR COMPUTER"PRINT "BEFORE PROCEEDING."GOTO 15901900 PRINT PRINT PRINT "CONGRATULATIONS!!!!!!!!!!!!!!!!!!"run ecb_str(float(N5), tmp_1$) \ PRINT "YOU HAVE SUCCESFULLY COMPLETED YOUR"; tmp_1$; "YEAR TERM"PRINT "OF OFFICE. YOU WERE, OF COURSE, EXTREMELY LUCKY, BUT"PRINT "NEVERTHELESS, IT'S QUITE AN ACHIEVEMENT. GOODBYE AND GOOD"PRINT "LUCK - YOU'LL PROBABLY NEED IT IF YOU'RE THE TYPE THAT"PRINT "PLAYS THIS GAME."GOTO 15901960 PRINT "HOW MANY YEARS HAD YOU BEEN IN OFFICE WHEN INTERRUPTED";RUN _ecb_input_prefix_t \ INPUT "? ", X5 \ RUN _ecb_input_suffix_tIF X5 < 0.0 THEN 1590IF X5 < 8.0 THEN 1969run ecb_str(float(N5), tmp_1$) \ PRINT "   COME ON, YOUR TERM IN OFFICE IS ONLY"; tmp_1$; "YEARS."GOTO 19601969 PRINT "HOW MUCH DID YOU HAVE IN THE TREASURY";RUN _ecb_input_prefix_t \ INPUT "? ", A \ RUN _ecb_input_suffix_tIF A < 0.0 THEN 1590PRINT "HOW MANY COUNTRYMEN";RUN _ecb_input_prefix_t \ INPUT "? ", B \ RUN _ecb_input_suffix_tIF B < 0.0 THEN 1590PRINT "HOW MANY WORKERS";RUN _ecb_input_prefix_t \ INPUT "? ", C \ RUN _ecb_input_suffix_tIF C < 0.0 THEN 15901990 PRINT "HOW MANY SQUARE MILES OF LAND";RUN _ecb_input_prefix_t \ INPUT "? ", D \ RUN _ecb_input_suffix_tIF D < 0.0 THEN 1590IF D > 2000.0 THEN 1996IF D > 1000.0 THEN 1001996 PRINT "   COME ON, YOU STARTED WITH 1000 SQ. MILES OF FARM LAND"PRINT "   AND 10,000 SQ. MILES OF FOREST LAND."GOTO 19902000 X5 := X5 + 1.0B5 := 0.0GOTO 100END