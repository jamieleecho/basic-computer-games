procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure guessbase 0DIM G, H, L1: INTEGERG := 0H := 0L := 0.0L1 := 0M := 0.0N := 0.0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 01 PRINT TAB(34.0); "GUESS"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT PRINT "THIS IS A NUMBER GUESSING GAME. I'LL THINK"PRINT "OF A NUMBER BETWEEN 1 AND ANY LIMIT YOU WANT."PRINT "THEN YOU HAVE TO GUESS WHAT IT IS."PRINT PRINT "WHAT LIMIT DO YOU WANT";RUN _ecb_input_prefix_t \ INPUT "? ", L \ RUN _ecb_input_suffix_tPRINT RUN ecb_int(LOG(L) / LOG(2.0), tmp_1) \ L1 := tmp_1 + 112 run ecb_str(L, tmp_1$) \ PRINT "I'M THINKING OF A NUMBER BETWEEN 1 AND"; tmp_1$G := 1PRINT "NOW YOU TRY TO GUESS WHAT IT IS."RUN ecb_int(L * RND(1.0) + 1.0, M)20 RUN _ecb_input_prefix_t \ INPUT "? ", N \ RUN _ecb_input_suffix_tIF N > 0.0 THEN 25GOSUB 70GOTO 125 IF N = M THEN 50G := G + 1IF N > M THEN 40PRINT "TOO LOW. TRY A BIGGER ANSWER."GOTO 2040 PRINT "TOO HIGH. TRY A SMALLER ANSWER."GOTO 2050 run ecb_str(float(G), tmp_1$) \ PRINT "THAT'S IT! YOU GOT IT IN"; tmp_1$; "TRIES."IF G < L1 THEN 58IF G = L1 THEN 60run ecb_str(float(L1), tmp_1$) \ PRINT "YOU SHOULD HAVE BEEN ABLE TO GET IT IN ONLY"; tmp_1$GOTO 6558 PRINT "VERY ";60 PRINT "GOOD."65 GOSUB 70GOTO 1270 FOR H = 1 TO 5  PRINT NEXT HRETURNEND