procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure combatbase 0A := 0.0B := 0.0C := 0.0D := 0.0E := 0.0F := 0.0G := 0.0T := 0.0X := 0.0Y := 0.0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(34.0); "COMBAT"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT PRINT "I AM AT WAR WITH YOU."PRINT "WE HAVE 72000 SOLDIERS APIECE."5 PRINT PRINT "DISTRIBUTE YOUR FORCES."PRINT "", "ME", "  YOU"run ecb_str(30000.0, tmp_1$) \ PRINT "ARMY", tmp_1$,RUN _ecb_input_prefix_t \ INPUT "? ", A \ RUN _ecb_input_suffix_trun ecb_str(20000.0, tmp_1$) \ PRINT "NAVY", tmp_1$,RUN _ecb_input_prefix_t \ INPUT "? ", B \ RUN _ecb_input_suffix_trun ecb_str(22000.0, tmp_1$) \ PRINT "A. F.", tmp_1$,RUN _ecb_input_prefix_t \ INPUT "? ", C \ RUN _ecb_input_suffix_tIF A + B + C > 72000.0 THEN 5D := 30000.0E := 20000.0F := 22000.0PRINT "YOU ATTACK FIRST. TYPE (1) FOR ARMY; (2) FOR NAVY;"PRINT "AND (3) FOR AIR FORCE."RUN _ecb_input_prefix_t \ INPUT "? ", Y \ RUN _ecb_input_suffix_t20 PRINT "HOW MANY MEN"RUN _ecb_input_prefix_t \ INPUT "? ", X \ RUN _ecb_input_suffix_tIF X < 0.0 THEN 20ON INT(Y) GOTO 100, 200, 300100 IF X > A THEN 20IF X < A / 3.0 THEN 120IF X < 2.0 * A / 3.0 THEN 150GOTO 270120 run ecb_str(X, tmp_1$) \ PRINT "YOU LOST"; tmp_1$; "MEN FROM YOUR ARMY."RUN ecb_int(A - X, A)GOTO 500150 RUN ecb_int(X / 3.0, tmp_1) \ run ecb_str(tmp_1, tmp_1$) \ RUN ecb_int(2.0 * D / 3.0, tmp_2) \ run ecb_str(tmp_2, tmp_2$) \ PRINT "YOU LOST"; tmp_1$; "MEN, BUT I LOST "; tmp_2$RUN ecb_int(A - X / 3.0, A)D := 0.0GOTO 500200 IF X > B THEN 20IF X < E / 3.0 THEN 230IF X < 2.0 * E / 3.0 THEN 250GOTO 270230 PRINT "YOUR ATTACK WAS STOPPED!"RUN ecb_int(B - X, B)GOTO 500250 RUN ecb_int(2.0 * E / 3.0, tmp_1) \ run ecb_str(tmp_1, tmp_1$) \ PRINT "YOU DESTROYED"; tmp_1$; "OF MY ARMY."RUN ecb_int(E / 3.0, E)GOTO 500270 PRINT "YOU SUNK ONE OF MY PATROL BOATS, BUT I WIPED OUT TWO"PRINT "OF YOUR AIR FORCE BASES AND 3 ARMY BASES."RUN ecb_int(A / 3.0, A)RUN ecb_int(C / 3.0, C)RUN ecb_int(2.0 * E / 3.0, E)GOTO 500300 IF X > C THEN 20IF X < C / 3.0 THEN 350IF X < 2.0 * C / 3.0 THEN 370GOTO 380350 PRINT "YOUR ATTACK WAS WIPED OUT."RUN ecb_int(C - X, C)GOTO 500370 PRINT "WE HAD A DOGFIGHT. YOU WON - AND FINISHED YOUR MISSION."RUN ecb_int(2.0 * D / 3.0, D)RUN ecb_int(E / 3.0, E)RUN ecb_int(F / 3.0, F)GOTO 500380 PRINT "YOU WIPED OUT ONE OF MY ARMY PATROLS, BUT I DESTROYED"PRINT "TWO NAVY BASES AND BOMBED THREE ARMY BASES."RUN ecb_int(A / 4.0, A)RUN ecb_int(B / 3.0, B)RUN ecb_int(2.0 * D / 3.0, D)500 PRINT PRINT "", "YOU", "ME"run ecb_str(A, tmp_1$) \ run ecb_str(D, tmp_2$) \ PRINT "ARMY", tmp_1$, tmp_2$run ecb_str(B, tmp_1$) \ run ecb_str(E, tmp_2$) \ PRINT "NAVY", tmp_1$, tmp_2$run ecb_str(C, tmp_1$) \ run ecb_str(F, tmp_2$) \ PRINT "A. F.", tmp_1$, tmp_2$PRINT "WHAT IS YOUR NEXT MOVE?"PRINT "ARMY=1  NAVY=2  AIR FORCE=3"RUN _ecb_input_prefix_t \ INPUT "? ", G \ RUN _ecb_input_suffix_t1030 PRINT "HOW MANY MEN"RUN _ecb_input_prefix_t \ INPUT "? ", T \ RUN _ecb_input_suffix_tIF T < 0.0 THEN 1030ON INT(G) GOTO 1600, 1700, 18001600 IF T > A THEN 1030IF T < D / 2.0 THEN 1630PRINT "YOU DESTROYED MY ARMY!"D := 0.0GOTO 20001630 PRINT "I WIPED OUT YOUR ATTACK!"A := A - TGOTO 20001700 IF T > B THEN 1030IF T < E / 2.0 THEN 1750GOTO 17701750 PRINT "I SUNK TWO OF YOUR BATTLESHIPS, AND MY AIR FORCE"PRINT "WIPED OUT YOUR UNGAURDED CAPITOL."A := A / 4.0B := B / 2.0GOTO 20001770 PRINT "YOUR NAVY SHOT DOWN THREE OF MY XIII PLANES,"PRINT "AND SUNK THREE BATTLESHIPS."F := 2.0 * F / 3.0E := (E / 2.0)GOTO 20001800 IF T > C THEN 1030IF T > F / 2.0 THEN 1830GOTO 18501830 PRINT "MY NAVY AND AIR FORCE IN A COMBINED ATTACK LEFT"PRINT "YOUR COUNTRY IN SHAMBLES."A := A / 3.0B := B / 3.0C := C / 3.0GOTO 20001850 PRINT "ONE OF YOUR PLANES CRASHED INTO MY HOUSE. I AM DEAD."PRINT "MY COUNTRY FELL APART."GOTO 20102000 PRINT PRINT "FROM THE RESULTS OF BOTH OF YOUR ATTACKS,"IF A + B + C > 3.0 / 2.0 * (D + E + F) THEN 2010IF A + B + C < 2.0 / 3.0 * (D + E + F) THEN 2015PRINT "THE TREATY OF PARIS CONCLUDED THAT WE TAKE OUR"PRINT "RESPECTIVE COUNTRIES AND LIVE IN PEACE."GOTO 20202010 PRINT "YOU WON, OH! SHUCKS!!!!"GOTO 20202015 PRINT "YOU LOST-I CONQUERED YOUR COUNTRY.  IT SERVES YOU"PRINT "RIGHT FOR PLAYING THIS STUPID GAME!!!"2020 END