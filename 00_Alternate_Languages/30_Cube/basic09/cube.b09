procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure cubebase 0A := 0.0A1 := 0.0B := 0.0B7 := 0.0C := 0.0D := 0.0E := 0.0F := 0.0G := 0.0H := 0.0I := 0.0J := 0.0K := 0.0L := 0.0M := 0.0N := 0.0O := 0.0P := 0.0Q := 0.0R := 0.0S := 0.0W := 0.0X := 0.0Y := 0.0Z := 0.0Z1 := 0.0Z2 := 0.0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(35.0); "CUBE"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT PRINT "DO YOU WANT TO SEE THE INSTRUCTIONS? (YES--1,NO--0)"RUN _ecb_input_prefix_t \ INPUT "? ", B7 \ RUN _ecb_input_suffix_tIF B7 = 0.0 THEN 370PRINT "THIS IS A GAME IN WHICH YOU WILL BE PLAYING AGAINST THE"PRINT "RANDOM DECISION OF THE COMPUTER. THE FIELD OF PLAY IS A"PRINT "CUBE OF SIDE 3. ANY OF THE 27 LOCATIONS CAN BE DESIGNATED"PRINT "BY INPUTING THREE NUMBERS SUCH AS 2,3,1. AT THE START,"PRINT "YOU ARE AUTOMATICALLY AT LOCATION 1,1,1. THE OBJECT OF"PRINT "THE GAME IS TO GET TO LOCATION 3,3,3. ONE MINOR DETAIL:"PRINT "THE COMPUTER WILL PICK, AT RANDOM, 5 LOCATIONS AT WHICH"PRINT "IT WILL PLANT LAND MINES. IF YOU HIT ONE OF THESE LOCATIONS"PRINT "YOU LOSE. ONE OTHER DETAIL: YOU MAY MOVE ONLY ONE SPACE "PRINT "IN ONE DIRECTION EACH MOVE. FOR  EXAMPLE: FROM 1,1,2 YOU"PRINT "MAY MOVE TO 2,1,2 OR 1,1,3. YOU MAY NOT CHANGE"PRINT "TWO OF THE NUMBERS ON THE SAME MOVE. IF YOU MAKE AN ILLEGAL"PRINT "MOVE, YOU LOSE AND THE COMPUTER TAKES THE MONEY YOU MAY"PRINT "HAVE BET ON THAT ROUND."PRINT PRINT PRINT "ALL YES OR NO QUESTIONS WILL BE ANSWERED BY A 1 FOR YES"PRINT "OR A 0 (ZERO) FOR NO."PRINT PRINT "WHEN STATING THE AMOUNT OF A WAGER, PRINT ONLY THE NUMBER"PRINT "OF DOLLARS (EXAMPLE: 250)  YOU ARE AUTOMATICALLY STARTED WITH"PRINT "500 DOLLARS IN YOUR ACCOUNT."PRINT PRINT "GOOD LUCK!"370 LET A1 := 500.0380 RUN ecb_int(3.0 * (RND(X)), A)IF A <> 0.0 THEN 410LET A := 3.0410 RUN ecb_int(3.0 * (RND(X)), B)IF B <> 0.0 THEN 440LET B := 2.0440 RUN ecb_int(3.0 * (RND(X)), C)IF C <> 0.0 THEN 470LET C := 3.0470 RUN ecb_int(3.0 * (RND(X)), D)IF D <> 0.0 THEN 500LET D := 1.0500 RUN ecb_int(3.0 * (RND(X)), E)IF E <> 0.0 THEN 530LET E := 3.0530 RUN ecb_int(3.0 * (RND(X)), F)IF F <> 0.0 THEN 560LET F := 3.0560 RUN ecb_int(3.0 * (RND(X)), G)IF G <> 0.0 THEN 590LET G := 3.0590 RUN ecb_int(3.0 * (RND(X)), H)IF H <> 0.0 THEN 620LET H := 3.0620 RUN ecb_int(3.0 * (RND(X)), I)IF I <> 0.0 THEN 650LET I := 2.0650 RUN ecb_int(3.0 * (RND(X)), J)IF J <> 0.0 THEN 680LET J := 3.0680 RUN ecb_int(3.0 * (RND(X)), K)IF K <> 0.0 THEN 710LET K := 2.0710 RUN ecb_int(3.0 * (RND(X)), L)IF L <> 0.0 THEN 740LET L := 3.0740 RUN ecb_int(3.0 * (RND(X)), M)IF M <> 0.0 THEN 770LET M := 3.0770 RUN ecb_int(3.0 * (RND(X)), N)IF N <> 0.0 THEN 800LET N := 1.0800 RUN ecb_int(3.0 * (RND(X)), O)IF O <> 0.0 THEN 830LET O := 3.0830 PRINT "WANT TO MAKE A WAGER?"RUN _ecb_input_prefix_t \ INPUT "? ", Z \ RUN _ecb_input_suffix_tIF Z = 0.0 THEN 880PRINT "HOW MUCH ";870 RUN _ecb_input_prefix_t \ INPUT "? ", Z1 \ RUN _ecb_input_suffix_tIF A1 < Z1 THEN 1522880 LET W := 1.0LET X := 1.0LET Y := 1.0PRINT PRINT "IT'S YOUR MOVE:  ";930 RUN _ecb_input_prefix_t \ INPUT "? ", P, Q, R \ RUN _ecb_input_suffix_tIF P > W + 1.0 THEN 1030IF P = W + 1.0 THEN 1000IF Q > X + 1.0 THEN 1030IF Q = (X + 1.0) THEN 1010IF R > (Y + 1.0) THEN 1030GOTO 10501000 IF Q >= X + 1.0 THEN 10301010 IF R >= Y + 1.0 THEN 1030GOTO 10501030 PRINT PRINT "ILLEGAL MOVE. YOU LOSE."GOTO 14401050 LET W := PLET X := QLET Y := RIF P = 3.0 THEN 1100GOTO 11301100 IF Q = 3.0 THEN 1120GOTO 11301120 IF R = 3.0 THEN 15301130 IF P = A THEN 1150GOTO 11801150 IF Q = B THEN 1170GOTO 11801170 IF R = C THEN 14001180 IF P = D THEN 1200GOTO 12301200 IF Q = E THEN 1220GOTO 12301220 IF R = F THEN 14001230 IF P = G THEN 1250GOTO 12801250 IF Q = H THEN 1270GOTO 12801270 IF R = I THEN 14001280 IF P = J THEN 1300GOTO 13301300 IF Q = K THEN 1320GOTO 13301320 IF R = L THEN 14001330 IF P = M THEN 1350GOTO 13801350 IF Q = N THEN 1370GOTO 13801370 IF R = O THEN 14001380 PRINT "NEXT MOVE: ";GOTO 9301400 PRINT "******BANG******"PRINT "YOU LOSE!"PRINT PRINT 1440 IF Z = 0.0 THEN 1580PRINT LET Z2 := A1 - Z1IF Z2 > 0.0 THEN 1500PRINT "YOU BUST."GOTO 16101500 run ecb_str(Z2, tmp_1$) \ PRINT " YOU NOW HAVE"; tmp_1$; "DOLLARS."LET A1 := Z2GOTO 15801522 PRINT "TRIED TO FOOL ME; BET AGAIN";GOTO 8701530 PRINT "CONGRATULATIONS!"IF Z = 0.0 THEN 1580LET Z2 := A1 + Z1run ecb_str(Z2, tmp_1$) \ PRINT "YOU NOW HAVE"; tmp_1$; "DOLLARS."LET A1 := Z21580 PRINT "DO YOU WANT TO TRY AGAIN ";RUN _ecb_input_prefix_t \ INPUT "? ", S \ RUN _ecb_input_suffix_tIF S = 1.0 THEN 3801610 PRINT "TOUGH LUCK!"PRINT PRINT "GOODBYE."END