procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure gunnerbase 0DIM S, S1, Z: INTEGERB := 0.0B2 := 0.0E := 0.0I := 0.0R := 0.0S := 0S1 := 0T := 0.0X := 0.0Z := 0Z$ := ""type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(31.0); "GUNNER"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT PRINT "YOU ARE THE OFFICER-IN-CHARGE, GIVING ORDERS TO A GUN"PRINT "CREW, TELLING THEM THE DEGREES OF ELEVATION YOU ESTIMATE"PRINT "WILL PLACE A PROJECTILE ON TARGET.  A HIT WITHIN 100 YARDS"PRINT "OF THE TARGET WILL DESTROY IT."PRINT 170 RUN ecb_int(40000.0 * RND(1.0) + 20000.0, R)run ecb_str(R, tmp_1$) \ PRINT "MAXIMUM RANGE OF YOUR GUN IS"; tmp_1$; " YARDS."Z := 0PRINT S1 := 0200 RUN ecb_int(R * (0.1 + 0.8 * RND(1.0)), T)S := 0GOTO 370230 PRINT "MINIMUM ELEVATION IS ONE DEGREE."GOTO 390250 PRINT "MAXIMUM ELEVATION IS 89 DEGREES."GOTO 390270 run ecb_str(ABS(E), tmp_1$) \ PRINT "OVER TARGET BY "; tmp_1$; "YARDS."GOTO 390290 run ecb_str(ABS(E), tmp_1$) \ PRINT "SHORT OF TARGET BY "; tmp_1$; "YARDS."GOTO 390320 run ecb_str(float(S), tmp_1$) \ PRINT "*** TARGET DESTROYED ***  "; tmp_1$; "ROUNDS OF AMMUNITION EXPENDED."S1 := S1 + SIF Z = 4.0 THEN 490Z := Z + 1PRINT PRINT "THE FORWARD OBSERVER HAS SIGHTED MORE ENEMY ACTIVITY..."GOTO 200370 run ecb_str(T, tmp_1$) \ PRINT "DISTANCE TO THE TARGET IS "; tmp_1$; " YARDS."PRINT 390 PRINT RUN _ecb_input_prefix_t \ INPUT "ELEVATION? ", B \ RUN _ecb_input_suffix_tIF B > 89.0 THEN 250IF B < 1.0 THEN 230S := S + 1IF S < 6.0 THEN 450PRINT PRINT "BOOM !!!!   YOU HAVE JUST BEEN DESTROYED ";PRINT "BY THE ENEMY."PRINT PRINT PRINT GOTO 495450 B2 := 2.0 * B / 57.3I := R * SIN(B2)X := T - IRUN ecb_int(X, E)IF ABS(E) < 100.0 THEN 320IF E > 100.0 THEN 290GOTO 270490 PRINT PRINT run ecb_str(float(S1), tmp_1$) \ PRINT "TOTAL ROUNDS EXPENDED WERE:"; tmp_1$IF S1 > 18.0 THEN 495PRINT "NICE SHOOTING !!"GOTO 500495 PRINT "BETTER GO BACK TO FORT SILL FOR REFRESHER TRAINING!"500 PRINT RUN _ecb_input_prefix_t \ INPUT "TRY AGAIN (Y OR N)? ", Z$ \ RUN _ecb_input_suffix_tIF Z$ = "Y" THEN 170PRINT PRINT "OK.  RETURN TO BASE CAMP."END