procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure pokerbase 0DIM I, Q, fnA_1: INTEGERB := 0.0C := 0.0D := 0.0G := 0.0H$ := ""I := 0I$ := ""J$ := ""K := 0.0K$ := ""M := 0.0N := 0.0O := 0.0P := 0.0Q := 0S := 0.0T := 0.0U := 0.0V := 0.0X := 0.0Z := 0.0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(34.0); "POKER"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT DIM arr_A(51), arr_B(16)FOR tmp_1 = 0 TO 50 \ arr_A(tmp_1) := 0 \ NEXT tmp_1FOR tmp_1 = 0 TO 15 \ arr_B(tmp_1) := 0 \ NEXT tmp_1(* DEF FNA(X)=INT(10*RND(1)) *)(* DEF FNB(X)=X-100*INT(X/100) *)PRINT "WELCOME TO THE CASINO.  WE EACH HAVE $200."PRINT "I WILL OPEN THE BETTING BEFORE THE DRAW; YOU OPEN AFTER."PRINT "TO FOLD BET 0; TO CHECK BET .5."PRINT "ENOUGH TALK -- LET'S GET DOWN TO BUSINESS."PRINT LET O := 1.0LET C := 200.0LET S := 200.0120 LET P := 0.0(* *)140 PRINT IF C <= 5.0 THEN 3670PRINT "THE ANTE IS $5.  I WILL DEAL:"PRINT IF S > 5.0 THEN 200GOSUB 3830200 LET P := P + 10.0LET S := S - 5.0LET C := C - 5.0FOR Z = 1.0 TO 10.0  GOSUB 1740NEXT ZPRINT "YOUR HAND:"N := 1.0GOSUB 1850N := 6.0I := 2GOSUB 2170PRINT IF I <> 6.0 THEN 470fnA_1 := 0 \ RUN ecb_int(10.0 * RND(1.0), tmp_1) \ IF tmp_1 <= 7.0 THEN 370LET X := 11100.0GOTO 420370 fnA_1 := 0 \ RUN ecb_int(10.0 * RND(1.0), tmp_1) \ IF tmp_1 <= 7.0 THEN 400LET X := 11110.0GOTO 420400 fnA_1 := 0 \ RUN ecb_int(10.0 * RND(1.0), tmp_1) \ IF tmp_1 >= 1.0 THEN 450X := 11111.0420 I := 7Z := 23.0GOTO 580450 Z := 1.0GOTO 510470 IF U >= 13.0 THEN 540fnA_1 := 0 \ RUN ecb_int(10.0 * RND(1.0), tmp_1) \ IF tmp_1 >= 2.0 THEN 500GOTO 420500 Z := 0.0510 K := 0.0PRINT "I CHECK."GOTO 620540 IF U <= 16.0 THEN 570Z := 2.0fnA_1 := 0 \ RUN ecb_int(10.0 * RND(1.0), tmp_1) \ IF tmp_1 >= 1.0 THEN 580570 Z := 35.0580 fnA_1 := 0 \ RUN ecb_int(10.0 * RND(1.0), tmp_1) \ V := Z + tmp_1GOSUB 3480run ecb_str(V, tmp_1$) \ PRINT "I'LL OPEN WITH $"; tmp_1$K := V620 GOSUB 3050GOSUB 650GOTO 820650 IF I <> 3.0 THEN 760PRINT 670 PRINT "I WIN."C := C + P690 run ecb_str(C, tmp_1$) \ run ecb_str(S, tmp_2$) \ PRINT "NOW I HAVE $"; tmp_1$; "AND YOU HAVE $"; tmp_2$700 PRINT "DO YOU WISH TO CONTINUE";RUN _ecb_input_prefix_t \ INPUT "? ", H$ \ RUN _ecb_input_suffix_tIF H$ = "YES" THEN 120IF H$ = "NO" THEN 4100PRINT "ANSWER YES OR NO, PLEASE."GOTO 700760 IF I <> 4.0 THEN 810PRINT 780 PRINT "YOU WIN."S := S + PGOTO 690810 RETURN820 PRINT PRINT "NOW WE DRAW -- HOW MANY CARDS DO YOU WANT";840 RUN _ecb_input_prefix_t \ INPUT "? ", T \ RUN _ecb_input_suffix_tIF T = 0.0 THEN 980Z := 10.0IF T < 4.0 THEN 900PRINT "YOU CAN'T DRAW MORE THAN THREE CARDS."GOTO 840900 PRINT "WHAT ARE THEIR NUMBERS:"FOR Q = 1 TO T  RUN _ecb_input_prefix_t \ INPUT "? ", U \ RUN _ecb_input_suffix_t  GOSUB 1730NEXT QPRINT "YOUR NEW HAND:"N := 1.0GOSUB 1850980 Z := 10.0 + TFOR U = 6.0 TO 10.0  RUN ecb_int(X / 10.0 ^ (U - 6.0), tmp_1) \ RUN ecb_int(X / 10.0 ^ (U - 5.0), tmp_2) \ IF tmp_1 <> 10.0 * tmp_2 THEN 1020  GOSUB 17301020 NEXT UPRINT PRINT "I AM TAKING"; Z - 10.0 - T; "CARD";IF Z = 11.0 + T THEN 1090PRINT "S"PRINT GOTO 11001090 PRINT 1100 N := 6.0V := II := 1GOSUB 2170B := UM := DIF V <> 7.0 THEN 1190Z := 28.0GOTO 13301190 IF I <> 6.0 THEN 1220Z := 1.0GOTO 13301220 IF U >= 13.0 THEN 1270Z := 2.0fnA_1 := 0 \ RUN ecb_int(10.0 * RND(1.0), tmp_1) \ IF tmp_1 <> 6.0 THEN 1260Z := 19.01260 GOTO 13301270 IF U >= 16.0 THEN 1320Z := 19.0fnA_1 := 0 \ RUN ecb_int(10.0 * RND(1.0), tmp_1) \ IF tmp_1 <> 8.0 THEN 1310Z := 11.01310 GOTO 13301320 Z := 2.01330 K := 0.0GOSUB 3050IF T <> 0.5 THEN 1450IF V = 7.0 THEN 1400IF I <> 6.0 THEN 1400PRINT "I'LL CHECK"GOTO 14601400 fnA_1 := 0 \ RUN ecb_int(10.0 * RND(1.0), tmp_1) \ V := Z + tmp_1GOSUB 3480run ecb_str(V, tmp_1$) \ PRINT "I'LL BET $"; tmp_1$K := VGOSUB 30601450 GOSUB 6501460 PRINT PRINT "NOW WE COMPARE HANDS:"J$ := H$K$ := I$PRINT "MY HAND:"N := 6.0GOSUB 1850N := 1.0GOSUB 2170PRINT PRINT "YOU HAVE ";K := DGOSUB 3690H$ := J$I$ := K$K := MPRINT "AND I HAVE ";GOSUB 3690IF B > U THEN 670IF U > B THEN 780IF H$ = "A FLUS" THEN 1700fnB_1 := M \ RUN ecb_int(fnB_1 / 100.0, tmp_1) \ fnB_2 := D \ RUN ecb_int(fnB_2 / 100.0, tmp_2) \ IF (fnB_1 - 100.0 * tmp_1) < (fnB_2 - 100.0 * tmp_2) THEN 780fnB_1 := M \ RUN ecb_int(fnB_1 / 100.0, tmp_1) \ fnB_2 := D \ RUN ecb_int(fnB_2 / 100.0, tmp_2) \ IF (fnB_1 - 100.0 * tmp_1) > (fnB_2 - 100.0 * tmp_2) THEN 6701670 PRINT "THE HAND IS DRAWN."run ecb_str(P, tmp_1$) \ PRINT "ALL $"; tmp_1$; "REMAINS IN THE POT."GOTO 1401700 fnB_1 := M \ RUN ecb_int(fnB_1 / 100.0, tmp_1) \ fnB_2 := D \ RUN ecb_int(fnB_2 / 100.0, tmp_2) \ IF (fnB_1 - 100.0 * tmp_1) > (fnB_2 - 100.0 * tmp_2) THEN 670fnB_1 := D \ RUN ecb_int(fnB_1 / 100.0, tmp_1) \ fnB_2 := M \ RUN ecb_int(fnB_2 / 100.0, tmp_2) \ IF (fnB_1 - 100.0 * tmp_1) > (fnB_2 - 100.0 * tmp_2) THEN 780GOTO 16701730 Z := Z + 1.01740 RUN ecb_int(4.0 * RND(1.0), tmp_1) \ RUN ecb_int(100.0 * RND(1.0), tmp_2) \ arr_A(INT(Z)) := 100.0 * tmp_1 + tmp_2RUN ecb_int(arr_A(INT(Z)) / 100.0, tmp_1) \ IF tmp_1 > 3.0 THEN 1740RUN ecb_int(arr_A(INT(Z)) / 100.0, tmp_1) \ IF arr_A(INT(Z)) - 100.0 * tmp_1 > 12.0 THEN 1740IF Z = 1.0 THEN 1840FOR K = 1.0 TO Z - 1.0  IF arr_A(INT(Z)) = arr_A(INT(K)) THEN 1740NEXT KIF Z <= 10.0 THEN 1840N := arr_A(INT(U))arr_A(INT(U)) := arr_A(INT(Z))arr_A(INT(Z)) := N1840 RETURN1850 FOR Z = N TO N + 4.0  run ecb_str(Z, tmp_1$) \ PRINT tmp_1$; "--  ";  GOSUB 1950  PRINT " OF";  GOSUB 2070  RUN ecb_int(Z / 2.0, tmp_1) \ IF Z / 2.0 <> tmp_1 THEN 1920  PRINT 1920 NEXT ZPRINT RETURN1950 fnB_1 := arr_A(INT(Z)) \ RUN ecb_int(fnB_1 / 100.0, tmp_1) \ K := (fnB_1 - 100.0 * tmp_1)1960 IF K <> 9.0 THEN 1980PRINT "JACK";1980 IF K <> 10.0 THEN 2000PRINT "QUEEN";2000 IF K <> 11.0 THEN 2020PRINT "KING";2020 IF K <> 12.0 THEN 2040PRINT "ACE";2040 IF K >= 9.0 THEN 2060PRINT K + 2.0;2060 RETURN2070 RUN ecb_int(arr_A(INT(Z)) / 100.0, K)2080 IF K <> 0.0 THEN 2100PRINT " CLUBS",2100 IF K <> 1.0 THEN 2120PRINT " DIAMONDS",2120 IF K <> 2.0 THEN 2140PRINT " HEARTS",2140 IF K <> 3.0 THEN 2160PRINT " SPADES",2160 RETURN2170 U := 0.0FOR Z = N TO N + 4.0  fnB_1 := arr_A(INT(Z)) \ RUN ecb_int(fnB_1 / 100.0, tmp_1) \ arr_B(INT(Z)) := (fnB_1 - 100.0 * tmp_1)  IF Z = N + 4.0 THEN 2230  RUN ecb_int(arr_A(INT(Z)) / 100.0, tmp_1) \ RUN ecb_int(arr_A(INT(Z + 1.0)) / 100.0, tmp_2) \ IF tmp_1 <> tmp_2 THEN 2230  U := U + 1.02230 NEXT ZIF U <> 4.0 THEN 2310X := 11111.0D := arr_A(INT(N))H$ := "A FLUS"I$ := "H IN"U := 15.0RETURN2310 FOR Z = N TO N + 3.0  FOR K = Z + 1.0 TO N + 4.0    IF arr_B(INT(Z)) <= arr_B(INT(K)) THEN 2390    X := arr_A(INT(Z))    arr_A(INT(Z)) := arr_A(INT(K))    arr_B(INT(Z)) := arr_B(INT(K))    arr_A(INT(K)) := X    RUN ecb_int(arr_A(INT(K)) / 100.0, tmp_1) \ arr_B(INT(K)) := arr_A(INT(K)) - 100.0 * tmp_12390   NEXT KNEXT ZX := 0.0FOR Z = N TO N + 3.0  IF arr_B(INT(Z)) <> arr_B(INT(Z + 1.0)) THEN 2470  X := X + 11.0 * 10.0 ^ (Z - N)  D := arr_A(INT(Z))  GOSUB 27602470 NEXT ZIF X <> 0.0 THEN 2620IF arr_B(INT(N)) + 3.0 <> arr_B(INT(N + 3.0)) THEN 2520X := 1111.0U := 10.02520 IF arr_B(INT(N + 1.0)) + 3.0 <> arr_B(INT(N + 4.0)) THEN 2620IF U <> 10.0 THEN 2600U := 14.0H$ := "STRAIG"I$ := "HT"X := 11111.0D := arr_A(INT(N + 4.0))RETURN2600 U := 10.0X := 11110.02620 IF U >= 10.0 THEN 2690D := arr_A(INT(N + 4.0))H$ := "SCHMAL"I$ := "TZ, "U := 9.0X := 11000.0GOTO 27402690 IF U <> 10.0 THEN 2720IF I = 1.0 THEN 2740GOTO 27502720 IF U > 12.0 THEN 2750fnB_1 := D \ RUN ecb_int(fnB_1 / 100.0, tmp_1) \ IF (fnB_1 - 100.0 * tmp_1) > 6.0 THEN 27502740 I := 62750 RETURN2760 IF U >= 11.0 THEN 2810U := 11.0H$ := "A PAIR"I$ := " OF "RETURN2810 IF U <> 11.0 THEN 2910IF arr_B(INT(Z)) <> arr_B(INT(Z - 1.0)) THEN 2870H$ := "THREE"I$ := " "U := 13.0RETURN2870 H$ := "TWO P"I$ := "AIR, "U := 12.0RETURN2910 IF U > 12.0 THEN 2960U := 16.0H$ := "FULL H"I$ := "OUSE, "RETURN2960 IF arr_B(INT(Z)) <> arr_B(INT(Z - 1.0)) THEN 3010U := 17.0H$ := "FOUR"I$ := " "RETURN3010 U := 16.0H$ := "FULL H"I$ := "OUSE, "RETURN3050 G := 0.03060 PRINT PRINT "WHAT IS YOUR BET";RUN _ecb_input_prefix_t \ INPUT "? ", T \ RUN _ecb_input_suffix_tRUN ecb_int(T, tmp_1) \ IF T - tmp_1 = 0.0 THEN 3140IF K <> 0.0 THEN 3120IF G <> 0.0 THEN 3120IF T = 0.5 THEN 34103120 PRINT "NO SMALL CHANGE, PLEASE."GOTO 30603140 IF S - G - T >= 0.0 THEN 3170GOSUB 3830GOTO 30603170 IF T <> 0.0 THEN 3200I := 3GOTO 33803200 IF G + T >= K THEN 3230PRINT "IF YOU CAN'T SEE MY BET, THEN FOLD."GOTO 30603230 G := G + TIF G = K THEN 3380IF Z <> 1.0 THEN 3420IF G > 5.0 THEN 3300IF Z >= 2.0 THEN 3350V := 5.0GOTO 34203300 IF Z = 1.0 THEN 3320IF T <= 25.0 THEN 33503320 I := 4PRINT "I FOLD."RETURN3350 IF Z = 2.0 THEN 34303360 PRINT "I'LL SEE YOU."K := G3380 S := S - GC := C - KP := P + G + K3410 RETURN3420 IF G > 3.0 * Z THEN 33503430 fnA_1 := 0 \ RUN ecb_int(10.0 * RND(1.0), tmp_1) \ V := G - K + tmp_1GOSUB 3480run ecb_str(V, tmp_1$) \ PRINT "I'LL SEE YOU, AND RAISE YOU"; tmp_1$K := G + VGOTO 30603480 IF C - G - V >= 0.0 THEN 3660IF G <> 0.0 THEN 3520V := CRETURN3520 IF C - G >= 0.0 THEN 3360RUN ecb_int(O / 2.0, tmp_1) \ IF (O / 2.0) <> tmp_1 THEN 3600PRINT "WOULD YOU LIKE TO BUY BACK YOUR WATCH FOR $50";RUN _ecb_input_prefix_t \ INPUT "? ", J$ \ RUN _ecb_input_suffix_tIF LEFT$(J$, 1.0) = "N" THEN 3600C := C + 50.0O := O / 2.0RETURN3600 RUN ecb_int(O / 3.0, tmp_1) \ IF O / 3.0 <> tmp_1 THEN 3670PRINT "WOULD YOU LIKE TO BUY BACK YOUR TIE TACK FOR $50";RUN _ecb_input_prefix_t \ INPUT "? ", J$ \ RUN _ecb_input_suffix_tIF LEFT$(J$, 1.0) = "N" THEN 3670C := C + 50.0O := O / 3.03660 RETURN3670 PRINT "I'M BUSTED.  CONGRATULATIONS!"STOP3690 PRINT H$; I$;IF H$ <> "A FLUS" THEN 3750RUN ecb_int(K / 100.0, K)GOSUB 2080PRINT RETURN3750 fnB_1 := K \ RUN ecb_int(fnB_1 / 100.0, tmp_1) \ K := (fnB_1 - 100.0 * tmp_1)GOSUB 1960IF H$ = "SCHMAL" THEN 3790IF H$ <> "STRAIG" THEN 38103790 PRINT " HIGH"RETURN3810 PRINT "'S"RETURN3830 PRINT PRINT "YOU CAN'T BET WITH WHAT YOU HAVEN'T GOT."RUN ecb_int(O / 2.0, tmp_1) \ IF O / 2.0 = tmp_1 THEN 3970PRINT "WOULD YOU LIKE TO SELL YOUR WATCH";RUN _ecb_input_prefix_t \ INPUT "? ", J$ \ RUN _ecb_input_suffix_tIF LEFT$(J$, 1.0) = "N" THEN 3970fnA_1 := 0 \ RUN ecb_int(10.0 * RND(1.0), tmp_1) \ IF tmp_1 >= 7.0 THEN 3930PRINT "I'LL GIVE YOU $75 FOR IT."S := S + 75.0GOTO 39503930 PRINT "THAT'S A PRETTY CRUMMY WATCH - I'LL GIVE YOU $25."S := S + 25.03950 O := O * 2.0RETURN3970 RUN ecb_int(O / 3.0, tmp_1) \ IF O / 3.0 <> tmp_1 THEN 4090PRINT "WILL YOU PART WITH THAT DIAMOND TIE TACK"RUN _ecb_input_prefix_t \ INPUT "? ", J$ \ RUN _ecb_input_suffix_tIF LEFT$(J$, 1.0) = "N" THEN 4080fnA_1 := 0 \ RUN ecb_int(10.0 * RND(1.0), tmp_1) \ IF tmp_1 >= 6.0 THEN 4050PRINT "YOU ARE NOW $100 RICHER."S := S + 100.0GOTO 40704050 PRINT "IT'S PASTE.  $25."S := S + 25.04070 O := O * 3.04080 RETURN4090 PRINT "YOUR WAD IS SHOT.  SO LONG, SUCKER!"4100 END