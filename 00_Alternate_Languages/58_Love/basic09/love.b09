procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure lovebase 0DIM C, J, L, P: INTEGERA := 0.0A$ := ""A1 := 0.0C := 0I := 0.0J := 0L := 0P := 0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(34.0); "LOVE"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT PRINT "A TRIBUTE TO THE GREAT AMERICAN ARTIST, ROBERT INDIANA."PRINT "HIS GREATEST WORK WILL BE REPRODUCED WITH A MESSAGE OF"PRINT "YOUR CHOICE UP TO 60 CHARACTERS.  IF YOU CAN'T THINK OF"PRINT "A MESSAGE, SIMPLE TYPE THE WORD 'LOVE'"PRINT RUN _ecb_input_prefix_t \ INPUT "YOUR MESSAGE, PLEASE? ", A$ \ RUN _ecb_input_suffix_tL := LEN(A$)DIM arr_T$(121)FOR tmp_1 = 0 TO 120 \ arr_T$(tmp_1) := "" \ NEXT tmp_1FOR I = 1.0 TO 10.0PRINT NEXT IRUN ecb_int(60.0 / L, tmp_1) \ FOR J = 0 TO tmp_1  FOR I = 1.0 TO L    arr_T$(INT(J * L + I)) := MID$(A$, INT(I), 1.0)NEXT INEXT JC := 0200 A1 := 1.0P := 1C := C + 1IF C = 37.0 THEN 999PRINT 210 READ AA1 := A1 + AIF P = 1.0 THEN 300FOR I = 1.0 TO APRINT " ";NEXT IP := 1GOTO 400300 FOR I = A1 - A TO A1 - 1.0PRINT arr_T$(INT(I));NEXT IP := 0400 IF A1 > 60.0 THEN 200GOTO 210DATA 60.0, 1.0, 12.0, 26.0, 9.0, 12.0, 3.0, 8.0, 24.0, 17.0, 8.0, 4.0, 6.0, 23.0, 21.0, 6.0, 4.0, 6.0, 22.0, 12.0, 5.0, 6.0, 5.0DATA 4.0, 6.0, 21.0, 11.0, 8.0, 6.0, 4.0, 4.0, 6.0, 21.0, 10.0, 10.0, 5.0, 4.0, 4.0, 6.0, 21.0, 9.0, 11.0, 5.0, 4.0DATA 4.0, 6.0, 21.0, 8.0, 11.0, 6.0, 4.0, 4.0, 6.0, 21.0, 7.0, 11.0, 7.0, 4.0, 4.0, 6.0, 21.0, 6.0, 11.0, 8.0, 4.0DATA 4.0, 6.0, 19.0, 1.0, 1.0, 5.0, 11.0, 9.0, 4.0, 4.0, 6.0, 19.0, 1.0, 1.0, 5.0, 10.0, 10.0, 4.0, 4.0, 6.0, 18.0, 2.0, 1.0, 6.0, 8.0, 11.0, 4.0DATA 4.0, 6.0, 17.0, 3.0, 1.0, 7.0, 5.0, 13.0, 4.0, 4.0, 6.0, 15.0, 5.0, 2.0, 23.0, 5.0, 1.0, 29.0, 5.0, 17.0, 8.0DATA 1.0, 29.0, 9.0, 9.0, 12.0, 1.0, 13.0, 5.0, 40.0, 1.0, 1.0, 13.0, 5.0, 40.0, 1.0, 4.0, 6.0, 13.0, 3.0, 10.0, 6.0, 12.0, 5.0, 1.0DATA 5.0, 6.0, 11.0, 3.0, 11.0, 6.0, 14.0, 3.0, 1.0, 5.0, 6.0, 11.0, 3.0, 11.0, 6.0, 15.0, 2.0, 1.0DATA 6.0, 6.0, 9.0, 3.0, 12.0, 6.0, 16.0, 1.0, 1.0, 6.0, 6.0, 9.0, 3.0, 12.0, 6.0, 7.0, 1.0, 10.0DATA 7.0, 6.0, 7.0, 3.0, 13.0, 6.0, 6.0, 2.0, 10.0, 7.0, 6.0, 7.0, 3.0, 13.0, 14.0, 10.0, 8.0, 6.0, 5.0, 3.0, 14.0, 6.0, 6.0, 2.0, 10.0DATA 8.0, 6.0, 5.0, 3.0, 14.0, 6.0, 7.0, 1.0, 10.0, 9.0, 6.0, 3.0, 3.0, 15.0, 6.0, 16.0, 1.0, 1.0DATA 9.0, 6.0, 3.0, 3.0, 15.0, 6.0, 15.0, 2.0, 1.0, 10.0, 6.0, 1.0, 3.0, 16.0, 6.0, 14.0, 3.0, 1.0, 10.0, 10.0, 16.0, 6.0, 12.0, 5.0, 1.0DATA 11.0, 8.0, 13.0, 27.0, 1.0, 11.0, 8.0, 13.0, 27.0, 1.0, 60.0999 FOR I = 1.0 TO 10.0PRINT NEXT IEND