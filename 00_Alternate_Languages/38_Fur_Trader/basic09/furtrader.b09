procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure furtraderbase 0DIM J, P: INTEGERB := 0.0B$ := ""B1 := 0.0D1 := 0.0E1 := 0.0I := 0.0J := 0M1 := 0.0P := 0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0DIM arr_F(5)FOR tmp_1 = 0 TO 4 \ arr_F(tmp_1) := 0 \ NEXT tmp_1PRINT TAB(32.0); "FUR TRADER"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT 15 GOSUB 1091LET I := 600.0PRINT "DO YOU WISH TO TRADE FURS?"18 GOSUB 1402IF B$ = "YES" THEN 100IF B$ = "YES " THEN 100STOP100 PRINT run ecb_str(I, tmp_1$) \ PRINT "YOU HAVE $"; tmp_1$; " SAVINGS."PRINT "AND 190 FURS TO BEGIN THE EXPEDITION."RUN ecb_int((0.15 * RND(1.0) + 0.95) * 10.0 ^ 2.0 + 0.5, tmp_1) \ LET E1 := tmp_1 / 10.0 ^ 2.0RUN ecb_int((0.25 * RND(1.0) + 1.0) * 10.0 ^ 2.0 + 0.5, tmp_1) \ LET B1 := tmp_1 / 10.0 ^ 2.0PRINT PRINT "YOUR 190 FURS ARE DISTRIBUTED AMONG THE FOLLOWING"PRINT "KINDS OF PELTS: MINK, BEAVER, ERMINE AND FOX."GOSUB 1430RESTOREFOR J = 1 TO 4  READ B$  PRINT   PRINT "HOW MANY "; B$; " PELTS DO YOU HAVE";  RUN _ecb_input_prefix_t \ INPUT "? ", arr_F(J) \ RUN _ecb_input_suffix_t  LET arr_F(0.0) := arr_F(1.0) + arr_F(2.0) + arr_F(3.0) + arr_F(4.0)  IF arr_F(0.0) = 190.0 THEN 1100  IF arr_F(0.0) > 190.0 THEN 500NEXT JGOTO 1100500 PRINT PRINT "YOU MAY NOT HAVE THAT MANY FURS."PRINT "DO NOT TRY TO CHEAT.  I CAN ADD."PRINT "YOU MUST START AGAIN."GOTO 15508 PRINT PRINT "DO YOU WANT TO TRADE FURS NEXT YEAR?"GOTO 181091 PRINT "YOU ARE THE LEADER OF A FRENCH FUR TRADING EXPEDITION IN "PRINT "1776 LEAVING THE LAKE ONTARIO AREA TO SELL FURS AND GET"PRINT "SUPPLIES FOR THE NEXT YEAR.  YOU HAVE A CHOICE OF THREE"PRINT "FORTS AT WHICH YOU MAY TRADE.  THE COST OF SUPPLIES"PRINT "AND THE AMOUNT YOU RECEIVE FOR YOUR FURS WILL DEPEND"PRINT "ON THE FORT THAT YOU CHOOSE."RETURN1100 PRINT "YOU MAY TRADE YOUR FURS AT FORT 1, FORT 2,"PRINT "OR FORT 3.  FORT 1 IS FORT HOCHELAGA (MONTREAL)"PRINT "AND IS UNDER THE PROTECTION OF THE FRENCH ARMY."PRINT "FORT 2 IS FORT STADACONA (QUEBEC) AND IS UNDER THE"PRINT "PROTECTION OF THE FRENCH ARMY.  HOWEVER, YOU MUST"PRINT "MAKE A PORTAGE AND CROSS THE LACHINE RAPIDS."PRINT "FORT 3 IS FORT NEW YORK AND IS UNDER DUTCH CONTROL."PRINT "YOU MUST CROSS THROUGH IROQUOIS LAND."1110 PRINT "ANSWER 1, 2, OR 3."RUN _ecb_input_prefix_t \ INPUT "? ", B \ RUN _ecb_input_suffix_tIF B = 1.0 THEN 1120IF B = 2.0 THEN 1135IF B = 3.0 THEN 1147GOTO 11101120 PRINT "YOU HAVE CHOSEN THE EASIEST ROUTE.  HOWEVER, THE FORT"PRINT "IS FAR FROM ANY SEAPORT.  THE VALUE"PRINT "YOU RECEIVE FOR YOUR FURS WILL BE LOW AND THE COST"PRINT "OF SUPPLIES HIGHER THAN AT FORTS STADACONA OR NEW YORK."GOSUB 1400IF B$ = "YES" THEN 1110GOTO 11601135 PRINT "YOU HAVE CHOSEN A HARD ROUTE.  IT IS, IN COMPARSION,"PRINT "HARDER THAN THE ROUTE TO HOCHELAGA BUT EASIER THAN"PRINT "THE ROUTE TO NEW YORK.  YOU WILL RECEIVE AN AVERAGE VALUE"PRINT "FOR YOUR FURS AND THE COST OF YOUR SUPPLIES WILL BE AVERAGE."GOSUB 1400IF B$ = "YES" THEN 1110GOTO 11981147 PRINT "YOU HAVE CHOSEN THE MOST DIFFICULT ROUTE.  AT"PRINT "FORT NEW YORK YOU WILL RECEIVE THE HIGHEST VALUE"PRINT "FOR YOUR FURS.  THE COST OF YOUR SUPPLIES"PRINT "WILL BE LOWER THAN AT ALL THE OTHER FORTS."GOSUB 1400IF B$ = "YES" THEN 1110GOTO 12501160 LET I := I - 160.0PRINT RUN ecb_int((0.2 * RND(1.0) + 0.7) * 10.0 ^ 2.0 + 0.5, tmp_1) \ LET M1 := tmp_1 / 10.0 ^ 2.0RUN ecb_int((0.2 * RND(1.0) + 0.65) * 10.0 ^ 2.0 + 0.5, tmp_1) \ LET E1 := tmp_1 / 10.0 ^ 2.0RUN ecb_int((0.2 * RND(1.0) + 0.75) * 10.0 ^ 2.0 + 0.5, tmp_1) \ LET B1 := tmp_1 / 10.0 ^ 2.0RUN ecb_int((0.2 * RND(1.0) + 0.8) * 10.0 ^ 2.0 + 0.5, tmp_1) \ LET D1 := tmp_1 / 10.0 ^ 2.0PRINT "SUPPLIES AT FORT HOCHELAGA COST $150.00."PRINT "YOUR TRAVEL EXPENSES TO HOCHELAGA WERE $10.00."GOTO 14101198 LET I := I - 140.0PRINT RUN ecb_int((0.3 * RND(1.0) + 0.85) * 10.0 ^ 2.0 + 0.5, tmp_1) \ LET M1 := tmp_1 / 10.0 ^ 2.0RUN ecb_int((0.15 * RND(1.0) + 0.8) * 10.0 ^ 2.0 + 0.5, tmp_1) \ LET E1 := tmp_1 / 10.0 ^ 2.0RUN ecb_int((0.2 * RND(1.0) + 0.9) * 10.0 ^ 2.0 + 0.5, tmp_1) \ LET B1 := tmp_1 / 10.0 ^ 2.0RUN ecb_int(10.0 * RND(1.0), tmp_1) \ LET P := tmp_1 + 1IF P <= 2.0 THEN 1216IF P <= 6.0 THEN 1224IF P <= 8.0 THEN 1226IF P <= 10.0 THEN 12351216 LET arr_F(2.0) := 0.0PRINT "YOUR BEAVER WERE TOO HEAVY TO CARRY ACROSS"PRINT "THE PORTAGE.  YOU HAD TO LEAVE THE PELTS, BUT FOUND"PRINT "THEM STOLEN WHEN YOU RETURNED."GOSUB 1244GOTO 14141224 PRINT "YOU ARRIVED SAFELY AT FORT STADACONA."GOTO 12391226 GOSUB 1430PRINT "YOUR CANOE UPSET IN THE LACHINE RAPIDS.  YOU"PRINT "LOST ALL YOUR FURS."GOSUB 1244GOTO 14181235 LET arr_F(4.0) := 0.0PRINT "YOUR FOX PELTS WERE NOT CURED PROPERLY."PRINT "NO ONE WILL BUY THEM."1239 GOSUB 1244GOTO 14101244 PRINT "SUPPLIES AT FORT STADACONA COST $125.00."PRINT "YOUR TRAVEL EXPENSES TO STADACONA WERE $15.00."RETURN1250 LET I := I - 105.0PRINT RUN ecb_int((0.15 * RND(1.0) + 1.05) * 10.0 ^ 2.0 + 0.5, tmp_1) \ LET M1 := tmp_1 / 10.0 ^ 2.0RUN ecb_int((0.25 * RND(1.0) + 1.1) * 10.0 ^ 2.0 + 0.5, tmp_1) \ LET D1 := tmp_1 / 10.0 ^ 2.0RUN ecb_int(10.0 * RND(1.0), tmp_1) \ LET P := tmp_1 + 1IF P <= 2.0 THEN 1281IF P <= 6.0 THEN 1291IF P <= 8.0 THEN 1295IF P <= 10.0 THEN 13061281 PRINT "YOU WERE ATTACKED BY A PARTY OF IROQUOIS."PRINT "ALL PEOPLE IN YOUR TRADING GROUP WERE"PRINT "KILLED.  THIS ENDS THE GAME."STOP1291 PRINT "YOU WERE LUCKY.  YOU ARRIVED SAFELY"PRINT "AT FORT NEW YORK."GOTO 13111295 GOSUB 1430PRINT "YOU NARROWLY ESCAPED AN IROQUOIS RAIDING PARTY."PRINT "HOWEVER, YOU HAD TO LEAVE ALL YOUR FURS BEHIND."GOSUB 1320GOTO 14181306 LET B1 := B1 / 2.0LET M1 := M1 / 2.0PRINT "YOUR MINK AND BEAVER WERE DAMAGED ON YOUR TRIP."PRINT "YOU RECEIVE ONLY HALF THE CURRENT PRICE FOR THESE FURS."1311 GOSUB 1320GOTO 14101320 PRINT "SUPPLIES AT NEW YORK COST $80.00."PRINT "YOUR TRAVEL EXPENSES TO NEW YORK WERE $25.00."RETURN1400 PRINT "DO YOU WANT TO TRADE AT ANOTHER FORT?"1402 PRINT "ANSWER YES OR NO",RUN _ecb_input_prefix_t \ INPUT "? ", B$ \ RUN _ecb_input_suffix_tRETURN1410 PRINT PRINT "YOUR BEAVER SOLD FOR $"; B1 * arr_F(2.0);1414 PRINT "YOUR FOX SOLD FOR $"; D1 * arr_F(4.0)PRINT "YOUR ERMINE SOLD FOR $"; E1 * arr_F(3.0);PRINT "YOUR MINK SOLD FOR $"; M1 * arr_F(1.0)1418 LET I := M1 * arr_F(1.0) + B1 * arr_F(2.0) + E1 * arr_F(3.0) + D1 * arr_F(4.0) + IPRINT run ecb_str(I, tmp_1$) \ PRINT "YOU NOW HAVE $"; tmp_1$; " INCLUDING YOUR PREVIOUS SAVINGS"GOTO 5081430 FOR J = 1 TO 4  LET arr_F(J) := 0.0NEXT JRETURNDATA "MINK", "BEAVER", "ERMINE", "FOX"END