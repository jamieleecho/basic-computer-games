procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure mathdicebase 0DIM N: INTEGERA := 0.0D := 0.0N := 0T := 0.0T1 := 0.0T2 := 0.0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(32.0); "MATH DICE"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT PRINT "THIS PROGRAM GENERATES SUCCESSIVE PICTURES OF TWO DICE."PRINT "WHEN TWO DICE AND AN EQUAL SIGN FOLLOWED BY A QUESTION"PRINT "MARK HAVE BEEN PRINTED, TYPE YOUR ANSWER AND THE RETURN KEY."PRINT "TO CONCLUDE THE LESSON, TYPE CONTROL-C AS YOUR ANSWER."PRINT PRINT 100 N := N + 1RUN ecb_int(6.0 * RND(1.0) + 1.0, D)PRINT " ----- "IF D = 1.0 THEN 200IF D = 2.0 THEN 180IF D = 3.0 THEN 180PRINT "I * * I"GOTO 210180 PRINT "I *   I"GOTO 210200 PRINT "I     I"210 IF D = 2.0 THEN 260IF D = 4.0 THEN 260IF D = 6.0 THEN 270PRINT "I  *  I"GOTO 280260 PRINT "I     I"GOTO 280270 PRINT "I * * I"280 IF D = 1.0 THEN 350IF D = 2.0 THEN 330IF D = 3.0 THEN 330PRINT "I * * I"GOTO 360330 PRINT "I   * I"GOTO 360350 PRINT "I     I"360 PRINT " ----- "PRINT IF N = 2.0 THEN 500PRINT "   +"PRINT A := DGOTO 100500 T := D + APRINT "      =";RUN _ecb_input_prefix_t \ INPUT "? ", T1 \ RUN _ecb_input_suffix_tIF T1 = T THEN 590PRINT "NO, COUNT THE SPOTS AND GIVE ANOTHER ANSWER."PRINT "      =";RUN _ecb_input_prefix_t \ INPUT "? ", T2 \ RUN _ecb_input_suffix_tIF T2 = T THEN 590run ecb_str(T, tmp_1$) \ PRINT "NO, THE ANSWER IS"; tmp_1$GOTO 600590 PRINT "RIGHT!"600 PRINT PRINT "THE DICE ROLL AGAIN..."PRINT N := 0GOTO 100END