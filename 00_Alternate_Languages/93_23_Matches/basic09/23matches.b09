procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure _23matchesbase 0K := 0.0N := 0.0Q := 0.0Z := 0.0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(32.0); "23 MATCHES"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT PRINT " THIS IS A GAME CALLED '23 MATCHES'."PRINT PRINT "WHEN IT IS YOUR TURN, YOU MAY TAKE ONE, TWO, OR THREE"PRINT "MATCHES. THE OBJECT OF THE GAME IS NOT TO HAVE TO TAKE"PRINT "THE LAST MATCH."PRINT PRINT "LET'S FLIP A COIN TO SEE WHO GOES FIRST."PRINT "IF IT COMES UP HEADS, I WILL WIN THE TOSS."PRINT (* *)N := 23.0RUN ecb_int(2.0 * RND(5.0), Q)IF Q = 1.0 THEN 210PRINT "TAILS! YOU GO FIRST. "PRINT GOTO 300210 PRINT "HEADS! I WIN! HA! HA!"PRINT "PREPARE TO LOSE, MEATBALL-NOSE!!"PRINT PRINT "I TAKE 2 MATCHES"N := N - 2.0270 run ecb_str(N, tmp_1$) \ PRINT "THE NUMBER OF MATCHES IS NOW"; tmp_1$PRINT PRINT "YOUR TURN -- YOU MAY TAKE 1, 2 OR 3 MATCHES."300 PRINT "HOW MANY DO YOU WISH TO REMOVE",310 RUN _ecb_input_prefix_t \ INPUT "? ", K \ RUN _ecb_input_suffix_tIF K > 3.0 THEN 430IF K <= 0.0 THEN 430N := N - Krun ecb_str(N, tmp_1$) \ PRINT "THERE ARE NOW"; tmp_1$; "MATCHES REMAINING."IF N = 4.0 THEN 381IF N = 3.0 THEN 383IF N = 2.0 THEN 385IF N <= 1.0 THEN 530Z := 4.0 - KGOTO 390PRINT 381 Z := 3.0GOTO 390383 Z := 2.0GOTO 390385 Z := 1.0390 run ecb_str(Z, tmp_1$) \ PRINT "MY TURN ! I REMOVE"; tmp_1$; "MATCHES"N := N - ZIF N <= 1.0 THEN 470GOTO 270430 PRINT "VERY FUNNY! DUMMY!"PRINT "DO YOU WANT TO PLAY OR GOOF AROUND?"PRINT "NOW, HOW MANY MATCHES DO YOU WANT",GOTO 310470 PRINT PRINT "YOU POOR BOOB! YOU TOOK THE LAST MATCH! I GOTCHA!!"PRINT "HA ! HA ! I BEAT YOU !!!"PRINT PRINT "GOOD BYE LOSER!"GOTO 560530 PRINT "YOU WON, FLOPPY EARS !"PRINT "THINK YOU'RE PRETTY SMART !"PRINT "LETS PLAY AGAIN AND I'LL BLOW YOUR SHOES OFF !!"560 STOPEND