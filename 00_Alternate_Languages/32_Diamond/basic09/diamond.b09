procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure diamondbase 0DIM A, C, L, M, Z: INTEGERA := 0A$ := ""C := 0L := 0M := 0N := 0.0Q := 0.0R := 0.0X := 0.0Y := 0.0Z := 0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(34.0); "DIAMOND"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT PRINT "FOR A PRETTY DIAMOND PATTERN,"RUN _ecb_input_prefix_t \ INPUT "TYPE IN AN ODD NUMBER BETWEEN 5 AND 21? ", R \ RUN _ecb_input_suffix_tPRINT RUN ecb_int(60.0 / R, Q)A$ := "CC"FOR L = 1 TO Q  X := 1.0  Y := R  Z := 220   FOR N = X TO Y STEP Z    PRINT TAB(INT((R - N) / 2.0) + 1.0);    FOR M = 1 TO Q      C := 1      FOR A = 1 TO N        IF C > LEN(A$) THEN          PRINT "!";          GOTO 50ENDIF        PRINT MID$(A$, C, 1.0);        C := C + 150       NEXT A      IF M = Q THEN 60      PRINT TAB(INT(R * M + (R - N) / 2.0) + 1.0);    NEXT M60     PRINT   NEXT N  IF X <> 1.0 THEN 95  X := R - 2.0  Y := 1.0  Z := -2  GOTO 2095 NEXT LEND