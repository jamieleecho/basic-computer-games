procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure pizzabase 0DIM I, K, S1: INTEGERA$ := ""I := 0K := 0N$ := ""S := 0.0S1 := 0T := 0.0DIM arr_A(11)FOR tmp_1 = 0 TO 10 \ arr_A(tmp_1) := 0 \ NEXT tmp_1type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(34.0); "PIZZA"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT DIM arr_S$(17), arr_M$(5)FOR tmp_1 = 0 TO 16 \ arr_S$(tmp_1) := "" \ NEXT tmp_1FOR tmp_1 = 0 TO 4 \ arr_M$(tmp_1) := "" \ NEXT tmp_1PRINT "PIZZA DELIVERY GAME"PRINT RUN _ecb_input_prefix_t \ INPUT "WHAT IS YOUR FIRST NAME? ", N$ \ RUN _ecb_input_suffix_tPRINT PRINT "HI, "; N$; ".  IN THIS GAME YOU ARE TO TAKE ORDERS"PRINT "FOR PIZZAS.  THEN YOU ARE TO TELL A DELIVERY BOY"PRINT "WHERE TO DELIVER THE ORDERED PIZZAS."PRINT PRINT FOR I = 1 TO 16  READ arr_S$(I)NEXT IFOR I = 1 TO 4  READ arr_M$(I)NEXT IDATA "A", "B", "C", "D", "E", "F", "G", "H", "I", "J", "K", "L", "M", "N", "O"DATA "P", "1", "2", "3", "4"PRINT "MAP OF THE CITY OF HYATTSVILLE"PRINT PRINT " -----1-----2-----3-----4-----"K := 4FOR I = 1 TO 4  PRINT "-"  PRINT "-"  PRINT "-"  PRINT "-"  PRINT arr_M$(K);  S1 := 16 - 4 * I + 1  PRINT "     "; arr_S$(S1); "     "; arr_S$(S1 + 1.0); "     "; arr_S$(S1 + 2.0); "     ";  PRINT arr_S$(S1 + 3.0); "     "; arr_M$(K)  K := K - 1NEXT IPRINT "-"PRINT "-"PRINT "-"PRINT "-"PRINT " -----1-----2-----3-----4-----"PRINT PRINT "THE OUTPUT IS A MAP OF THE HOMES WHERE"PRINT "YOU ARE TO SEND PIZZAS."PRINT PRINT "YOUR JOB IS TO GIVE A TRUCK DRIVER"PRINT "THE LOCATION OR COORDINATES OF THE"PRINT "HOME ORDERING THE PIZZA."PRINT 520 RUN _ecb_input_prefix_t \ INPUT "DO YOU NEED MORE DIRECTIONS? ", A$ \ RUN _ecb_input_suffix_tIF A$ = "YES" THEN 590IF A$ = "NO" THEN 750PRINT "'YES' OR 'NO' PLEASE, NOW THEN,"GOTO 520590 PRINT PRINT "SOMEBODY WILL ASK FOR A PIZZA TO BE"PRINT "DELIVERED.  THEN A DELIVERY BOY WILL"PRINT "ASK YOU FOR THE LOCATION."PRINT "     EXAMPLE:"PRINT "THIS IS J.  PLEASE SEND A PIZZA."PRINT "DRIVER TO "; N$; ".  WHERE DOES J LIVE?"PRINT "YOUR ANSWER WOULD BE 2,3"PRINT RUN _ecb_input_prefix_t \ INPUT "UNDERSTAND? ", A$ \ RUN _ecb_input_suffix_tIF A$ = "YES" THEN 690PRINT "THIS JOB IS DEFINITELY TOO DIFFICULT FOR YOU. THANKS ANYWAY"GOTO 999690 PRINT "GOOD.  YOU ARE NOW READY TO START TAKING ORDERS."PRINT PRINT "GOOD LUCK!!"PRINT 750 FOR I = 1 TO 5  RUN ecb_int(RND(1.0) * 16.0 + 1.0, S)  PRINT   PRINT "HELLO "; N$; "'S PIZZA.  THIS IS "; arr_S$(INT(S)); ".";  PRINT "  PLEASE SEND A PIZZA."780   PRINT "  DRIVER TO "; N$; ":  WHERE DOES "; arr_S$(INT(S)); " LIVE";  RUN _ecb_input_prefix_t \ INPUT "? ", arr_A(1.0), arr_A(2.0) \ RUN _ecb_input_suffix_t  T := arr_A(1.0) + (arr_A(2.0) - 1.0) * 4.0  IF T = S THEN 920  PRINT "THIS IS "; arr_S$(INT(T)); ".  I DID NOT ORDER A PIZZA."  run ecb_str(arr_A(1.0), tmp_1$) \ run ecb_str(arr_A(2.0), tmp_2$) \ PRINT "I LIVE AT "; tmp_1$; ","; tmp_2$  GOTO 780920   PRINT "HELLO "; N$; ".  THIS IS "; arr_S$(INT(S)); ", THANKS FOR THE PIZZA."NEXT IPRINT RUN _ecb_input_prefix_t \ INPUT "DO YOU WANT TO DELIVER MORE PIZZAS? ", A$ \ RUN _ecb_input_suffix_tIF A$ = "YES" THEN 750PRINT PRINT "O.K. "; N$; ", SEE YOU LATER!"PRINT 999 END