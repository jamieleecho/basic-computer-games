procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure namebase 0DIM I, J, L: INTEGERA$ := ""D$ := ""I := 0J := 0L := 0T$ := ""type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(35.0); "NAME"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT DIM arr_B$(41)FOR tmp_1 = 0 TO 40 \ arr_B$(tmp_1) := "" \ NEXT tmp_1PRINT "HELLO."PRINT "MY NAME IS CREATIVE COMPUTER."PRINT "WHAT'S YOUR NAME (FIRST AND LAST";RUN _ecb_input_prefix_t \ INPUT "? ", A$ \ RUN _ecb_input_suffix_tL := LEN(A$)PRINT PRINT "THANK YOU, ";FOR I = 1 TO Larr_B$(I) := MID$(A$, I, 1.0)NEXT IFOR I = L TO 1 STEP -1PRINT arr_B$(I);NEXT IPRINT "."PRINT "OOPS!  I GUESS I GOT IT BACKWARDS.  A SMART"PRINT "COMPUTER LIKE ME SHOULDN'T MAKE A MISTAKE LIKE THAT!"PRINT PRINT "BUT I JUST NOTICED YOUR LETTERS ARE OUT OF ORDER."PRINT "LET'S PUT THEM IN ORDER LIKE THIS: ";FOR J = 2 TO L  I := J - 1  T$ := arr_B$(J)110   IF T$ > arr_B$(I) THEN 130  arr_B$(I + 1.0) := arr_B$(I)  I := I - 1  IF I > 0.0 THEN 110130 arr_B$(I + 1.0) := T$NEXT JFOR I = 1 TO LPRINT arr_B$(I);NEXT IPRINT PRINT PRINT "DON'T YOU LIKE THAT BETTER";RUN _ecb_input_prefix_t \ INPUT "? ", D$ \ RUN _ecb_input_suffix_tIF D$ = "YES" THEN 180PRINT PRINT "I'M SORRY YOU DON'T LIKE IT THAT WAY."GOTO 200180 PRINT PRINT "I KNEW YOU'D AGREE!!"200 PRINT PRINT "I REALLY ENJOYED MEETING YOU "; A$; "."PRINT "HAVE A NICE DAY!"END