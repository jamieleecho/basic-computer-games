procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure nicomachusbase 0DIM I: INTEGERA := 0.0A$ := ""B := 0.0C := 0.0D := 0.0I := 0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(34.0); "NICOMA"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT PRINT "BOOMERANG PUZZLE FROM ARITHMETICA OF NICOMACHUS -- A.D. 90!"20 PRINT PRINT "PLEASE THINK OF A NUMBER BETWEEN 1 AND 100."PRINT "YOUR NUMBER DIVIDED BY 3 HAS A REMAINDER OF";RUN _ecb_input_prefix_t \ INPUT "? ", A \ RUN _ecb_input_suffix_tPRINT "YOUR NUMBER DIVIDED BY 5 HAS A REMAINDER OF";RUN _ecb_input_prefix_t \ INPUT "? ", B \ RUN _ecb_input_suffix_tPRINT "YOUR NUMBER DIVIDED BY 7 HAS A REMAINDER OF";RUN _ecb_input_prefix_t \ INPUT "? ", C \ RUN _ecb_input_suffix_tPRINT PRINT "LET ME THINK A MOMENT..."PRINT FOR I = 1 TO 1500NEXT ID := 70.0 * A + 21.0 * B + 15.0 * C110 IF D <= 105.0 THEN 140D := D - 105.0GOTO 110140 run ecb_str(D, tmp_1$) \ PRINT "YOUR NUMBER WAS"; tmp_1$; ", RIGHT";160 RUN _ecb_input_prefix_t \ INPUT "? ", A$ \ RUN _ecb_input_suffix_tPRINT IF A$ = "YES" THEN 220IF A$ = "NO" THEN 240PRINT "EH?  I DON'T UNDERSTAND '"; A$; "'  TRY 'YES' OR 'NO'."GOTO 160220 PRINT "HOW ABOUT THAT!!"GOTO 250240 PRINT "I FEEL YOUR ARITHMETIC IS IN ERROR."250 PRINT PRINT "LET'S TRY ANOTHER."GOTO 20END