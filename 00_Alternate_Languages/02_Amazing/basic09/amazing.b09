procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure amazingbase 0DIM C, I, J, Q, S, Z: INTEGERC := 0H := 0.0I := 0J := 0Q := 0R := 0.0S := 0V := 0.0X := 0.0Z := 0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(29.0); "AMAZING PROGRAM"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT PRINT 100 RUN _ecb_input_prefix_t \ INPUT "WHAT ARE YOUR WIDTH AND LENGTH? ", H, V \ RUN _ecb_input_suffix_tIF H <> 1.0 AND V <> 1.0 THEN 110PRINT "MEANINGLESS DIMENSIONS.  TRY AGAIN."GOTO 100110 DIM arr_W(21, 21), arr_V(21, 21): INTEGERFOR tmp_1 = 0 TO 20 \ FOR tmp_2 = 0 TO 20 \ arr_W(tmp_1, tmp_2) := 0 \ NEXT tmp_2 \ NEXT tmp_1FOR tmp_1 = 0 TO 20 \ FOR tmp_2 = 0 TO 20 \ arr_V(tmp_1, tmp_2) := 0 \ NEXT tmp_2 \ NEXT tmp_1PRINT PRINT PRINT PRINT Q := 0Z := 0RUN ecb_int(RND(1.0) * H + 1.0, X)FOR I = 1 TO H  IF I = X THEN 173  PRINT ".--";  GOTO 180173   PRINT ".  ";180 NEXT IPRINT "."C := 1arr_W(INT(X), 1) := CC := C + 1R := XS := 1GOTO 260210 IF R <> H THEN 240IF S <> V THEN 230R := 1.0S := 1GOTO 250230 R := 1.0S := S + 1GOTO 250240 R := R + 1.0250 IF arr_W(INT(R), S) = 0.0 THEN 210260 IF R - 1.0 = 0.0 THEN 530IF arr_W(INT(R - 1.0), S) <> 0.0 THEN 530IF S - 1.0 = 0.0 THEN 390IF arr_W(INT(R), S - 1) <> 0.0 THEN 390IF R = H THEN 330IF arr_W(INT(R + 1.0), S) <> 0.0 THEN 330RUN ecb_int(RND(1.0) * 3.0 + 1.0, X)ON INT(X) GOTO 790, 820, 860330 IF S <> V THEN 340IF Z = 1.0 THEN 370Q := 1GOTO 350340 IF arr_W(INT(R), S + 1) <> 0.0 THEN 370350 RUN ecb_int(RND(1.0) * 3.0 + 1.0, X)ON INT(X) GOTO 790, 820, 910370 RUN ecb_int(RND(1.0) * 2.0 + 1.0, X)ON INT(X) GOTO 790, 820390 IF R = H THEN 470IF arr_W(INT(R + 1.0), S) <> 0.0 THEN 470IF S <> V THEN 420IF Z = 1.0 THEN 450Q := 1GOTO 430420 IF arr_W(INT(R), S + 1) <> 0.0 THEN 450430 RUN ecb_int(RND(1.0) * 3.0 + 1.0, X)ON INT(X) GOTO 790, 860, 910450 RUN ecb_int(RND(1.0) * 2.0 + 1.0, X)ON INT(X) GOTO 790, 860470 IF S <> V THEN 490IF Z = 1.0 THEN 520Q := 1GOTO 500490 IF arr_W(INT(R), S + 1) <> 0.0 THEN 520500 RUN ecb_int(RND(1.0) * 2.0 + 1.0, X)ON INT(X) GOTO 790, 910520 GOTO 790530 IF S - 1.0 = 0.0 THEN 670IF arr_W(INT(R), S - 1) <> 0.0 THEN 670IF R = H THEN 610IF arr_W(INT(R + 1.0), S) <> 0.0 THEN 610IF S <> V THEN 560IF Z = 1.0 THEN 590Q := 1GOTO 570560 IF arr_W(INT(R), S + 1) <> 0.0 THEN 590570 RUN ecb_int(RND(1.0) * 3.0 + 1.0, X)ON INT(X) GOTO 820, 860, 910590 RUN ecb_int(RND(1.0) * 2.0 + 1.0, X)ON INT(X) GOTO 820, 860610 IF S <> V THEN 630IF Z = 1.0 THEN 660Q := 1GOTO 640630 IF arr_W(INT(R), S + 1) <> 0.0 THEN 660640 RUN ecb_int(RND(1.0) * 2.0 + 1.0, X)ON INT(X) GOTO 820, 910660 GOTO 820670 IF R = H THEN 740IF arr_W(INT(R + 1.0), S) <> 0.0 THEN 740IF S <> V THEN 700IF Z = 1.0 THEN 730Q := 1GOTO 710700 IF arr_W(INT(R), S + 1) <> 0.0 THEN 730710 RUN ecb_int(RND(1.0) * 2.0 + 1.0, X)ON INT(X) GOTO 860, 910730 GOTO 860740 IF S <> V THEN 760IF Z = 1.0 THEN 780Q := 1GOTO 770760 IF arr_W(INT(R), S + 1) <> 0.0 THEN 780770 GOTO 910780 GOTO 1000790 arr_W(INT(R - 1.0), S) := CC := C + 1arr_V(INT(R - 1.0), S) := 2R := R - 1.0IF C = H * V + 1.0 THEN 1010Q := 0GOTO 260820 arr_W(INT(R), S - 1) := CC := C + 1arr_V(INT(R), S - 1) := 1S := S - 1IF C = H * V + 1.0 THEN 1010Q := 0GOTO 260860 arr_W(INT(R + 1.0), S) := CC := C + 1IF arr_V(INT(R), S) = 0.0 THEN 880arr_V(INT(R), S) := 3GOTO 890880 arr_V(INT(R), S) := 2890 R := R + 1.0IF C = H * V + 1.0 THEN 1010GOTO 530910 IF Q = 1.0 THEN 960arr_W(INT(R), S + 1) := CC := C + 1IF arr_V(INT(R), S) = 0.0 THEN 940arr_V(INT(R), S) := 3GOTO 950940 arr_V(INT(R), S) := 1950 S := S + 1IF C = H * V + 1.0 THEN 1010GOTO 260960 Z := 1IF arr_V(INT(R), S) = 0.0 THEN 980arr_V(INT(R), S) := 3Q := 0GOTO 1000980 arr_V(INT(R), S) := 1Q := 0R := 1.0S := 1GOTO 2501000 GOTO 2101010 IF Z = 1.0 THEN 1015RUN ecb_int(RND(1.0) * H + 1.0, X)IF arr_V(INT(X), INT(V)) = 0.0 THEN 1014arr_V(INT(X), INT(V)) := 3GOTO 10151014 arr_V(INT(X), INT(V)) := 11015 FOR J = 1 TO V  PRINT "I";  FOR I = 1 TO H    IF arr_V(I, J) < 2.0 THEN 1030    PRINT "   ";    GOTO 10401030     PRINT "  I";1040   NEXT I  PRINT   FOR I = 1 TO H    IF arr_V(I, J) = 0.0 THEN 1060    IF arr_V(I, J) = 2.0 THEN 1060    PRINT ":  ";    GOTO 10701060     PRINT ":--";1070   NEXT I  PRINT "."NEXT JEND