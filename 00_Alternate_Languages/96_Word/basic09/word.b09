procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure wordbase 0DIM G, I, J, M, Q: INTEGERA$ := ""C := 0.0G := 0I := 0J := 0L$ := ""M := 0N := 0.0P$ := ""Q := 0Q$ := ""S$ := ""type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(34.0); "WORD"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT DIM arr_S(8), arr_A(8), arr_L(8), arr_P(8): INTEGERFOR tmp_1 = 0 TO 7 \ arr_S(tmp_1) := 0 \ NEXT tmp_1FOR tmp_1 = 0 TO 7 \ arr_A(tmp_1) := 0 \ NEXT tmp_1FOR tmp_1 = 0 TO 7 \ arr_L(tmp_1) := 0 \ NEXT tmp_1FOR tmp_1 = 0 TO 7 \ arr_P(tmp_1) := 0 \ NEXT tmp_1DIM arr_D(8)FOR tmp_1 = 0 TO 7 \ arr_D(tmp_1) := 0 \ NEXT tmp_1PRINT "I AM THINKING OF A WORD -- YOU GUESS IT.  I WILL GIVE YOU"PRINT "CLUES TO HELP YOU GET IT.  GOOD LUCK!!"PRINT PRINT (* *)30 PRINT PRINT PRINT "YOU ARE STARTING A NEW GAME..."RESTOREREAD NRUN ecb_int(RND(1.0) * N + 1.0, C)FOR I = 1 TO C  READ S$NEXT IG := 0arr_S(0) := LEN(S$)FOR I = 1 TO LEN(S$)arr_S(I) := ASC(MID$(S$, I, 1.0))NEXT IFOR I = 1 TO 5  arr_A(I) := 45NEXT IFOR J = 1 TO 5  arr_P(J) := 0NEXT J150 PRINT "GUESS A FIVE LETTER WORD";RUN _ecb_input_prefix_t \ INPUT "? ", L$ \ RUN _ecb_input_suffix_tG := G + 1IF S$ = L$ THEN 500FOR I = 1 TO 7arr_P(I) := 0NEXT Iarr_L(0) := LEN(L$)FOR I = 1 TO LEN(L$)arr_L(I) := ASC(MID$(L$, I, 1.0))NEXT IIF arr_L(1) = 63.0 THEN 300IF arr_L(0) <> 5.0 THEN 400M := 0Q := 1FOR I = 1 TO 5  FOR J = 1 TO 5    IF arr_S(I) <> arr_L(J) THEN 260    arr_P(Q) := arr_L(J)    Q := Q + 1    IF I <> J THEN 250    arr_A(J) := arr_L(J)250     M := M + 1260   NEXT JNEXT Iarr_A(0) := 5arr_P(0) := MA$ := ""FOR I = 1 TO arr_A(0)A$ := A$ + CHR$(arr_A(I))NEXT IP$ := ""FOR I = 1 TO arr_P(0)P$ := P$ + CHR$(arr_P(I))NEXT Irun ecb_str(float(M), tmp_1$) \ PRINT "THERE WERE"; tmp_1$; "MATCHES AND THE COMMON LETTERS WERE..."; P$PRINT "FROM THE EXACT LETTER MATCHES, YOU KNOW................"; A$IF A$ = S$ THEN 500IF M > 1.0 THEN 289PRINT PRINT "IF YOU GIVE UP, TYPE '?' FOR YOUR NEXT GUESS."289 PRINT GOTO 150300 S$ := ""FOR I = 1 TO 7S$ := S$ + CHR$(arr_S(I))NEXT IPRINT "THE SECRET WORD IS "; S$PRINT GOTO 30400 PRINT "YOU MUST GUESS A 5 LETTER WORD.  START AGAIN."PRINT G := G - 1GOTO 150500 run ecb_str(float(G), tmp_1$) \ PRINT "YOU HAVE GUESSED THE WORD.  IT TOOK"; tmp_1$; "GUESSES!"PRINT RUN _ecb_input_prefix_t \ INPUT "WANT TO PLAY AGAIN? ", Q$ \ RUN _ecb_input_suffix_tIF Q$ = "YES" THEN 30DATA 12.0, "DINKY", "SMOKE", "WATER", "GRASS", "TRAIN", "MIGHT", "FIRST"DATA "CANDY", "CHAMP", "WOULD", "CLUMP", "DOPEY"END