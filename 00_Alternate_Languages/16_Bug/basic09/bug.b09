procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure bugbase 0DIM A, B, C, DE, H, L, N, P, Q, R, S, T, U, V, Y: INTEGERA := 0B := 0C := 0DE := 0H := 0L := 0N := 0P := 0Q := 0R := 0S := 0T := 0U := 0V := 0X := 0.0Y := 0Z := 0.0Z$ := ""type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(35.0); "BUG"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT (* *)A := 0B := 0H := 0L := 0N := 0P := 0Q := 0R := 0S := 0T := 0U := 0V := 0Y := 0PRINT "THE GAME BUG"PRINT "I HOPE YOU ENJOY THIS GAME."PRINT PRINT "DO YOU WANT INSTRUCTIONS";RUN _ecb_input_prefix_t \ INPUT "? ", Z$ \ RUN _ecb_input_suffix_tIF Z$ = "NO" THEN 300PRINT "THE OBJECT OF BUG IS TO FINISH YOUR BUG BEFORE I FINISH"PRINT "MINE. EACH NUMBER STANDS FOR A PART OF THE BUG BODY."PRINT "I WILL ROLL THE DIE FOR YOU, TELL YOU WHAT I ROLLED FOR YOU"PRINT "WHAT THE NUMBER STANDS FOR, AND IF YOU CAN GET THE PART."PRINT "IF YOU CAN GET THE PART I WILL GIVE IT TO YOU."PRINT "THE SAME WILL HAPPEN ON MY TURN."PRINT "IF THERE IS A CHANGE IN EITHER BUG I WILL GIVE YOU THE"PRINT "OPTION OF SEEING THE PICTURES OF THE BUGS."PRINT "THE NUMBERS STAND FOR PARTS AS FOLLOWS:"PRINT "NUMBER", "PART", "NUMBER OF PART NEEDED"PRINT "1", "BODY", "1"PRINT "2", "NECK", "1"PRINT "3", "HEAD", "1"PRINT "4", "FEELERS", "2"PRINT "5", "TAIL", "1"PRINT "6", "LEGS", "6"PRINT PRINT 300 IF Y > 0.0 THEN 2480RUN ecb_int(6.0 * RND(1.0) + 1.0, Z)C := 1run ecb_str(Z, tmp_1$) \ PRINT "YOU ROLLED A"; tmp_1$ON INT(Z) GOTO 350, 430, 540, 650, 760, 870350 PRINT "1=BODY"IF B = 1.0 THEN 410PRINT "YOU NOW HAVE A BODY."B := 1C := 0GOTO 970410 PRINT "YOU DO NOT NEED A BODY."GOTO 970430 PRINT "2=NECK"IF N = 1.0 THEN 500IF B = 0.0 THEN 520PRINT "YOU NOW HAVE A NECK."N := 1C := 0GOTO 970500 PRINT "YOU DO NOT NEED A NECK."GOTO 970520 PRINT "YOU DO NOT HAVE A BODY."GOTO 970540 PRINT "3=HEAD"IF N = 0.0 THEN 610IF H = 1.0 THEN 630PRINT "YOU NEEDED A HEAD."H := 1C := 0GOTO 970610 PRINT "YOU DO NOT HAVE A NECK."GOTO 970630 PRINT "YOU HAVE A HEAD."GOTO 970650 PRINT "4=FEELERS"IF H = 0.0 THEN 740IF A = 2.0 THEN 720PRINT "I NOW GIVE YOU A FEELER."A := A + 1C := 0GOTO 970720 PRINT "YOU HAVE TWO FEELERS ALREADY."GOTO 970740 PRINT "YOU DO NOT HAVE A HEAD."GOTO 970760 PRINT "5=TAIL"IF B = 0.0 THEN 830IF T = 1.0 THEN 850PRINT "I NOW GIVE YOU A TAIL."T := T + 1C := 0GOTO 970830 PRINT "YOU DO NOT HAVE A BODY."GOTO 970850 PRINT "YOU ALREADY HAVE A TAIL."GOTO 970870 PRINT "6=LEG"IF L = 6.0 THEN 940IF B = 0.0 THEN 960L := L + 1C := 0run ecb_str(float(L), tmp_1$) \ PRINT "YOU NOW HAVE"; tmp_1$; "LEGS."GOTO 970940 PRINT "YOU HAVE 6 FEET ALREADY."GOTO 970960 PRINT "YOU DO NOT HAVE A BODY."970 RUN ecb_int(6.0 * RND(1.0) + 1.0, X)PRINT FOR DE = 1 TO 2000NEXT DErun ecb_str(X, tmp_1$) \ PRINT "I ROLLED A"; tmp_1$ON INT(X) GOTO 1000, 1080, 1190, 1300, 1410, 15201000 PRINT "1=BODY"IF P = 1.0 THEN 1060PRINT "I NOW HAVE A BODY."C := 0P := 1GOTO 16301060 PRINT "I DO NOT NEED A BODY."GOTO 16301080 PRINT "2=NECK"IF Q = 1.0 THEN 1150IF P = 0.0 THEN 1170PRINT "I NOW HAVE A NECK."Q := 1C := 0GOTO 16301150 PRINT "I DO NOT NEED A NECK."GOTO 16301170 PRINT "I DO NOT HAVE A BODY."GOTO 16301190 PRINT "3=HEAD"IF Q = 0.0 THEN 1260IF R = 1.0 THEN 1280PRINT "I NEEDED A HEAD."R := 1C := 0GOTO 16301260 PRINT "I DO NOT HAVE A NECK."GOTO 16301280 PRINT "I DO NOT NEED A HEAD."GOTO 16301300 PRINT "4=FEELERS"IF R = 0.0 THEN 1390IF S = 2.0 THEN 1370PRINT "I GET A FEELER."S := S + 1C := 0GOTO 16301370 PRINT "I HAVE 2 FEELERS ALREADY."GOTO 16301390 PRINT "I DO NOT HAVE A HEAD."GOTO 16301410 PRINT "5=TAIL"IF P = 0.0 THEN 1480IF U = 1.0 THEN 1500PRINT "I NOW HAVE A TAIL."U := 1C := 0GOTO 16301480 PRINT "I DO NOT HAVE A BODY."GOTO 16301500 PRINT "I DO NOT NEED A TAIL."GOTO 16301520 PRINT "6=LEGS"IF V = 6.0 THEN 1590IF P = 0.0 THEN 1610V := V + 1C := 0run ecb_str(float(V), tmp_1$) \ PRINT "I NOW HAVE"; tmp_1$; "LEGS."GOTO 16301590 PRINT "", "I HAVE 6 FEET."GOTO 16301610 PRINT "I DO NOT HAVE A BODY."GOTO 16301630 IF A = 2.0 AND T = 1.0 AND L = 6.0 THEN 1650GOTO 16701650 PRINT "YOUR BUG IS FINISHED."Y := Y + 11670 IF S = 2.0 AND P = 1.0 AND V = 6.0 THEN 1690GOTO 17101690 PRINT "MY BUG IS FINISHED."Y := Y + 21710 IF C = 1.0 THEN 300PRINT "DO YOU WANT THE PICTURES";RUN _ecb_input_prefix_t \ INPUT "? ", Z$ \ RUN _ecb_input_suffix_tIF Z$ = "NO" THEN 300PRINT "*****YOUR BUG*****"PRINT PRINT IF A = 0.0 THEN 1860FOR Z = 1.0 TO 4.0  FOR X = 1.0 TO A    PRINT TAB(11.0);    PRINT "A ";  NEXT X  PRINT NEXT Z1860 IF H = 0.0 THEN 1880GOSUB 24701880 IF N = 0.0 THEN 1920FOR Z = 1.0 TO 2.0  PRINT "          N N"NEXT Z1920 IF B = 0.0 THEN 2000PRINT "     BBBBBBBBBBBB"FOR Z = 1.0 TO 2.0  PRINT "     B          B"NEXT ZIF T <> 1.0 THEN 1990PRINT "TTTTTB          B"1990 PRINT "     BBBBBBBBBBBB"2000 IF L = 0.0 THEN 2080FOR Z = 1.0 TO 2.0  PRINT TAB(6.0);  FOR X = 1.0 TO L    PRINT " L";  NEXT X  PRINT NEXT Z2080 FOR Z = 1.0 TO 4.0  PRINT NEXT ZPRINT "*****MY BUG*****"PRINT PRINT PRINT IF S = 0.0 THEN 2230FOR Z = 1.0 TO 4.0  PRINT TAB(11.0);  FOR X = 1.0 TO S    PRINT "F ";  NEXT X  PRINT NEXT Z2230 IF R <> 1.0 THEN 2250GOSUB 24702250 IF Q = 0.0 THEN 2280PRINT "          N N"PRINT "          N N"2280 IF P = 0.0 THEN 2360PRINT "     BBBBBBBBBBBB"FOR Z = 1.0 TO 2.0  PRINT "     B          B"NEXT ZIF U <> 1.0 THEN 2350PRINT "TTTTTB          B"2350 PRINT "     BBBBBBBBBBBB"2360 IF V = 0.0 THEN 2450FOR Z = 1.0 TO 2.0  PRINT TAB(6.0);  FOR X = 1.0 TO V    PRINT " L";  NEXT X  PRINT NEXT Z2450 IF Y <> 0.0 THEN 2540GOTO 3002470 PRINT "        HHHHHHH"2480 PRINT "        H     H"PRINT "        H O O H"PRINT "        H     H"PRINT "        H  V  H"PRINT "        HHHHHHH"RETURN2540 PRINT "I HOPE YOU ENJOYED THE GAME, PLAY IT AGAIN SOON!!"END