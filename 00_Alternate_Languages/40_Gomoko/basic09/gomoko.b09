procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure gomokobase 0DIM E, F, L: INTEGERE := 0F := 0I := 0.0J := 0.0L := 0N := 0.0Q := 0.0X := 0.0Y := 0.0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(34.0); "GOMOKO"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT DIM arr_A(20, 20): INTEGERFOR tmp_1 = 0 TO 19 \ FOR tmp_2 = 0 TO 19 \ arr_A(tmp_1, tmp_2) := 0 \ NEXT tmp_2 \ NEXT tmp_1PRINT "WELCOME TO THE ORIENTAL GAME OF GOMOKO."PRINT PRINT "THE GAME IS PLAYED ON AN N BY N GRID OF A SIZE"PRINT "THAT YOU SPECIFY.  DURING YOUR PLAY, YOU MAY COVER ONE GRID"PRINT "INTERSECTION WITH A MARKER. THE OBJECT OF THE GAME IS TO GET"PRINT "5 ADJACENT MARKERS IN A ROW -- HORIZONTALLY, VERTICALLY, OR"PRINT "DIAGONALLY.  ON THE BOARD DIAGRAM, YOUR MOVES ARE MARKED"PRINT "WITH A '1' AND THE COMPUTER MOVES WITH A '2'."PRINT PRINT "THE COMPUTER DOES NOT KEEP TRACK OF WHO HAS WON."PRINT "TO END THE GAME, TYPE -1,-1 FOR YOUR MOVE."PRINT 110 PRINT "WHAT IS YOUR BOARD SIZE (MIN 7/ MAX 19)";RUN _ecb_input_prefix_t \ INPUT "? ", N \ RUN _ecb_input_suffix_tIF N > 6.0 THEN 117GOTO 120117 IF N < 20.0 THEN 210120 PRINT "I SAID, THE MINIMUM IS 7, THE MAXIMUM IS 19."GOTO 110210 FOR I = 1.0 TO NFOR J = 1.0 TO Narr_A(INT(I), INT(J)) := 0NEXT JNEXT IPRINT PRINT "WE ALTERNATE MOVES.  YOU GO FIRST..."PRINT 310 PRINT "YOUR PLAY (I,J)";RUN _ecb_input_prefix_t \ INPUT "? ", I, J \ RUN _ecb_input_suffix_tPRINT IF I = -1.0 THEN 980X := IY := JGOSUB 910IF L = 1.0 THEN 410PRINT "ILLEGAL MOVE.  TRY AGAIN..."GOTO 310410 IF arr_A(INT(I), INT(J)) = 0.0 THEN 440PRINT "SQUARE OCCUPIED.  TRY AGAIN..."GOTO 310440 arr_A(INT(I), INT(J)) := 1(* *** COMPUTER TRIES AN INTELLIGENT MOVE *** *)  FOR E = -1 TO 1  FOR F = -1 TO 1    IF E + F - E * F = 0.0 THEN 590    X := I + E    Y := J + F    GOSUB 910    IF L = 0.0 THEN 590    IF arr_A(INT(X), INT(Y)) = 1.0 THEN 710590 NEXT FNEXT E(* *** COMPUTER TRIES A RANDOM MOVE *** *)610 RUN ecb_int(N * RND(1.0) + 1.0, X)RUN ecb_int(N * RND(1.0) + 1.0, Y)GOSUB 910IF L = 0.0 THEN 610650 IF arr_A(INT(X), INT(Y)) <> 0.0 THEN 610arr_A(INT(X), INT(Y)) := 2GOSUB 810GOTO 310710 X := I - EY := J - FGOSUB 910IF L = 0.0 THEN 610GOTO 650(* *** PRINT THE BOARD *** *)810   FOR I = 1.0 TO N  FOR J = 1.0 TO N    run ecb_str(float(arr_A(INT(I), INT(J))), tmp_1$) \ PRINT tmp_1$;NEXT JPRINT NEXT IPRINT RETURN910 L := 1IF X < 1.0 THEN 970IF X > N THEN 970IF Y < 1.0 THEN 970IF Y > N THEN 970RETURN970 L := 0RETURN980 PRINT PRINT "THANKS FOR THE GAME!!"PRINT "PLAY AGAIN (1 FOR YES, 0 FOR NO)";RUN _ecb_input_prefix_t \ INPUT "? ", Q \ RUN _ecb_input_suffix_tIF Q = 1.0 THEN 110END