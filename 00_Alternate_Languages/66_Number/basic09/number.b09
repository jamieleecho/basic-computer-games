procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure numberbase 0DIM R, S, T, U, V, fnR_1: INTEGERG := 0.0P := 0.0R := 0S := 0T := 0U := 0V := 0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(34.0); "NUMBER"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT PRINT "YOU HAVE 100 POINTS.  BY GUESSING NUMBERS FROM 1 TO 5, YOU"PRINT "CAN GAIN OR LOSE POINTS DEPENDING UPON HOW CLOSE YOU GET TO"PRINT "A RANDOM NUMBER SELECTED BY THE COMPUTER."PRINT PRINT "YOU OCCASIONALLY WILL GET A JACKPOT WHICH WILL DOUBLE(!)"PRINT "YOUR POINT COUNT.  YOU WIN WHEN YOU GET 500 POINTS."PRINT P := 100.0(* DEF FNR(X)=INT(5*RND(1)+1) *)12 RUN _ecb_input_prefix_t \ INPUT "GUESS A NUMBER FROM 1 TO 5? ", G \ RUN _ecb_input_suffix_tfnR_1 := 1 \ RUN ecb_int(5.0 * RND(1.0) + 1.0, tmp_1) \ R := tmp_1fnR_1 := 1 \ RUN ecb_int(5.0 * RND(1.0) + 1.0, tmp_1) \ S := tmp_1fnR_1 := 1 \ RUN ecb_int(5.0 * RND(1.0) + 1.0, tmp_1) \ T := tmp_1fnR_1 := 1 \ RUN ecb_int(5.0 * RND(1.0) + 1.0, tmp_1) \ U := tmp_1fnR_1 := 1 \ RUN ecb_int(5.0 * RND(1.0) + 1.0, tmp_1) \ V := tmp_1IF G = R THEN 30IF G = S THEN 40IF G = T THEN 50IF G = U THEN 60IF G = V THEN 70IF G > 5.0 THEN 1230 P := P - 5.0GOTO 8040 P := P + 5.0GOTO 8050 P := P + PPRINT "YOU HIT THE JACKPOT!!!"GOTO 8060 P := P + 1.0GOTO 8070 P := P - (P * 0.5)80 IF P > 500.0 THEN 90run ecb_str(P, tmp_1$) \ PRINT "YOU HAVE"; tmp_1$; "POINTS."PRINT GOTO 1290 run ecb_str(P, tmp_1$) \ PRINT "!!!!YOU WIN!!!! WITH "; tmp_1$; "POINTS."END