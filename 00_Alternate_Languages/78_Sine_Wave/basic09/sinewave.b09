procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure sinewavebase 0DIM B: INTEGERA := 0.0B := 0T := 0.0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(31.0); "SINE WAVE"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT PRINT PRINT (*ARKABLE PROGRAM BY DAVID AHL *)B := 0(*  START LONG LOOP *)FOR T = 0.0 TO 40.0 STEP 0.25  RUN ecb_int(26.0 + 25.0 * SIN(T), A)  PRINT TAB(INT(A) + 1.0);  IF B = 1.0 THEN 180  PRINT "CREATIVE"  B := 1  GOTO 200180   PRINT "COMPUTING"  B := 0200 NEXT TEND