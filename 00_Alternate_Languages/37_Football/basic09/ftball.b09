procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure ftballbase 0DIM D, E, F, I, T, fnF_1, fnG_1: INTEGERA := 0.0A$ := ""D := 0E := 0F := 0I := 0P := 0.0P3 := 0.0R := 0.0R1 := 0.0T := 0X := 0.0X1 := 0.0X3 := 0.0Y := 0.0Y1 := 0.0Z := 0.0DIM arr_O$(11)FOR tmp_1 = 0 TO 10 \ arr_O$(tmp_1) := "" \ NEXT tmp_1DIM arr_S(11): INTEGERFOR tmp_1 = 0 TO 10 \ arr_S(tmp_1) := 0 \ NEXT tmp_1type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(34.0); "FTBALL"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT "THIS IS DARTMOUTH CHAMPIONSHIP FOOTBALL."PRINT PRINT "YOU WILL QUARTERBACK DARTMOUTH. CALL PLAYS AS FOLLOWS:"PRINT "1= SIMPLE RUN; 2= TRICKY RUN; 3= SHORT PASS;"PRINT "4= LONG PASS; 5= PUNT; 6= QUICK KICK; 7= PLACE KICK."PRINT PRINT "CHOOSE YOUR OPPONENT";RUN _ecb_input_prefix_t \ INPUT "? ", arr_O$(1.0) \ RUN _ecb_input_suffix_tarr_O$(0.0) := "DARTMOUTH"PRINT LET arr_S(0) := 0LET arr_S(1) := 0(* *)DIM arr_L$(21)FOR tmp_1 = 0 TO 20 \ arr_L$(tmp_1) := "" \ NEXT tmp_1FOR I = 1 TO 20READ arr_L$(I)NEXT IDATA "KICK", "RECEIVE", " YARD ", "RUN BACK FOR ", "BALL ON "DATA "YARD LINE", " SIMPLE RUN", " TRICKY RUN", " SHORT PASS"DATA " LONG PASS", "PUNT", " QUICK KICK ", " PLACE KICK", " LOSS "DATA " NO GAIN", "GAIN ", " TOUCHDOWN ", " TOUCHBACK ", "SAFETY***"DATA "JUNK"RUN ecb_int(RND(1.0) * 2.0, P)PRINT arr_O$(INT(P)); " WON THE TOSS"(* DEF FNF(X)=1-2*P *)(* DEF FNG(Z)=P*(X1-X)+(1-P)*(X-X1) *)IF P = 0.0 THEN 470PRINT arr_O$(1.0); " ELECTS TO RECEIVE."PRINT GOTO 580470 PRINT "DO YOU ELECT TO KICK OR RECEIVE";480 RUN _ecb_input_prefix_t \ INPUT "? ", A$ \ RUN _ecb_input_suffix_tPRINT FOR E = 1 TO 2  IF A$ = arr_L$(E) THEN 550NEXT EPRINT "INCORRECT ANSWER.  PLEASE TYPE 'KICK' OR 'RECEIVE'";GOTO 480550 IF E = 2.0 THEN 580LET P := 1.0580 LET X := 40.0 + (1.0 - P) * 20.0590 RUN ecb_int(200.0 * (RND(1.0) - 0.5) ^ 3.0 + 55.0, Y)run ecb_str(Y, tmp_1$) \ PRINT tmp_1$; arr_L$(3.0); " KICKOFF"fnF_1 := 1 \ LET X := X - (1.0 - 2.0 * P) * YIF ABS(X - 50.0) >= 50.0 THEN 700630 RUN ecb_int(50.0 * RND(1.0) ^ 2.0, tmp_1) \ RUN ecb_int(50.0 * RND(1.0) ^ 4.0, tmp_2) \ LET Y := tmp_1 + (1.0 - P) * tmp_2fnF_1 := 1 \ LET X := X + (1.0 - 2.0 * P) * YIF ABS(X - 50.0) >= 50.0 THEN 655run ecb_str(Y, tmp_1$) \ PRINT tmp_1$; arr_L$(3.0); " RUNBACK"GOTO 720655 PRINT arr_L$(4.0);GOTO 2600700 PRINT "TOUCHBACK FOR "; arr_O$(INT(P)); "."LET X := 20.0 + P * 60.0720 (* FIRST DOWN *)GOSUB 800740 LET X1 := XLET D := 1PRINT PRINT "FIRST DOWN "; arr_O$(INT(P)); "***"PRINT PRINT GOTO 860800 (* PRINT POSITION *)IF X > 50.0 THEN 840run ecb_str(X, tmp_1$) \ PRINT arr_L$(5.0); arr_O$(0.0); tmp_1$; arr_L$(6.0)GOTO 850840 PRINT arr_L$(5.0); arr_O$(1.0); 100.0 - X; arr_L$(6.0)850 RETURN860 (* NEW PLAY *)LET T := T + 1IF T = 30.0 THEN 1060IF T < 50.0 THEN 940IF RND(1.0) > 0.2 THEN 940PRINT "END OF GAME  ***"run ecb_str(float(arr_S(0)), tmp_1$) \ run ecb_str(float(arr_S(1)), tmp_2$) \ PRINT "FINAL SCORE:  "; arr_O$(0.0); ": "; tmp_1$; "  "; arr_O$(1.0); ": "; tmp_2$STOP940 IF P = 1.0 THEN 1870PRINT "NEXT PLAY";960 RUN _ecb_input_prefix_t \ INPUT "? ", Z \ RUN _ecb_input_suffix_tRUN ecb_int(Z, tmp_1) \ IF Z <> tmp_1 THEN 990IF ABS(Z - 4.0) <= 3.0 THEN 1010990 PRINT "ILLEGAL PLAY NUMBER, RETYPE";GOTO 9601010 LET F := 0PRINT arr_L$(INT(Z + 6.0)); ".  ";fnF_1 := 1 \ LET R := RND(1.0) * (0.98 + (1.0 - 2.0 * P) * 0.02)LET R1 := RND(1.0)ON INT(Z) GOTO 1110, 1150, 1260, 1480, 1570, 1570, 16801060 (*  JEAN'S SPECIAL *)IF RND(1.0) > 1.0 / 3.0 THEN 940PRINT "GAME DELAYED.  DOG ON FIELD."PRINT GOTO 9401110 (*  SIMPLE RUN *)RUN ecb_int(24.0 * (R - 0.5) ^ 3.0 + 3.0, Y)IF RND(1.0) < 0.05 THEN 1180GOTO 21901150 (*  TRICKY RUN *)RUN ecb_int(20.0 * R - 5.0, Y)IF RND(1.0) > 0.1 THEN 21901180 LET F := -1LET X3 := XfnF_1 := 1 \ LET X := X + (1.0 - 2.0 * P) * YIF ABS(X - 50.0) >= 50.0 THEN 1240PRINT "***  FUMBLE AFTER ";GOTO 22301240 PRINT "***  FUMBLE."GOTO 24501260 (*  SHORT PASS *)RUN ecb_int(60.0 * (R1 - 0.5) ^ 3.0 + 10.0, Y)IF R < 0.05 THEN 1330IF R < 0.15 THEN 1390IF R < 0.55 THEN 14201310 PRINT "COMPLETE.  ";GOTO 21901330 IF D = 4.0 THEN 1420PRINT "INTERCEPTED."1350 LET F := -1fnF_1 := 1 \ LET X := X + (1.0 - 2.0 * P) * YIF ABS(X - 50.0) >= 50.0 THEN 2450GOTO 23001390 PRINT "PASSER TACKLED.  ";RUN ecb_int(10.0 * R1, tmp_1) \ LET Y := - tmp_1GOTO 21901420 LET Y := 0.0IF RND(1.0) < 0.3 THEN 1460PRINT "INCOMPLETE.  ";GOTO 21901460 PRINT "BATTED DOWN.  ";GOTO 21901480 (*  LONG PASS *)RUN ecb_int(160.0 * (R1 - 0.5) ^ 3.0 + 30.0, Y)IF R < 0.1 THEN 1330IF R < 0.3 THEN 1540IF R < 0.75 THEN 1420GOTO 13101540 PRINT "PASSER TACKLED.  ";RUN ecb_int(15.0 * R1 + 3.0, tmp_1) \ LET Y := - tmp_1GOTO 21901570 (*  PUNT OR KICK *)RUN ecb_int(100.0 * (R - 0.5) ^ 3.0 + 35.0, Y)IF D = 4.0 THEN 1610RUN ecb_int(Y * 1.3, Y)1610 run ecb_str(Y, tmp_1$) \ PRINT tmp_1$; arr_L$(3.0); " PUNT"fnF_1 := 1 \ IF ABS(X + Y * (1.0 - 2.0 * P) - 50.0) >= 50.0 THEN 1670IF D < 4.0 THEN 1670RUN ecb_int(R1 ^ 2.0 * 20.0, Y1)run ecb_str(Y1, tmp_1$) \ PRINT tmp_1$; arr_L$(3.0); " RUN BACK"LET Y := Y - Y11670 GOTO 13501680 (*  PLACE KICK *)RUN ecb_int(100.0 * (R - 0.5) ^ 3.0 + 35.0, Y)IF R1 > 0.15 THEN 1750PRINT "KICK IS BLOCKED  ***"fnF_1 := 1 \ LET X := X - 5.0 * (1.0 - 2.0 * P)LET P := 1.0 - PGOTO 7201750 fnF_1 := 1 \ LET X := X + (1.0 - 2.0 * P) * YIF ABS(X - 50.0) >= 60.0 THEN 1810PRINT "KICK IS SHORT."IF ABS(X - 50.0) >= 50.0 THEN 2710P := 1.0 - PGOTO 6301810 IF R1 > 0.5 THEN 1840PRINT "KICK IS OFF TO THE SIDE."GOTO 27101840 PRINT "FIELD GOAL ***"LET arr_S(INT(P)) := arr_S(INT(P)) + 3GOTO 26401870 (*  OPPONENT'S PLAY *)IF D > 1.0 THEN 19401890 IF RND(1.0) > 1.0 / 3.0 THEN 1920LET Z := 3.0GOTO 10101920 LET Z := 1.0GOTO 10101940 IF D = 4.0 THEN 2090IF 10.0 + X - X1 < 5.0 THEN 1890IF X < 5.0 THEN 1890IF X <= 10.0 THEN 2160IF X > X1 THEN 20201990 RUN ecb_int(2.0 * RND(1.0), A)LET Z := 2.0 + A * 2.0GOTO 10102020 IF D < 3.0 THEN 1990IF X < 45.0 THEN 1990IF RND(1.0) > 1.0 / 4.0 THEN 2070LET Z := 6.0GOTO 10102070 LET Z := 4.0GOTO 10102090 IF X > 30.0 THEN 2140IF 10.0 + X - X1 < 3.0 THEN 1890IF X < 3.0 THEN 1890LET Z := 7.0GOTO 10102140 LET Z := 5.0GOTO 10102160 RUN ecb_int(2.0 * RND(1.0), A)LET Z := 2.0 + AGOTO 10102190 (* GAIN OR LOSS *)LET X3 := XfnF_1 := 1 \ LET X := X + (1.0 - 2.0 * P) * YIF ABS(X - 50.0) >= 50.0 THEN 24502230 IF Y = 0.0 THEN 2250run ecb_str(ABS(Y), tmp_1$) \ PRINT tmp_1$; arr_L$(3.0);2250 PRINT arr_L$(15.0 + SGN(Y))IF ABS(X3 - 50.0) > 40.0 THEN 2300IF RND(1.0) < 0.1 THEN 28602300 GOSUB 800IF F = 0.0 THEN 23402320 LET P := 1.0 - PGOTO 7402340 fnG_1 := 1 \ IF (P * (X1 - X) + (1.0 - P) * (X - X1)) >= 10.0 THEN 740IF D = 4.0 THEN 2320LET D := D + 1run ecb_str(float(D), tmp_1$) \ PRINT "DOWN: "; tmp_1$; "     ";fnF_1 := 1 \ IF (X1 - 50.0) * (1.0 - 2.0 * P) < 40.0 THEN 2410PRINT "GOAL TO GO"GOTO 24202410 fnG_1 := 1 \ PRINT "YARDS TO GO: "; 10.0 - (P * (X1 - X) + (1.0 - P) * (X - X1))2420 PRINT PRINT GOTO 8602450 (* BALL IN END-ZONE *)IF X >= 100.0 THEN 2490LET E := 0GOTO 25002490 LET E := 12500 ON INT(1.0 + E - F * 2.0 + P * 4.0) GOTO 2510, 2590, 2760, 2710, 2590, 2510, 2710, 27602510 (* SAFETY *)LET arr_S(INT(1.0 - P)) := arr_S(INT(1.0 - P)) + 2PRINT arr_L$(19.0)GOSUB 2800PRINT arr_O$(INT(P)); " KICKS OFF FROM ITS 20 YARD LINE."LET X := 20.0 + P * 60.0LET P := 1.0 - PGOTO 5902590 (* OFFENSIVE TD *)2600 PRINT arr_L$(17.0); "***"IF RND(1.0) > 0.8 THEN 2680LET arr_S(INT(P)) := arr_S(INT(P)) + 7PRINT "KICK IS GOOD."2640 GOSUB 2800PRINT arr_O$(INT(P)); " KICKS OFF"LET P := 1.0 - PGOTO 5802680 PRINT "KICK IS OFF TO THE SIDE"LET arr_S(INT(P)) := arr_S(INT(P)) + 6GOTO 26402710 (* TOUCHBACK *)PRINT arr_L$(18.0)LET P := 1.0 - PLET X := 20.0 + P * 60.0GOTO 7202760 (* DEFENSIVE TD *)PRINT arr_L$(17.0); "FOR "; arr_O$(INT(1.0 - P)); "***"LET P := 1.0 - PGOTO 26002800 (* SCORE *)PRINT run ecb_str(float(arr_S(0)), tmp_1$) \ run ecb_str(float(arr_S(1)), tmp_2$) \ PRINT "SCORE:  "; tmp_1$; " TO "; tmp_2$PRINT PRINT RETURN2860 (* PENALTY *)RUN ecb_int(2.0 * RND(1.0), P3)PRINT arr_O$(INT(P3)); " OFFSIDES -- PENALTY OF 5 YARDS."PRINT PRINT IF P3 = 0.0 THEN 2980PRINT "DO YOU ACCEPT THE PENALTY";2930 RUN _ecb_input_prefix_t \ INPUT "? ", A$ \ RUN _ecb_input_suffix_tIF A$ = "NO" THEN 2300IF A$ = "YES" THEN 3110PRINT "TYPE 'YES' OR 'NO'";GOTO 29302980 (* OPPONENT'S STRATEGY ON PENALTY *)IF P = 1.0 THEN 3040IF Y <= 0.0 THEN 3080IF F < 0.0 THEN 3080fnG_1 := 1 \ IF (P * (X1 - X) + (1.0 - P) * (X - X1)) < 3.0 * D - 2.0 THEN 3080GOTO 31003040 IF Y <= 5.0 THEN 3100IF F < 0.0 THEN 3100IF D < 4.0 THEN 3080fnG_1 := 1 \ IF (P * (X1 - X) + (1.0 - P) * (X - X1)) < 10.0 THEN 31003080 PRINT "PENALTY REFUSED."GOTO 23003100 PRINT "PENALTY ACCEPTED."3110 LET F := 0LET D := D - 1IF P <> P3 THEN 3160fnF_1 := 1 \ LET X := X3 - (1.0 - 2.0 * P) * 5.0GOTO 23003160 fnF_1 := 1 \ LET X := X3 + (1.0 - 2.0 * P) * 5.0GOTO 2300END