procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure changebase 0A := 0.0C := 0.0D := 0.0E := 0.0F := 0.0G := 0.0H := 0.0I := 0.0J := 0.0K := 0.0M := 0.0N := 0.0P := 0.0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(34.0); "CHANGE"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT PRINT "I, YOUR FRIENDLY MICROCOMPUTER, WILL DETERMINE"PRINT "THE CORRECT CHANGE FOR ITEMS COSTING UP TO $100."PRINT PRINT 10 PRINT "COST OF ITEM";RUN _ecb_input_prefix_t \ INPUT "? ", A \ RUN _ecb_input_suffix_tPRINT "AMOUNT OF PAYMENT";RUN _ecb_input_prefix_t \ INPUT "? ", P \ RUN _ecb_input_suffix_tC := P - AM := CIF C <> 0.0 THEN 90PRINT "CORRECT AMOUNT, THANK YOU."GOTO 40090 IF C > 0.0 THEN 120PRINT "SORRY, YOU HAVE SHORT-CHANGED ME $"; A - PGOTO 10120 run ecb_str(C, tmp_1$) \ PRINT "YOUR CHANGE, $"; tmp_1$RUN ecb_int(C / 10.0, D)IF D = 0.0 THEN 155run ecb_str(D, tmp_1$) \ PRINT tmp_1$; "TEN DOLLAR BILL(S)"155 C := M - (D * 10.0)RUN ecb_int(C / 5.0, E)IF E = 0.0 THEN 185run ecb_str(E, tmp_1$) \ PRINT tmp_1$; "FIVE DOLLARS BILL(S)"185 C := M - (D * 10.0 + E * 5.0)RUN ecb_int(C, F)IF F = 0.0 THEN 215run ecb_str(F, tmp_1$) \ PRINT tmp_1$; "ONE DOLLAR BILL(S)"215 C := M - (D * 10.0 + E * 5.0 + F)C := C * 100.0N := CRUN ecb_int(C / 50.0, G)IF G = 0.0 THEN 255run ecb_str(G, tmp_1$) \ PRINT tmp_1$; "ONE HALF DOLLAR(S)"255 C := N - (G * 50.0)RUN ecb_int(C / 25.0, H)IF H = 0.0 THEN 285run ecb_str(H, tmp_1$) \ PRINT tmp_1$; "QUARTER(S)"285 C := N - (G * 50.0 + H * 25.0)RUN ecb_int(C / 10.0, I)IF I = 0.0 THEN 315run ecb_str(I, tmp_1$) \ PRINT tmp_1$; "DIME(S)"315 C := N - (G * 50.0 + H * 25.0 + I * 10.0)RUN ecb_int(C / 5.0, J)IF J = 0.0 THEN 345run ecb_str(J, tmp_1$) \ PRINT tmp_1$; "NICKEL(S)"345 C := N - (G * 50.0 + H * 25.0 + I * 10.0 + J * 5.0)RUN ecb_int(C + 0.5, K)IF K = 0.0 THEN 380run ecb_str(K, tmp_1$) \ PRINT tmp_1$; "PENNY(S)"380 PRINT "THANK YOU, COME AGAIN."PRINT PRINT 400 GOTO 10END