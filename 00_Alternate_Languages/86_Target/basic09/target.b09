procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure targetbase 0DIM I, R: INTEGERA := 0.0A1 := 0.0B := 0.0B1 := 0.0D := 0.0I := 0P := 0.0P1 := 0.0P2 := 0.0P3 := 0.0Q := 0.0R := 0R1 := 0.0W := 0.0X := 0.0X1 := 0.0X2 := 0.0Y := 0.0Y1 := 0.0Y2 := 0.0Z := 0.0Z1 := 0.0Z2 := 0.0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(34.0); "TARGET"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT R := 1R1 := 57.296P := 3.14159PRINT "YOU ARE THE WEAPONS OFFICER ON THE STARSHIP ENTERPRISE"PRINT "AND THIS IS A TEST TO SEE HOW ACCURATE A SHOT YOU"PRINT "ARE IN A THREE-DIMENSIONAL RANGE.  YOU WILL BE TOLD"PRINT "THE RADIAN OFFSET FOR THE X AND Z AXES, THE LOCATION"PRINT "OF THE TARGET IN THREE DIMENSIONAL RECTANGULAR COORDINATES,"PRINT "THE APPROXIMATE NUMBER OF DEGREES FROM THE X AND Z"PRINT "AXES, AND THE APPROXIMATE DISTANCE TO THE TARGET."PRINT "YOU WILL THEN PROCEEED TO SHOOT AT THE TARGET UNTIL IT IS"PRINT "DESTROYED!"PRINT PRINT "GOOD LUCK!!"PRINT PRINT 220 A := RND(1.0) * 2.0 * PB := RND(1.0) * 2.0 * PRUN ecb_int(A * R1, Q)RUN ecb_int(B * R1, W)run ecb_str(A, tmp_1$) \ run ecb_str(B, tmp_2$) \ PRINT "RADIANS FROM X AXIS ="; tmp_1$; "   FROM Z AXIS ="; tmp_2$P1 := 100000.0 * RND(1.0) + RND(1.0)X := SIN(B) * COS(A) * P1Y := SIN(B) * SIN(A) * P1Z := COS(B) * P1run ecb_str(X, tmp_1$) \ run ecb_str(Y, tmp_2$) \ run ecb_str(Z, tmp_3$) \ PRINT "TARGET SIGHTED: APPROXIMATE COORDINATES:  X="; tmp_1$; "  Y="; tmp_2$; "  Z="; tmp_3$345 R := R + 1IF R > 5.0 THEN 390ON R GOTO 355, 360, 365, 370, 375355 RUN ecb_int(P1 * 0.05, tmp_1) \ P3 := tmp_1 * 20.0GOTO 390360 RUN ecb_int(P1 * 0.1, tmp_1) \ P3 := tmp_1 * 10.0GOTO 390365 RUN ecb_int(P1 * 0.5, tmp_1) \ P3 := tmp_1 * 2.0GOTO 390370 RUN ecb_int(P1, P3)GOTO 390375 P3 := P1390 run ecb_str(P3, tmp_1$) \ PRINT "     ESTIMATED DISTANCE:"; tmp_1$PRINT PRINT "INPUT ANGLE DEVIATION FROM X, DEVIATION FROM Z, DISTANCE";RUN _ecb_input_prefix_t \ INPUT "? ", A1, B1, P2 \ RUN _ecb_input_suffix_tPRINT IF P2 < 20.0 THEN  PRINT "YOU BLEW YOURSELF UP!!"  GOTO 580ENDIFA1 := A1 / R1B1 := B1 / R1run ecb_str(A1, tmp_1$) \ PRINT "RADIANS FROM X AXIS ="; tmp_1$; "  ";run ecb_str(B1, tmp_1$) \ PRINT "FROM Z AXIS ="; tmp_1$X1 := P2 * SIN(B1) * COS(A1)Y1 := P2 * SIN(B1) * SIN(A1)Z1 := P2 * COS(B1)D := ((X1 - X) ^ 2.0 + (Y1 - Y) ^ 2.0 + (Z1 - Z) ^ 2.0) ^ (1.0 / 2.0)IF D > 20.0 THEN 670PRINT PRINT " * * * HIT * * *   TARGET IS NON-FUNCTIONAL"PRINT run ecb_str(D, tmp_1$) \ PRINT "DISTANCE OF EXPLOSION FROM TARGET WAS"; tmp_1$; "KILOMETERS."PRINT run ecb_str(float(R), tmp_1$) \ PRINT "MISSION ACCOMPLISHED IN "; tmp_1$; " SHOTS."580 R := 0FOR I = 1 TO 5PRINT NEXT IPRINT "NEXT TARGET..."PRINT GOTO 220670 X2 := X1 - XY2 := Y1 - YZ2 := Z1 - ZIF X2 < 0.0 THEN 730run ecb_str(X2, tmp_1$) \ PRINT "SHOT IN FRONT OF TARGET"; tmp_1$; "KILOMETERS."GOTO 740730 run ecb_str(- X2, tmp_1$) \ PRINT "SHOT BEHIND TARGET"; tmp_1$; "KILOMETERS."740 IF Y2 < 0.0 THEN 770run ecb_str(Y2, tmp_1$) \ PRINT "SHOT TO LEFT OF TARGET"; tmp_1$; "KILOMETERS."GOTO 780770 run ecb_str(- Y2, tmp_1$) \ PRINT "SHOT TO RIGHT OF TARGET"; tmp_1$; "KILOMETERS."780 IF Z2 < 0.0 THEN 810run ecb_str(Z2, tmp_1$) \ PRINT "SHOT ABOVE TARGET"; tmp_1$; "KILOMETERS."GOTO 820810 run ecb_str(- Z2, tmp_1$) \ PRINT "SHOT BELOW TARGET"; tmp_1$; "KILOMETERS."820 run ecb_str(X1, tmp_1$) \ run ecb_str(Y1, tmp_2$) \ run ecb_str(Z1, tmp_3$) \ PRINT "APPROX POSITION OF EXPLOSION:  X="; tmp_1$; "   Y="; tmp_2$; "   Z="; tmp_3$run ecb_str(D, tmp_1$) \ PRINT "     DISTANCE FROM TARGET ="; tmp_1$PRINT PRINT PRINT GOTO 345END