procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure bagelsbase 0DIM C, D, I, J, T, Y, Z: INTEGERA$ := ""C := 0D := 0I := 0J := 0T := 0Y := 0Z := 0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(34.0); "BAGELS"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT (* *** BAGLES NUMBER GUESSING GAME *)(* *** ORIGINAL SOURCE UNKNOWN BUT SUSPECTED TO BE *)(* *** LAWRENCE HALL OF SCIENCE, U.C. BERKELY *)DIM arr_A1(4), arr_B(4): INTEGERFOR tmp_1 = 0 TO 3 \ arr_A1(tmp_1) := 0 \ NEXT tmp_1FOR tmp_1 = 0 TO 3 \ arr_B(tmp_1) := 0 \ NEXT tmp_1DIM arr_A(4)FOR tmp_1 = 0 TO 3 \ arr_A(tmp_1) := 0 \ NEXT tmp_1Y := 0T := 255PRINT PRINT PRINT RUN _ecb_input_prefix_t \ INPUT "WOULD YOU LIKE THE RULES (YES OR NO)? ", A$ \ RUN _ecb_input_suffix_tIF LEFT$(A$, 1.0) = "N" THEN 150PRINT PRINT "I AM THINKING OF A THREE-DIGIT NUMBER.  TRY TO GUESS"PRINT "MY NUMBER AND I WILL GIVE YOU CLUES AS FOLLOWS:"PRINT "   PICO   - ONE DIGIT CORRECT BUT IN THE WRONG POSITION"PRINT "   FERMI  - ONE DIGIT CORRECT AND IN THE RIGHT POSITION"PRINT "   BAGELS - NO DIGITS CORRECT"150 FOR I = 1 TO 3160   RUN ecb_int(10.0 * RND(1.0), arr_A(I))  IF I - 1.0 = 0.0 THEN 200  FOR J = 1 TO I - 1    IF arr_A(I) = arr_A(J) THEN 160  NEXT J200 NEXT IPRINT PRINT "O.K.  I HAVE A NUMBER IN MIND."FOR I = 1 TO 20230   run ecb_str(float(I), tmp_1$) \ PRINT "GUESS #"; tmp_1$,  RUN _ecb_input_prefix_t \ INPUT "? ", A$ \ RUN _ecb_input_suffix_t  IF LEN(A$) <> 3.0 THEN 630FOR Z = 1 TO 3  arr_A1(Z) := ASC(MID$(A$, Z, 1.0))  NEXT Z  FOR J = 1 TO 3    IF arr_A1(J) < 48.0 THEN 300    IF arr_A1(J) > 57.0 THEN 300    arr_B(J) := arr_A1(J) - 48  NEXT J  GOTO 320300   PRINT "WHAT?"  GOTO 230320   IF arr_B(1) = arr_B(2) THEN 650  IF arr_B(2) = arr_B(3) THEN 650  IF arr_B(3) = arr_B(1) THEN 650  C := 0  D := 0  FOR J = 1 TO 2    IF arr_A(J) <> arr_B(J + 1) THEN 390    C := C + 1390     IF arr_A(J + 1.0) <> arr_B(J) THEN 410    C := C + 1410   NEXT J  IF arr_A(1.0) <> arr_B(3) THEN 440  C := C + 1440   IF arr_A(3.0) <> arr_B(1) THEN 460  C := C + 1460   FOR J = 1 TO 3    IF arr_A(J) <> arr_B(J) THEN 490    D := D + 1490   NEXT J  IF D = 3.0 THEN 680  IF C = 0.0 THEN 545  FOR J = 1 TO C    PRINT "PICO ";  NEXT J545   IF D = 0.0 THEN 580  FOR J = 1 TO D    PRINT "FERMI ";  NEXT J580   IF C + D <> 0.0 THEN 600  PRINT "BAGELS";600   PRINT NEXT IPRINT "OH WELL."PRINT "THAT'S TWENTY GUESSES.  MY NUMBER WAS"; 100.0 * arr_A(1.0) + 10.0 * arr_A(2.0) + arr_A(3.0)GOTO 700630 PRINT "TRY GUESSING A THREE-DIGIT NUMBER."GOTO 230650 PRINT "OH, I FORGOT TO TELL YOU THAT THE NUMBER I HAVE IN MIND"PRINT "HAS NO TWO DIGITS THE SAME."GOTO 230680 PRINT "YOU GOT IT!!!"PRINT Y := Y + 1700 RUN _ecb_input_prefix_t \ INPUT "PLAY AGAIN (YES OR NO)? ", A$ \ RUN _ecb_input_suffix_tIF LEFT$(A$, 1.0) = "Y" THEN 150IF Y = 0.0 THEN 750PRINT run ecb_str(float(Y), tmp_1$) \ PRINT "A"; tmp_1$; "POINT BAGELS BUFF!!"750 PRINT "HOPE YOU HAD FUN.  BYE."END