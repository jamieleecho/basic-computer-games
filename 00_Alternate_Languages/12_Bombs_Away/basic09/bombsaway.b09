procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure bombsawaybase 0DIM T: INTEGERA := 0.0B := 0.0D := 0.0F$ := ""G := 0.0M := 0.0R := 0.0S := 0.0T := 0U$ := ""type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 08 PRINT "YOU ARE A PILOT IN A WORLD WAR II BOMBER."10 RUN _ecb_input_prefix_t \ INPUT "WHAT SIDE -- ITALY(1), ALLIES(2), JAPAN(3), GERMANY(4)? ", A \ RUN _ecb_input_suffix_tIF A > 0.0 AND A < 5.0 THEN 25PRINT "TRY AGAIN..."GOTO 1025 ON INT(A) GOTO 30, 110, 200, 22030 RUN _ecb_input_prefix_t \ INPUT "YOUR TARGET -- ALBANIA(1), GREECE(2), NORTH AFRICA(3)? ", B \ RUN _ecb_input_suffix_tIF B > 0.0 AND B < 4.0 THEN 45PRINT "TRY AGAIN..."GOTO 3045 PRINT ON INT(B) GOTO 50, 80, 9050 PRINT "SHOULD BE EASY -- YOU'RE FLYING A NAZI-MADE PLANE."GOTO 28080 PRINT "BE CAREFUL!!!"GOTO 28090 PRINT "YOU'RE GOING FOR THE OIL, EH?"GOTO 280110 RUN _ecb_input_prefix_t \ INPUT "AIRCRAFT -- LIBERATOR(1), B-29(2), B-17(3), LANCASTER(4)? ", G \ RUN _ecb_input_suffix_tIF G > 0.0 AND G < 5.0 THEN 125PRINT "TRY AGAIN..."GOTO 110125 PRINT ON INT(G) GOTO 130, 150, 170, 190130 PRINT "YOU'VE GOT 2 TONS OF BOMBS FLYING FOR PLOESTI."GOTO 280150 PRINT "YOU'RE DUMPING THE A-BOMB ON HIROSHIMA."GOTO 280170 PRINT "YOU'RE CHASING THE BISMARK IN THE NORTH SEA."GOTO 280190 PRINT "YOU'RE BUSTING A GERMAN HEAVY WATER PLANT IN THE RUHR."GOTO 280200 PRINT "YOU'RE FLYING A KAMIKAZE MISSION OVER THE USS LEXINGTON."RUN _ecb_input_prefix_t \ INPUT "YOUR FIRST KAMIKAZE MISSION(Y OR N)? ", F$ \ RUN _ecb_input_suffix_tIF F$ = "N" THEN  S := 0.0  GOTO 358ENDIFPRINT IF RND(1.0) > 0.65 THEN 325GOTO 380220 PRINT "A NAZI, EH?  OH WELL.  ARE YOU GOING FOR RUSSIA(1),"RUN _ecb_input_prefix_t \ INPUT "ENGLAND(2), OR FRANCE(3)? ", M \ RUN _ecb_input_suffix_tIF M > 0.0 AND M < 4.0 THEN 235PRINT "TRY AGAIN..."GOTO 220235 PRINT ON INT(M) GOTO 250, 260, 270250 PRINT "YOU'RE NEARING STALINGRAD."GOTO 280260 PRINT "NEARING LONDON.  BE CAREFUL, THEY'VE GOT RADAR."GOTO 280270 PRINT "NEARING VERSAILLES.  DUCK SOUP.  THEY'RE NEARLY DEFENSELESS."280 PRINT 285 RUN _ecb_input_prefix_t \ INPUT "HOW MANY MISSIONS HAVE YOU FLOWN? ", D \ RUN _ecb_input_suffix_tIF D < 160.0 THEN 300PRINT "MISSIONS, NOT MILES..."PRINT "150 MISSIONS IS HIGH EVEN FOR OLD-TIMERS."PRINT "NOW THEN, ";GOTO 285300 PRINT IF D < 100.0 THEN 310PRINT "THAT'S PUSHING THE ODDS!"GOTO 320310 IF D < 25.0 THEN  PRINT "FRESH OUT OF TRAINING, EH?"ENDIF320 PRINT IF D < 160.0 * RND(1.0) THEN 330325 RUN ecb_int(100.0 * RND(1.0), tmp_1) \ run ecb_str(tmp_1, tmp_1$) \ PRINT "DIRECT HIT!!!! "; tmp_1$; "KILLED."PRINT "MISSION SUCCESSFUL."GOTO 390330 RUN ecb_int(2.0 + 30.0 * RND(1.0), tmp_1) \ run ecb_str(tmp_1, tmp_1$) \ PRINT "MISSED TARGET BY"; tmp_1$; "MILES!"PRINT "NOW YOU'RE REALLY IN FOR IT !!"PRINT 340 RUN _ecb_input_prefix_t \ INPUT "DOES THE ENEMY HAVE GUNS(1), MISSILES(2), OR BOTH(3)? ", R \ RUN _ecb_input_suffix_tIF R > 0.0 AND R < 4.0 THEN 350PRINT "TRY AGAIN..."GOTO 340350 PRINT T := 0IF R = 2.0 THEN 360RUN _ecb_input_prefix_t \ INPUT "WHAT'S THE PERCENT HIT RATE OF ENEMY GUNNERS (10 TO 50)? ", S \ RUN _ecb_input_suffix_tIF S < 10.0 THEN  PRINT "YOU LIE, BUT YOU'LL PAY..."  GOTO 380ENDIF358 PRINT 360 PRINT IF R > 1.0 THEN  T := 35ENDIFIF S + T > 100.0 * RND(1.0) THEN 380PRINT "YOU MADE IT THROUGH TREMENDOUS FLAK!!"GOTO 390380 PRINT "* * * * BOOM * * * *"PRINT "YOU HAVE BEEN SHOT DOWN....."PRINT "DEARLY BELOVED, WE ARE GATHERED HERE TODAY TO PAY OUR"PRINT "LAST TRIBUTE..."390 PRINT PRINT PRINT RUN _ecb_input_prefix_t \ INPUT "ANOTHER MISSION (Y OR N)? ", U$ \ RUN _ecb_input_suffix_tIF U$ = "Y" THEN 8PRINT "CHICKEN !!!"PRINT END