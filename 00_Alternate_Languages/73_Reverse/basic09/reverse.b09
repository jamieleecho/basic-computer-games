procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure reversebase 0DIM J, K, N, T: INTEGERA$ := ""J := 0K := 0N := 0R := 0.0T := 0Z := 0.0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(33.0); "REVERSE"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT PRINT "REVERSE -- A GAME OF SKILL"PRINT DIM arr_A(21)FOR tmp_1 = 0 TO 20 \ arr_A(tmp_1) := 0 \ NEXT tmp_1(* *** N=NUMBER OF NUMBERS *)N := 9PRINT "DO YOU WANT THE RULES";RUN _ecb_input_prefix_t \ INPUT "? ", A$ \ RUN _ecb_input_suffix_tIF A$ = "NO" THEN 210GOSUB 710(* *** MAKE A RANDOM LIST A(1) TO A(N) *)210 RUN ecb_int((N - 1.0) * RND(1.0) + 2.0, arr_A(1.0))FOR K = 2 TO N230   RUN ecb_int(N * RND(1.0) + 1.0, arr_A(K))  FOR J = 1 TO K - 1    IF arr_A(K) = arr_A(J) THEN 230NEXT JNEXT K(* *** PRINT ORIGINAL LIST AND START GAME *)PRINT PRINT "HERE WE GO ... THE LIST IS:"T := 0GOSUB 610330 PRINT "HOW MANY SHALL I REVERSE";RUN _ecb_input_prefix_t \ INPUT "? ", R \ RUN _ecb_input_suffix_tIF R = 0.0 THEN 520IF R <= N THEN 390run ecb_str(float(N), tmp_1$) \ PRINT "OOPS! TOO MANY! I CAN REVERSE AT MOST"; tmp_1$GOTO 330390 T := T + 1(* *** REVERSE R NUMBERS AND PRINT NEW LIST *)RUN ecb_int(R / 2.0, tmp_1) \ FOR K = 1 TO tmp_1  Z := arr_A(K)  arr_A(K) := arr_A(INT(R - K + 1.0))  arr_A(INT(R - K + 1.0)) := ZNEXT KGOSUB 610(* *** CHECK FOR A WIN *)FOR K = 1 TO N  IF arr_A(K) <> K THEN 330NEXT Krun ecb_str(float(T), tmp_1$) \ PRINT "YOU WON IT IN"; tmp_1$; "MOVES!!!"PRINT 520 PRINT PRINT "TRY AGAIN (YES OR NO)";RUN _ecb_input_prefix_t \ INPUT "? ", A$ \ RUN _ecb_input_suffix_tIF A$ = "YES" THEN 210PRINT PRINT "O.K. HOPE YOU HAD FUN!!"GOTO 999(* *** SUBROUTINE TO PRINT LIST *)610 PRINT FOR K = 1 TO Nrun ecb_str(arr_A(K), tmp_1$) \ PRINT tmp_1$;NEXT KPRINT PRINT RETURN(* *** SUBROUTINE TO PRINT THE RULES *)710 PRINT PRINT "THIS IS THE GAME OF 'REVERSE'.  TO WIN, ALL YOU HAVE"run ecb_str(float(N), tmp_1$) \ PRINT "TO DO IS ARRANGE A LIST OF NUMBERS (1 THROUGH"; tmp_1$; ")"PRINT "IN NUMERICAL ORDER FROM LEFT TO RIGHT.  TO MOVE, YOU"PRINT "TELL ME HOW MANY NUMBERS (COUNTING FROM THE LEFT) TO"PRINT "REVERSE.  FOR EXAMPLE, IF THE CURRENT LIST IS:"PRINT PRINT "2 3 4 5 1 6 7 8 9"PRINT PRINT "AND YOU REVERSE 4, THE RESULT WILL BE:"PRINT PRINT "5 4 3 2 1 6 7 8 9"PRINT PRINT "NOW IF YOU REVERSE 5, YOU WIN!"PRINT PRINT "1 2 3 4 5 6 7 8 9"PRINT PRINT "NO DOUBT YOU WILL LIKE THIS GAME, BUT"PRINT "IF YOU WANT TO QUIT, REVERSE 0 (ZERO)."PRINT RETURN999 END