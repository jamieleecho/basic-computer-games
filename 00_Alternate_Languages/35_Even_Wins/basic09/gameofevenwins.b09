procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure gameofevenwinsbase 0DIM I: INTEGERA := 0.0A$ := ""B := 0.0E := 0.0E1 := 0.0I := 0L := 0.0L1 := 0.0M := 0.0P := 0.0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(29.0); "GAME OF EVEN WINS"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT RUN _ecb_input_prefix_t \ INPUT "DO YOU WANT INSTRUCTIONS (YES OR NO)? ", A$ \ RUN _ecb_input_suffix_tPRINT IF A$ = "NO" THEN 20PRINT "THE GAME IS PLAYED AS FOLLOWS:"PRINT PRINT "AT THE BEGINNING OF THE GAME, A RANDOM NUMBER OF CHIPS ARE"PRINT "PLACED ON THE BOARD.  THE NUMBER OF CHIPS ALWAYS STARTS"PRINT "AS AN ODD NUMBER.  ON EACH TURN, A PLAYER MUST TAKE ONE,"PRINT "TWO, THREE, OR FOUR CHIPS.  THE WINNER IS THE PLAYER WHO"PRINT "FINISHES WITH A TOTAL NUMBER OF CHIPS THAT IS EVEN."PRINT "THE COMPUTER STARTS OUT KNOWING ONLY THE RULES OF THE"PRINT "GAME.  IT GRADUALLY LEARNS TO PLAY WELL.  IT SHOULD BE"PRINT "DIFFICULT TO BEAT THE COMPUTER AFTER TWENTY GAMES IN A ROW."PRINT "TRY IT!!!!"PRINT PRINT "TO QUIT AT ANY TIME, TYPE A '0' AS YOUR MOVE."PRINT 20 DIM arr_R(2, 6)FOR tmp_1 = 0 TO 1 \ FOR tmp_2 = 0 TO 5 \ arr_R(tmp_1, tmp_2) := 0 \ NEXT tmp_2 \ NEXT tmp_1L := 0.0B := 0.0FOR I = 0 TO 5  arr_R(1.0, I) := 4.0  arr_R(0.0, I) := 4.0NEXT I70 A := 0.0B := 0.0RUN ecb_int((13.0 * RND(1.0) + 9.0) / 2.0, tmp_1) \ P := tmp_1 * 2.0 + 1.0100 IF P = 1.0 THEN 530run ecb_str(P, tmp_1$) \ PRINT "THERE ARE"; tmp_1$; "CHIPS ON THE BOARD."120 E1 := EL1 := LRUN ecb_int(A / 2.0, tmp_1) \ E := (A / 2.0 - tmp_1) * 2.0RUN ecb_int(P / 6.0, tmp_1) \ RUN ecb_int((P / 6.0 - tmp_1) * 6.0 + 0.5, L)IF arr_R(INT(E), INT(L)) >= P THEN 320M := arr_R(INT(E), INT(L))IF M <= 0.0 THEN 370P := P - MIF M = 1.0 THEN 510run ecb_str(M, tmp_1$) \ run ecb_str(P, tmp_2$) \ PRINT "COMPUTER TAKES"; tmp_1$; "CHIPS LEAVING"; tmp_2$; "... YOUR MOVE";220 B := B + M230 RUN _ecb_input_prefix_t \ INPUT "? ", M \ RUN _ecb_input_suffix_tRUN ecb_int(M, M)IF M < 1.0 THEN 450IF M > 4.0 THEN 460IF M > P THEN 460IF M = P THEN 360P := P - MA := A + MGOTO 100320 IF P = 1.0 THEN 550run ecb_str(P, tmp_1$) \ PRINT "COMPUTER TAKES"; tmp_1$; "CHIPS."340 arr_R(INT(E), INT(L)) := PB := B + P360 RUN ecb_int(B / 2.0, tmp_1) \ IF B / 2.0 = tmp_1 THEN 420370 PRINT "GAME OVER ... YOU WIN!!!"PRINT IF arr_R(INT(E), INT(L)) = 1.0 THEN 480arr_R(INT(E), INT(L)) := arr_R(INT(E), INT(L)) - 1.0GOTO 70420 PRINT "GAME OVER ... I WIN!!!"PRINT GOTO 70450 IF M = 0.0 THEN 570460 run ecb_str(M, tmp_1$) \ PRINT tmp_1$; "IS AN ILLEGAL MOVE ... YOUR MOVE";GOTO 230480 IF arr_R(INT(E1), INT(L1)) = 1.0 THEN 70arr_R(INT(E1), INT(L1)) := arr_R(INT(E1), INT(L1)) - 1.0GOTO 70510 run ecb_str(P, tmp_1$) \ PRINT "COMPUTER TAKES 1 CHIP LEAVING"; tmp_1$; "... YOUR MOVE";GOTO 220530 PRINT "THERE IS 1 CHIP ON THE BOARD."GOTO 120550 PRINT "COMPUTER TAKES 1 CHIP."GOTO 340570 END