procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure evenwinsbase 0A1 := 0.0C := 0.0M := 0.0M1 := 0.0R := 0.0T := 0.0Y := 0.0Y1 := 0.0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(32.0); "EVEN WINS"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT Y1 := 0.0M1 := 0.0DIM arr_M(21), arr_Y(21)FOR tmp_1 = 0 TO 20 \ arr_M(tmp_1) := 0 \ NEXT tmp_1FOR tmp_1 = 0 TO 20 \ arr_Y(tmp_1) := 0 \ NEXT tmp_1PRINT "     THIS IS A TWO PERSON GAME CALLED 'EVEN WINS.'"PRINT "TO PLAY THE GAME, THE PLAYERS NEED 27 MARBLES OR"PRINT "OTHER OBJECTS ON A TABLE."PRINT PRINT PRINT "     THE 2 PLAYERS ALTERNATE TURNS, WITH EACH PLAYER"PRINT "REMOVING FROM 1 TO 4 MARBLES ON EACH MOVE.  THE GAME"PRINT "ENDS WHEN THERE ARE NO MARBLES LEFT, AND THE WINNER"PRINT "IS THE ONE WITH AN EVEN NUMBER OF MARBLES."PRINT PRINT PRINT "     THE ONLY RULES ARE THAT (1) YOU MUST ALTERNATE TURNS,"PRINT "(2) YOU MUST TAKE BETWEEN 1 AND 4 MARBLES EACH TURN,"PRINT "AND (3) YOU CANNOT SKIP A TURN."PRINT PRINT PRINT 200 PRINT "     TYPE A '1' IF YOU WANT TO GO FIRST, AND TYPE"PRINT "A '0' IF YOU WANT ME TO GO FIRST."RUN _ecb_input_prefix_t \ INPUT "? ", C \ RUN _ecb_input_suffix_tPRINT IF C = 0.0 THEN 250GOTO 1060250 T := 27.0M := 2.0PRINT run ecb_str(T, tmp_1$) \ PRINT "TOTAL="; tmp_1$PRINT M1 := M1 + MT := T - M300 run ecb_str(M, tmp_1$) \ PRINT "I PICK UP"; tmp_1$; "MARBLES."IF T = 0.0 THEN 880PRINT run ecb_str(T, tmp_1$) \ PRINT "TOTAL="; tmp_1$PRINT run ecb_str(M1, tmp_1$) \ PRINT "     AND WHAT IS YOUR NEXT MOVE, MY TOTAL IS"; tmp_1$350 RUN _ecb_input_prefix_t \ INPUT "? ", Y \ RUN _ecb_input_suffix_t360 PRINT IF Y < 1.0 THEN 1160IF Y > 4.0 THEN 1160IF Y <= T THEN 430PRINT "     YOU HAVE TRIED TO TAKE MORE MARBLES THAN THERE ARE"PRINT "LEFT.  TRY AGAIN."GOTO 350430 Y1 := Y1 + YT := T - YIF T = 0.0 THEN 880run ecb_str(T, tmp_1$) \ PRINT "TOTAL="; tmp_1$PRINT run ecb_str(Y1, tmp_1$) \ PRINT "YOUR TOTAL IS"; tmp_1$IF T < 0.5 THEN 880RUN ecb_int(T / 6.0, tmp_1) \ R := T - 6.0 * tmp_1RUN ecb_int(Y1 / 2.0, tmp_1) \ IF tmp_1 = Y1 / 2.0 THEN 700IF T < 4.2 THEN 580IF R > 3.4 THEN 620M := R + 1.0M1 := M1 + MT := T - MGOTO 300580 M := TT := T - MGOTO 830(*     250 IS WHERE I WIN. *)620 IF R < 4.7 THEN 660IF R > 3.5 THEN 660640 M := 1.0GOTO 670660 M := 4.0670 T := T - MM1 := M1 + MGOTO 300700 (*     I AM READY TO ENCODE THE STRAT FOR WHEN OPP TOT IS EVEN *)IF R < 1.5 THEN 1020IF R > 5.3 THEN 1020M := R - 1.0M1 := M1 + MT := T - MIF T < 0.2 THEN 790(*     IS # ZERO HERE *)GOTO 300790 (*     IS = ZERO HERE *)run ecb_str(M, tmp_1$) \ PRINT "I PICK UP"; tmp_1$; "MARBLES."PRINT GOTO 880830 (*    THIS IS WHERE I WIN *)run ecb_str(M, tmp_1$) \ PRINT "I PICK UP"; tmp_1$; "MARBLES."PRINT PRINT "TOTAL = 0"M1 := M1 + M880 PRINT "THAT IS ALL OF THE MARBLES."PRINT run ecb_str(M1, tmp_1$) \ run ecb_str(Y1, tmp_2$) \ PRINT " MY TOTAL IS"; tmp_1$; ", YOUR TOTAL IS"; tmp_2$PRINT RUN ecb_int(M1 / 2.0, tmp_1) \ IF tmp_1 = M1 / 2.0 THEN 950PRINT "     YOU WON.  DO YOU WANT TO PLAY"GOTO 960950 PRINT "     I WON.  DO YOU WANT TO PLAY"960 PRINT "AGAIN?  TYPE 1 FOR YES AND 0 FOR NO."RUN _ecb_input_prefix_t \ INPUT "? ", A1 \ RUN _ecb_input_suffix_tIF A1 = 0.0 THEN 1030M1 := 0.0Y1 := 0.0GOTO 2001020 GOTO 6401030 PRINT PRINT "OK.  SEE YOU LATER."GOTO 12301060 T := 27.0PRINT PRINT PRINT run ecb_str(T, tmp_1$) \ PRINT "TOTAL="; tmp_1$PRINT PRINT PRINT "WHAT IS YOUR FIRST MOVE";RUN _ecb_input_prefix_t \ INPUT "? ", Y \ RUN _ecb_input_suffix_tGOTO 3601160 PRINT PRINT "THE NUMBER OF MARBLES YOU TAKE MUST BE A POSITIVE"PRINT "INTEGER BETWEEN 1 AND 4."PRINT PRINT "     WHAT IS YOUR NEXT MOVE?"PRINT GOTO 3501230 END