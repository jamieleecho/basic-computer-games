procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure highiqbase 0DIM A, B, C, F, R, T, W, X, Y: INTEGERA := 0A$ := ""B := 0C := 0F := 0M := 0.0P := 0.0R := 0T := 0W := 0X := 0Y := 0Z := 0.0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(34.0); "H-I-Q"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT DIM arr_B(71), arr_T(10, 10): INTEGERFOR tmp_1 = 0 TO 70 \ arr_B(tmp_1) := 0 \ NEXT tmp_1FOR tmp_1 = 0 TO 9 \ FOR tmp_2 = 0 TO 9 \ arr_T(tmp_1, tmp_2) := 0 \ NEXT tmp_2 \ NEXT tmp_1PRINT "HERE IS THE BOARD:"PRINT PRINT "          !    !    !"PRINT "         13   14   15"PRINT PRINT "          !    !    !"PRINT "         22   23   24"PRINT PRINT "!    !    !    !    !    !    !"PRINT "29   30   31   32   33   34   35"PRINT PRINT "!    !    !    !    !    !    !"PRINT "38   39   40   41   42   43   44"PRINT PRINT "!    !    !    !    !    !    !"PRINT "47   48   49   50   51   52   53"PRINT PRINT "          !    !    !"PRINT "         58   59   60"PRINT PRINT "          !    !    !"PRINT "         67   68   69"PRINT PRINT "TO SAVE TYPING TIME, A COMPRESSED VERSION OF THE GAME BOARD"PRINT "WILL BE USED DURING PLAY.  REFER TO THE ABOVE ONE FOR PEG"PRINT "NUMBERS.  OK, LET'S BEGIN."28 (* *** SET UP BOARD *)FOR R = 1 TO 9  FOR C = 1 TO 9    IF (R - 4.0) * (R - 5.0) * (R - 6.0) = 0.0 THEN 40    IF (C - 4.0) * (C - 5.0) * (C - 6.0) = 0.0 THEN 4035     arr_T(R, C) := -5    GOTO 5040     IF (R - 1.0) * (C - 1.0) * (R - 9.0) * (C - 9.0) = 0.0 THEN 35    arr_T(R, C) := 550   NEXT CNEXT Rarr_T(5, 5) := 0GOSUB 500(* *** INPUT MOVE AND CHECK ON LEGALITY *)FOR W = 1 TO 33  READ M  DATA 13.0, 14.0, 15.0, 22.0, 23.0, 24.0, 29.0, 30.0, 31.0, 32.0, 33.0, 34.0, 35.0, 38.0, 39.0, 40.0, 41.0  DATA 42.0, 43.0, 44.0, 47.0, 48.0, 49.0, 50.0, 51.0, 52.0, 53.0, 58.0, 59.0, 60.0, 67.0, 68.0, 69.0arr_B(INT(M)) := -7NEXT Warr_B(41) := -3100 RUN _ecb_input_prefix_t \ INPUT "MOVE WHICH PIECE? ", Z \ RUN _ecb_input_suffix_tIF arr_B(INT(Z)) = -7.0 THEN 140120 PRINT "ILLEGAL MOVE, TRY AGAIN..."GOTO 100140 RUN _ecb_input_prefix_t \ INPUT "TO WHERE? ", P \ RUN _ecb_input_suffix_tIF arr_B(INT(P)) = 0.0 THEN 120IF arr_B(INT(P)) = -7.0 THEN 120IF Z = P THEN 100RUN ecb_int((Z + P) / 2.0, tmp_1) \ IF ((Z + P) / 2.0) = tmp_1 THEN 180GOTO 120180 IF (ABS(Z - P) - 2.0) * (ABS(Z - P) - 18.0) <> 0.0 THEN 120GOSUB 1000GOSUB 500GOSUB 1500GOTO 100500 (* *** PRINT BOARD *)FOR X = 1 TO 9  FOR Y = 1 TO 9    IF (X - 1.0) * (X - 9.0) * (Y - 1.0) * (Y - 9.0) = 0.0 THEN 550    IF (X - 4.0) * (X - 5.0) * (X - 6.0) = 0.0 THEN 570    IF (Y - 4.0) * (Y - 5.0) * (Y - 6.0) = 0.0 THEN 570550 (* *)    GOTO 610570     IF arr_T(X, Y) <> 5.0 THEN 600    PRINT TAB((Y * 2.0) + 1.0); "!";    GOTO 610600     PRINT TAB((Y * 2.0) + 1.0); "O";610 (* *)  NEXT Y  PRINT NEXT XRETURN1000 (* *** UPDATE BOARD *)  C := 1FOR X = 1 TO 9  FOR Y = 1 TO 9    IF C <> Z THEN 1220    IF C + 2.0 <> P THEN 1080    IF arr_T(X, Y + 1) = 0.0 THEN 120    arr_T(X, Y + 2) := 5    arr_T(X, Y + 1) := 0    arr_B(C + 1) := -3    GOTO 12001080     IF C + 18.0 <> P THEN 1130    IF arr_T(X + 1, Y) = 0.0 THEN 120    arr_T(X + 2, Y) := 5    arr_T(X + 1, Y) := 0    arr_B(C + 9) := -3    GOTO 12001130     IF C - 2.0 <> P THEN 1170    IF arr_T(X, Y - 1) = 0.0 THEN 120    arr_T(X, Y - 2) := 5    arr_T(X, Y - 1) := 0    arr_B(C - 1) := -3    GOTO 12001170     IF C - 18.0 <> P THEN 1220    IF arr_T(X - 1, Y) = 0.0 THEN 120    arr_T(X - 2, Y) := 5    arr_T(X - 1, Y) := 0    arr_B(C - 9) := -31200     arr_B(INT(Z)) := -3    arr_B(INT(P)) := -7    arr_T(X, Y) := 0    GOTO 12401220     C := C + 1  NEXT YNEXT X1240 RETURN1500 (**** CHECK IF GAME IS OVER *)F := 0FOR R = 2 TO 8  FOR C = 2 TO 8    IF arr_T(R, C) <> 5.0 THEN 1580    F := F + 1    FOR A = R - 1 TO R + 1      T := 0      FOR B = C - 1 TO C + 1        T := T + arr_T(A, B)      NEXT B      IF T <> 10.0 THEN 1567      IF arr_T(A, C) <> 0.0 THEN 16301567     NEXT A    FOR X = C - 1 TO C + 1      T := 0      FOR Y = R - 1 TO R + 1        T := T + arr_T(Y, X)      NEXT Y      IF T <> 10.0 THEN 1575      IF arr_T(R, X) <> 0.0 THEN 16301575     NEXT X1580   NEXT CNEXT R(* *** GAME IS OVER *)PRINT "THE GAME IS OVER."run ecb_str(float(F), tmp_1$) \ PRINT "YOU HAD"; tmp_1$; "PIECES REMAINING."IF F <> 1.0 THEN 1615PRINT "BRAVO!  YOU MADE A PERFECT SCORE!"PRINT "SAVE THIS PAPER AS A RECORD OF YOUR ACCOMPLISHMENT!"1615 PRINT RUN _ecb_input_prefix_t \ INPUT "PLAY AGAIN (YES OR NO)? ", A$ \ RUN _ecb_input_suffix_tIF A$ = "NO" THEN 2000RESTOREGOTO 28STOP1630 RETURN2000 PRINT PRINT "SO LONG FOR NOW."PRINT END