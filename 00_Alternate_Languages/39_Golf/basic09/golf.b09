procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure golfbase 0DIM A, F, G1, G2, J, K, Q, S1, S2, X: INTEGERA := 0B := 0.0C := 0.0D := 0.0D1 := 0.0D2 := 0.0F := 0G1 := 0G2 := 0G3 := 0.0H := 0.0I := 0.0J := 0K := 0N := 0.0O := 0.0P := 0.0Q := 0S1 := 0S2 := 0S9 := 0.0T := 0.0W := 0.0X := 0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(35.0); "GOLF"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT PRINT "WELCOME TO THE CREATIVE COMPUTING COUNTRY CLUB,"PRINT "AN EIGHTEEN HOLE CHAMPIONSHIP LAYOUT LOCATED A SHORT"PRINT "DISTANCE FROM SCENIC DOWNTOWN MORRISTOWN.  THE"PRINT "COMMENTATOR WILL EXPLAIN THE GAME AS YOU PLAY."PRINT "ENJOY YOUR GAME; SEE YOU AT THE 19TH HOLE..."PRINT PRINT DIM arr_L(11)FOR tmp_1 = 0 TO 10 \ arr_L(tmp_1) := 0 \ NEXT tmp_1G1 := 18G2 := 0G3 := 0.0A := 0N := 0.8S2 := 0F := 180 PRINT "WHAT IS YOUR HANDICAP";RUN _ecb_input_prefix_t \ INPUT "? ", H \ RUN _ecb_input_suffix_tPRINT IF H > 30.0 THEN 470IF H < 0.0 THEN 470120 PRINT "DIFFICULTIES AT GOLF INCLUDE:"PRINT "0=HOOK, 1=SLICE, 2=POOR DISTANCE, 4=TRAP SHOTS, 5=PUTTING"PRINT "WHICH ONE (ONLY ONE) IS YOUR WORST";RUN _ecb_input_prefix_t \ INPUT "? ", T \ RUN _ecb_input_suffix_tPRINT IF T > 5.0 THEN 120S1 := 0(* *)230 arr_L(0.0) := 0.0J := 0Q := 0S2 := S2 + 1K := 0IF F = 1.0 THEN 310run ecb_str(float(S1), tmp_1$) \ PRINT "YOUR SCORE ON HOLE"; F - 1.0; "WAS"; tmp_1$GOTO 1750292 IF S1 > P + 2.0 THEN 297IF S1 = P THEN 299IF S1 = P - 1.0 THEN 301IF S1 = P - 2.0 THEN 303GOTO 310297 PRINT "KEEP YOUR HEAD DOWN."GOTO 310299 PRINT "A PAR.  NICE GOING."GOTO 310301 PRINT "A BIRDIE."GOTO 310303 IF P = 3.0 THEN 306PRINT "A GREAT BIG EAGLE."GOTO 310306 PRINT "A HOLE IN ONE."310 IF F = 19.0 THEN 1710S1 := 0PRINT 320 IF S1 = 0.0 THEN 1590IF arr_L(0.0) < 1.0 THEN 1150X := 0IF arr_L(0.0) > 5.0 THEN 1190run ecb_str(D1, tmp_1$) \ run ecb_str(D2, tmp_2$) \ PRINT "SHOT WENT"; tmp_1$; "YARDS.  IT'S"; tmp_2$; "YARDS FROM THE CUP."RUN ecb_int(O, tmp_1) \ run ecb_str(tmp_1, tmp_1$) \ PRINT "BALL IS"; tmp_1$; "YARDS OFF LINE... IN ";GOSUB 400GOTO 620400 IF arr_L(X) = 1.0 THEN 480IF arr_L(X) = 2.0 THEN 500IF arr_L(X) = 3.0 THEN 520IF arr_L(X) = 4.0 THEN 540IF arr_L(X) = 5.0 THEN 560IF arr_L(X) = 6.0 THEN 580PRINT "OUT OF BOUNDS."GOTO 1690470 PRINT "PGA HANDICAPS RANGE FROM 0 TO 30."GOTO 80480 PRINT "FAIRWAY."GOTO 1690500 PRINT "ROUGH."GOTO 1690520 PRINT "TREES."GOTO 1690540 PRINT "ADJACENT FAIRWAY."GOTO 1690560 PRINT "TRAP."GOTO 1690580 PRINT "WATER."GOTO 1690620 IF A = 1.0 THEN 629PRINT "SELECTION OF CLUBS"PRINT "YARDAGE DESIRED                       SUGGESTED CLUBS"PRINT "200 TO 280 YARDS                           1 TO 4"PRINT "100 TO 200 YARDS                          19 TO 13"PRINT "  0 TO 100 YARDS                          29 TO 23"A := 1629 PRINT "WHAT CLUB DO YOU CHOOSE";RUN _ecb_input_prefix_t \ INPUT "? ", C \ RUN _ecb_input_suffix_tPRINT IF C < 1.0 THEN 690IF C > 29.0 THEN 690IF C > 4.0 THEN 710650 IF arr_L(0.0) <= 5.0 THEN 740IF C = 14.0 THEN 740IF C = 23.0 THEN 740GOTO 690680 S1 := S1 - 1690 PRINT "THAT CLUB IS NOT IN THE BAG."PRINT GOTO 620710 IF C < 12.0 THEN 690C := C - 6.0GOTO 650740 S1 := S1 + 1W := 1.0IF C > 13.0 THEN 960RUN ecb_int(F / 3.0, tmp_1) \ IF tmp_1 = F / 3.0 THEN 952752 IF C < 4.0 THEN 756GOTO 760756 IF arr_L(0.0) = 2.0 THEN 862760 IF S1 > 7.0 THEN 867770 RUN ecb_int(((30.0 - H) * 2.5 + 187.0 - ((30.0 - H) * 0.25 + 15.0) * C / 2.0) + 25.0 * RND(1.0), D1)RUN ecb_int(D1 * W, D1)IF T = 2.0 THEN 1170830 O := (RND(1.0) / 0.8) * (2.0 * H + 16.0) * ABS(TAN(D1 * 0.0035))RUN ecb_int(SQR(O ^ 2.0 + ABS(D - D1) ^ 2.0), D2)IF D - D1 < 0.0 THEN 870GOTO 890862 PRINT "YOU DUBBED IT."D1 := 35.0GOTO 830867 IF D < 200.0 THEN 1300GOTO 770870 IF D2 < 20.0 THEN 890PRINT "TOO MUCH CLUB. YOU'RE PAST THE HOLE."890 B := DD := D2IF D2 > 27.0 THEN 1020IF D2 > 20.0 THEN 1100IF D2 > 0.5 THEN 1120arr_L(0.0) := 9.0GOTO 1470952 IF S2 + Q + (10.0 * (F - 1.0) / 18.0) < (F - 1.0) * (72.0 + ((H + 1.0) / 0.85)) / 18.0 THEN 956GOTO 752956 Q := Q + 1RUN ecb_int(S1 / 2.0, tmp_1) \ IF S1 / 2.0 <> tmp_1 THEN 1011GOTO 862960 PRINT "NOW GAUGE YOUR DISTANCE BY A PERCENTAGE (1 TO 100)"PRINT "OF A FULL SWING";RUN _ecb_input_prefix_t \ INPUT "? ", W \ RUN _ecb_input_suffix_tW := W / 100.0PRINT IF W > 1.0 THEN 680IF arr_L(0.0) = 5.0 THEN 1280IF C = 14.0 THEN 760C := C - 10.0GOTO 7601011 IF D < 95.0 THEN 862PRINT "BALL HIT TREE - BOUNCED INTO ROUGH"; D - 75.0; "YARDS FROM HOLE."D := D - 75.0GOTO 6201020 IF O < 30.0 THEN 1150IF J > 0.0 THEN 1150IF T > 0.0 THEN 1070S9 := (S2 + 1.0) / 15.0RUN ecb_int(S9, tmp_1) \ IF tmp_1 = S9 THEN 10751040 PRINT "YOU HOOKED- ";arr_L(0.0) := arr_L(2.0)1055 IF O > 45.0 THEN 1092GOTO 3201070 S9 := (S2 + 1.0) / 15.0RUN ecb_int(S9, tmp_1) \ IF tmp_1 = S9 THEN 10401075 PRINT "YOU SLICED- ";arr_L(0.0) := arr_L(1.0)GOTO 10551092 PRINT "BADLY."GOTO 3201100 arr_L(0.0) := 5.0GOTO 3201120 arr_L(0.0) := 8.0RUN ecb_int(D2 * 3.0, D2)GOTO 13801150 arr_L(0.0) := 1.0GOTO 3201170 RUN ecb_int(0.85 * D1, D1)GOTO 8301190 IF arr_L(0.0) > 6.0 THEN 1260PRINT "YOUR SHOT WENT INTO THE WATER."1210 S1 := S1 + 1PRINT "PENALTY STROKE ASSESSED.  HIT FROM PREVIOUS LOCATION."J := J + 1arr_L(0.0) := 1.0D := BGOTO 6201260 PRINT "YOUR SHOT WENT OUT OF BOUNDS."GOTO 12101280 IF T = 3.0 THEN 13201300 RUN ecb_int((80.0 / (40.0 - H)) * RND(1.0), tmp_1) \ D2 := 1.0 + (3.0 * tmp_1)GOTO 13801320 IF RND(1.0) > N THEN 1360N := N * 0.2PRINT "SHOT DUBBED, STILL IN TRAP."GOTO 6201360 N := 0.8GOTO 13001380 run ecb_str(D2, tmp_1$) \ PRINT "ON GREEN,"; tmp_1$; "FEET FROM THE PIN."PRINT "CHOOSE YOUR PUTT POTENCY (1 TO 13):";RUN _ecb_input_prefix_t \ INPUT "? ", I \ RUN _ecb_input_suffix_tS1 := S1 + 1IF S1 + 1.0 - P > (H * 0.072) + 2.0 THEN 1470IF K > 2.0 THEN 1470K := K + 1IF T = 4.0 THEN 1530D2 := D2 - I * (4.0 + 2.0 * RND(1.0)) + 1.51450 IF D2 < -2.0 THEN 1560IF D2 > 2.0 THEN 15001470 PRINT "YOU HOLED IT."PRINT F := F + 1GOTO 2301500 PRINT "PUTT SHORT."1505 RUN ecb_int(D2, D2)GOTO 13801530 D2 := D2 - I * (4.0 + 1.0 * RND(1.0)) + 1.0GOTO 14501560 PRINT "PASSED BY CUP."D2 := - D2GOTO 15051590 READ D, P, arr_L(1.0), arr_L(2.0)PRINT run ecb_str(float(F), tmp_1$) \ run ecb_str(D, tmp_2$) \ run ecb_str(P, tmp_3$) \ PRINT "YOU ARE AT THE TEE OFF HOLE"; tmp_1$; "DISTANCE"; tmp_2$; "YARDS, PAR"; tmp_3$G3 := G3 + PPRINT "ON YOUR RIGHT IS ";X := 1GOSUB 400PRINT "ON YOUR LEFT IS ";X := 2GOSUB 400GOTO 6201690 RETURNDATA 361.0, 4.0, 4.0, 2.0, 389.0, 4.0, 3.0, 3.0, 206.0, 3.0, 4.0, 2.0, 500.0, 5.0, 7.0, 2.0DATA 408.0, 4.0, 2.0, 4.0, 359.0, 4.0, 6.0, 4.0, 424.0, 4.0, 4.0, 2.0, 388.0, 4.0, 4.0, 4.0DATA 196.0, 3.0, 7.0, 2.0, 400.0, 4.0, 7.0, 2.0, 560.0, 5.0, 7.0, 2.0, 132.0, 3.0, 2.0, 2.0DATA 357.0, 4.0, 4.0, 4.0, 294.0, 4.0, 2.0, 4.0, 475.0, 5.0, 2.0, 3.0, 375.0, 4.0, 4.0, 2.0DATA 180.0, 3.0, 6.0, 2.0, 550.0, 5.0, 6.0, 6.01710 PRINT 1750 G2 := G2 + S1run ecb_str(G3, tmp_1$) \ run ecb_str(float(G2), tmp_2$) \ PRINT "TOTAL PAR FOR"; F - 1.0; "HOLES IS"; tmp_1$; "  YOUR TOTAL IS"; tmp_2$IF G1 = F - 1.0 THEN 1770GOTO 2921770 END