procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure lembase 0DIM B, I, R0: INTEGERA := 0.0A1 := 0.0A2 := 0.0A3 := 0.0A4 := 0.0B := 0B1 := 0.0C := 0.0D := 0.0D1 := 0.0F := 0.0F1 := 0.0G3 := 0.0G5 := 0.0H := 0.0H0 := 0.0H1 := 0.0I := 0K := 0.0M := 0.0M$ := ""M0 := 0.0M1 := 0.0M2 := 0.0N := 0.0N$ := ""P := 0.0Q$ := ""R := 0.0R0 := 0R1 := 0.0R2 := 0.0R3 := 0.0R4 := 0.0S := 0.0T := 0.0T1 := 0.0T2 := 0.0V0 := 0.0X := 0.0X1 := 0.0Z := 0.0Z$ := ""type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(35.0); "LEM"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"(* ROCKT2 IS AN INTERACTIVE GAME THAT SIMULATES A LUNAR *)(* LANDING IS SIMILAR TO THAT OF THE APOLLO PROGRAM. *)(* THERE IS ABSOLUTELY NO CHANCE INVOLVED *)Z$ := "GO"B1 := 1.020 M := 17.95F1 := 5.25N := 7.5R0 := 926V0 := 1.29T := 0.0H0 := 60.0R := R0 + H0A := -3.425R1 := 0.0A1 := 0.000884361R3 := 0.0A3 := 0.0M1 := 7.45M0 := M1B := 750T1 := 0.0F := 0.0P := 0.0N := 1.0M2 := 0.0S := 0.0C := 0.0IF Z$ = "YES" THEN 1150PRINT PRINT "LUNAR LANDING SIMULATION"PRINT PRINT "HAVE YOU FLOWN AN APOLLO/LEM MISSION BEFORE";160 PRINT " (YES OR NO)";RUN _ecb_input_prefix_t \ INPUT "? ", Q$ \ RUN _ecb_input_suffix_tIF Q$ = "YES" THEN 190IF Q$ = "NO" THEN 205PRINT "JUST ANSWER THE QUESTION, PLEASE, ";GOTO 160190 PRINT PRINT "INPUT MEASUREMENT OPTION NUMBER";GOTO 225205 PRINT PRINT "WHICH SYSTEM OF MEASUREMENT DO YOU PREFER?"PRINT " 1=METRIC     0=ENGLISH"220 PRINT "ENTER THE APPROPRIATE NUMBER";225 RUN _ecb_input_prefix_t \ INPUT "? ", K \ RUN _ecb_input_suffix_tPRINT IF K = 0.0 THEN 280IF K = 1.0 THEN 250GOTO 220250 Z := 1852.8M$ := "METERS"G3 := 3.6N$ := " KILOMETERS"G5 := 1000.0GOTO 305280 Z := 6080.0M$ := "FEET"G3 := 0.592N$ := "N.MILES"G5 := Z305 IF B1 = 3.0 THEN 670IF Q$ = "YES" THEN 485PRINT PRINT "  YOU ARE ON A LUNAR LANDING MISSION.  AS THE PILOT OF"PRINT "THE LUNAR EXCURSION MODULE, YOU WILL BE EXPECTED TO"PRINT "GIVE CERTAIN COMMANDS TO THE MODULE NAVIGATION SYSTEM."PRINT "THE ON-BOARD COMPUTER WILL GIVE A RUNNING ACCOUNT"PRINT "OF INFORMATION NEEDED TO NAVIGATE THE SHIP."PRINT PRINT PRINT "THE ATTITUDE ANGLE CALLED FOR IS DESCRIBED AS FOLLOWS."PRINT "+ OR -180 DEGREES IS DIRECTLY AWAY FROM THE MOON"PRINT "-90 DEGREES IS ON A TANGENT IN THE DIRECTION OF ORBIT"PRINT "+90 DEGREES IS ON A TANGENT FROM THE DIRECTION OF ORBIT"PRINT "0 (ZERO) DEGREES IS DIRECTLY TOWARD THE MOON"PRINT PRINT TAB(31.0); "-180|+180"PRINT TAB(35.0); "^"PRINT TAB(28.0); "-90 < -+- > +90"PRINT TAB(35.0); "!"PRINT TAB(35.0); "0"PRINT TAB(22.0); "<<<< DIRECTION OF ORBIT <<<<"PRINT PRINT TAB(21.0); "------ SURFACE OF MOON ------"PRINT PRINT PRINT "ALL ANGLES BETWEEN -180 AND +180 DEGREES ARE ACCEPTED."PRINT PRINT "1 FUEL UNIT = 1 SEC. AT MAX THRUST"PRINT "ANY DISCREPANCIES ARE ACCOUNTED FOR IN THE USE OF FUEL"PRINT "FOR AN ATTITUDE CHANGE."PRINT "AVAILABLE ENGINE POWER: 0 (ZERO) AND ANY VALUE BETWEEN"PRINT "10 AND 100 PERCENT."PRINT PRINT "NEGATIVE THRUST OR TIME IS PROHIBITED."PRINT 485 PRINT PRINT "INPUT: TIME INTERVAL IN SECONDS ------ (T)"PRINT "       PERCENTAGE OF THRUST ---------- (P)"PRINT "       ATTITUDE ANGLE IN DEGREES ----- (A)"PRINT IF Q$ = "YES" THEN 535PRINT "FOR EXAMPLE:"PRINT "T,P,A? 10,65,-60"PRINT "TO ABORT THE MISSION AT ANY TIME, ENTER 0,0,0"PRINT 535 PRINT "OUTPUT: TOTAL TIME IN ELAPSED SECONDS"PRINT "        HEIGHT IN "; M$PRINT "        DISTANCE FROM LANDING SITE IN "; M$PRINT "        VERTICAL VELOCITY IN "; M$; "/SECOND"PRINT "        HORIZONTAL VELOCITY IN "; M$; "/SECOND"PRINT "        FUEL UNITS REMAINING"PRINT GOTO 670575 PRINT 580 PRINT "T,P,A";RUN _ecb_input_prefix_t \ INPUT "? ", T1, F, P \ RUN _ecb_input_suffix_tF := F / 100.0IF T1 < 0.0 THEN 905IF T1 = 0.0 THEN 1090IF ABS(F - 0.05) > 1.0 THEN 945IF ABS(F - 0.05) < 0.05 THEN 945IF ABS(P) > 180.0 THEN 925620 N := 20.0IF T1 < 400.0 THEN 635N := T1 / 20.0635 T1 := T1 / NP := P * 3.14159 / 180.0S := SIN(P)C := COS(P)M2 := M0 * T1 * F / BR3 := -0.5 * R0 * ((V0 / R) ^ 2.0) + R * A1 * A1A3 := -2.0 * R1 * A1 / R670 FOR I = 1 TO N  IF M1 = 0.0 THEN 715  M1 := M1 - M2  IF M1 > 0.0 THEN 725  F := F * (1.0 + M1 / M2)  M2 := M1 + M2  PRINT "YOU ARE OUT OF FUEL."  M1 := 0.0  GOTO 725715   F := 0.0  M2 := 0.0725   M := M - 0.5 * M2  R4 := R3  R3 := -0.5 * R0 * ((V0 / R) ^ 2.0) + R * A1 * A1  R2 := (3.0 * R3 - R4) / 2.0 + 0.00526 * F1 * F * C / M  A4 := A3  A3 := -2.0 * R1 * A1 / R  A2 := (3.0 * A3 - A4) / 2.0 + 0.0056 * F1 * F * S / (M * R)  X := R1 * T1 + 0.5 * R2 * T1 * T1  R := R + X  H0 := H0 + X  R1 := R1 + R2 * T1  A := A + A1 * T1 + 0.5 * A2 * T1 * T1  A1 := A1 + A2 * T1  M := M - 0.5 * M2  T := T + T1  IF H0 < 0.0003287828 THEN 810NEXT I810 H := H0 * ZH1 := R1 * ZD := R0 * A * ZD1 := R * A1 * ZT2 := M1 * B / M0run ecb_str(T, tmp_1$) \ run ecb_str(H, tmp_2$) \ run ecb_str(D, tmp_3$) \ PRINT " "; tmp_1$; TAB(11.0); tmp_2$; TAB(24.0); tmp_3$;run ecb_str(H1, tmp_1$) \ run ecb_str(D1, tmp_2$) \ run ecb_str(T2, tmp_3$) \ PRINT TAB(38.0); tmp_1$; TAB(50.0); tmp_2$; TAB(61.0); tmp_3$IF H0 < 0.0003287828 THEN 880IF R0 * A > 164.474 THEN 1050IF M1 > 0.0 THEN 580T1 := 20.0F := 0.0P := 0.0GOTO 620880 IF R1 < -0.000821957 THEN 1020IF ABS(R * A1) > 0.000493174 THEN 1020IF H0 < -0.0003287828 THEN 1020IF ABS(D) > 10.0 * Z THEN 1065GOTO 995905 PRINT PRINT "THIS SPACECRAFT IS NOT ABLE TO VIOLATE THE SPACE-";PRINT "TIME CONTINUUM."GOTO 575925 PRINT PRINT "IF YOU WANT TO SPIN AROUND, GO OUTSIDE THE MODULE"PRINT "FOR AN E.V.A."GOTO 575945 PRINT PRINT "IMPOSSIBLE THRUST VALUE ";IF F < 0.0 THEN 985IF F - 0.05 < 0.05 THEN 975PRINT "TOO LARGE"GOTO 575975 PRINT "TOO SMALL"GOTO 575985 PRINT "NEGATIVE"GOTO 575995 PRINT PRINT "TRANQUILITY BASE HERE -- THE EAGLE HAS LANDED."PRINT "CONGRATULATIONS -- THERE WAS NO SPACECRAFT DAMAGE."PRINT "YOU MAY NOW PROCEED WITH SURFACE EXPLORATION."GOTO 11001020 PRINT PRINT "CRASH !!!!!!!!!!!!!!!!"run ecb_str(ABS(H), tmp_1$) \ PRINT "YOUR IMPACT CREATED A CRATER"; tmp_1$; M$; " DEEP."X1 := SQR(D1 * D1 + H1 * H1) * G3run ecb_str(X1, tmp_1$) \ PRINT "AT CONTACT YOU WERE TRAVELING"; tmp_1$; N$; "/HR"GOTO 11001050 PRINT PRINT "YOU HAVE BEEN LOST IN SPACE WITH NO HOPE OF RECOVERY."GOTO 11001065 PRINT "YOU ARE DOWN SAFELY - "PRINT run ecb_str(ABS(D / G5), tmp_1$) \ PRINT "BUT MISSED THE LANDING SITE BY"; tmp_1$; N$; "."GOTO 11001090 PRINT PRINT "MISSION ABENDED"1100 PRINT 1105 PRINT "DO YOU WANT TO TRY IT AGAIN (YES/NO)?"RUN _ecb_input_prefix_t \ INPUT "? ", Z$ \ RUN _ecb_input_suffix_tIF Z$ = "YES" THEN 20IF Z$ = "NO" THEN 1130GOTO 11051130 PRINT PRINT "TOO BAD, THE SPACE PROGRAM HATES TO LOSE EXPERIENCED"PRINT "ASTRONAUTS."STOP1150 PRINT PRINT "OK, DO YOU WANT THE COMPLETE INSTRUCTIONS OR THE INPUT -"PRINT "OUTPUT STATEMENTS?"1165 PRINT "1=COMPLETE INSTRUCTIONS"PRINT "2=INPUT-OUTPUT STATEMENTS"PRINT "3=NEITHER"RUN _ecb_input_prefix_t \ INPUT "? ", B1 \ RUN _ecb_input_suffix_tQ$ := "NO"IF B1 = 1.0 THEN 205Q$ := "YES"IF B1 = 2.0 THEN 190IF B1 = 3.0 THEN 190GOTO 1165END