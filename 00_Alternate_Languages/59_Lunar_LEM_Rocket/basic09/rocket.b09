procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure rocketbase 0DIM T: INTEGERA$ := ""B := 0.0D := 0.0F := 0.0H := 0.0T := 0V := 0.0V1 := 0.0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(31.0); "ROCKET"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT PRINT "LUNAR LANDING SIMULATION"PRINT "----- ------- ----------"PRINT RUN _ecb_input_prefix_t \ INPUT "DO YOU WANT INSTRUCTIONS (YES OR NO)? ", A$ \ RUN _ecb_input_suffix_tIF A$ = "NO" THEN 390PRINT PRINT "YOU ARE LANDING ON THE MOON AND AND HAVE TAKEN OVER MANUAL"PRINT "CONTROL 1000 FEET ABOVE A GOOD LANDING SPOT. YOU HAVE A DOWN-"PRINT "WARD VELOCITY OF 50 FEET/SEC. 150 UNITS OF FUEL REMAIN."PRINT PRINT "HERE ARE THE RULES THAT GOVERN YOUR APOLLO SPACE-CRAFT:"PRINT PRINT "(1) AFTER EACH SECOND THE HEIGHT, VELOCITY, AND REMAINING FUEL"PRINT "    WILL BE REPORTED VIA DIGBY YOUR ON-BOARD COMPUTER."PRINT "(2) AFTER THE REPORT A '?' WILL APPEAR. ENTER THE NUMBER"PRINT "    OF UNITS OF FUEL YOU WISH TO BURN DURING THE NEXT"PRINT "    SECOND. EACH UNIT OF FUEL WILL SLOW YOUR DESCENT BY"PRINT "    1 FOOT/SEC."PRINT "(3) THE MAXIMUM THRUST OF YOUR ENGINE IS 30 FEET/SEC/SEC"PRINT "    OR 30 UNITS OF FUEL PER SECOND."PRINT "(4) WHEN YOU CONTACT THE LUNAR SURFACE. YOUR DESCENT ENGINE"PRINT "    WILL AUTOMATICALLY SHUT DOWN AND YOU WILL BE GIVEN A"PRINT "    REPORT OF YOUR LANDING SPEED AND REMAINING FUEL."PRINT "(5) IF YOU RUN OUT OF FUEL THE '?' WILL NO LONGER APPEAR"PRINT "    BUT YOUR SECOND BY SECOND REPORT WILL CONTINUE UNTIL"PRINT "    YOU CONTACT THE LUNAR SURFACE."PRINT 390 PRINT "BEGINNING LANDING PROCEDURE.........."PRINT PRINT "G O O D  L U C K ! ! !"PRINT PRINT PRINT "SEC  FEET      SPEED     FUEL     PLOT OF DISTANCE"PRINT T := 0H := 1000.0V := 50.0F := 150.0490 run ecb_str(float(T), tmp_1$) \ run ecb_str(H, tmp_2$) \ run ecb_str(V, tmp_3$) \ run ecb_str(F, tmp_4$) \ PRINT tmp_1$; TAB(7.0); tmp_2$; TAB(17.0); tmp_3$; TAB(27.0); tmp_4$; TAB(36.0); "I"; TAB(INT(H / 15.0) + 1.0); "*"RUN _ecb_input_prefix_t \ INPUT "? ", B \ RUN _ecb_input_suffix_tIF B < 0.0 THEN 650IF B > 30.0 THEN  B := 30.0ENDIFIF B > F THEN  B := FENDIF540 V1 := V - B + 5.0F := F - BH := H - 0.5 * (V + V1)IF H <= 0.0 THEN 670T := T + 1V := V1IF F > 0.0 THEN 490IF B = 0.0 THEN 640PRINT "**** OUT OF FUEL ****"640 run ecb_str(float(T), tmp_1$) \ run ecb_str(H, tmp_2$) \ run ecb_str(V, tmp_3$) \ run ecb_str(F, tmp_4$) \ PRINT tmp_1$; TAB(5.0); tmp_2$; TAB(13.0); tmp_3$; TAB(21.0); tmp_4$; TAB(30.0); "I"; TAB(INT(H / 12.0 + 29.0) + 1.0); "*"650 B := 0.0GOTO 540670 PRINT "***** CONTACT *****"H := H + 0.5 * (V1 + V)IF B = 5.0 THEN 720D := (- V + SQR(V * V + H * (10.0 - 2.0 * B))) / (5.0 - B)GOTO 730720 D := H / V730 V1 := V + (5.0 - B) * DPRINT "TOUCHDOWN AT"; T + D; "SECONDS."run ecb_str(V1, tmp_1$) \ PRINT "LANDING VELOCITY="; tmp_1$; "FEET/SEC."run ecb_str(F, tmp_1$) \ PRINT tmp_1$; "UNITS OF FUEL REMAINING."IF V1 <> 0.0 THEN 810PRINT "CONGRATULATIONS! A PERFECT LANDING!!"PRINT "YOUR LICENSE WILL BE RENEWED.......LATER."810 IF ABS(V1) < 2.0 THEN 840PRINT "***** SORRY, BUT YOU BLEW IT!!!!"PRINT "APPROPRIATE CONDOLENCES WILL BE SENT TO YOUR NEXT OF KIN."840 PRINT PRINT PRINT RUN _ecb_input_prefix_t \ INPUT "ANOTHER MISSION? ", A$ \ RUN _ecb_input_suffix_tIF A$ = "YES" THEN 390PRINT PRINT "CONTROL OUT."PRINT END