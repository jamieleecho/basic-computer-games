procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure lunarbase 0DIM N: INTEGERA := 0.0D := 0.0G := 0.0I := 0.0J := 0.0K := 0.0L := 0.0M := 0.0N := 0Q := 0.0S := 0.0T := 0.0V := 0.0W := 0.0Z := 0.0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(34.0); "LUNAR"PRINT TAB(16.0); "CREATIVE COMPUTING MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT PRINT "THIS IS A COMPUTER SIMULATION OF AN APOLLO LUNAR"PRINT "LANDING CAPSULE."PRINT PRINT PRINT "THE ON-BOARD COMPUTER HAS FAILED (IT WAS MADE BY"PRINT "XEROX) SO YOU HAVE TO LAND THE CAPSULE MANUALLY."70 PRINT PRINT "SET BURN RATE OF RETRO ROCKETS TO ANY VALUE BETWEEN"PRINT "0 (FREE FALL) AND 200 (MAXIMUM BURN) POUNDS PER SECOND."PRINT "SET NEW BURN RATE EVERY 10 SECONDS."PRINT PRINT "CAPSULE WEIGHT 32,500 LBS; FUEL WEIGHT 16,000 LBS."PRINT PRINT PRINT PRINT "GOOD LUCK"L := 0.0PRINT PRINT "SEC", "MI + FT", "MPH", "LB FUEL", "BURN RATE"PRINT A := 120.0V := 1.0M := 33000.0N := 16500G := 0.001Z := 1.8150 run ecb_str(L, tmp_1$) \ RUN ecb_int(A, tmp_1) \ run ecb_str(tmp_1, tmp_2$) \ RUN ecb_int(A, tmp_2) \ RUN ecb_int(5280.0 * (A - tmp_2), tmp_3) \ run ecb_str(tmp_3, tmp_3$) \ PRINT tmp_1$, tmp_2$; tmp_3$, 3600.0 * V, M - N,RUN _ecb_input_prefix_t \ INPUT "? ", K \ RUN _ecb_input_suffix_tT := 10.0160 IF M - N < 0.001 THEN 240IF T < 0.001 THEN 150S := TIF M >= N + S * K THEN 200S := (M - N) / K200 GOSUB 420IF I <= 0.0 THEN 340IF V <= 0.0 THEN 230IF J < 0.0 THEN 370230 GOSUB 330GOTO 160240 run ecb_str(L, tmp_1$) \ PRINT "FUEL OUT AT"; tmp_1$; "SECONDS"S := (- V + SQR(V * V + 2.0 * A * G)) / GV := V + G * SL := L + S260 W := 3600.0 * Vrun ecb_str(L, tmp_1$) \ run ecb_str(W, tmp_2$) \ PRINT "ON MOON AT"; tmp_1$; "SECONDS - IMPACT VELOCITY"; tmp_2$; "MPH"IF W <= 1.2 THEN  PRINT "PERFECT LANDING!"  GOTO 440ENDIFIF W <= 10.0 THEN  PRINT "GOOD LANDING (COULD BE BETTER)"  GOTO 440ENDIFIF W > 60.0 THEN 300PRINT "CRAFT DAMAGE... YOU'RE STRANDED HERE UNTIL A RESCUE"PRINT "PARTY ARRIVES. HOPE YOU HAVE ENOUGH OXYGEN!"GOTO 440300 PRINT "SORRY THERE WERE NO SURVIVORS. YOU BLEW IT!"PRINT "IN FACT, YOU BLASTED A NEW LUNAR CRATER"; W * 0.227; "FEET DEEP!"GOTO 440330 L := L + ST := T - SM := M - S * KA := IV := JRETURN340 IF S < 0.005 THEN 260D := V + SQR(V * V + 2.0 * A * (G - Z * K / M))S := 2.0 * A / DGOSUB 420GOSUB 330GOTO 340370 W := (1.0 - M * G / (Z * K)) / 2.0S := M * V / (Z * K * (W + SQR(W * W + V / Z))) + 0.05GOSUB 420IF I <= 0.0 THEN 340GOSUB 330IF J > 0.0 THEN 160IF V > 0.0 THEN 370GOTO 160420 Q := S * K / MJ := V + G * S + Z * (- Q - Q * Q / 2.0 - Q ^ 3.0 / 3.0 - Q ^ 4.0 / 4.0 - Q ^ 5.0 / 5.0)I := A - G * S * S / 2.0 - V * S + Z * S * (Q / 2.0 + Q ^ 2.0 / 6.0 + Q ^ 3.0 / 12.0 + Q ^ 4.0 / 20.0 + Q ^ 5.0 / 30.0)RETURN440 PRINT PRINT PRINT PRINT "TRY AGAIN??"GOTO 70