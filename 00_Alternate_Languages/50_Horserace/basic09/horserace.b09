procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure horseracebase 0DIM A, F, H, I, J, L, M, Z9: INTEGERA := 0B := 0.0C := 0.0F := 0H := 0I := 0J := 0L := 0M := 0N := 0.0O$ := ""R := 0.0S := 0.0T := 0.0X$ := ""Z9 := 0DIM arr_D(11)FOR tmp_1 = 0 TO 10 \ arr_D(tmp_1) := 0 \ NEXT tmp_1DIM arr_M(11): INTEGERFOR tmp_1 = 0 TO 10 \ arr_M(tmp_1) := 0 \ NEXT tmp_1DIM arr_P(11)FOR tmp_1 = 0 TO 10 \ arr_P(tmp_1) := 0 \ NEXT tmp_1DIM arr_Q(11)FOR tmp_1 = 0 TO 10 \ arr_Q(tmp_1) := 0 \ NEXT tmp_1DIM arr_V$(11)FOR tmp_1 = 0 TO 10 \ arr_V$(tmp_1) := "" \ NEXT tmp_1DIM arr_W$(11)FOR tmp_1 = 0 TO 10 \ arr_W$(tmp_1) := "" \ NEXT tmp_1DIM arr_Y(11)FOR tmp_1 = 0 TO 10 \ arr_Y(tmp_1) := 0 \ NEXT tmp_1type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(32.0); "HORSERACE"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT DIM arr_S(9)FOR tmp_1 = 0 TO 8 \ arr_S(tmp_1) := 0 \ NEXT tmp_1PRINT "WELCOME TO SOUTH PORTLAND HIGH RACETRACK"PRINT "                      ...OWNED BY LAURIE CHEVALIER"PRINT "DO YOU WANT DIRECTIONS";RUN _ecb_input_prefix_t \ INPUT "? ", X$ \ RUN _ecb_input_suffix_tIF X$ = "NO" THEN 320PRINT "UP TO 10 MAY PLAY.  A TABLE OF ODDS WILL BE PRINTED.  YOU"PRINT "MAY BET ANY + AMOUNT UNDER 100000 ON ONE HORSE."PRINT "DURING THE RACE, A HORSE WILL BE SHOWN BY ITS"PRINT "NUMBER.  THE HORSES RACE DOWN THE PAPER!"PRINT 320 PRINT "HOW MANY WANT TO BET";RUN _ecb_input_prefix_t \ INPUT "? ", C \ RUN _ecb_input_suffix_tPRINT "WHEN ? APPEARS,TYPE NAME"FOR A = 1 TO C  RUN _ecb_input_prefix_t \ INPUT "? ", arr_W$(A) \ RUN _ecb_input_suffix_tNEXT A380 PRINT PRINT "HORSE", "", "NUMBER", "ODDS"PRINT FOR I = 1 TO 8arr_S(I) := 0.0NEXT ILET R := 0.0FOR A = 1 TO 8  RUN ecb_int(10.0 * RND(1.0) + 1.0, arr_D(A))NEXT AFOR A = 1 TO 8  LET R := R + arr_D(A)NEXT ALET arr_V$(1.0) := "JOE MAW"LET arr_V$(2.0) := "L.B.J."LET arr_V$(3.0) := "MR.WASHBURN"LET arr_V$(4.0) := "MISS KAREN"LET arr_V$(5.0) := "JOLLY"LET arr_V$(6.0) := "HORSE"LET arr_V$(7.0) := "JELLY DO NOT"LET arr_V$(8.0) := "MIDNIGHT"FOR N = 1.0 TO 8.0  run ecb_str(N, tmp_1$) \ PRINT arr_V$(INT(N)), "", tmp_1$, R / arr_D(INT(N)); ":1"NEXT NPRINT "--------------------------------------------------"PRINT "PLACE YOUR BETS...HORSE # THEN AMOUNT"FOR J = 1 TO C630   PRINT arr_W$(J);  RUN _ecb_input_prefix_t \ INPUT "? ", arr_Q(J), arr_P(J) \ RUN _ecb_input_suffix_t  IF arr_P(J) < 1.0 THEN 670  IF arr_P(J) < 100000.0 THEN 690670   PRINT "  YOU CAN'T DO THAT!"  GOTO 630690 NEXT JPRINT PRINT "1 2 3 4 5 6 7 8"720 PRINT "XXXXSTARTXXXX"FOR I = 1 TO 8  LET M := I  LET arr_M(I) := M  RUN ecb_int(100.0 * RND(1.0) + 1.0, arr_Y(arr_M(I)))  IF arr_Y(arr_M(I)) < 10.0 THEN 860  RUN ecb_int(R / arr_D(I) + 0.5, S)  IF arr_Y(arr_M(I)) < S + 17.0 THEN 880  IF arr_Y(arr_M(I)) < S + 37.0 THEN 900  IF arr_Y(arr_M(I)) < S + 57.0 THEN 920  IF arr_Y(arr_M(I)) < 77.0 + S THEN 940  IF arr_Y(arr_M(I)) < S + 92.0 THEN 960  LET arr_Y(arr_M(I)) := 7.0  GOTO 970860   LET arr_Y(arr_M(I)) := 1.0  GOTO 970880   LET arr_Y(arr_M(I)) := 2.0  GOTO 970900   LET arr_Y(arr_M(I)) := 3.0  GOTO 970920   LET arr_Y(arr_M(I)) := 4.0  GOTO 970940   LET arr_Y(arr_M(I)) := 5.0  GOTO 970960   LET arr_Y(arr_M(I)) := 6.0970 NEXT ILET M := IFOR I = 1 TO 8  LET arr_S(arr_M(I)) := arr_S(arr_M(I)) + arr_Y(arr_M(I))NEXT ILET I := 1FOR L = 1 TO 8  FOR I = 1 TO 8 - L    IF arr_S(arr_M(I)) < arr_S(arr_M(I + 1)) THEN 1090    LET H := arr_M(I)    LET arr_M(I) := arr_M(I + 1)    LET arr_M(I + 1) := H1090   NEXT INEXT LLET T := arr_S(arr_M(8))FOR I = 1 TO 8  LET B := arr_S(arr_M(I)) - arr_S(arr_M(I - 1))  IF B = 0.0 THEN 1190  FOR A = 1 TO B    PRINT     IF arr_S(arr_M(I)) > 27.0 THEN 1240  NEXT A1190   run ecb_str(float(arr_M(I)), tmp_1$) \ PRINT tmp_1$;NEXT IFOR A = 1 TO 28 - T  PRINT NEXT A1240 PRINT "XXXXFINISHXXXX";PRINT PRINT PRINT "---------------------------------------------"PRINT IF T < 28.0 THEN 720PRINT "THE RACE RESULTS ARE:"LET Z9 := 1FOR I = 8 TO 1 STEP -1  LET F := arr_M(I)  PRINT   run ecb_str(float(Z9), tmp_1$) \ run ecb_str(float(F), tmp_2$) \ PRINT tmp_1$; "PLACE HORSE NO."; tmp_2$, "AT "; R / arr_D(F); ":1"  LET Z9 := Z9 + 1NEXT IFOR J = 1 TO C  IF arr_Q(J) <> arr_M(8) THEN 1370  LET N := arr_Q(J)  PRINT   PRINT arr_W$(J); " WINS $"; (R / arr_D(INT(N))) * arr_P(J)1370 NEXT JPRINT "DO YOU WANT TO BET ON THE NEXT RACE ?"RUN _ecb_input_prefix_t \ INPUT "YES OR NO? ", O$ \ RUN _ecb_input_suffix_tIF O$ = "YES" THEN 380END