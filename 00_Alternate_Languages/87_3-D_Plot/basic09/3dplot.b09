procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure _3dplotbase 0DIM Y, Y1: INTEGERL := 0.0X := 0.0Y := 0Y1 := 0Z := 0.0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(33.0); "3D PLOT"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT (* DEF FNA(Z)=30*EXP(-Z*Z/100) *)PRINT FOR X = -30.0 TO 30.0 STEP 1.5  L := 0.0  RUN ecb_int(SQR(900.0 - X * X) / 5.0, tmp_1) \ Y1 := 5 * tmp_1  FOR Y = Y1 TO - Y1 STEP -5    fnA_1 := SQR(X * X + Y * Y) \ RUN ecb_int(25.0 + (30.0 * EXP(- fnA_1 * fnA_1 / 100.0)) - 0.7 * Y, Z)    IF Z <= L THEN 190    L := Z    PRINT TAB(INT(Z) + 1.0); "*";190   NEXT Y  PRINT NEXT XEND