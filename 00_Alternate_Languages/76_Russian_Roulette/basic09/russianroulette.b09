procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure russianroulettebase 0DIM N: INTEGERI := 0.0N := 0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(29.0); "RUSSIAN ROULETTE"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT PRINT "THIS IS A GAME OF >>>>>>>>>>RUSSIAN ROULETTE."10 PRINT PRINT "HERE IS A REVOLVER."20 PRINT "TYPE '1' TO SPIN CHAMBER AND PULL TRIGGER."PRINT "TYPE '2' TO GIVE UP."PRINT "GO";N := 030 RUN _ecb_input_prefix_t \ INPUT "? ", I \ RUN _ecb_input_suffix_tIF I <> 2.0 THEN 35PRINT "     CHICKEN!!!!!"GOTO 7235 N := N + 1IF RND(1.0) > 0.833333 THEN 70IF N > 10.0 THEN 80PRINT "- CLICK -"PRINT GOTO 3070 PRINT "     BANG!!!!!   YOU'RE DEAD!"PRINT "CONDOLENCES WILL BE SENT TO YOUR RELATIVES."72 PRINT PRINT PRINT PRINT "...NEXT VICTIM..."GOTO 2080 PRINT "YOU WIN!!!!!"PRINT "LET SOMEONE ELSE BLOW HIS BRAINS OUT."GOTO 10END