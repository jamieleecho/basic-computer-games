procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure buzzwordbase 0DIM I: INTEGERI := 0Y$ := ""type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(27.0); "BUZZWORD GENERATOR"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT PRINT "THIS PROGRAM PRINTS HIGHLY ACCEPTABLE PHRASES IN"PRINT "'EDUCATOR-SPEAK' THAT YOU CAN WORK INTO REPORTS"PRINT "AND SPEECHES.  WHENEVER A QUESTION MARK IS PRINTED,"PRINT "TYPE A 'Y' FOR ANOTHER PHRASE OR 'N' TO QUIT."PRINT PRINT PRINT "HERE'S THE FIRST PHRASE:"DIM arr_A$(41)FOR tmp_1 = 0 TO 40 \ arr_A$(tmp_1) := "" \ NEXT tmp_1FOR I = 1 TO 39READ arr_A$(I)NEXT I110 RUN ecb_int(13.0 * RND(1.0) + 1.0, tmp_1) \ PRINT arr_A$(tmp_1); " ";RUN ecb_int(13.0 * RND(1.0) + 14.0, tmp_1) \ PRINT arr_A$(tmp_1); " ";RUN ecb_int(13.0 * RND(1.0) + 27.0, tmp_1) \ PRINT arr_A$(tmp_1)PRINT RUN _ecb_input_prefix_t \ INPUT "? ", Y$ \ RUN _ecb_input_suffix_tIF Y$ = "Y" THEN 110GOTO 999DATA "ABILITY", "BASAL", "BEHAVIORAL", "CHILD-CENTERED"DATA "DIFFERENTIATED", "DISCOVERY", "FLEXIBLE", "HETEROGENEOUS"DATA "HOMOGENEOUS", "MANIPULATIVE", "MODULAR", "TAVISTOCK"DATA "INDIVIDUALIZED", "LEARNING", "EVALUATIVE", "OBJECTIVE"DATA "COGNITIVE", "ENRICHMENT", "SCHEDULING", "HUMANISTIC"DATA "INTEGRATED", "NON-GRADED", "TRAINING", "VERTICAL AGE"DATA "MOTIVATIONAL", "CREATIVE", "GROUPING", "MODIFICATION"DATA "ACCOUNTABILITY", "PROCESS", "CORE CURRICULUM", "ALGORITHM"DATA "PERFORMANCE", "REINFORCEMENT", "OPEN CLASSROOM", "RESOURCE"DATA "STRUCTURE", "FACILITY", "ENVIRONMENT"999 PRINT "COME BACK WHEN YOU NEED HELP WITH ANOTHER REPORT!"END