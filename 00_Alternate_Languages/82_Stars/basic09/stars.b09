procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure starsbase 0DIM A, K, M, N: INTEGERA := 0A$ := ""D := 0.0G := 0.0K := 0M := 0N := 0X := 0.0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(35.0); "STARS"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT (* *** STARS - PEOPLE'S COMPUTER CENTER, MENLO PARK, CA *)(* *** A IS LIMIT ON NUMBER, M IS NUMBER OF GUESSES *)A := 100M := 7RUN _ecb_input_prefix_t \ INPUT "DO YOU WANT INSTRUCTIONS? ", A$ \ RUN _ecb_input_suffix_tIF LEFT$(A$, 1.0) = "N" THEN 280(* *** INSTRUCTIONS ON HOW TO PLAY *)run ecb_str(float(A), tmp_1$) \ PRINT "I AM THINKING OF A WHOLE NUMBER FROM 1 TO"; tmp_1$PRINT "TRY TO GUESS MY NUMBER.  AFTER YOU GUESS, I"PRINT "WILL TYPE ONE OR MORE STARS (*).  THE MORE"PRINT "STARS I TYPE, THE CLOSER YOU ARE TO MY NUMBER."PRINT "ONE STAR (*) MEANS FAR AWAY, SEVEN STARS (*******)"run ecb_str(float(M), tmp_1$) \ PRINT "MEANS REALLY CLOSE!  YOU GET"; tmp_1$; "GUESSES."(* *** COMPUTER THINKS OF A NUMBER *)280 PRINT PRINT RUN ecb_int(A * RND(1.0) + 1.0, X)PRINT "OK, I AM THINKING OF A NUMBER, START GUESSING."(* *** GUESSING BEGINS, HUMAN GETS M GUESSES *)FOR K = 1 TO M  PRINT   PRINT "YOUR GUESS";  RUN _ecb_input_prefix_t \ INPUT "? ", G \ RUN _ecb_input_suffix_t  IF G = X THEN 600  D := ABS(G - X)  IF D >= 64.0 THEN 510  IF D >= 32.0 THEN 500  IF D >= 16.0 THEN 490  IF D >= 8.0 THEN 480  IF D >= 4.0 THEN 470  IF D >= 2.0 THEN 460  PRINT "*";460   PRINT "*";470   PRINT "*";480   PRINT "*";490   PRINT "*";500   PRINT "*";510   PRINT "*";  PRINT NEXT K(* *** DID NOT GUESS IN M GUESSES *)PRINT run ecb_str(float(M), tmp_1$) \ run ecb_str(X, tmp_2$) \ PRINT "SORRY, THAT'S"; tmp_1$; "GUESSES. THE NUMBER WAS"; tmp_2$GOTO 650(* *** WE HAVE A WINNER *)600   PRINT FOR N = 1 TO 79  PRINT "*";NEXT NPRINT PRINT run ecb_str(float(K), tmp_1$) \ PRINT "YOU GOT IT IN"; tmp_1$; "GUESSES!!!  LET'S PLAY AGAIN..."650 GOTO 280END