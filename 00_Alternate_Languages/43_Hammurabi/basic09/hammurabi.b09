procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure hammurabibase 0DIM N, Z: INTEGERA := 0.0C := 0.0D := 0.0D1 := 0.0E := 0.0H := 0.0I := 0.0L := 0.0N := 0P := 0.0P1 := 0.0Q := 0.0S := 0.0Y := 0.0Z := 0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(33.0); "HAMURABI"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT PRINT "TRY YOUR HAND AT GOVERNING ANCIENT SUMERIA"PRINT "FOR A TEN-YEAR TERM OF OFFICE."PRINT D1 := 0.0P1 := 0.0Z := 0P := 95.0S := 2800.0H := 3000.0E := H - SY := 3.0A := H / YI := 5.0Q := 1.0210 D := 0.0215 PRINT PRINT PRINT "HAMURABI:  I BEG TO REPORT TO YOU,"Z := Z + 1run ecb_str(float(Z), tmp_1$) \ run ecb_str(D, tmp_2$) \ run ecb_str(I, tmp_3$) \ PRINT "IN YEAR"; tmp_1$; ","; tmp_2$; "PEOPLE STARVED,"; tmp_3$; "CAME TO THE CITY,"P := P + IIF Q > 0.0 THEN 230RUN ecb_int(P / 2.0, P)PRINT "A HORRIBLE PLAGUE STRUCK!  HALF THE PEOPLE DIED."230 run ecb_str(P, tmp_1$) \ PRINT "POPULATION IS NOW"; tmp_1$run ecb_str(A, tmp_1$) \ PRINT "THE CITY NOW OWNS "; tmp_1$; "ACRES."run ecb_str(Y, tmp_1$) \ PRINT "YOU HARVESTED"; tmp_1$; "BUSHELS PER ACRE."run ecb_str(E, tmp_1$) \ PRINT "THE RATS ATE"; tmp_1$; "BUSHELS."run ecb_str(S, tmp_1$) \ PRINT "YOU NOW HAVE "; tmp_1$; "BUSHELS IN STORE."PRINT IF Z = 11.0 THEN 860RUN ecb_int(10.0 * RND(1.0), C)Y := C + 17.0run ecb_str(Y, tmp_1$) \ PRINT "LAND IS TRADING AT"; tmp_1$; "BUSHELS PER ACRE."320 PRINT "HOW MANY ACRES DO YOU WISH TO BUY";RUN _ecb_input_prefix_t \ INPUT "? ", Q \ RUN _ecb_input_suffix_tIF Q < 0.0 THEN 850IF Y * Q <= S THEN 330GOSUB 710GOTO 320330 IF Q = 0.0 THEN 340A := A + QS := S - Y * QC := 0.0GOTO 400340 PRINT "HOW MANY ACRES DO YOU WISH TO SELL";RUN _ecb_input_prefix_t \ INPUT "? ", Q \ RUN _ecb_input_suffix_tIF Q < 0.0 THEN 850IF Q < A THEN 350GOSUB 720GOTO 340350 A := A - QS := S + Y * QC := 0.0400 PRINT 410 PRINT "HOW MANY BUSHELS DO YOU WISH TO FEED YOUR PEOPLE";RUN _ecb_input_prefix_t \ INPUT "? ", Q \ RUN _ecb_input_suffix_tIF Q < 0.0 THEN 850(* *** TRYING TO USE MORE GRAIN THAN IS IN SILOS? *)IF Q <= S THEN 430GOSUB 710GOTO 410430 S := S - QC := 1.0PRINT 440 PRINT "HOW MANY ACRES DO YOU WISH TO PLANT WITH SEED";RUN _ecb_input_prefix_t \ INPUT "? ", D \ RUN _ecb_input_suffix_tIF D = 0.0 THEN 511IF D < 0.0 THEN 850(* *** TRYING TO PLANT MORE ACRES THAN YOU OWN? *)IF D <= A THEN 450GOSUB 720GOTO 440(* *** ENOUGH GRAIN FOR SEED? *)450 RUN ecb_int(D / 2.0, tmp_1) \ IF tmp_1 <= S THEN 455GOSUB 710GOTO 440(* *** ENOUGH PEOPLE TO TEND THE CROPS? *)455 IF D < 10.0 * P THEN 510run ecb_str(P, tmp_1$) \ PRINT "BUT YOU HAVE ONLY"; tmp_1$; "PEOPLE TO TEND THE FIELDS!  NOW THEN,"GOTO 440510 RUN ecb_int(D / 2.0, tmp_1) \ S := S - tmp_1511 GOSUB 800(* *** A BOUNTIFUL HARVEST! *)Y := CH := D * YE := 0.0GOSUB 800RUN ecb_int(C / 2.0, tmp_1) \ IF tmp_1 <> C / 2.0 THEN 530(* *** RATS ARE RUNNING WILD!! *)RUN ecb_int(S / C, E)530 S := S - E + HGOSUB 800(* *** LET'S HAVE SOME BABIES *)RUN ecb_int(C * (20.0 * A + S) / P / 100.0 + 1.0, I)(* *** HOW MANY PEOPLE HAD FULL TUMMIES? *)RUN ecb_int(Q / 20.0, C)(* *** HORROS, A 15% CHANCE OF PLAGUE *)RUN ecb_int(10.0 * (2.0 * RND(1.0) - 0.3), Q)IF P < C THEN 210(* *** STARVE ENOUGH FOR IMPEACHMENT? *)D := P - CIF D > 0.45 * P THEN 560P1 := ((Z - 1.0) * P1 + D * 100.0 / P) / ZP := CD1 := D1 + DGOTO 215560 PRINT run ecb_str(D, tmp_1$) \ PRINT "YOU STARVED"; tmp_1$; "PEOPLE IN ONE YEAR!!!"565 PRINT "DUE TO THIS EXTREME MISMANAGEMENT YOU HAVE NOT ONLY"PRINT "BEEN IMPEACHED AND THROWN OUT OF OFFICE BUT YOU HAVE"PRINT "ALSO BEEN DECLARED NATIONAL FINK!!!!"GOTO 990710 PRINT "HAMURABI:  THINK AGAIN.  YOU HAVE ONLY"run ecb_str(S, tmp_1$) \ PRINT tmp_1$; "BUSHELS OF GRAIN.  NOW THEN,"RETURN720 run ecb_str(A, tmp_1$) \ PRINT "HAMURABI:  THINK AGAIN.  YOU OWN ONLY"; tmp_1$; "ACRES.  NOW THEN,"RETURN800 RUN ecb_int(RND(1.0) * 5.0, tmp_1) \ C := tmp_1 + 1.0RETURN850 PRINT PRINT "HAMURABI:  I CANNOT DO WHAT YOU WISH."PRINT "GET YOURSELF ANOTHER STEWARD!!!!!"GOTO 990860 run ecb_str(P1, tmp_1$) \ PRINT "IN YOUR 10-YEAR TERM OF OFFICE,"; tmp_1$; "PERCENT OF THE"PRINT "POPULATION STARVED PER YEAR ON THE AVERAGE, I.E. A TOTAL OF"run ecb_str(D1, tmp_1$) \ PRINT tmp_1$; "PEOPLE DIED!!"L := A / PPRINT "YOU STARTED WITH 10 ACRES PER PERSON AND ENDED WITH"run ecb_str(L, tmp_1$) \ PRINT tmp_1$; "ACRES PER PERSON."PRINT IF P1 > 33.0 THEN 565IF L < 7.0 THEN 565IF P1 > 10.0 THEN 940IF L < 9.0 THEN 940IF P1 > 3.0 THEN 960IF L < 10.0 THEN 960PRINT "A FANTASTIC PERFORMANCE!!!  CHARLEMANGE, DISRAELI, AND"PRINT "JEFFERSON COMBINED COULD NOT HAVE DONE BETTER!"GOTO 990940 PRINT "YOUR HEAVY-HANDED PERFORMANCE SMACKS OF NERO AND IVAN IV."PRINT "THE PEOPLE (REMAINING) FIND YOU AN UNPLEASANT RULER, AND,"PRINT "FRANKLY, HATE YOUR GUTS!!"GOTO 990960 PRINT "YOUR PERFORMANCE COULD HAVE BEEN SOMEWHAT BETTER, BUT"RUN ecb_int(P * 0.8 * RND(1.0), tmp_1) \ run ecb_str(tmp_1, tmp_1$) \ PRINT "REALLY WASN'T TOO BAD AT ALL. "; tmp_1$; "PEOPLE"PRINT "WOULD DEARLY LIKE TO SEE YOU ASSASSINATED BUT WE ALL HAVE OUR"PRINT "TRIVIAL PROBLEMS."990 PRINT FOR N = 1 TO 10PRINT CHR$(7.0);NEXT NPRINT "SO LONG FOR NOW."PRINT END