procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure digitsbase 0DIM G, I, J, Q, T, U: INTEGERA := 0.0B := 0.0C := 0.0E := 0.0G := 0I := 0J := 0N := 0.0Q := 0S := 0.0S1 := 0.0T := 0U := 0W := 0.0X := 0.0Z := 0.0Z1 := 0.0Z2 := 0.0DIM arr_N(11)FOR tmp_1 = 0 TO 10 \ arr_N(tmp_1) := 0 \ NEXT tmp_1type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(34.0); "DIGITS"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT PRINT "THIS IS A GAME OF GUESSING."PRINT "FOR INSTRUCTIONS, TYPE '1', ELSE TYPE '0'";RUN _ecb_input_prefix_t \ INPUT "? ", E \ RUN _ecb_input_suffix_tIF E = 0.0 THEN 360PRINT PRINT "PLEASE TAKE A PIECE OF PAPER AND WRITE DOWN"PRINT "THE DIGITS '0', '1', OR '2' THIRTY TIMES AT RANDOM."PRINT "ARRANGE THEM IN THREE LINES OF TEN DIGITS EACH."PRINT "I WILL ASK FOR THEN TEN AT A TIME."PRINT "I WILL ALWAYS GUESS THEM FIRST AND THEN LOOK AT YOUR"PRINT "NEXT NUMBER TO SEE IF I WAS RIGHT. BY PURE LUCK,"PRINT "I OUGHT TO BE RIGHT TEN TIMES. BUT I HOPE TO DO BETTER"PRINT "THAN THAT *****"PRINT PRINT 360 READ A, B, CDATA 0.0, 1.0, 3.0DIM arr_M(27, 3), arr_K(3, 3), arr_L(9, 3): INTEGERFOR tmp_1 = 0 TO 26 \ FOR tmp_2 = 0 TO 2 \ arr_M(tmp_1, tmp_2) := 0 \ NEXT tmp_2 \ NEXT tmp_1FOR tmp_1 = 0 TO 2 \ FOR tmp_2 = 0 TO 2 \ arr_K(tmp_1, tmp_2) := 0 \ NEXT tmp_2 \ NEXT tmp_1FOR tmp_1 = 0 TO 8 \ FOR tmp_2 = 0 TO 2 \ arr_L(tmp_1, tmp_2) := 0 \ NEXT tmp_2 \ NEXT tmp_1400 FOR I = 0 TO 26FOR J = 0 TO 2arr_M(I, J) := 1NEXT JNEXT IFOR I = 0 TO 2FOR J = 0 TO 2arr_K(I, J) := 9NEXT JNEXT IFOR I = 0 TO 8FOR J = 0 TO 2arr_L(I, J) := 3NEXT JNEXT Iarr_L(0, 0) := 2arr_L(4, 1) := 2arr_L(8, 2) := 2Z := 26.0Z1 := 8.0Z2 := 2.0X := 0.0FOR T = 1 TO 3530   PRINT   PRINT "TEN NUMBERS, PLEASE";  RUN _ecb_input_prefix_t \ INPUT "? ", arr_N(1.0), arr_N(2.0), arr_N(3.0), arr_N(4.0), arr_N(5.0), arr_N(6.0), arr_N(7.0), arr_N(8.0), arr_N(9.0), arr_N(10.0) \ RUN _ecb_input_suffix_t  FOR I = 1 TO 10    W := arr_N(I) - 1.0    IF W = SGN(W) THEN 620    PRINT "ONLY USE THE DIGITS '0', '1', OR '2'."    PRINT "LET'S TRY AGAIN."    GOTO 530620   NEXT I  PRINT   PRINT "MY GUESS", "YOUR NO.", "RESULT", "NO. RIGHT"  PRINT   FOR U = 1 TO 10    N := arr_N(U)    S := 0.0    FOR J = 0 TO 2      S1 := A * arr_K(INT(Z2), J) + B * arr_L(INT(Z1), J) + C * arr_M(INT(Z), J)      IF S > S1 THEN 760      IF S < S1 THEN 740      IF RND(1.0) < 0.5 THEN 760740       S := S1      G := J760     NEXT J    run ecb_str(float(G), tmp_1$) \ run ecb_str(arr_N(U), tmp_2$) \ PRINT "  "; tmp_1$, "   "; tmp_2$,    IF G = arr_N(U) THEN 810    run ecb_str(X, tmp_1$) \ PRINT " WRONG", tmp_1$    GOTO 880810     X := X + 1.0    run ecb_str(X, tmp_1$) \ PRINT " RIGHT", tmp_1$    arr_M(INT(Z), INT(N)) := arr_M(INT(Z), INT(N)) + 1    arr_L(INT(Z1), INT(N)) := arr_L(INT(Z1), INT(N)) + 1    arr_K(INT(Z2), INT(N)) := arr_K(INT(Z2), INT(N)) + 1    RUN ecb_int(Z / 9.0, tmp_1) \ Z := Z - tmp_1 * 9.0    Z := 3.0 * Z + arr_N(U)880     RUN ecb_int(Z / 9.0, tmp_1) \ Z1 := Z - tmp_1 * 9.0    Z2 := arr_N(U)  NEXT UNEXT TPRINT IF X > 10.0 THEN 980IF X < 10.0 THEN 1010PRINT "I GUESSED EXACTLY 1/3 OF YOUR NUMBERS."PRINT "IT'S A TIE GAME."GOTO 1030980 PRINT "I GUESSED MORE THAN 1/3 OF YOUR NUMBERS."PRINT "I WIN."FOR Q = 1 TO 10PRINT CHR$(7.0);NEXT QGOTO 10301010 PRINT "I GUESSED LESS THAN 1/3 OF YOUR NUMBERS."PRINT "YOU BEAT ME.  CONGRATULATIONS *****"1030 PRINT PRINT "DO YOU WANT TO TRY AGAIN (1 FOR YES, 0 FOR NO)";RUN _ecb_input_prefix_t \ INPUT "? ", X \ RUN _ecb_input_suffix_tIF X = 1.0 THEN 400PRINT PRINT "THANKS FOR THE GAME."END