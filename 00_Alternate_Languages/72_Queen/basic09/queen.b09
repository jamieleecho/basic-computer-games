procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure queenbase 0DIM A, B, C, I, K: INTEGERA := 0B := 0C := 0I := 0K := 0L := 0.0M := 0.0M1 := 0.0P := 0.0Q$ := ""T := 0.0T1 := 0.0U := 0.0U1 := 0.0W$ := ""Z := 0.0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(34.0); "QUEEN"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT DIM arr_S(65)FOR tmp_1 = 0 TO 64 \ arr_S(tmp_1) := 0 \ NEXT tmp_1FOR I = 1 TO 64  READ arr_S(I)NEXT IDATA 81.0, 71.0, 61.0, 51.0, 41.0, 31.0, 21.0, 11.0DATA 92.0, 82.0, 72.0, 62.0, 52.0, 42.0, 32.0, 22.0DATA 103.0, 93.0, 83.0, 73.0, 63.0, 53.0, 43.0, 33.0DATA 114.0, 104.0, 94.0, 84.0, 74.0, 64.0, 54.0, 44.0DATA 125.0, 115.0, 105.0, 95.0, 85.0, 75.0, 65.0, 55.0DATA 136.0, 126.0, 116.0, 106.0, 96.0, 86.0, 76.0, 66.0DATA 147.0, 137.0, 127.0, 117.0, 107.0, 97.0, 87.0, 77.0DATA 158.0, 148.0, 138.0, 128.0, 118.0, 108.0, 98.0, 88.022 RUN _ecb_input_prefix_t \ INPUT "DO YOU WANT INSTRUCTIONS? ", W$ \ RUN _ecb_input_suffix_tIF W$ = "NO" THEN 30IF W$ = "YES" THEN 28PRINT "PLEASE ANSWER 'YES' OR 'NO'."GOTO 2228 GOSUB 5000GOTO 10030 GOSUB 5160(*     ERROR CHECKS *)100 PRINT "WHERE WOULD YOU LIKE TO START";RUN _ecb_input_prefix_t \ INPUT "? ", M1 \ RUN _ecb_input_suffix_tIF M1 = 0.0 THEN 232RUN ecb_int(M1 / 10.0, T1)U1 := M1 - 10.0 * T1IF U1 = 1.0 THEN 200IF U1 = T1 THEN 200PRINT "PLEASE READ THE DIRECTIONS AGAIN."PRINT "YOU HAVE BEGUN ILLEGALLY."PRINT GOTO 100200 GOSUB 2000run ecb_str(M, tmp_1$) \ PRINT "COMPUTER MOVES TO SQUARE"; tmp_1$IF M = 158.0 THEN 3400PRINT "WHAT IS YOUR MOVE";230 RUN _ecb_input_prefix_t \ INPUT "? ", M1 \ RUN _ecb_input_suffix_tIF M1 <> 0.0 THEN 239232 PRINT PRINT "IT LOOKS LIKE I HAVE WON BY FORFEIT."PRINT GOTO 4000239 IF M1 <= M THEN 3200RUN ecb_int(M1 / 10.0, T1)U1 := M1 - 10.0 * T1P := U1 - UIF P <> 0.0 THEN 300L := T1 - TIF L <= 0.0 THEN 3200GOTO 200300 IF T1 - T <> P THEN 320GOTO 200320 IF T1 - T <> 2.0 * P THEN 3200GOTO 200(*     LOCATE MOVE FOR COMPUTER *)2000 IF M1 = 41.0 THEN 2180IF M1 = 44.0 THEN 2180IF M1 = 73.0 THEN 2180IF M1 = 75.0 THEN 2180IF M1 = 126.0 THEN 2180IF M1 = 127.0 THEN 2180IF M1 = 158.0 THEN 3300C := 0FOR K = 7 TO 1 STEP -1  U := U1  T := T1 + K  GOSUB 3500  IF C = 1.0 THEN 2160  U := U + K  GOSUB 3500  IF C = 1.0 THEN 2160  T := T + K  GOSUB 3500  IF C = 1.0 THEN 2160NEXT KGOTO 21802160 C := 0RETURN2180 GOSUB 3000RETURN(*     RANDOM MOVE *)3000 Z := RND(1.0)IF Z > 0.6 THEN 3110IF Z > 0.3 THEN 3070U := U1T := T1 + 1.0M := 10.0 * T + URETURN3070 U := U1 + 1.0T := T1 + 2.0M := 10.0 * T + URETURN3110 U := U1 + 1.0T := T1 + 1.0M := 10.0 * T + URETURN(*     ILLEGAL MOVE MESSAGE *)3200 PRINT PRINT "Y O U   C H E A T . . .  TRY AGAIN";GOTO 230(*     PLAYER WINS *)3300 PRINT PRINT "C O N G R A T U L A T I O N S . . ."PRINT PRINT "YOU HAVE WON--VERY WELL PLAYED."PRINT "IT LOOKS LIKE I HAVE MET MY MATCH."PRINT "THANKS FOR PLAYING---I CAN'T WIN ALL THE TIME."PRINT GOTO 4000(*     COMPUTER WINS *)3400 PRINT PRINT "NICE TRY, BUT IT LOOKS LIKE I HAVE WON."PRINT "THANKS FOR PLAYING."PRINT GOTO 4000(*     TEST FOR COMPUTER MOVE *)3500 M := 10.0 * T + UIF M = 158.0 THEN 3570IF M = 127.0 THEN 3570IF M = 126.0 THEN 3570IF M = 75.0 THEN 3570IF M = 73.0 THEN 35703560 RETURN3570 C := 1GOTO 3560(*     ANOTHER GAME??? *)4000 PRINT "ANYONE ELSE CARE TO TRY";RUN _ecb_input_prefix_t \ INPUT "? ", Q$ \ RUN _ecb_input_suffix_tPRINT IF Q$ = "YES" THEN 30IF Q$ = "NO" THEN 4050PRINT "PLEASE ANSWER 'YES' OR 'NO'."GOTO 40004050 PRINT PRINT "OK --- THANKS AGAIN."STOP(*     DIRECTIONS *)5000 PRINT "WE ARE GOING TO PLAY A GAME BASED ON ONE OF THE CHESS"PRINT "MOVES.  OUR QUEEN WILL BE ABLE TO MOVE ONLY TO THE LEFT,"PRINT "DOWN, OR DIAGONALLY DOWN AND TO THE LEFT."PRINT PRINT "THE OBJECT OF THE GAME IS TO PLACE THE QUEEN IN THE LOWER"PRINT "LEFT HAND SQUARE BY ALTERNATING MOVES BETWEEN YOU AND THE"PRINT "COMPUTER.  THE FIRST ONE TO PLACE THE QUEEN THERE WINS."PRINT PRINT "YOU GO FIRST AND PLACE THE QUEEN IN ANY ONE OF THE SQUARES"PRINT "ON THE TOP ROW OR RIGHT HAND COLUMN."PRINT "THAT WILL BE YOUR FIRST MOVE."PRINT "WE ALTERNATE MOVES."PRINT "YOU MAY FORFEIT BY TYPING '0' AS YOUR MOVE."PRINT "BE SURE TO PRESS THE RETURN KEY AFTER EACH RESPONSE."PRINT PRINT 5160 PRINT FOR A = 0 TO 7  FOR B = 1 TO 8    I := 8 * A + B    run ecb_str(arr_S(I), tmp_1$) \ PRINT tmp_1$;  NEXT B  PRINT   PRINT   PRINT NEXT APRINT RETURNEND