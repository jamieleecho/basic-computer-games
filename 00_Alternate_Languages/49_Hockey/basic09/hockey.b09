procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure hockeybase 0DIM A1, A2, B1, C, G, G1, G2, I, J, L, N, S1, S2, S3, T, X, Z, Z1: INTEGERA := 0.0A1 := 0A2 := 0B1 := 0C := 0C$ := ""G := 0G1 := 0G2 := 0I := 0J := 0L := 0N := 0P := 0.0R$ := ""S := 0.0S1 := 0S2 := 0S3 := 0T := 0T6 := 0.0X := 0Z := 0Z1 := 0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(34.0); "HOCKEY"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT (* ROBERT PUOPOLO ALG. 1 140 MCCOWAN 6/7/73 HOCKEY *)LET X := 1PRINT PRINT PRINT 50 PRINT "WOULD YOU LIKE THE INSTRUCTIONS";RUN _ecb_input_prefix_t \ INPUT "? ", C$ \ RUN _ecb_input_suffix_tPRINT IF C$ = "NO" THEN 90IF C$ = "YES" THEN 80PRINT "ANSWER YES OR NO!!"GOTO 5080 GOTO 172090 DIM arr_A$(8), arr_B$(8)FOR tmp_1 = 0 TO 7 \ arr_A$(tmp_1) := "" \ NEXT tmp_1FOR tmp_1 = 0 TO 7 \ arr_B$(tmp_1) := "" \ NEXT tmp_1DIM arr_H(21), arr_T(6), arr_T1(6), arr_T2(6), arr_T3(6): INTEGERFOR tmp_1 = 0 TO 20 \ arr_H(tmp_1) := 0 \ NEXT tmp_1FOR tmp_1 = 0 TO 5 \ arr_T(tmp_1) := 0 \ NEXT tmp_1FOR tmp_1 = 0 TO 5 \ arr_T1(tmp_1) := 0 \ NEXT tmp_1FOR tmp_1 = 0 TO 5 \ arr_T2(tmp_1) := 0 \ NEXT tmp_1FOR tmp_1 = 0 TO 5 \ arr_T3(tmp_1) := 0 \ NEXT tmp_1PRINT "ENTER THE TWO TEAMS";RUN _ecb_input_prefix_t \ INPUT "? ", arr_A$(7.0), arr_B$(7.0) \ RUN _ecb_input_suffix_tPRINT 110 PRINT "ENTER THE NUMBER OF MINUTES IN A GAME";RUN _ecb_input_prefix_t \ INPUT "? ", T6 \ RUN _ecb_input_suffix_tPRINT IF T6 < 1.0 THEN 110PRINT PRINT "WOULD THE "; arr_A$(7.0); " COACH ENTER HIS TEAM"PRINT FOR I = 1 TO 6run ecb_str(float(I), tmp_1$) \ PRINT "PLAYER"; tmp_1$;RUN _ecb_input_prefix_t \ INPUT "? ", arr_A$(I) \ RUN _ecb_input_suffix_tNEXT IPRINT PRINT "WOULD THE "; arr_B$(7.0); " COACH DO THE SAME"PRINT FOR T = 1 TO 6run ecb_str(float(T), tmp_1$) \ PRINT "PLAYER"; tmp_1$;RUN _ecb_input_prefix_t \ INPUT "? ", arr_B$(T) \ RUN _ecb_input_suffix_tNEXT TPRINT PRINT "INPUT THE REFEREE FOR THIS GAME";RUN _ecb_input_prefix_t \ INPUT "? ", R$ \ RUN _ecb_input_suffix_tPRINT PRINT TAB(11.0); arr_A$(7.0); " STARTING LINEUP"FOR T = 1 TO 6PRINT arr_A$(T)NEXT TPRINT PRINT TAB(11.0); arr_B$(7.0); " STARTING LINEUP"FOR T = 1 TO 6PRINT arr_B$(T)NEXT TPRINT PRINT "WE'RE READY FOR TONIGHTS OPENING FACE-OFF."PRINT R$; " WILL DROP THE PUCK BETWEEN "; arr_A$(2.0); " AND "; arr_B$(2.0)FOR L = 1 TO T6  IF L = 1.0 THEN 260  PRINT "AND WE'RE READY FOR THE FACE-OFF"260   RUN ecb_int(2.0 * RND(X), tmp_1) \ C := tmp_1 + 1  ON C GOTO 270, 280270   PRINT arr_A$(7.0); " HAS CONTROL OF THE PUCK"  GOTO 290280   PRINT arr_B$(7.0); " HAS CONTROL."290   PRINT "PASS";RUN _ecb_input_prefix_t \ INPUT "? ", P \ RUN _ecb_input_suffix_tFOR N = 1 TO 3  arr_H(N) := 0  NEXT N  IF P < 0.0 THEN 290  IF P > 3.0 THEN 290310   FOR J = 1 TO (P + 2)    RUN ecb_int(5.0 * RND(X), tmp_1) \ arr_H(J) := tmp_1 + 1  NEXT J  IF arr_H(J - 1) = arr_H(J - 2) THEN 310  IF P + 2.0 < 3.0 THEN 350  IF arr_H(J - 1) = arr_H(J - 3) THEN 310  IF arr_H(J - 2) = arr_H(J - 3) THEN 310350   IF P = 0.0 THEN 360  GOTO 490360   RUN _ecb_input_prefix_t \ INPUT "SHOT? ", S \ RUN _ecb_input_suffix_t  IF S < 1.0 THEN 360  IF S > 4.0 THEN 360  ON C GOTO 380, 480380   PRINT arr_A$(arr_H(J - 1));  G := arr_H(J - 1)  G1 := 0  G2 := 0390   ON INT(S) GOTO 400, 420, 440, 460400   PRINT " LET'S A BOOMER GO FROM THE RED LINE!!"  Z := 10  GOTO 890420   PRINT " FLIPS A WRISTSHOT DOWN THE ICE"440   PRINT " BACKHANDS ONE IN ON THE GOALTENDER"  Z := 25  GOTO 890460   PRINT " SNAPS A LONG FLIP SHOT"  Z := 17  GOTO 890480   PRINT arr_B$(arr_H(J - 1));  G1 := 0  G2 := 0  G := arr_H(J - 1)  GOTO 390490   ON C GOTO 500, 640500   ON INT(P) GOTO 510, 540, 570510   PRINT arr_A$(arr_H(J - 2)); " LEADS "; arr_A$(arr_H(J - 1)); " WITH A PERFECT PASS."  PRINT arr_A$(arr_H(J - 1)); " CUTTING IN!!!"  G := arr_H(J - 1)  G1 := arr_H(J - 2)  G2 := 0  Z1 := 3  GOTO 770540   PRINT arr_A$(arr_H(J - 2)); " GIVES TO A STREAKING "; arr_A$(arr_H(J - 1))  PRINT arr_A$(arr_H(J - 3)); " COMES DOWN ON "; arr_B$(5.0); " AND "; arr_B$(4.0)  G := arr_H(J - 3)  G1 := arr_H(J - 1)  G2 := arr_H(J - 2)  Z1 := 2  GOTO 770570   PRINT "OH MY GOD!! A ' 4 ON 2 ' SITUATION"  PRINT arr_A$(arr_H(J - 3)); " LEADS "; arr_A$(arr_H(J - 2))  PRINT arr_A$(arr_H(J - 2)); " IS WHEEELING THROUGH CENTER."  PRINT arr_A$(arr_H(J - 2)); " GIVES AND GOES WITH "; arr_A$(arr_H(J - 1))  PRINT "PRETTY PASSING!"  PRINT arr_A$(arr_H(J - 1)); " DROPS IT TO "; arr_A$(arr_H(J - 4))  G := arr_H(J - 4)  G1 := arr_H(J - 1)  G2 := arr_H(J - 2)  Z1 := 1  GOTO 770640   ON INT(P) GOTO 650, 670, 720650   PRINT arr_B$(arr_H(J - 1)); " HITS "; arr_B$(arr_H(J - 2)); " FLYING DOWN THE LEFT SIDE"  G := arr_H(J - 2)  G1 := arr_H(J - 1)  G2 := 0  Z1 := 3  GOTO 770670   PRINT "IT'S A ' 3 ON 2 '!"  PRINT "ONLY "; arr_A$(4.0); " AND "; arr_A$(5.0); " ARE BACK."  PRINT arr_B$(arr_H(J - 2)); " GIVES OFF TO "; arr_B$(arr_H(J - 1))  PRINT arr_B$(arr_H(J - 1)); " DROPS TO "; arr_B$(arr_H(J - 3))  G := arr_H(J - 3)  G1 := arr_H(J - 1)  G2 := arr_H(J - 2)  Z1 := 2  GOTO 770720   PRINT " A ' 3 ON 2 ' WITH A ' TRAILER '!"  PRINT arr_B$(arr_H(J - 4)); " GIVES TO "; arr_B$(arr_H(J - 2)); " WHO SHUFFLES IT OFF TO"  PRINT arr_B$(arr_H(J - 1)); " WHO FIRES A WING TO WING PASS TO "  PRINT arr_B$(arr_H(J - 3)); " AS HE CUTS IN ALONE!!"  G := arr_H(J - 3)  G1 := arr_H(J - 1)  G2 := arr_H(J - 2)  Z1 := 1  GOTO 770770   PRINT "SHOT";RUN _ecb_input_prefix_t \ INPUT "? ", S \ RUN _ecb_input_suffix_t  IF S > 4.0 THEN 770  IF S < 1.0 THEN 770  ON C GOTO 790, 880790   PRINT arr_A$(G);  ON INT(S) GOTO 800, 820, 840, 860800   PRINT " LET'S A BIG SLAP SHOT GO!!"  Z := 4  Z := Z + Z1  GOTO 890820   PRINT " RIPS A WRIST SHOT OFF"  Z := 2  Z := Z + Z1  GOTO 890840   PRINT " GETS A BACKHAND OFF"  Z := 3  Z := Z + Z1  GOTO 890860   PRINT " SNAPS OFF A SNAP SHOT"  Z := 2  Z := Z + Z1  GOTO 890880   PRINT arr_B$(G);  ON INT(S) GOTO 800, 820, 840, 860890   PRINT "AREA";RUN _ecb_input_prefix_t \ INPUT "? ", A \ RUN _ecb_input_suffix_t  IF A < 1.0 THEN 890  IF A > 4.0 THEN 890  ON C GOTO 910, 920910   S2 := S2 + 1  GOTO 930920   S3 := S3 + 1930   RUN ecb_int(4.0 * RND(X), tmp_1) \ A1 := tmp_1 + 1  IF A <> A1 THEN 1200940   RUN ecb_int(100.0 * RND(X), tmp_1) \ arr_H(20) := tmp_1 + 1  RUN ecb_int(float(arr_H(20) / Z), tmp_1) \ IF tmp_1 = arr_H(20) / Z THEN 1160  ON C GOTO 970, 980970   PRINT "GOAL "; arr_A$(7.0)  arr_H(9) := arr_H(9) + 1  GOTO 990980   PRINT "SCORE "; arr_B$(7.0)  arr_H(8) := arr_H(8) + 1990 FOR B1 = 1 TO 25  PRINT CHR$(7.0);  NEXT B1  PRINT   PRINT "SCORE: ";  IF arr_H(8) > arr_H(9) THEN 1020  run ecb_str(float(arr_H(9)), tmp_1$) \ run ecb_str(float(arr_H(8)), tmp_2$) \ PRINT arr_A$(7.0); ":"; tmp_1$, arr_B$(7.0); ":"; tmp_2$  GOTO 10301020   run ecb_str(float(arr_H(8)), tmp_1$) \ run ecb_str(float(arr_H(9)), tmp_2$) \ PRINT arr_B$(7.0); ":"; tmp_1$, arr_A$(7.0); ":"; tmp_2$1030   ON C GOTO 1040, 11001040   PRINT "GOAL SCORED BY: "; arr_A$(G)  IF G1 = 0.0 THEN 1070  IF G2 = 0.0 THEN 1080  PRINT " ASSISTED BY: "; arr_A$(G1); " AND "; arr_A$(G2)  GOTO 10901070   PRINT " UNASSISTED."  GOTO 10901080   PRINT " ASSISTED BY: "; arr_A$(G1)1090   arr_T(G) := arr_T(G) + 1  arr_T1(G1) := arr_T1(G1) + 1  arr_T1(G2) := arr_T1(G2) + 1  GOTO 15401100   PRINT "GOAL SCORED BY: "; arr_B$(G);  IF G1 = 0.0 THEN 1130  IF G2 = 0.0 THEN 1140  PRINT " ASSISTED BY: "; arr_B$(G1); " AND "; arr_B$(G2)  GOTO 11501130   PRINT " UNASSISTED"  GOTO 11501140   PRINT " ASSISTED BY: "; arr_B$(G1)  GOTO 11501150   arr_T2(G) := arr_T2(G) + 1  arr_T3(G1) := arr_T3(G1) + 1  arr_T3(G2) := arr_T3(G2) + 1  GOTO 15401160   RUN ecb_int(100.0 * RND(X), tmp_1) \ A2 := tmp_1 + 1  RUN ecb_int(A2 / 4.0, tmp_1) \ IF tmp_1 = A2 / 4.0 THEN 1170  GOTO 12001170   ON C GOTO 1180, 11901180   PRINT "SAVE "; arr_B$(6.0); " --  REBOUND"  GOTO 9401190   PRINT "SAVE "; arr_A$(6.0); " --  FOLLOW UP"  GOTO 9401200   RUN ecb_int(6.0 * RND(X), tmp_1) \ S1 := tmp_1 + 1  ON C GOTO 1220, 13801220   ON S1 GOTO 1230, 1260, 1290, 1300, 1330, 13501230   PRINT "KICK SAVE AND A BEAUTY BY "; arr_B$(6.0)  PRINT "CLEARED OUT BY "; arr_B$(3.0)  GOTO 2601260   PRINT "WHAT A SPECTACULAR GLOVE SAVE BY "; arr_B$(6.0)  PRINT "AND "; arr_B$(6.0); " GOLFS IT INTO THE CROWD"  GOTO 15401290   PRINT "SKATE SAVE ON A LOW STEAMER BY "; arr_B$(6.0)  GOTO 2601300   PRINT "PAD SAVE BY "; arr_B$(6.0); " OFF THE STICK"  PRINT "OF "; arr_A$(G); " AND "; arr_B$(6.0); " COVERS UP"  GOTO 15401330   PRINT "WHISTLES ONE OVER THE HEAD OF "; arr_B$(6.0)  GOTO 2601350   PRINT arr_B$(6.0); " MAKES A FACE SAVE!! AND HE IS HURT"  PRINT "THE DEFENSEMAN "; arr_B$(5.0); " COVERS UP FOR HIM"  GOTO 15401380   ON S1 GOTO 1390, 1410, 1440, 1470, 1490, 15201390   PRINT "STICK SAVE BY "; arr_A$(6.0)  PRINT "AND CLEARED OUT BY "; arr_A$(4.0)  GOTO 2601410   PRINT "OH MY GOD!! "; arr_B$(G); " RATTLES ONE OFF THE POST"  PRINT "TO THE RIGHT OF "; arr_A$(6.0); " AND "; arr_A$(6.0); " COVERS ";  PRINT "ON THE LOOSE PUCK!"  GOTO 15401440   PRINT "SKATE SAVE BY "; arr_A$(6.0)  PRINT arr_A$(6.0); " WHACKS THE LOOSE PUCK INTO THE STANDS"  GOTO 15401470   PRINT "STICK SAVE BY "; arr_A$(6.0); " AND HE CLEARS IT OUT HIMSELF"  GOTO 2601490   PRINT "KICKED OUT BY "; arr_A$(6.0)  PRINT "AND IT REBOUNDS ALL THE WAY TO CENTER ICE"  GOTO 2601520   PRINT "GLOVE SAVE "; arr_A$(6.0); " AND HE HANGS ON"  GOTO 15401540 NEXT LFOR N = 1 TO 30PRINT CHR$(7.0);NEXT NPRINT "THAT'S THE SIREN"PRINT PRINT TAB(16.0); "FINAL SCORE:"IF arr_H(8) > arr_H(9) THEN 1580run ecb_str(float(arr_H(9)), tmp_1$) \ run ecb_str(float(arr_H(8)), tmp_2$) \ PRINT arr_A$(7.0); ":"; tmp_1$, arr_B$(7.0); ":"; tmp_2$GOTO 15901580 run ecb_str(float(arr_H(8)), tmp_1$) \ run ecb_str(float(arr_H(9)), tmp_2$) \ PRINT arr_B$(7.0); ":"; tmp_1$, arr_A$(7.0); ":"; tmp_2$1590 PRINT PRINT TAB(11.0); "SCORING SUMMARY"PRINT PRINT TAB(26.0); arr_A$(7.0)PRINT TAB(6.0); "NAME"; TAB(21.0); "GOALS"; TAB(36.0); "ASSISTS"PRINT TAB(6.0); "----"; TAB(21.0); "-----"; TAB(36.0); "-------"FOR I = 1 TO 5  run ecb_str(float(arr_T(I)), tmp_1$) \ run ecb_str(float(arr_T1(I)), tmp_2$) \ PRINT TAB(6.0); arr_A$(I); TAB(22.0); tmp_1$; TAB(37.0); tmp_2$NEXT IPRINT PRINT TAB(26.0); arr_B$(7.0)PRINT TAB(6.0); "NAME"; TAB(21.0); "GOALS"; TAB(36.0); "ASSISTS"PRINT TAB(6.0); "----"; TAB(21.0); "-----"; TAB(36.0); "-------"FOR T = 1 TO 5  run ecb_str(float(arr_T2(T)), tmp_1$) \ run ecb_str(float(arr_T3(T)), tmp_2$) \ PRINT TAB(6.0); arr_B$(T); TAB(22.0); tmp_1$; TAB(37.0); tmp_2$NEXT TPRINT PRINT "SHOTS ON NET"run ecb_str(float(S2), tmp_1$) \ PRINT arr_A$(7.0); ":"; tmp_1$run ecb_str(float(S3), tmp_1$) \ PRINT arr_B$(7.0); ":"; tmp_1$END1720 PRINT PRINT "THIS IS A SIMULATED HOCKEY GAME."PRINT "QUESTION     RESPONSE"PRINT "PASS         TYPE IN THE NUMBER OF PASSES YOU WOULD"PRINT "             LIKE TO MAKE, FROM 0 TO 3."PRINT "SHOT         TYPE THE NUMBER CORRESPONDING TO THE SHOT"PRINT "             YOU WANT TO MAKE.  ENTER:"PRINT "             1 FOR A SLAPSHOT"PRINT "             2 FOR A WRISTSHOT"PRINT "             3 FOR A BACKHAND"PRINT "             4 FOR A SNAP SHOT"PRINT "AREA         TYPE IN THE NUMBER CORRESPONDING TO"PRINT "             THE AREA YOU ARE AIMING AT.  ENTER:"PRINT "             1 FOR UPPER LEFT HAND CORNER"PRINT "             2 FOR UPPER RIGHT HAND CORNER"PRINT "             3 FOR LOWER LEFT HAND CORNER"PRINT "             4 FOR LOWER RIGHT HAND CORNER"PRINT PRINT "AT THE START OF THE GAME, YOU WILL BE ASKED FOR THE NAMES"PRINT "OF YOUR PLAYERS.  THEY ARE ENTERED IN THE ORDER: "PRINT "LEFT WING, CENTER, RIGHT WING, LEFT DEFENSE,"PRINT "RIGHT DEFENSE, GOALKEEPER.  ANY OTHER INPUT REQUIRED WILL"PRINT "HAVE EXPLANATORY INSTRUCTIONS."GOTO 90END