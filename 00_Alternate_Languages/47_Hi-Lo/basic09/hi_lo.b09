procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure hi_lobase 0DIM B: INTEGERA := 0.0A$ := ""B := 0R := 0.0Y := 0.0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(35.0); "HI LO"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT PRINT "THIS IS THE GAME OF HI LO."PRINT PRINT "YOU WILL HAVE 6 TRIES TO GUESS THE AMOUNT OF MONEY IN THE"PRINT "HI LO JACKPOT, WHICH IS BETWEEN 1 AND 100 DOLLARS.  IF YOU"PRINT "GUESS THE AMOUNT, YOU WIN ALL THE MONEY IN THE JACKPOT!"PRINT "THEN YOU GET ANOTHER CHANCE TO WIN MORE MONEY.  HOWEVER,"PRINT "IF YOU DO NOT GUESS THE AMOUNT, THE GAME ENDS."PRINT R := 0.0170 B := 0PRINT RUN ecb_int(100.0 * RND(1.0), Y)200 PRINT "YOUR GUESS";RUN _ecb_input_prefix_t \ INPUT "? ", A \ RUN _ecb_input_suffix_tB := B + 1IF A = Y THEN 300IF A > Y THEN 270PRINT "YOUR GUESS IS TOO LOW."GOTO 280270 PRINT "YOUR GUESS IS TOO HIGH."280 PRINT IF B < 6.0 THEN 200run ecb_str(Y, tmp_1$) \ PRINT "YOU BLEW IT...TOO BAD...THE NUMBER WAS"; tmp_1$R := 0.0GOTO 350300 run ecb_str(Y, tmp_1$) \ PRINT "GOT IT!!!!!!!!!!   YOU WIN"; tmp_1$; "DOLLARS."R := R + Yrun ecb_str(R, tmp_1$) \ PRINT "YOUR TOTAL WINNINGS ARE NOW"; tmp_1$; "DOLLARS."350 PRINT PRINT "PLAY AGAIN (YES OR NO)";RUN _ecb_input_prefix_t \ INPUT "? ", A$ \ RUN _ecb_input_suffix_tIF A$ = "YES" THEN 170PRINT PRINT "SO LONG.  HOPE YOU ENJOYED YOURSELF!!!"END