procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure blackjackbase 0DIM D$:STRING[40]DIM H$:STRING[40]DIM I$:STRING[40]DIM Z$:STRING[40]DIM tmp_1$:STRING[40]DIM C, C1, C2, D, H1, Q2, tmp_2: INTEGERAA := 0.0AB := 0.0AC := 0.0C := 0C1 := 0C2 := 0C3 := 0.0D := 0D$ := ""D1 := 0.0H := 0.0H$ := ""H1 := 0I := 0.0I$ := ""I1 := 0.0J := 0.0L1 := 0.0L2 := 0.0N := 0.0Q := 0.0Q1 := 0.0Q2 := 0X := 0.0X1 := 0.0Z$ := ""DIM arr_Z(11)FOR tmp_1 = 0 TO 10 \ arr_Z(tmp_1) := 0 \ NEXT tmp_1type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(32.0); "BLACK JACK"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT (* DEF FNA(Q)=Q+11*(Q>=22) *)DIM arr_P(16, 13), arr_Q(16), arr_C(53), arr_D(53), arr_T(9), arr_S(8), arr_B(16)FOR tmp_1 = 0 TO 15 \ FOR tmp_2 = 0 TO 12 \ arr_P(tmp_1, tmp_2) := 0 \ NEXT tmp_2 \ NEXT tmp_1FOR tmp_1 = 0 TO 15 \ arr_Q(tmp_1) := 0 \ NEXT tmp_1FOR tmp_1 = 0 TO 52 \ arr_C(tmp_1) := 0 \ NEXT tmp_1FOR tmp_1 = 0 TO 52 \ arr_D(tmp_1) := 0 \ NEXT tmp_1FOR tmp_1 = 0 TO 8 \ arr_T(tmp_1) := 0 \ NEXT tmp_1FOR tmp_1 = 0 TO 7 \ arr_S(tmp_1) := 0 \ NEXT tmp_1FOR tmp_1 = 0 TO 15 \ arr_B(tmp_1) := 0 \ NEXT tmp_1DIM arr_R(16): INTEGERFOR tmp_1 = 0 TO 15 \ arr_R(tmp_1) := 0 \ NEXT tmp_1(*--P(I,J) IS THE JTH CARD IN HAND I, Q(I) IS TOTAL OF HAND I *)(*--C IS THE DECK BEING DEALT FROM, D IS THE DISCARD PILE, *)(*--T(I) IS THE TOTAL FOR PLAYER I, S(I) IS THE TOTAL THIS HAND FOR *)(*--PLAYER I, B(I) IS TH BET FOR HAND I *)(*--R(I) IS THE LENGTH OF P(I,*) *)GOTO 1500100 (*--SUBROUTINE TO GET A CARD.  RESULT IS PUT IN X. *)IF C < 51.0 THEN 230120 PRINT "RESHUFFLING"FOR D = D TO 1 STEP -1  C := C - 1  arr_C(C) := arr_D(D)NEXT DFOR C1 = 52 TO C STEP -1  RUN ecb_int(RND(1.0) * (C1 - C + 1.0), tmp_1) \ C2 := tmp_1 + C  C3 := arr_C(C2)  arr_C(C2) := arr_C(C1)  arr_C(C1) := C3NEXT C1230 X := arr_C(C)C := C + 1RETURN300 (*--SUBROUTINE TO EVALUATE HAND I.  TOTAL IS PUT INTO *)(*--Q(I). TOTALS HAVE THE FOLLOWING MEANING: *)(*--  2-10...HARD 2-10 *)(*-- 11-21...SOFT 11-21 *)(*-- 22-32...HARD 11-21 *)(*--  33+....BUSTED *)Q := 0.0FOR Q2 = 1 TO arr_R(INT(I))  X := arr_P(INT(I), Q2)  GOSUB 500NEXT Q2arr_Q(INT(I)) := QRETURN500 (*--SUBROUTINE TO ADD CARD X TO TOTAL Q. *)X1 := XIF X1 > 10.0 THEN  X1 := 10.0(*  SAME AS X1=10 MIN X *)ENDIFQ1 := Q + X1IF Q >= 11.0 THEN 590IF X > 1.0 THEN 570Q := Q + 11.0RETURN570 IF Q1 >= 11.0 THEN tmp_1 := -1.0 \ ELSE tmp_1 := 0.0 \ ENDIF \ Q := Q1 - 11.0 * (tmp_1)RETURN590 IF Q <= 21.0 THEN tmp_1 := -1.0 \ ELSE tmp_1 := 0.0 \ ENDIF \ IF Q1 > 21.0 THEN tmp_2 := -1 \ ELSE tmp_2 := 0 \ ENDIF \ Q := Q1 - (LAND(tmp_1, tmp_2))IF Q < 33.0 THEN 620Q := -1.0620 RETURN700 (*--CARD PRINTING SUBROUTINE *)(*  D$ DEFINED ELSEWHERE *)PRINT MID$(D$, INT(3.0 * X - 2.0), 3.0);PRINT "  ";RETURN750 (*--ALTERNATIVE PRINTING ROUTINE *)PRINT " "; MID$(D$, INT(3.0 * X - 1.0), 2.0);PRINT "   ";RETURN800 (*--SUBROUTINE TO PLAY OUT A HAND. *)(*--NO SPLITTING OR BLACKJACKS ALLOWED *)H1 := 5830 GOSUB 1410H1 := 3ON INT(H) GOTO 950, 930860 GOSUB 100arr_B(INT(I)) := arr_B(INT(I)) * 2.0PRINT "RECEIVED A";GOSUB 700GOSUB 1100IF Q > 0.0 THEN  GOSUB 1300ENDIFRETURN930 GOSUB 1320940 RETURN950 GOSUB 100PRINT "RECEIVED A";GOSUB 700GOSUB 1100IF Q < 0.0 THEN 940PRINT "HIT";GOTO 8301100 (*--SUBROUTINE TO ADD A CARD TO ROW I *)arr_R(INT(I)) := arr_R(INT(I)) + 1arr_P(INT(I), arr_R(INT(I))) := XQ := arr_Q(INT(I))GOSUB 500arr_Q(INT(I)) := QIF Q >= 0.0 THEN 1190PRINT "...BUSTED"GOSUB 12001190 RETURN1200 (*--SUBROUTINE TO DISCARD ROW I *)1210 IF arr_R(INT(I)) <> 0.0 THEN 1230RETURN1230 D := D + 1arr_D(D) := arr_P(INT(I), arr_R(INT(I)))arr_R(INT(I)) := arr_R(INT(I)) - 1GOTO 12101300 (*--PRINTS TOTAL OF HAND I *)PRINT 1320 AA := arr_Q(INT(I))GOSUB 3400run ecb_str(AA, tmp_1$) \ PRINT "TOTAL IS"; tmp_1$RETURN(*--SUBROUTINE TO READ REPLY *)1410 (*  I$ DEFINED ELSEWHERE *)1420 RUN _ecb_input_prefix_t \ INPUT "? ", H$ \ RUN _ecb_input_suffix_tH$ := LEFT$(H$, 1.0)FOR H = 1.0 TO H1 STEP 2.0  IF H$ = MID$(I$, INT(H), 1.0) THEN 1480NEXT HPRINT "TYPE "; MID$(I$, 1.0, H1 - 1.0); " OR "; MID$(I$, H1, 2.0); " PLEASE";GOTO 14201480 H := (H + 1.0) / 2.0RETURN1500 (*--PROGRAM STARTS HERE *)(*--INITIALIZE *)D$ := "N A  2  3  4  5  6  7N 8  9 10  J  Q  K"I$ := "H,S,D,/,"FOR I = 1.0 TO 13.0  FOR J = 4.0 * I - 3.0 TO 4.0 * I    arr_D(INT(J)) := I  NEXT JNEXT ID := 52C := 53PRINT "DO YOU WANT INSTRUCTIONS";RUN _ecb_input_prefix_t \ INPUT "? ", H$ \ RUN _ecb_input_suffix_tIF LEFT$(H$, 1.0) = "N" OR LEFT$(H$, 1.0) = "n" THEN 1760PRINT "THIS IS THE GAME OF 21. AS MANY AS 7 PLAYERS MAY PLAY THE"PRINT "GAME. ON EACH DEAL, BETS WILL BE ASKED FOR, AND THE"PRINT "PLAYERS' BETS SHOULD BE TYPED IN. THE CARDS WILL THEN BE"PRINT "DEALT, AND EACH PLAYER IN TURN PLAYS HIS HAND. THE"PRINT "FIRST RESPONSE SHOULD BE EITHER 'D', INDICATING THAT THE"PRINT "PLAYER IS DOUBLING DOWN, 'S', INDICATING THAT HE IS"PRINT "STANDING, 'H', INDICATING HE WANTS ANOTHER CARD, OR '/',"PRINT "INDICATING THAT HE WANTS TO SPLIT HIS CARDS. AFTER THE"PRINT "INITIAL RESPONSE, ALL FURTHER RESPONSES SHOULD BE 'S' OR"PRINT "'H', UNLESS THE CARDS WERE SPLIT, IN WHICH CASE DOUBLING"PRINT "DOWN IS AGAIN PERMITTED. IN ORDER TO COLLECT FOR"PRINT "BLACKJACK, THE INITIAL RESPONSE SHOULD BE 'S'."1760 PRINT "NUMBER OF PLAYERS";RUN _ecb_input_prefix_t \ INPUT "? ", N \ RUN _ecb_input_suffix_tPRINT RUN ecb_int(N, tmp_1) \ IF N < 1.0 OR N > 7.0 OR N > tmp_1 THEN 1760FOR I = 1.0 TO 8.0arr_T(INT(I)) := 0.0NEXT ID1 := N + 1.01810 IF 2.0 * D1 + C >= 52.0 THEN  GOSUB 120ENDIFIF C = 2.0 THEN  C := C - 1ENDIFFOR I = 1.0 TO Narr_Z(INT(I)) := 0.0NEXT IFOR I = 1.0 TO 15.0arr_B(INT(I)) := 0.0NEXT IFOR I = 1.0 TO 15.0arr_Q(INT(I)) := 0.0NEXT IFOR I = 1.0 TO 7.0arr_S(INT(I)) := 0.0NEXT IFOR I = 1.0 TO 15.0arr_R(INT(I)) := 0NEXT I1880 PRINT "BETS:"FOR I = 1.0 TO Nrun ecb_str(I, tmp_1$) \ PRINT "#"; tmp_1$;RUN _ecb_input_prefix_t \ INPUT "? ", arr_Z(INT(I)) \ RUN _ecb_input_suffix_tNEXT IFOR I = 1.0 TO N  IF arr_Z(INT(I)) <= 0.0 OR arr_Z(INT(I)) > 500.0 THEN 1880  arr_B(INT(I)) := arr_Z(INT(I))NEXT IPRINT "PLAYER";FOR I = 1.0 TO N  run ecb_str(I, tmp_1$) \ PRINT tmp_1$; "   ";NEXT IPRINT "DEALER"FOR J = 1.0 TO 2.0  PRINT TAB(6.0);  FOR I = 1.0 TO D1    GOSUB 100    arr_P(INT(I), INT(J)) := X    IF J = 1.0 OR I <= N THEN      GOSUB 750ENDIF  NEXT I  PRINT NEXT JFOR I = 1.0 TO D1  arr_R(INT(I)) := 2NEXT I(*--TEST FOR INSURANCE *)IF arr_P(INT(D1), 1.0) > 1.0 THEN 2240PRINT "ANY INSURANCE";RUN _ecb_input_prefix_t \ INPUT "? ", H$ \ RUN _ecb_input_suffix_tIF LEFT$(H$, 1.0) <> "Y" THEN 22402160 PRINT "INSURANCE BETS"FOR I = 1.0 TO Nrun ecb_str(I, tmp_1$) \ PRINT "#"; tmp_1$;RUN _ecb_input_prefix_t \ INPUT "? ", arr_Z(INT(I)) \ RUN _ecb_input_suffix_tNEXT IFOR I = 1.0 TO N  IF arr_Z(INT(I)) < 0.0 OR arr_Z(INT(I)) > arr_B(INT(I)) / 2.0 THEN 2160NEXT IFOR I = 1.0 TO N  IF arr_P(INT(D1), 2.0) >= 10.0 THEN tmp_1 := -1.0 \ ELSE tmp_1 := 0.0 \ ENDIF \ arr_S(INT(I)) := arr_Z(INT(I)) * (3.0 * (- (tmp_1)) - 1.0)NEXT I2240 (*--TEST FOR DEALER BLACKJACK *)L1 := 1.0L2 := 1.0IF arr_P(INT(D1), 1.0) = 1.0 AND arr_P(INT(D1), 2.0) > 9.0 THEN  L1 := 0.0  L2 := 0.0ENDIFIF arr_P(INT(D1), 2.0) = 1.0 AND arr_P(INT(D1), 1.0) > 9.0 THEN  L1 := 0.0  L2 := 0.0ENDIFIF L1 <> 0.0 OR L2 <> 0.0 THEN 2320PRINT PRINT "DEALER HAS A"; MID$(D$, INT(3.0 * arr_P(INT(D1), 2.0) - 2.0), 3.0); " IN THE HOLE ";PRINT "FOR BLACKJACK"FOR I = 1.0 TO D1  GOSUB 300NEXT IGOTO 31402320 (*--NO DEALER BLACKJACK *)IF arr_P(INT(D1), 1.0) > 1.0 AND arr_P(INT(D1), 1.0) < 10.0 THEN 2350PRINT PRINT "NO DEALER BLACKJACK."2350 (*--NOW PLAY THE HANDS *)FOR I = 1.0 TO N2370   run ecb_str(I, tmp_1$) \ PRINT "PLAYER"; tmp_1$;  H1 := 7  GOSUB 1410  ON INT(H) GOTO 2550, 2410, 2510, 26002410 (*--PLAYER WANTS TO STAND *)  GOSUB 300  IF arr_Q(INT(I)) <> 21.0 THEN 2490  PRINT "BLACKJACK"  arr_S(INT(I)) := arr_S(INT(I)) + 1.5 * arr_B(INT(I))  arr_B(INT(I)) := 0.0  GOSUB 1200  GOTO 29002490   GOSUB 1320  GOTO 29002510 (*--PLAYER WANTS TO DOUBLE DOWN *)  GOSUB 300  GOSUB 860  GOTO 29002550 (*--PLAYER WANTS TO BE HIT *)  GOSUB 300  H1 := 3  GOSUB 950  GOTO 29002600 (*--PLAYER WANTS TO SPLIT *)  L1 := arr_P(INT(I), 1.0)  IF arr_P(INT(I), 1.0) > 10.0 THEN    L1 := 10.0ENDIF  L2 := arr_P(INT(I), 2.0)  IF arr_P(INT(I), 2.0) > 10.0 THEN    L2 := 10.0ENDIF  IF L1 = L2 THEN 2640  PRINT "SPLITTING NOT ALLOWED."  GOTO 23702640 (*--PLAY OUT SPLIT *)  I1 := I + D1  arr_R(INT(I1)) := 2  arr_P(INT(I1), 1.0) := arr_P(INT(I), 2.0)  arr_B(INT(I + D1)) := arr_B(INT(I))  GOSUB 100  PRINT "FIRST HAND RECEIVES A";  GOSUB 700  arr_P(INT(I), 2.0) := X  GOSUB 300  PRINT   GOSUB 100  PRINT "SECOND HAND RECEIVES A";  I := I1  GOSUB 700  arr_P(INT(I), 2.0) := X  GOSUB 300  PRINT   I := I1 - D1  IF arr_P(INT(I), 1.0) = 1.0 THEN 2900(*--NOW PLAY THE TWO HANDS *)2850   IF I > D1 THEN tmp_1 := -1.0 \ ELSE tmp_1 := 0.0 \ ENDIF \ PRINT "HAND"; 1.0 - (tmp_1);  GOSUB 800  I := I + D1  IF I = I1 THEN 2850  I := I1 - D12900 NEXT IGOSUB 300(*--TEST FOR PLAYING DEALER'S HAND *)FOR I = 1.0 TO N  IF arr_R(INT(I)) > 0.0 OR arr_R(INT(I + D1)) > 0.0 THEN 3010NEXT IPRINT "DEALER HAD A";X := arr_P(INT(D1), 2.0)GOSUB 700PRINT " CONCEALED."GOTO 31403010 PRINT "DEALER HAS A"; MID$(D$, INT(3.0 * arr_P(INT(D1), 2.0) - 2.0), 3.0); " CONCEALED ";I := D1AA := arr_Q(INT(I))GOSUB 3400run ecb_str(AA, tmp_1$) \ PRINT "FOR A TOTAL OF"; tmp_1$IF AA > 16.0 THEN 3130PRINT "DRAWS";3060 GOSUB 100GOSUB 750GOSUB 1100AA := QGOSUB 3400IF Q > 0.0 AND AA < 17.0 THEN 3060IF Q < 0.0 THEN tmp_1 := -1.0 \ ELSE tmp_1 := 0.0 \ ENDIF \ arr_Q(INT(I)) := Q - (tmp_1) / 2.0IF Q < 0.0 THEN 3140AA := QGOSUB 3400run ecb_str(AA, tmp_1$) \ PRINT "---TOTAL IS"; tmp_1$3130 PRINT 3140 (*--TALLY THE RESULT *)(* *)Z$ := "LOSES PUSHES WINS "PRINT FOR I = 1.0 TO N  AA := arr_Q(INT(I))  GOSUB 3400  AB := arr_Q(INT(I + D1))  GOSUB 3410  AC := arr_Q(INT(D1))  GOSUB 3420  arr_S(INT(I)) := arr_S(INT(I)) + arr_B(INT(I)) * SGN(AA - AC) + arr_B(INT(I + D1)) * SGN(AB - AC)  arr_B(INT(I + D1)) := 0.0  run ecb_str(I, tmp_1$) \ PRINT "PLAYER"; tmp_1$;  PRINT MID$(Z$, SGN(arr_S(INT(I))) * 6.0 + 7.0, 6.0); " ";  IF arr_S(INT(I)) <> 0.0 THEN 3250  PRINT "      ";  GOTO 32603250   run ecb_str(ABS(arr_S(INT(I))), tmp_1$) \ PRINT tmp_1$;3260   arr_T(INT(I)) := arr_T(INT(I)) + arr_S(INT(I))  run ecb_str(arr_T(INT(I)), tmp_1$) \ PRINT "TOTAL="; tmp_1$  GOSUB 1200  arr_T(INT(D1)) := arr_T(INT(D1)) - arr_S(INT(I))  I := I + D1  GOSUB 1200  I := I - D1NEXT Irun ecb_str(arr_T(INT(D1)), tmp_1$) \ PRINT "DEALER'S TOTAL="; tmp_1$PRINT GOSUB 1200GOTO 18103400 IF AA >= 22.0 THEN tmp_1 := -1.0 \ ELSE tmp_1 := 0.0 \ ENDIF \ AA := AA + 11.0 * (tmp_1)RETURN3410 IF AB >= 22.0 THEN tmp_1 := -1.0 \ ELSE tmp_1 := 0.0 \ ENDIF \ AB := AB + 11.0 * (tmp_1)RETURN3420 IF AC >= 22.0 THEN tmp_1 := -1.0 \ ELSE tmp_1 := 0.0 \ ENDIF \ AC := AC + 11.0 * (tmp_1)RETURN