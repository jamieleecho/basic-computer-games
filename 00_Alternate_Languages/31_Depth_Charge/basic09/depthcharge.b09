procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure depthchargebase 0DIM D, N: INTEGERA := 0.0A$ := ""B := 0.0C := 0.0D := 0G := 0.0N := 0X := 0.0Y := 0.0Z := 0.0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(31.0); "DEPTH CHARGE"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT RUN _ecb_input_prefix_t \ INPUT "DIMENSION OF SEARCH AREA? ", G \ RUN _ecb_input_suffix_tPRINT RUN ecb_int(LOG(G) / LOG(2.0), tmp_1) \ N := tmp_1 + 1PRINT "YOU ARE THE CAPTAIN OF THE DESTROYER USS COMPUTER"PRINT "AN ENEMY SUB HAS BEEN CAUSING YOU TROUBLE.  YOUR"run ecb_str(float(N), tmp_1$) \ PRINT "MISSION IS TO DESTROY IT.  YOU HAVE"; tmp_1$; "SHOTS."PRINT "SPECIFY DEPTH CHARGE EXPLOSION POINT WITH A"PRINT "TRIO OF NUMBERS -- THE FIRST TWO ARE THE"PRINT "SURFACE COORDINATES; THE THIRD IS THE DEPTH."100 PRINT PRINT "GOOD LUCK !"PRINT RUN ecb_int(G * RND(1.0), A)RUN ecb_int(G * RND(1.0), B)RUN ecb_int(G * RND(1.0), C)FOR D = 1 TO N  PRINT   run ecb_str(float(D), tmp_1$) \ PRINT "TRIAL #"; tmp_1$;RUN _ecb_input_prefix_t \ INPUT "? ", X, Y, Z \ RUN _ecb_input_suffix_t  IF ABS(X - A) + ABS(Y - B) + ABS(Z - C) = 0.0 THEN 300GOSUB 500PRINT NEXT DPRINT PRINT "YOU HAVE BEEN TORPEDOED!  ABANDON SHIP!"run ecb_str(A, tmp_1$) \ run ecb_str(B, tmp_2$) \ run ecb_str(C, tmp_3$) \ PRINT "THE SUBMARINE WAS AT"; tmp_1$; ","; tmp_2$; ","; tmp_3$GOTO 400300 PRINT run ecb_str(float(D), tmp_1$) \ PRINT "B O O M ! ! YOU FOUND IT IN"; tmp_1$; "TRIES!"400 PRINT PRINT RUN _ecb_input_prefix_t \ INPUT "ANOTHER GAME (Y OR N)? ", A$ \ RUN _ecb_input_suffix_tIF A$ = "Y" THEN 100PRINT "OK.  HOPE YOU ENJOYED YOURSELF."GOTO 600500 PRINT "SONAR REPORTS SHOT WAS ";IF Y > B THEN  PRINT "NORTH";ENDIFIF Y < B THEN  PRINT "SOUTH";ENDIFIF X > A THEN  PRINT "EAST";ENDIFIF X < A THEN  PRINT "WEST";ENDIFIF Y <> B OR X <> A THEN  PRINT " AND";ENDIFIF Z > C THEN  PRINT " TOO LOW."ENDIFIF Z < C THEN  PRINT " TOO HIGH."ENDIFIF Z = C THEN  PRINT " DEPTH OK."ENDIFRETURN600 END