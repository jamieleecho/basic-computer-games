procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure chemistbase 0DIM T: INTEGERA := 0.0D := 0.0R := 0.0T := 0W := 0.0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(34.0); "CHEMIST"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT PRINT "THE FICTITIOUS CHEMICAL KRYPTOCYANIC ACID CAN ONLY BE"PRINT "DILUTED BY THE RATIO OF 7 PARTS WATER TO 3 PARTS ACID."PRINT "IF ANY OTHER RATIO IS ATTEMPTED, THE ACID BECOMES UNSTABLE"PRINT "AND SOON EXPLODES.  GIVEN THE AMOUNT OF ACID, YOU MUST"PRINT "DECIDE WHO MUCH WATER TO ADD FOR DILUTION.  IF YOU MISS"PRINT "YOU FACE THE CONSEQUENCES."100 RUN ecb_int(RND(1.0) * 50.0, A)W := 7.0 * A / 3.0run ecb_str(A, tmp_1$) \ PRINT tmp_1$; "LITERS OF KRYPTOCYANIC ACID.  HOW MUCH WATER";RUN _ecb_input_prefix_t \ INPUT "? ", R \ RUN _ecb_input_suffix_tD := ABS(W - R)IF D > W / 20.0 THEN 200PRINT " GOOD JOB! YOU MAY BREATHE NOW, BUT DON'T INHALE THE FUMES!"PRINT GOTO 100200 PRINT " SIZZLE!  YOU HAVE JUST BEEN DESALINATED INTO A BLOB"PRINT " OF QUIVERING PROTOPLASM!"T := T + 1IF T = 9.0 THEN 260PRINT " HOWEVER, YOU MAY TRY AGAIN WITH ANOTHER LIFE."GOTO 100260 PRINT " YOUR 9 LIVES ARE USED, BUT YOU WILL BE LONG REMEMBERED FOR"PRINT " YOUR CONTRIBUTIONS TO THE FIELD OF COMIC BOOK CHEMISTRY."END