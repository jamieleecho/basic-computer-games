procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure slotsbase 0DIM Q4, T8: INTEGERA$ := ""M := 0.0P := 0.0Q4 := 0T8 := 0X := 0.0Y := 0.0Z := 0.0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(31.0); "SLOTS"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT (* PRODUCED BY FRED MIRABELLE AND BOB HARPER ON JAN 29, 1973 *)(* IT SIMULATES THE SLOT MACHINE. *)PRINT "YOU ARE IN THE H&M CASINO,IN FRONT OF ONE OF OUR"PRINT "ONE-ARM BANDITS. BET FROM $1 TO $100."PRINT "TO PULL THE ARM, PUNCH THE RETURN KEY AFTER MAKING YOUR BET."LET P := 0.0160 PRINT PRINT "YOUR BET";RUN _ecb_input_prefix_t \ INPUT "? ", M \ RUN _ecb_input_suffix_tIF M > 100.0 THEN 860IF M < 1.0 THEN 880RUN ecb_int(M, M)GOSUB 1270220 PRINT RUN ecb_int(6.0 * RND(1.0) + 1.0, X)RUN ecb_int(6.0 * RND(1.0) + 1.0, Y)RUN ecb_int(6.0 * RND(1.0) + 1.0, Z)PRINT IF X = 1.0 THEN 910IF X = 2.0 THEN 930IF X = 3.0 THEN 950IF X = 4.0 THEN 970IF X = 5.0 THEN 990IF X = 6.0 THEN 1010330 IF Y = 1.0 THEN 1030IF Y = 2.0 THEN 1050IF Y = 3.0 THEN 1070IF Y = 4.0 THEN 1090IF Y = 5.0 THEN 1110IF Y = 6.0 THEN 1130390 IF Z = 1.0 THEN 1150IF Z = 2.0 THEN 1170IF Z = 3.0 THEN 1190IF Z = 4.0 THEN 1210IF Z = 5.0 THEN 1230IF Z = 6.0 THEN 1250450 IF X = Y THEN 600IF X = Z THEN 630470 IF Y = Z THEN 650PRINT PRINT "YOU LOST."LET P := P - M510 run ecb_str(P, tmp_1$) \ PRINT "YOUR STANDINGS ARE $"; tmp_1$PRINT "AGAIN";RUN _ecb_input_prefix_t \ INPUT "? ", A$ \ RUN _ecb_input_suffix_tIF A$ = "Y" THEN 160PRINT IF P < 0.0 THEN 670IF P = 0.0 THEN 690IF P > 0.0 THEN 710GOTO 1350600 IF Y = Z THEN 730IF Y = 1.0 THEN 820GOTO 1341630 IF Z = 1.0 THEN 820GOTO 470650 IF Z = 1.0 THEN 820GOTO 1341670 PRINT "PAY UP!  PLEASE LEAVE YOUR MONEY ON THE TERMINAL."GOTO 1350690 PRINT "HEY, YOU BROKE EVEN."GOTO 1350710 PRINT "COLLECT YOUR WINNINGS FROM THE H&M CASHIER."GOTO 1350730 IF Z = 1.0 THEN 780PRINT PRINT "**TOP DOLLAR**"PRINT "YOU WON!"P := (((10.0 * M) + M) + P)GOTO 510780 PRINT PRINT "***JACKPOT***"PRINT "YOU WON!"P := (((100.0 * M) + M) + P)GOTO 510820 PRINT PRINT "*DOUBLE BAR*"PRINT "YOU WON!"P := (((5.0 * M) + M) + P)GOTO 510860 PRINT "HOUSE LIMITS ARE $100"GOTO 160880 PRINT "MINIMUM BET IS $1"GOTO 160GOTO 220910 PRINT "BAR";GOSUB 1310GOTO 330930 PRINT "BELL";GOSUB 1310GOTO 330950 PRINT "ORANGE";GOSUB 1310GOTO 330970 PRINT "LEMON";GOSUB 1310GOTO 330990 PRINT "PLUM";GOSUB 1310GOTO 3301010 PRINT "CHERRY";GOSUB 1310GOTO 3301030 PRINT " BAR";GOSUB 1310GOTO 3901050 PRINT " BELL";GOSUB 1310GOTO 3901070 PRINT " ORANGE";GOSUB 1310GOTO 3901090 PRINT " LEMON";GOSUB 1310GOTO 3901110 PRINT " PLUM";GOSUB 1310GOTO 3901130 PRINT " CHERRY";GOSUB 1310GOTO 3901150 PRINT " BAR"GOTO 4501170 PRINT " BELL"GOTO 4501190 PRINT " ORANGE"GOTO 4501210 PRINT " LEMON"GOTO 4501230 PRINT " PLUM"GOTO 4501250 PRINT " CHERRY"GOTO 4501270 FOR Q4 = 1 TO 10  PRINT CHR$(7.0);NEXT Q4RETURN1310 FOR T8 = 1 TO 5  PRINT CHR$(7.0);NEXT T8RETURN1341 PRINT PRINT "DOUBLE!!"PRINT "YOU WON!"P := (((2.0 * M) + M) + P)GOTO 5101350 STOPEND