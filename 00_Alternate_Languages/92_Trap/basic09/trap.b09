procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure trapbase 0DIM G, N, Q, X: INTEGERA := 0.0B := 0.0G := 0N := 0Q := 0R := 0.0X := 0Z$ := ""type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(35.0); "TRAP"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT G := 6N := 100(*-TRAP *)(*-STEVE ULLMAN, 8-1-72 *)PRINT "INSTRUCTIONS";RUN _ecb_input_prefix_t \ INPUT "? ", Z$ \ RUN _ecb_input_suffix_tIF LEFT$(Z$, 1.0) <> "Y" THEN 180run ecb_str(float(N), tmp_1$) \ PRINT "I AM THINKING OF A NUMBER BETWEEN 1 AND"; tmp_1$PRINT "TRY TO GUESS MY NUMBER. ON EACH GUESS,"PRINT "YOU ARE TO ENTER 2 NUMBERS, TRYING TO TRAP"PRINT "MY NUMBER BETWEEN THE TWO NUMBERS. I WILL"PRINT "TELL YOU IF YOU HAVE TRAPPED MY NUMBER, IF MY"PRINT "NUMBER IS LARGER THAN YOUR TWO NUMBERS, OR IF"PRINT "MY NUMBER IS SMALLER THAN YOUR TWO NUMBERS."PRINT "IF YOU WANT TO GUESS ONE SINGLE NUMBER, TYPE"PRINT "YOUR GUESS FOR BOTH YOUR TRAP NUMBERS."run ecb_str(float(G), tmp_1$) \ PRINT "YOU GET"; tmp_1$; "GUESSES TO GET MY NUMBER."180 RUN ecb_int(N * RND(1.0), tmp_1) \ X := tmp_1 + 1FOR Q = 1 TO G  PRINT   run ecb_str(float(Q), tmp_1$) \ PRINT "GUESS #"; tmp_1$;  RUN _ecb_input_prefix_t \ INPUT "? ", A, B \ RUN _ecb_input_suffix_t  IF A = B AND X = A THEN 400  IF A <= B THEN 260  GOSUB 360260   IF A <= X AND X <= B THEN 320  IF X < A THEN 300  PRINT "MY NUMBER IS LARGER THAN YOUR TRAP NUMBERS."  GOTO 330300   PRINT "MY NUMBER IS SMALLER THAN YOUR TRAP NUMBERS."  GOTO 330320   PRINT "YOU HAVE TRAPPED MY NUMBER."330 NEXT Qrun ecb_str(float(G), tmp_1$) \ run ecb_str(float(X), tmp_2$) \ PRINT "SORRY, THAT'S"; tmp_1$; "GUESSES. THE NUMBER WAS"; tmp_2$PRINT GOTO 410360 R := AA := BB := RRETURN400 PRINT "YOU GOT IT!!!"410 PRINT PRINT "TRY AGAIN."PRINT GOTO 180END