procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure bunnybase 0DIM L: INTEGERI := 0.0J := 0.0L := 0X := 0.0Y := 0.0DIM arr_B(11)FOR tmp_1 = 0 TO 10 \ arr_B(tmp_1) := 0 \ NEXT tmp_1type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(34.0); "BUNNY"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT (*  "BUNNY" FROM AHL'S 'BASIC COMPUTER GAMES' *)(* *)FOR I = 0.0 TO 4.0READ arr_B(INT(I))NEXT IGOSUB 260L := 64(*  ASCII LETTER CODE... *)(* *)160 PRINT 170 READ XIF X < 0.0 THEN 160IF X > 128.0 THEN 240PRINT TAB(INT(X) + 1.0);READ YFOR I = X TO Y  RUN ecb_int(I / 5.0, tmp_1) \ J := I - 5.0 * tmp_1  PRINT CHR$(INT(L + arr_B(INT(J))));NEXT IGOTO 170(* *)240 GOSUB 260GOTO 450(* *)260 FOR I = 1.0 TO 6.0PRINT CHR$(10.0);NEXT IRETURN(* *)DATA 2.0, 21.0, 14.0, 14.0, 25.0DATA 1.0, 2.0, -1.0, 0.0, 2.0, 45.0, 50.0, -1.0, 0.0, 5.0, 43.0, 52.0, -1.0, 0.0, 7.0, 41.0, 52.0, -1.0DATA 1.0, 9.0, 37.0, 50.0, -1.0, 2.0, 11.0, 36.0, 50.0, -1.0, 3.0, 13.0, 34.0, 49.0, -1.0, 4.0, 14.0, 32.0, 48.0, -1.0DATA 5.0, 15.0, 31.0, 47.0, -1.0, 6.0, 16.0, 30.0, 45.0, -1.0, 7.0, 17.0, 29.0, 44.0, -1.0, 8.0, 19.0, 28.0, 43.0, -1.0DATA 9.0, 20.0, 27.0, 41.0, -1.0, 10.0, 21.0, 26.0, 40.0, -1.0, 11.0, 22.0, 25.0, 38.0, -1.0, 12.0, 22.0, 24.0, 36.0, -1.0DATA 13.0, 34.0, -1.0, 14.0, 33.0, -1.0, 15.0, 31.0, -1.0, 17.0, 29.0, -1.0, 18.0, 27.0, -1.0DATA 19.0, 26.0, -1.0, 16.0, 28.0, -1.0, 13.0, 30.0, -1.0, 11.0, 31.0, -1.0, 10.0, 32.0, -1.0DATA 8.0, 33.0, -1.0, 7.0, 34.0, -1.0, 6.0, 13.0, 16.0, 34.0, -1.0, 5.0, 12.0, 16.0, 35.0, -1.0DATA 4.0, 12.0, 16.0, 35.0, -1.0, 3.0, 12.0, 15.0, 35.0, -1.0, 2.0, 35.0, -1.0, 1.0, 35.0, -1.0DATA 2.0, 34.0, -1.0, 3.0, 34.0, -1.0, 4.0, 33.0, -1.0, 6.0, 33.0, -1.0, 10.0, 32.0, 34.0, 34.0, -1.0DATA 14.0, 17.0, 19.0, 25.0, 28.0, 31.0, 35.0, 35.0, -1.0, 15.0, 19.0, 23.0, 30.0, 36.0, 36.0, -1.0DATA 14.0, 18.0, 21.0, 21.0, 24.0, 30.0, 37.0, 37.0, -1.0, 13.0, 18.0, 23.0, 29.0, 33.0, 38.0, -1.0DATA 12.0, 29.0, 31.0, 33.0, -1.0, 11.0, 13.0, 17.0, 17.0, 19.0, 19.0, 22.0, 22.0, 24.0, 31.0, -1.0DATA 10.0, 11.0, 17.0, 18.0, 22.0, 22.0, 24.0, 24.0, 29.0, 29.0, -1.0DATA 22.0, 23.0, 26.0, 29.0, -1.0, 27.0, 29.0, -1.0, 28.0, 29.0, -1.0, 4096.0(* *)450 END