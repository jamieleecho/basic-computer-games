procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure bombardmentbase 0DIM C, D, E, F, I, M, N, P, Q, R, T, X, Z: INTEGERC := 0D := 0E := 0F := 0G := 0.0H := 0.0I := 0K := 0.0L := 0.0M := 0N := 0P := 0Q := 0R := 0T := 0X := 0Y := 0.0Z := 0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(34.0); "BOMBARDMENT"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT PRINT "YOU ARE ON A BATTLEFIELD WITH 4 PLATOONS AND YOU"PRINT "HAVE 25 OUTPOSTS AVAILABLE WHERE THEY MAY BE PLACED."PRINT "YOU CAN ONLY PLACE ONE PLATOON AT ANY ONE OUTPOST."PRINT "THE COMPUTER DOES THE SAME WITH ITS FOUR PLATOONS."PRINT PRINT "THE OBJECT OF THE GAME IS TO FIRE MISSLES AT THE"PRINT "OUTPOSTS OF THE COMPUTER.  IT WILL DO THE SAME TO YOU."PRINT "THE ONE WHO DESTROYS ALL FOUR OF THE ENEMY'S PLATOONS"PRINT "FIRST IS THE WINNER."PRINT PRINT "GOOD LUCK... AND TELL US WHERE YOU WANT THE BODIES SENT!"PRINT PRINT "TEAR OFF MATRIX AND USE IT TO CHECK OFF THE NUMBERS."FOR R = 1 TO 5PRINT NEXT RDIM arr_M(101): INTEGERFOR tmp_1 = 0 TO 100 \ arr_M(tmp_1) := 0 \ NEXT tmp_1FOR R = 1 TO 5  I := (R - 1) * 5 + 1  run ecb_str(float(I), tmp_1$) \ PRINT tmp_1$, I + 1.0, I + 2.0, I + 3.0, I + 4.0NEXT RFOR R = 1 TO 10PRINT NEXT RRUN ecb_int(RND(1.0) * 25.0, tmp_1) \ C := tmp_1 + 1390 RUN ecb_int(RND(1.0) * 25.0, tmp_1) \ D := tmp_1 + 1400 RUN ecb_int(RND(1.0) * 25.0, tmp_1) \ E := tmp_1 + 1410 RUN ecb_int(RND(1.0) * 25.0, tmp_1) \ F := tmp_1 + 1IF C = D THEN 390IF C = E THEN 400IF C = F THEN 410IF D = E THEN 400IF D = F THEN 410IF E = F THEN 410PRINT "WHAT ARE YOUR FOUR POSITIONS";RUN _ecb_input_prefix_t \ INPUT "? ", G, H, K, L \ RUN _ecb_input_suffix_tPRINT 500 PRINT "WHERE DO YOU WISH TO FIRE YOUR MISSLE";RUN _ecb_input_prefix_t \ INPUT "? ", Y \ RUN _ecb_input_suffix_tIF Y = C THEN 710IF Y = D THEN 710IF Y = E THEN 710IF Y = F THEN 710GOTO 630570 RUN ecb_int(RND(1.0) * 25.0, tmp_1) \ M := tmp_1 + 1GOTO 1160580 IF X = G THEN 920IF X = H THEN 920IF X = L THEN 920IF X = K THEN 920GOTO 670630 PRINT "HA, HA YOU MISSED. MY TURN NOW:"PRINT PRINT GOTO 570670 run ecb_str(float(M), tmp_1$) \ PRINT "I MISSED YOU, YOU DIRTY RAT. I PICKED"; tmp_1$; ". YOUR TURN:"PRINT PRINT GOTO 500710 Q := Q + 1IF Q = 4.0 THEN 890PRINT "YOU GOT ONE OF MY OUTPOSTS!"IF Q = 1.0 THEN 770IF Q = 2.0 THEN 810IF Q = 3.0 THEN 850770 PRINT "ONE DOWN, THREE TO GO."PRINT PRINT GOTO 570810 PRINT "TWO DOWN, TWO TO GO."PRINT PRINT GOTO 570850 PRINT "THREE DOWN, ONE TO GO."PRINT PRINT GOTO 570890 PRINT "YOU GOT ME, I'M GOING FAST. BUT I'LL GET YOU WHEN"PRINT "MY TRANSISTO&S RECUP%RA*E!"GOTO 1235920 Z := Z + 1IF Z = 4.0 THEN 1110run ecb_str(float(X), tmp_1$) \ PRINT "I GOT YOU. IT WON'T BE LONG NOW. POST"; tmp_1$; "WAS HIT."IF Z = 1.0 THEN 990IF Z = 2.0 THEN 1030IF Z = 3.0 THEN 1070990 PRINT "YOU HAVE ONLY THREE OUTPOSTS LEFT."PRINT PRINT GOTO 5001030 PRINT "YOU HAVE ONLY TWO OUTPOSTS LEFT."PRINT PRINT GOTO 5001070 PRINT "YOU HAVE ONLY ONE OUTPOST LEFT."PRINT PRINT GOTO 5001110 run ecb_str(float(X), tmp_1$) \ PRINT "YOU'RE DEAD. YOUR LAST OUTPOST WAS AT"; tmp_1$; ". HA, HA, HA."PRINT "BETTER LUCK NEXT TIME."GOTO 12351160 P := P + 1N := P - 1FOR T = 1 TO N  IF M = arr_M(T) THEN 570NEXT TX := Marr_M(P) := MGOTO 5801235 END