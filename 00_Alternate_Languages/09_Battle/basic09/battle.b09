procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure battlebase 0DIM H, I, J, K, M, N, S: INTEGERA := 0.0B := 0.0C := 0.0D := 0.0H := 0I := 0J := 0K := 0M := 0N := 0R := 0.0S := 0X := 0.0Y := 0.0Z := 0.0Z1 := 0.0Z2 := 0.0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(34.0); "BATTLE"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"(* -- BATTLE WRITTEN BY RAY WESTERGARD  10/70 *)(* COPYRIGHT 1971 BY THE REGENTS OF THE UNIV. OF CALIF. *)(* PRODUCED AT THE LAWRENCE HALL OF SCIENCE, BERKELEY *)DIM arr_F(7, 7), arr_H(7, 7), arr_C(7), arr_L(4): INTEGERFOR tmp_1 = 0 TO 6 \ FOR tmp_2 = 0 TO 6 \ arr_F(tmp_1, tmp_2) := 0 \ NEXT tmp_2 \ NEXT tmp_1FOR tmp_1 = 0 TO 6 \ FOR tmp_2 = 0 TO 6 \ arr_H(tmp_1, tmp_2) := 0 \ NEXT tmp_2 \ NEXT tmp_1FOR tmp_1 = 0 TO 6 \ arr_C(tmp_1) := 0 \ NEXT tmp_1FOR tmp_1 = 0 TO 3 \ arr_L(tmp_1) := 0 \ NEXT tmp_1DIM arr_A(5), arr_B(5)FOR tmp_1 = 0 TO 4 \ arr_A(tmp_1) := 0 \ NEXT tmp_1FOR tmp_1 = 0 TO 4 \ arr_B(tmp_1) := 0 \ NEXT tmp_150 FOR X = 1.0 TO 6.0  FOR Y = 1.0 TO 6.0    arr_F(INT(X), INT(Y)) := 0  NEXT YNEXT XFOR I = 1 TO 3  N := 4 - I  FOR J = 1 TO 290     RUN ecb_int(6.0 * RND(1.0) + 1.0, A)    RUN ecb_int(6.0 * RND(1.0) + 1.0, B)    RUN ecb_int(4.0 * RND(1.0) + 1.0, D)    IF arr_F(INT(A), INT(B)) > 0.0 THEN 90    M := 0    ON INT(D) GOTO 150, 340, 550, 740150     arr_B(1.0) := B    arr_B(2.0) := 7.0    arr_B(3.0) := 7.0    FOR K = 1 TO N      IF M > 1.0 THEN 240      IF arr_B(K) = 6.0 THEN 230      IF arr_F(INT(A), INT(arr_B(K) + 1.0)) > 0.0 THEN 230      arr_B(K + 1.0) := arr_B(K) + 1.0      GOTO 280230       M := 2240       IF arr_B(1.0) < arr_B(2.0) AND arr_B(1.0) < arr_B(3.0) THEN        Z := arr_B(1.0)ENDIF      IF arr_B(2.0) < arr_B(1.0) AND arr_B(2.0) < arr_B(3.0) THEN        Z := arr_B(2.0)ENDIF      IF arr_B(3.0) < arr_B(1.0) AND arr_B(3.0) < arr_B(2.0) THEN        Z := arr_B(3.0)ENDIF      IF Z = 1.0 THEN 90      IF arr_F(INT(A), INT(Z - 1.0)) > 0.0 THEN 90      arr_B(K + 1.0) := Z - 1.0280     NEXT K    arr_F(INT(A), INT(B)) := 9 - 2 * I - J    FOR K = 1 TO N      arr_F(INT(A), INT(arr_B(K + 1.0))) := arr_F(INT(A), INT(B))    NEXT K    GOTO 990340     arr_A(1.0) := A    arr_B(1.0) := B    arr_A(2.0) := 0.0    arr_A(3.0) := 0.0    arr_B(2.0) := 0.0    arr_B(3.0) := 0.0    FOR K = 1 TO N      IF M > 1.0 THEN 460      IF arr_A(K) = 1.0 OR arr_B(K) = 1.0 THEN 450      IF arr_F(INT(arr_A(K) - 1.0), INT(arr_B(K) - 1.0)) > 0.0 THEN 450      IF arr_F(INT(arr_A(K) - 1.0), INT(arr_B(K))) > 0.0 AND arr_F(INT(arr_A(K) - 1.0), INT(arr_B(K))) = arr_F(INT(arr_A(K)), INT(arr_B(K) - 1.0)) THEN 450      arr_A(K + 1.0) := arr_A(K) - 1.0      arr_B(K + 1.0) := arr_B(K) - 1.0      GOTO 530450       M := 2460       IF arr_A(1.0) > arr_A(2.0) AND arr_A(1.0) > arr_A(3.0) THEN        Z1 := arr_A(1.0)ENDIF      IF arr_A(2.0) > arr_A(1.0) AND arr_A(2.0) > arr_A(3.0) THEN        Z1 := arr_A(2.0)ENDIF      IF arr_A(3.0) > arr_A(1.0) AND arr_A(3.0) > arr_A(2.0) THEN        Z1 := arr_A(3.0)ENDIF      IF arr_B(1.0) > arr_B(2.0) AND arr_B(1.0) > arr_B(3.0) THEN        Z2 := arr_B(1.0)ENDIF      IF arr_B(2.0) > arr_B(1.0) AND arr_B(2.0) > arr_B(3.0) THEN        Z2 := arr_B(2.0)ENDIF      IF arr_B(3.0) > arr_B(1.0) AND arr_B(3.0) > arr_B(2.0) THEN        Z2 := arr_B(3.0)ENDIF      IF Z1 = 6.0 OR Z2 = 6.0 THEN 90      IF arr_F(INT(Z1 + 1.0), INT(Z2 + 1.0)) > 0.0 THEN 90      IF arr_F(INT(Z1), INT(Z2 + 1.0)) > 0.0 AND arr_F(INT(Z1), INT(Z2 + 1.0)) = arr_F(INT(Z1 + 1.0), INT(Z2)) THEN 90      arr_A(K + 1.0) := Z1 + 1.0      arr_B(K + 1.0) := Z2 + 1.0530     NEXT K    GOTO 950550     arr_A(1.0) := A    arr_A(2.0) := 7.0    arr_A(3.0) := 7.0    FOR K = 1 TO N      IF M > 1.0 THEN 640      IF arr_A(K) = 6.0 THEN 630      IF arr_F(INT(arr_A(K) + 1.0), INT(B)) > 0.0 THEN 630      arr_A(K + 1.0) := arr_A(K) + 1.0      GOTO 680630       M := 2640       IF arr_A(1.0) < arr_A(2.0) AND arr_A(1.0) < arr_A(3.0) THEN        Z := arr_A(1.0)ENDIF      IF arr_A(2.0) < arr_A(1.0) AND arr_A(2.0) < arr_A(3.0) THEN        Z := arr_A(2.0)ENDIF      IF arr_A(3.0) < arr_A(1.0) AND arr_A(3.0) < arr_A(2.0) THEN        Z := arr_A(3.0)ENDIF      IF Z = 1.0 THEN 90      IF arr_F(INT(Z - 1.0), INT(B)) > 0.0 THEN 90      arr_A(K + 1.0) := Z - 1.0680     NEXT K    arr_F(INT(A), INT(B)) := 9 - 2 * I - J    FOR K = 1 TO N      arr_F(INT(arr_A(K + 1.0)), INT(B)) := arr_F(INT(A), INT(B))    NEXT K    GOTO 990740     arr_A(1.0) := A    arr_B(1.0) := B    arr_A(2.0) := 7.0    arr_A(3.0) := 7.0    arr_B(2.0) := 0.0    arr_B(3.0) := 0.0    FOR K = 1 TO N      IF M > 1.0 THEN 870      IF arr_A(K) = 6.0 OR arr_B(K) = 1.0 THEN 860      IF arr_F(INT(arr_A(K) + 1.0), INT(arr_B(K) - 1.0)) > 0.0 THEN 860      IF arr_F(INT(arr_A(K) + 1.0), INT(arr_B(K))) > 0.0 AND arr_F(INT(arr_A(K) + 1.0), INT(arr_B(K))) = arr_F(INT(arr_A(K)), INT(arr_B(K) - 1.0)) THEN 860      arr_A(K + 1.0) := arr_A(K) + 1.0      arr_B(K + 1.0) := arr_B(K) - 1.0      GOTO 940860       M := 2870       IF arr_A(1.0) < arr_A(2.0) AND arr_A(1.0) < arr_A(3.0) THEN        Z1 := arr_A(1.0)ENDIF      IF arr_A(2.0) < arr_A(1.0) AND arr_A(2.0) < arr_A(3.0) THEN        Z1 := arr_A(2.0)ENDIF      IF arr_A(3.0) < arr_A(1.0) AND arr_A(3.0) < arr_A(2.0) THEN        Z1 := arr_A(3.0)ENDIF      IF arr_B(1.0) > arr_B(2.0) AND arr_B(1.0) > arr_B(3.0) THEN        Z2 := arr_B(1.0)ENDIF      IF arr_B(2.0) > arr_B(1.0) AND arr_B(2.0) > arr_B(3.0) THEN        Z2 := arr_B(2.0)ENDIF      IF arr_B(3.0) > arr_B(1.0) AND arr_B(3.0) > arr_B(2.0) THEN        Z2 := arr_B(3.0)ENDIF      IF Z1 = 1.0 OR Z2 = 6.0 THEN 90      IF arr_F(INT(Z1 - 1.0), INT(Z2 + 1.0)) > 0.0 THEN 90      IF arr_F(INT(Z1), INT(Z2 + 1.0)) > 0.0 AND arr_F(INT(Z1), INT(Z2 + 1.0)) = arr_F(INT(Z1 - 1.0), INT(Z2)) THEN 90      arr_A(K + 1.0) := Z1 - 1.0      arr_B(K + 1.0) := Z2 + 1.0940     NEXT K950     arr_F(INT(A), INT(B)) := 9 - 2 * I - J    FOR K = 1 TO N      arr_F(INT(arr_A(K + 1.0)), INT(arr_B(K + 1.0))) := arr_F(INT(A), INT(B))    NEXT K990   NEXT JNEXT IPRINT PRINT "THE FOLLOWING CODE OF THE BAD GUYS' FLEET DISPOSITION"PRINT "HAS BEEN CAPTURED BUT NOT DECODED:"PRINT FOR I = 1 TO 6  FOR J = 1 TO 6    arr_H(I, J) := arr_F(J, I)  NEXT JNEXT IFOR I = 1 TO 6  FOR J = 1 TO 6    run ecb_str(float(arr_H(I, J)), tmp_1$) \ PRINT tmp_1$;  NEXT J  PRINT NEXT IPRINT PRINT "DE-CODE IT AND USE IT IF YOU CAN"PRINT "BUT KEEP THE DE-CODING METHOD A SECRET."PRINT FOR I = 1 TO 6  FOR J = 1 TO 6    arr_H(I, J) := 0  NEXT JNEXT IFOR I = 1 TO 3  arr_L(I) := 0NEXT Iarr_C(1) := 2arr_C(2) := 2arr_C(3) := 1arr_C(4) := 1arr_C(5) := 0arr_C(6) := 0S := 0H := 0PRINT "START GAME"1180 RUN _ecb_input_prefix_t \ INPUT "? ", X, Y \ RUN _ecb_input_suffix_tRUN ecb_int(X, tmp_1) \ IF X < 1.0 OR X > 6.0 OR tmp_1 <> ABS(X) THEN 1210RUN ecb_int(Y, tmp_1) \ IF Y > 0.0 AND Y < 7.0 AND tmp_1 = ABS(Y) THEN 12301210 PRINT "INVALID INPUT.  TRY AGAIN."GOTO 11801230 R := 7.0 - YC := XIF arr_F(INT(R), INT(C)) > 0.0 THEN 1290S := S + 1PRINT "SPLASH!  TRY AGAIN."GOTO 11801290 IF arr_C(arr_F(INT(R), INT(C))) < 4.0 THEN 1340PRINT "THERE USED TO BE A SHIP AT THAT POINT, BUT YOU SUNK IT."PRINT "SPLASH!  TRY AGAIN."S := S + 1GOTO 11801340 IF arr_H(INT(R), INT(C)) > 0.0 THEN 1420H := H + 1arr_H(INT(R), INT(C)) := arr_F(INT(R), INT(C))run ecb_str(float(arr_F(INT(R), INT(C))), tmp_1$) \ PRINT "A DIRECT HIT ON SHIP NUMBER"; tmp_1$arr_C(arr_F(INT(R), INT(C))) := arr_C(arr_F(INT(R), INT(C))) + 1IF arr_C(arr_F(INT(R), INT(C))) >= 4.0 THEN 1470PRINT "TRY AGAIN."GOTO 11801420 run ecb_str(float(arr_F(INT(R), INT(C))), tmp_1$) \ PRINT "YOU ALREADY PUT A HOLE IN SHIP NUMBER"; tmp_1$;PRINT "AT THAT POINT."PRINT "SPLASH!  TRY AGAIN."S := S + 1GOTO 11801470 RUN ecb_int(arr_F(INT(R), INT(C)) - 1.0, tmp_1) \ RUN ecb_int(arr_F(INT(R), INT(C)) - 1.0, tmp_2) \ arr_L(INT((tmp_1 / 2.0) + 1.0)) := arr_L(INT((tmp_2 / 2.0) + 1.0)) + 1PRINT "AND YOU SUNK IT.  HURRAH FOR THE GOOD GUYS."PRINT "SO FAR, THE BAD GUYS HAVE LOST"run ecb_str(float(arr_L(1)), tmp_1$) \ run ecb_str(float(arr_L(2)), tmp_2$) \ PRINT tmp_1$; "DESTROYER(S),"; tmp_2$; "CRUISER(S), AND";run ecb_str(float(arr_L(3)), tmp_1$) \ PRINT tmp_1$; "AIRCRAFT CARRIER(S)."PRINT "YOUR CURRENT SPLASH/HIT RATIO IS"; S / HIF (arr_L(1) + arr_L(2) + arr_L(3)) < 6.0 THEN 1180PRINT PRINT "YOU HAVE TOTALLY WIPED OUT THE BAD GUYS' FLEET"PRINT "WITH A FINAL SPLASH/HIT RATIO OF"; S / HIF S / H > 0.0 THEN 1590PRINT "CONGRATULATIONS -- A DIRECT HIT EVERY TIME."1590 PRINT PRINT "****************************"PRINT GOTO 50END