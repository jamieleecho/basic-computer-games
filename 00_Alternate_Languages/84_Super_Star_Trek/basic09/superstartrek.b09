procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure superstartrekbase 0DIM A$:STRING[52]DIM A1$:STRING[52]DIM C$:STRING[52]DIM G2$:STRING[52]DIM O1$:STRING[52]DIM Q$:STRING[52]DIM X$:STRING[52]DIM X0$:STRING[52]DIM Z$:STRING[52]DIM tmp_1$:STRING[52]DIM tmp_2$:STRING[52]DIM tmp_3$:STRING[52]DIM tmp_4$:STRING[52]DIM B5, B9, D0, D1, G5, H8, K7, K9, L, P, P0, R2, S9, T9, X5, Z3, fnD_1, fnR_1, fnR_2, fnR_3, fnR_4: INTEGERA := 0.0A$ := ""A1$ := ""B3 := 0.0B4 := 0.0B5 := 0B9 := 0C$ := ""C1 := 0.0D0 := 0D1 := 0D3 := 0.0D4 := 0.0D6 := 0.0E := 0.0E0 := 0.0G2$ := ""G5 := 0H := 0.0H1 := 0.0H8 := 0I := 0.0J := 0.0J0 := 0.0K3 := 0.0K7 := 0K9 := 0L := 0N := 0.0O1$ := ""P := 0P0 := 0Q$ := ""Q1 := 0.0Q2 := 0.0Q4 := 0.0Q5 := 0.0R1 := 0.0R2 := 0S := 0.0S1 := 0.0S2 := 0.0S3 := 0.0S8 := 0.0S9 := 0T := 0.0T0 := 0.0T8 := 0.0T9 := 0W1 := 0.0X := 0.0X$ := ""X0$ := ""X1 := 0.0X2 := 0.0X3 := 0.0X5 := 0Y := 0.0Y3 := 0.0Z$ := ""Z1 := 0.0Z2 := 0.0Z3 := 0Z4 := 0.0Z5 := 0.0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 010 (* SUPER STARTREK - MAY 16,1978 - REQUIRES 24K MEMORY *)(* *)(* ****        **** STAR TREK ****        **** *)(* **** SIMULATION OF A MISSION OF THE STARSHIP ENTERPRISE, *)(* **** AS SEEN ON THE STAR TREK TV SHOW. *)(* **** ORIGIONAL PROGRAM BY MIKE MAYFIELD, MODIFIED VERSION *)(* **** PUBLISHED IN DEC'S "101 BASIC GAMES", BY DAVE AHL. *)(* **** MODIFICATIONS TO THE LATTER (PLUS DEBUGGING) BY BOB *)(* *** LEEDOM - APRIL & DECEMBER 1974, *)(* *** WITH A LITTLE HELP FROM HIS FRIENDS . . . *)(* *** COMMENTS, EPITHETS, AND SUGGESTIONS SOLICITED -- *)(* *** SEND TO:  R. C. LEEDOM *)(* ***           WESTINGHOUSE DEFENSE & ELECTRONICS SYSTEMS CNTR. *)(* ***           BOX 746, M.S. 338 *)(* ***           BALTIMORE, MD  21203 *)(* *** *)(* *** CONVERTED TO MICROSOFT 8 K BASIC 3/16/78 BY JOHN GORDERS *)(* *** LINE NUMBERS FROM VERSION STREK7 OF 1/12/75 PRESERVED AS *)(* *** MUCH AS POSSIBLE WHILE USING MULTIPLE STATEMENTS PER LINE *)(* *** SOME LINES ARE LONGER THAN 72 CHARACTERS; THIS WAS DONE *)(* *** BY USING "?" INSTEAD OF "PRINT" WHEN ENTERING LINES *)(* *** *)PRINT PRINT PRINT PRINT PRINT PRINT PRINT PRINT PRINT PRINT PRINT PRINT "                                    ,------*------,"PRINT "                    ,-------------   '---  ------'"PRINT "                     '-------- --'      / /"PRINT "                         ,---' '-------/ /--,"PRINT "                          '----------------'"PRINT PRINT "                    THE USS ENTERPRISE --- NCC-1701"PRINT PRINT PRINT PRINT PRINT (* CLEAR 600 *)Z$ := "                         "DIM arr_C(10, 3): INTEGERFOR tmp_1 = 0 TO 9 \ FOR tmp_2 = 0 TO 2 \ arr_C(tmp_1, tmp_2) := 0 \ NEXT tmp_2 \ NEXT tmp_1DIM arr_G(9, 9), arr_K(4, 4), arr_N(4), arr_Z(9, 9), arr_D(9)FOR tmp_1 = 0 TO 8 \ FOR tmp_2 = 0 TO 8 \ arr_G(tmp_1, tmp_2) := 0 \ NEXT tmp_2 \ NEXT tmp_1FOR tmp_1 = 0 TO 3 \ FOR tmp_2 = 0 TO 3 \ arr_K(tmp_1, tmp_2) := 0 \ NEXT tmp_2 \ NEXT tmp_1FOR tmp_1 = 0 TO 3 \ arr_N(tmp_1) := 0 \ NEXT tmp_1FOR tmp_1 = 0 TO 8 \ FOR tmp_2 = 0 TO 8 \ arr_Z(tmp_1, tmp_2) := 0 \ NEXT tmp_2 \ NEXT tmp_1FOR tmp_1 = 0 TO 8 \ arr_D(tmp_1) := 0 \ NEXT tmp_1RUN ecb_int(RND(1.0) * 20.0 + 20.0, tmp_1) \ T := tmp_1 * 100.0T0 := TRUN ecb_int(RND(1.0) * 10.0, tmp_1) \ T9 := 25 + tmp_1D0 := 0E := 3000.0E0 := EP := 10P0 := PS9 := 200S := 0.0B9 := 2K9 := 0X$ := ""X0$ := " IS "(* DEF FND(D)=SQR((K(I,1)-S1)^2+(K(I,2)-S2)^2) *)(* DEF FNR(R)=INT(RND(R)*7.98+1.01) *)(* INITIALIZE ENTERPRIZE'S POSITION *)fnR_1 := 1 \ RUN ecb_int(RND(fnR_1) * 7.98 + 1.01, tmp_1) \ Q1 := tmp_1fnR_2 := 1 \ RUN ecb_int(RND(fnR_2) * 7.98 + 1.01, tmp_1) \ Q2 := tmp_1fnR_3 := 1 \ RUN ecb_int(RND(fnR_3) * 7.98 + 1.01, tmp_1) \ S1 := tmp_1fnR_4 := 1 \ RUN ecb_int(RND(fnR_4) * 7.98 + 1.01, tmp_1) \ S2 := tmp_1FOR I = 1.0 TO 9.0arr_C(INT(I), 1) := 0arr_C(INT(I), 2) := 0NEXT Iarr_C(3, 1) := -1arr_C(2, 1) := -1arr_C(4, 1) := -1arr_C(4, 2) := -1arr_C(5, 2) := -1arr_C(6, 2) := -1arr_C(1, 2) := 1arr_C(2, 2) := 1arr_C(6, 1) := 1arr_C(7, 1) := 1arr_C(8, 1) := 1arr_C(8, 2) := 1arr_C(9, 2) := 1FOR I = 1.0 TO 8.0arr_D(INT(I)) := 0.0NEXT IA1$ := "NAVSRSLRSPHATORSHEDAMCOMXXX"(* SETUP WHAT EXHISTS IN GALAXY . . . *)(* K3= # KLINGONS  B3= # STARBASES  S3 = # STARS *)  FOR I = 1.0 TO 8.0  FOR J = 1.0 TO 8.0    K3 := 0.0    arr_Z(INT(I), INT(J)) := 0.0    R1 := RND(1.0)    IF R1 > 0.98 THEN      K3 := 3.0      K9 := K9 + 3      GOTO 980ENDIF    IF R1 > 0.95 THEN      K3 := 2.0      K9 := K9 + 2      GOTO 980ENDIF    IF R1 > 0.8 THEN      K3 := 1.0      K9 := K9 + 1ENDIF980     B3 := 0.0    IF RND(1.0) > 0.96 THEN      B3 := 1.0      B9 := B9 + 1ENDIFfnR_1 := 1 \ RUN ecb_int(RND(fnR_1) * 7.98 + 1.01, tmp_1) \ arr_G(INT(I), INT(J)) := K3 * 100.0 + B3 * 10.0 + tmp_1NEXT JNEXT IIF K9 > T9 THEN  T9 := K9 + 1ENDIFIF B9 <> 0.0 THEN 1200IF arr_G(INT(Q1), INT(Q2)) < 200.0 THEN  arr_G(INT(Q1), INT(Q2)) := arr_G(INT(Q1), INT(Q2)) + 120.0  K9 := K9 + 1ENDIFB9 := 1arr_G(INT(Q1), INT(Q2)) := arr_G(INT(Q1), INT(Q2)) + 10.0fnR_1 := 1 \ RUN ecb_int(RND(fnR_1) * 7.98 + 1.01, tmp_1) \ Q1 := tmp_1fnR_2 := 1 \ RUN ecb_int(RND(fnR_2) * 7.98 + 1.01, tmp_1) \ Q2 := tmp_11200 K7 := K9IF B9 <> 1.0 THEN  X$ := "S"  X0$ := " ARE "ENDIFPRINT "YOUR ORDERS ARE AS FOLLOWS:"run ecb_str(float(K9), tmp_1$) \ PRINT "     DESTROY THE"; tmp_1$; "KLINGON WARSHIPS WHICH HAVE INVADED"PRINT "   THE GALAXY BEFORE THEY CAN ATTACK FEDERATION HEADQUARTERS"run ecb_str(float(T9), tmp_1$) \ PRINT "   ON STARDATE"; T0 + T9; "  THIS GIVES YOU"; tmp_1$; "DAYS.  THERE"; X0$run ecb_str(float(B9), tmp_1$) \ PRINT "  "; tmp_1$; "STARBASE"; X$; " IN THE GALAXY FOR RESUPPLYING YOUR SHIP"PRINT (* PRINT "HIT ANY KEY EXCEPT RETURN WHEN READY TO ACCEPT COMMAND" *)I := RND(1.0)(* IF INP(1)=13 THEN 1300 *)(* HERE ANY TIME NEW QUADRANT ENTERED *)1320 Z4 := Q1Z5 := Q2K3 := 0.0B3 := 0.0S3 := 0.0G5 := 0D4 := 0.5 * RND(1.0)arr_Z(INT(Q1), INT(Q2)) := arr_G(INT(Q1), INT(Q2))IF Q1 < 1.0 OR Q1 > 8.0 OR Q2 < 1.0 OR Q2 > 8.0 THEN 1600GOSUB 9030PRINT IF T0 <> T THEN 1490PRINT "YOUR MISSION BEGINS WITH YOUR STARSHIP LOCATED"PRINT "IN THE GALACTIC QUADRANT, '"; G2$; "'."GOTO 15001490 PRINT "NOW ENTERING "; G2$; " QUADRANT . . ."1500 PRINT RUN ecb_int(arr_G(INT(Q1), INT(Q2)) * 0.01, K3)RUN ecb_int(arr_G(INT(Q1), INT(Q2)) * 0.1, tmp_1) \ B3 := tmp_1 - 10.0 * K3S3 := arr_G(INT(Q1), INT(Q2)) - 100.0 * K3 - 10.0 * B3IF K3 = 0.0 THEN 1590PRINT "COMBAT AREA      CONDITION RED"IF S > 200.0 THEN 1590PRINT "   SHIELDS DANGEROUSLY LOW"1590 FOR I = 1.0 TO 3.0arr_K(INT(I), 1.0) := 0.0arr_K(INT(I), 2.0) := 0.0NEXT I1600 FOR I = 1.0 TO 3.0arr_K(INT(I), 3.0) := 0.0NEXT IQ$ := Z$ + Z$ + Z$ + Z$ + Z$ + Z$ + Z$ + LEFT$(Z$, 17.0)(* POSITION ENTERPRISE IN QUADRANT, THEN PLACE "K3" KLINGONS, & *)(* "B3" STARBASES, & "S3" STARS ELSEWHERE. *)A$ := "<*>"Z1 := S1Z2 := S2GOSUB 8670IF K3 < 1.0 THEN 1820FOR I = 1.0 TO K3  GOSUB 8590  A$ := "+K+"  Z1 := R1  Z2 := R2GOSUB 8670arr_K(INT(I), 1.0) := R1arr_K(INT(I), 2.0) := R2arr_K(INT(I), 3.0) := S9 * (0.5 + RND(1.0))NEXT I1820 IF B3 < 1.0 THEN 1910GOSUB 8590A$ := ">!<"Z1 := R1B4 := R1Z2 := R2B5 := R2GOSUB 86701910 FOR I = 1.0 TO S3GOSUB 8590A$ := " * "Z1 := R1Z2 := R2GOSUB 8670NEXT I1980 GOSUB 64301990 IF S + E > 10.0 THEN  IF E > 10.0 OR arr_D(7.0) = 0.0 THEN 2060ENDIFPRINT PRINT "** FATAL ERROR **   YOU'VE JUST STRANDED YOUR SHIP IN "PRINT "SPACE"PRINT "YOU HAVE INSUFFICIENT MANEUVERING ENERGY,";PRINT " AND SHIELD CONTROL"PRINT "IS PRESENTLY INCAPABLE OF CROSS";PRINT "-CIRCUITING TO ENGINE ROOM!!"GOTO 62202060 RUN _ecb_input_prefix_t \ INPUT "COMMAND? ", A$ \ RUN _ecb_input_suffix_tFOR I = 1.0 TO 9.0  IF LEFT$(A$, 3.0) <> MID$(A1$, INT(3.0 * I - 2.0), 3.0) THEN 2160  ON INT(I) GOTO 2300, 1980, 4000, 4260, 4700, 5530, 5690, 7290, 62702160 NEXT IPRINT "ENTER ONE OF THE FOLLOWING:"PRINT "  NAV  (TO SET COURSE)"PRINT "  SRS  (FOR SHORT RANGE SENSOR SCAN)"PRINT "  LRS  (FOR LONG RANGE SENSOR SCAN)"PRINT "  PHA  (TO FIRE PHASERS)"PRINT "  TOR  (TO FIRE PHOTON TORPEDOES)"PRINT "  SHE  (TO RAISE OR LOWER SHIELDS)"PRINT "  DAM  (FOR DAMAGE CONTROL REPORTS)"PRINT "  COM  (TO CALL ON LIBRARY-COMPUTER)"PRINT "  XXX  (TO RESIGN YOUR COMMAND)"PRINT GOTO 1990(* COURSE CONTROL BEGINS HERE *)2300 RUN _ecb_input_prefix_t \ INPUT "COURSE (0-9)? ", C1 \ RUN _ecb_input_suffix_tIF C1 = 9.0 THEN  C1 := 1.0ENDIFIF C1 >= 1.0 AND C1 < 9.0 THEN 2350PRINT "   LT. SULU REPORTS, 'INCORRECT COURSE DATA, SIR!'"GOTO 19902350 X$ := "8"IF arr_D(1.0) < 0.0 THEN  X$ := "0.2"ENDIFPRINT "WARP FACTOR (0-"; X$; ")";RUN _ecb_input_prefix_t \ INPUT "? ", W1 \ RUN _ecb_input_suffix_tIF arr_D(1.0) < 0.0 AND W1 > 0.2 THEN 2470IF W1 > 0.0 AND W1 <= 8.0 THEN 2490IF W1 = 0.0 THEN 1990PRINT "   CHIEF ENGINEER SCOTT REPORTS 'THE ENGINES WON'T TAKE";run ecb_str(W1, tmp_1$) \ PRINT " WARP "; tmp_1$; "!'"GOTO 19902470 PRINT "WARP ENGINES ARE DAMAGED.  MAXIUM SPEED = WARP 0.2"GOTO 19902490 RUN ecb_int(W1 * 8.0 + 0.5, N)IF E - N >= 0.0 THEN 2590PRINT "ENGINEERING REPORTS   'INSUFFICIENT ENERGY AVAILABLE"run ecb_str(W1, tmp_1$) \ PRINT "                       FOR MANEUVERING AT WARP"; tmp_1$; "!'"IF S < N - E OR arr_D(7.0) < 0.0 THEN 1990run ecb_str(S, tmp_1$) \ PRINT "DEFLECTOR CONTROL ROOM ACKNOWLEDGES"; tmp_1$; "UNITS OF ENERGY"PRINT "                         PRESENTLY DEPLOYED TO SHIELDS."GOTO 1990(* KLINGONS MOVE/FIRE ON MOVING STARSHIP . . . *)2590 FOR I = 1.0 TO K3  IF arr_K(INT(I), 3.0) = 0.0 THEN 2700  A$ := "   "  Z1 := arr_K(INT(I), 1.0)  Z2 := arr_K(INT(I), 2.0)  GOSUB 8670  GOSUB 8590  arr_K(INT(I), 1.0) := Z1  arr_K(INT(I), 2.0) := Z2  A$ := "+K+"  GOSUB 86702700 NEXT IGOSUB 6000D1 := 0D6 := W1IF W1 >= 1.0 THEN  D6 := 1.0ENDIFFOR I = 1.0 TO 8.0  IF arr_D(INT(I)) >= 0.0 THEN 2880  arr_D(INT(I)) := arr_D(INT(I)) + D6  IF arr_D(INT(I)) > -0.1 AND arr_D(INT(I)) < 0.0 THEN    arr_D(INT(I)) := -0.1    GOTO 2880ENDIF  IF arr_D(INT(I)) < 0.0 THEN 2880  IF D1 <> 1.0 THEN    D1 := 1    PRINT "DAMAGE CONTROL REPORT:  ";ENDIF  PRINT TAB(9.0);  R1 := I  GOSUB 8790  PRINT G2$; " REPAIR COMPLETED."2880 NEXT IIF RND(1.0) > 0.2 THEN 3070fnR_1 := 1 \ RUN ecb_int(RND(fnR_1) * 7.98 + 1.01, tmp_1) \ R1 := tmp_1IF RND(1.0) >= 0.6 THEN 3000arr_D(INT(R1)) := arr_D(INT(R1)) - (RND(1.0) * 5.0 + 1.0)PRINT "DAMAGE CONTROL REPORT:  ";GOSUB 8790PRINT G2$; " DAMAGED"PRINT GOTO 30703000 arr_D(INT(R1)) := arr_D(INT(R1)) + RND(1.0) * 3.0 + 1.0PRINT "DAMAGE CONTROL REPORT:  ";GOSUB 8790PRINT G2$; " STATE OF REPAIR IMPROVED"PRINT (* BEGIN MOVING STARSHIP *)3070 A$ := "   "RUN ecb_int(S1, Z1)RUN ecb_int(S2, Z2)GOSUB 8670RUN ecb_int(C1, tmp_1) \ X1 := arr_C(INT(C1), 1) + (arr_C(INT(C1 + 1.0), 1) - arr_C(INT(C1), 1)) * (C1 - tmp_1)X := S1Y := S2RUN ecb_int(C1, tmp_1) \ X2 := arr_C(INT(C1), 2) + (arr_C(INT(C1 + 1.0), 2) - arr_C(INT(C1), 2)) * (C1 - tmp_1)Q4 := Q1Q5 := Q2FOR I = 1.0 TO N  S1 := S1 + X1  S2 := S2 + X2  IF S1 < 1.0 OR S1 >= 9.0 OR S2 < 1.0 OR S2 >= 9.0 THEN 3500  RUN ecb_int(S1, tmp_1) \ RUN ecb_int(S2, tmp_2) \ S8 := tmp_1 * 24.0 + tmp_2 * 3.0 - 26.0  IF MID$(Q$, INT(S8), 2.0) = "  " THEN 3360  RUN ecb_int(S1 - X1, S1)  RUN ecb_int(S2 - X2, S2)  PRINT "WARP ENGINES SHUT DOWN AT ";  run ecb_str(S1, tmp_1$) \ run ecb_str(S2, tmp_2$) \ PRINT "SECTOR"; tmp_1$; ","; tmp_2$; "DUE TO BAD NAVAGATION"  GOTO 33703360 NEXT IRUN ecb_int(S1, S1)RUN ecb_int(S2, S2)3370 A$ := "<*>"RUN ecb_int(S1, Z1)RUN ecb_int(S2, Z2)GOSUB 8670GOSUB 3910T8 := 1.0IF W1 < 1.0 THEN  RUN ecb_int(10.0 * W1, tmp_1) \ T8 := 0.1 * tmp_1ENDIFT := T + T8IF T > T0 + T9 THEN 6220(* SEE IF DOCKED, THEN GET COMMAND *)GOTO 1980(* EXCEEDED QUADRANT LIMITS *)3500 X := 8.0 * Q1 + X + N * X1Y := 8.0 * Q2 + Y + N * X2RUN ecb_int(X / 8.0, Q1)RUN ecb_int(Y / 8.0, Q2)RUN ecb_int(X - Q1 * 8.0, S1)RUN ecb_int(Y - Q2 * 8.0, S2)IF S1 = 0.0 THEN  Q1 := Q1 - 1.0  S1 := 8.0ENDIFIF S2 = 0.0 THEN  Q2 := Q2 - 1.0  S2 := 8.0ENDIFX5 := 0IF Q1 < 1.0 THEN  X5 := 1  Q1 := 1.0  S1 := 1.0ENDIFIF Q1 > 8.0 THEN  X5 := 1  Q1 := 8.0  S1 := 8.0ENDIFIF Q2 < 1.0 THEN  X5 := 1  Q2 := 1.0  S2 := 1.0ENDIFIF Q2 > 8.0 THEN  X5 := 1  Q2 := 8.0  S2 := 8.0ENDIFIF X5 = 0.0 THEN 3860PRINT "LT. UHURA REPORTS MESSAGE FROM STARFLEET COMMAND:"PRINT "  'PERMISSION TO ATTEMPT CROSSING OF GALACTIC PERIMETER"PRINT "  IS HEREBY *DENIED*.  SHUT DOWN YOUR ENGINES.'"PRINT "CHIEF ENGINEER SCOTT REPORTS  'WARP ENGINES SHUT DOWN"run ecb_str(S1, tmp_1$) \ run ecb_str(S2, tmp_2$) \ run ecb_str(Q1, tmp_3$) \ run ecb_str(Q2, tmp_4$) \ PRINT "  AT SECTOR"; tmp_1$; ","; tmp_2$; "OF QUADRANT"; tmp_3$; ","; tmp_4$; ".'"IF T > T0 + T9 THEN 62203860 IF 8.0 * Q1 + Q2 = 8.0 * Q4 + Q5 THEN 3370T := T + 1.0GOSUB 3910GOTO 1320(* MANEUVER ENERGY S/R ** *)3910 E := E - N - 10.0IF E >= 0.0 THEN  RETURNENDIFPRINT "SHIELD CONTROL SUPPLIES ENERGY TO COMPLETE THE MANEUVER."S := S + EE := 0.0IF S <= 0.0 THEN  S := 0.0ENDIFRETURN(* LONG RANGE SENSOR SCAN CODE *)4000 IF arr_D(3.0) < 0.0 THEN  PRINT "LONG RANGE SENSORS ARE INOPERABLE"  GOTO 1990ENDIFrun ecb_str(Q1, tmp_1$) \ run ecb_str(Q2, tmp_2$) \ PRINT "LONG RANGE SCAN FOR QUADRANT"; tmp_1$; ","; tmp_2$O1$ := "-------------------"PRINT O1$  FOR I = Q1 - 1.0 TO Q1 + 1.0    arr_N(1.0) := -1.0    arr_N(2.0) := -2.0    arr_N(3.0) := -3.0  FOR J = Q2 - 1.0 TO Q2 + 1.0    IF I > 0.0 AND I < 9.0 AND J > 0.0 AND J < 9.0 THEN      arr_N(INT(J - Q2 + 2.0)) := arr_G(INT(I), INT(J))      arr_Z(INT(I), INT(J)) := arr_G(INT(I), INT(J))ENDIF    NEXT J  FOR L = 1 TO 3    PRINT ": ";    IF arr_N(L) < 0.0 THEN      PRINT "*** ";      GOTO 4230ENDIF    RUN ecb_str(arr_N(L) + 1000.0, tmp_1$) \ PRINT RIGHT$(tmp_1$, 3.0); " ";4230 NEXT LPRINT ":"PRINT O1$NEXT IGOTO 1990(* PHASER CONTROL CODE BEGINS HERE *)4260 IF arr_D(4.0) < 0.0 THEN  PRINT "PHASERS INOPERATIVE"  GOTO 1990ENDIFIF K3 > 0.0 THEN 43304270 PRINT "SCIENCE OFFICER SPOCK REPORTS  'SENSORS SHOW NO ENEMY SHIPS"PRINT "                                IN THIS QUADRANT'"GOTO 19904330 IF arr_D(8.0) < 0.0 THEN  PRINT "COMPUTER FAILURE HAMPERS ACCURACY"ENDIFPRINT "PHASERS LOCKED ON TARGET;  ";4360 run ecb_str(E, tmp_1$) \ PRINT "ENERGY AVAILABLE ="; tmp_1$; "UNITS"RUN _ecb_input_prefix_t \ INPUT "NUMBER OF UNITS TO FIRE? ", X \ RUN _ecb_input_suffix_tIF X <= 0.0 THEN 1990IF E - X < 0.0 THEN 4360E := E - XIF arr_D(7.0) < 0.0 THEN  X := X * RND(1.0)ENDIF  RUN ecb_int(X / K3, H1)FOR I = 1.0 TO 3.0  IF arr_K(INT(I), 3.0) <= 0.0 THEN 4670  fnD_1 := 0 \ RUN ecb_int((H1 / SQR((arr_K(INT(I), 1.0) - S1) ^ 2.0 + (arr_K(INT(I), 2.0) - S2) ^ 2.0)) * (RND(1.0) + 2.0), H)  IF H > 0.15 * arr_K(INT(I), 3.0) THEN 4530  run ecb_str(arr_K(INT(I), 1.0), tmp_1$) \ run ecb_str(arr_K(INT(I), 2.0), tmp_2$) \ PRINT "SENSORS SHOW NO DAMAGE TO ENEMY AT "; tmp_1$; ","; tmp_2$  GOTO 46704530   arr_K(INT(I), 3.0) := arr_K(INT(I), 3.0) - H  run ecb_str(H, tmp_1$) \ run ecb_str(arr_K(INT(I), 1.0), tmp_2$) \ PRINT tmp_1$; "UNIT HIT ON KLINGON AT SECTOR"; tmp_2$; ",";  run ecb_str(arr_K(INT(I), 2.0), tmp_1$) \ PRINT tmp_1$  IF arr_K(INT(I), 3.0) <= 0.0 THEN    PRINT "*** KLINGON DESTROYED ***"    GOTO 4580ENDIF  run ecb_str(arr_K(INT(I), 3.0), tmp_1$) \ PRINT "   (SENSORS SHOW"; tmp_1$; "UNITS REMAINING)"  GOTO 46704580   K3 := K3 - 1.0  K9 := K9 - 1  Z1 := arr_K(INT(I), 1.0)  Z2 := arr_K(INT(I), 2.0)  A$ := "   "  GOSUB 8670  arr_K(INT(I), 3.0) := 0.0  arr_G(INT(Q1), INT(Q2)) := arr_G(INT(Q1), INT(Q2)) - 100.0  arr_Z(INT(Q1), INT(Q2)) := arr_G(INT(Q1), INT(Q2))  IF K9 <= 0.0 THEN 63704670 NEXT IGOSUB 6000GOTO 1990(* PHOTON TORPEDO CODE BEGINS HERE *)4700 IF P <= 0.0 THEN  PRINT "ALL PHOTON TORPEDOES EXPENDED"  GOTO 1990ENDIFIF arr_D(5.0) < 0.0 THEN  PRINT "PHOTON TUBES ARE NOT OPERATIONAL"  GOTO 1990ENDIF4760 RUN _ecb_input_prefix_t \ INPUT "PHOTON TORPEDO COURSE (1-9)? ", C1 \ RUN _ecb_input_suffix_tIF C1 = 9.0 THEN  C1 := 1.0ENDIFIF C1 >= 1.0 AND C1 < 9.0 THEN 4850PRINT "ENSIGN CHEKOV REPORTS,  'INCORRECT COURSE DATA, SIR!'"GOTO 19904850 RUN ecb_int(C1, tmp_1) \ X1 := arr_C(INT(C1), 1) + (arr_C(INT(C1 + 1.0), 1) - arr_C(INT(C1), 1)) * (C1 - tmp_1)E := E - 2.0P := P - 1RUN ecb_int(C1, tmp_1) \ X2 := arr_C(INT(C1), 2) + (arr_C(INT(C1 + 1.0), 2) - arr_C(INT(C1), 2)) * (C1 - tmp_1)X := S1Y := S2PRINT "TORPEDO TRACK:"4920 X := X + X1Y := Y + X2RUN ecb_int(X + 0.5, X3)RUN ecb_int(Y + 0.5, Y3)IF X3 < 1.0 OR X3 > 8.0 OR Y3 < 1.0 OR Y3 > 8.0 THEN 5490run ecb_str(X3, tmp_1$) \ run ecb_str(Y3, tmp_2$) \ PRINT "               "; tmp_1$; ","; tmp_2$A$ := "   "Z1 := XZ2 := YGOSUB 8830IF Z3 <> 0.0 THEN 4920A$ := "+K+"Z1 := XZ2 := YGOSUB 8830IF Z3 = 0.0 THEN 5210PRINT "*** KLINGON DESTROYED ***"K3 := K3 - 1.0K9 := K9 - 1IF K9 <= 0.0 THEN 6370FOR I = 1.0 TO 3.0  IF X3 = arr_K(INT(I), 1.0) AND Y3 = arr_K(INT(I), 2.0) THEN 5190NEXT II := 3.05190 arr_K(INT(I), 3.0) := 0.0GOTO 54305210 A$ := " * "Z1 := XZ2 := YGOSUB 8830IF Z3 = 0.0 THEN 5280run ecb_str(X3, tmp_1$) \ run ecb_str(Y3, tmp_2$) \ PRINT "STAR AT"; tmp_1$; ","; tmp_2$; "ABSORBED TORPEDO ENERGY."GOSUB 6000GOTO 19905280 A$ := ">!<"Z1 := XZ2 := YGOSUB 8830IF Z3 = 0.0 THEN 4760PRINT "*** STARBASE DESTROYED ***"B3 := B3 - 1.0B9 := B9 - 1IF B9 > 0.0 OR K9 > T - T0 - T9 THEN 5400PRINT "THAT DOES IT, CAPTAIN!!  YOU ARE HEREBY RELIEVED OF COMMAND"PRINT "AND SENTENCED TO 99 STARDATES AT HARD LABOR ON CYGNUS 12!!"GOTO 62705400 PRINT "STARFLEET COMMAND REVIEWING YOUR RECORD TO CONSIDER"PRINT "COURT MARTIAL!"D0 := 05430 Z1 := XZ2 := YA$ := "   "GOSUB 8670arr_G(INT(Q1), INT(Q2)) := K3 * 100.0 + B3 * 10.0 + S3arr_Z(INT(Q1), INT(Q2)) := arr_G(INT(Q1), INT(Q2))GOSUB 6000GOTO 19905490 PRINT "TORPEDO MISSED"GOSUB 6000GOTO 1990(* SHIELD CONTROL *)5530 IF arr_D(7.0) < 0.0 THEN  PRINT "SHIELD CONTROL INOPERABLE"  GOTO 1990ENDIFPRINT "ENERGY AVAILABLE ="; E + S;RUN _ecb_input_prefix_t \ INPUT "NUMBER OF UNITS TO SHIELDS? ", X \ RUN _ecb_input_suffix_tIF X < 0.0 OR S = X THEN  PRINT "<SHIELDS UNCHANGED>"  GOTO 1990ENDIFIF X <= E + S THEN 5630PRINT "SHIELD CONTROL REPORTS  'THIS IS NOT THE FEDERATION TREASURY.'"PRINT "<SHIELDS UNCHANGED>"GOTO 19905630 E := E + S - XS := XPRINT "DEFLECTOR CONTROL ROOM REPORT:"RUN ecb_int(S, tmp_1) \ run ecb_str(tmp_1, tmp_1$) \ PRINT "  'SHIELDS NOW AT"; tmp_1$; "UNITS PER YOUR COMMAND.'"GOTO 1990(* DAMAGE CONTROL *)5690 IF arr_D(6.0) >= 0.0 THEN 5910PRINT "DAMAGE CONTROL REPORT NOT AVAILABLE"IF D0 = 0.0 THEN 19905720   D3 := 0.0FOR I = 1.0 TO 8.0  IF arr_D(INT(I)) < 0.0 THEN    D3 := D3 + 0.1ENDIFNEXT IIF D3 = 0.0 THEN 1990PRINT D3 := D3 + D4IF D3 >= 1.0 THEN  D3 := 0.9ENDIFPRINT "TECHNICIANS STANDING BY TO EFFECT REPAIRS TO YOUR SHIP;"RUN ecb_int(100.0 * D3, tmp_1) \ PRINT "ESTIMATED TIME TO REPAIR:"; 0.01 * tmp_1; "STARDATES"RUN _ecb_input_prefix_t \ INPUT "WILL YOU AUTHORIZE THE REPAIR ORDER (Y/N)? ", A$ \ RUN _ecb_input_suffix_tIF A$ <> "Y" THEN 1990FOR I = 1.0 TO 8.0  IF arr_D(INT(I)) < 0.0 THEN    arr_D(INT(I)) := 0.0ENDIFNEXT IT := T + D3 + 0.15910   PRINT   PRINT "DEVICE             STATE OF REPAIR"FOR R1 = 1.0 TO 8.0  GOSUB 8790  RUN ecb_int(arr_D(INT(R1)) * 100.0, tmp_1) \ PRINT G2$; LEFT$(Z$, 25.0 - LEN(G2$)); tmp_1 * 0.01NEXT R1PRINT IF D0 <> 0.0 THEN 5720GOTO 1990(* KLINGONS SHOOTING *)6000 IF K3 <= 0.0 THEN  RETURNENDIFIF D0 <> 0.0 THEN  PRINT "STARBASE SHIELDS PROTECT THE ENTERPRISE"  RETURNENDIFFOR I = 1.0 TO 3.0  IF arr_K(INT(I), 3.0) <= 0.0 THEN 6200  fnD_1 := 1 \ RUN ecb_int((arr_K(INT(I), 3.0) / SQR((arr_K(INT(I), 1.0) - S1) ^ 2.0 + (arr_K(INT(I), 2.0) - S2) ^ 2.0)) * (2.0 + RND(1.0)), H)  S := S - H  arr_K(INT(I), 3.0) := arr_K(INT(I), 3.0) / (3.0 + RND(0.0))  run ecb_str(H, tmp_1$) \ run ecb_str(arr_K(INT(I), 1.0), tmp_2$) \ run ecb_str(arr_K(INT(I), 2.0), tmp_3$) \ PRINT tmp_1$; "UNIT HIT ON ENTERPRISE FROM SECTOR"; tmp_2$; ","; tmp_3$  IF S <= 0.0 THEN 6240  run ecb_str(S, tmp_1$) \ PRINT "      <SHIELDS DOWN TO"; tmp_1$; "UNITS>"  IF H < 20.0 THEN 6200  IF RND(1.0) > 0.6 OR H / S <= 0.02 THEN 6200  fnR_1 := 1 \ RUN ecb_int(RND(fnR_1) * 7.98 + 1.01, tmp_1) \ R1 := tmp_1  arr_D(INT(R1)) := arr_D(INT(R1)) - H / S - 0.5 * RND(1.0)  GOSUB 8790  PRINT "DAMAGE CONTROL REPORTS "; G2$; " DAMAGED BY THE HIT'"6200 NEXT IRETURN(* END OF GAME *)6220 run ecb_str(T, tmp_1$) \ PRINT "IT IS STARDATE"; tmp_1$GOTO 62706240 PRINT PRINT "THE ENTERPRISE HAS BEEN DESTROYED.  THEN FEDERATION ";PRINT "WILL BE CONQUERED"GOTO 62206270 run ecb_str(float(K9), tmp_1$) \ PRINT "THERE WERE"; tmp_1$; "KLINGON BATTLE CRUISERS LEFT AT"PRINT "THE END OF YOUR MISSION."6290 PRINT PRINT IF B9 = 0.0 THEN 6360PRINT "THE FEDERATION IS IN NEED OF A NEW STARSHIP COMMANDER"PRINT "FOR A SIMILAR MISSION -- IF THERE IS A VOLUNTEER,"RUN _ecb_input_prefix_t \ INPUT "LET HIM STEP FORWARD AND ENTER 'AYE'? ", A$ \ RUN _ecb_input_suffix_tIF A$ = "AYE" THEN 106360 END6370 PRINT "CONGRULATION, CAPTAIN!  THEN LAST KLINGON BATTLE CRUISER"PRINT "MENACING THE FDERATION HAS BEEN DESTROYED."PRINT PRINT "YOUR EFFICIENCY RATING IS"; 1000.0 * (K7 / (T - T0)) ^ 2.0GOTO 6290(* SHORT RANGE SENSOR SCAN & STARTUP SUBROUTINE *)6430   FOR I = S1 - 1.0 TO S1 + 1.0  FOR J = S2 - 1.0 TO S2 + 1.0    RUN ecb_int(I + 0.5, tmp_1) \ RUN ecb_int(I + 0.5, tmp_2) \ RUN ecb_int(J + 0.5, tmp_3) \ RUN ecb_int(J + 0.5, tmp_4) \ IF tmp_1 < 1.0 OR tmp_2 > 8.0 OR tmp_3 < 1.0 OR tmp_4 > 8.0 THEN 6540    A$ := ">!<"    Z1 := I    Z2 := J    GOSUB 8830    IF Z3 = 1.0 THEN 65806540 NEXT JNEXT ID0 := 0GOTO 66506580 D0 := 1C$ := "DOCKED"E := E0P := P0PRINT "SHIELDS DROPPED FOR DOCKING PURPOSES"S := 0.0GOTO 67206650 IF K3 > 0.0 THEN  C$ := "*RED*"  GOTO 6720ENDIFC$ := "GREEN"IF E < E0 * 0.1 THEN  C$ := "YELLOW"ENDIF6720 IF arr_D(2.0) >= 0.0 THEN 6770PRINT PRINT "*** SHORT RANGE SENSORS ARE OUT ***"PRINT RETURN6770   O1$ := "---------------------------------"  PRINT O1$FOR I = 1.0 TO 8.0FOR J = (I - 1.0) * 24.0 + 1.0 TO (I - 1.0) * 24.0 + 22.0 STEP 3.0  PRINT " "; MID$(Q$, INT(J), 3.0);  NEXT J  ON INT(I) GOTO 6850, 6900, 6960, 7020, 7070, 7120, 7180, 72406850   RUN ecb_int(T * 10.0, tmp_1) \ PRINT "        STARDATE          "; tmp_1 * 0.1  GOTO 72606900   PRINT "        CONDITION          "; C$  GOTO 72606960   run ecb_str(Q1, tmp_1$) \ run ecb_str(Q2, tmp_2$) \ PRINT "        QUADRANT          "; tmp_1$; ","; tmp_2$  GOTO 72607020   run ecb_str(S1, tmp_1$) \ run ecb_str(S2, tmp_2$) \ PRINT "        SECTOR            "; tmp_1$; ","; tmp_2$  GOTO 72607070   RUN ecb_int(float(P), tmp_1) \ run ecb_str(tmp_1, tmp_1$) \ PRINT "        PHOTON TORPEDOES  "; tmp_1$  GOTO 72607120   RUN ecb_int(E + S, tmp_1) \ run ecb_str(tmp_1, tmp_1$) \ PRINT "        TOTAL ENERGY      "; tmp_1$  GOTO 72607180   RUN ecb_int(S, tmp_1) \ run ecb_str(tmp_1, tmp_1$) \ PRINT "        SHIELDS           "; tmp_1$  GOTO 72607240   RUN ecb_int(float(K9), tmp_1) \ run ecb_str(tmp_1, tmp_1$) \ PRINT "        KLINGONS REMAINING"; tmp_1$7260 NEXT IPRINT O1$RETURN(* LIBRARY COMPUTER CODE *)7290 IF arr_D(8.0) < 0.0 THEN  PRINT "COMPUTER DISABLED"  GOTO 1990ENDIF7320 RUN _ecb_input_prefix_t \ INPUT "COMPUTER ACTIVE AND AWAITING COMMAND? ", A \ RUN _ecb_input_suffix_tIF A < 0.0 THEN 1990PRINT H8 := 1ON INT(A + 1.0) GOTO 7540, 7900, 8070, 8500, 8150, 7400PRINT "FUNCTIONS AVAILABLE FROM LIBRARY-COMPUTER:"PRINT "   0 = CUMULATIVE GALACTIC RECORD"PRINT "   1 = STATUS REPORT"PRINT "   2 = PHOTON TORPEDO DATA"PRINT "   3 = STARBASE NAV DATA"PRINT "   4 = DIRECTION/DISTANCE CALCULATOR"PRINT "   5 = GALAXY 'REGION NAME' MAP"PRINT GOTO 7320(* SETUP TO CHANGE CUM GAL RECORD TO GALAXY MAP *)7400 H8 := 0G5 := 1PRINT "                        THE GALAXY"GOTO 7550(* CUM GALACTIC RECORD *)7540 (* INPUT"DO YOU WANT A HARDCOPY? IS THE TTY ON (Y/N)";A$ *)(* IF A$="Y" THEN POKE1229,2:POKE1237,3:NULL1 *)PRINT PRINT "        ";run ecb_str(Q1, tmp_1$) \ run ecb_str(Q2, tmp_2$) \ PRINT "COMPUTER RECORD OF GALAXY FOR QUADRANT"; tmp_1$; ","; tmp_2$PRINT 7550 PRINT "       1     2     3     4     5     6     7     8"O1$ := "     ----- ----- ----- ----- ----- ----- ----- -----"  PRINT O1$FOR I = 1.0 TO 8.0  run ecb_str(I, tmp_1$) \ PRINT tmp_1$;  IF H8 = 0.0 THEN 7740  FOR J = 1.0 TO 8.0    PRINT "   ";    IF arr_Z(INT(I), INT(J)) = 0.0 THEN      PRINT "***";      GOTO 7720ENDIF    RUN ecb_str(arr_Z(INT(I), INT(J)) + 1000.0, tmp_1$) \ PRINT RIGHT$(tmp_1$, 3.0);7720   NEXT J  GOTO 78507740   Z4 := I  Z5 := 1.0  GOSUB 9030  RUN ecb_int(15.0 - 0.5 * LEN(G2$), J0)  PRINT TAB(INT(J0) + 1.0); G2$;  Z5 := 5.0  GOSUB 9030  RUN ecb_int(39.0 - 0.5 * LEN(G2$), J0)  PRINT TAB(INT(J0) + 1.0); G2$;7850 PRINT PRINT O1$NEXT IPRINT GOTO 1990(* STATUS REPORT *)7900 PRINT "   STATUS REPORT:"X$ := ""IF K9 > 1.0 THEN  X$ := "S"ENDIFrun ecb_str(float(K9), tmp_1$) \ PRINT "KLINGON"; X$; " LEFT: "; tmp_1$RUN ecb_int((T0 + T9 - T) * 10.0, tmp_1) \ PRINT "MISSION MUST BE COMPLETED IN"; 0.1 * tmp_1; "STARDATES"X$ := "S"IF B9 < 2.0 THEN  X$ := ""  IF B9 < 1.0 THEN 8010ENDIFrun ecb_str(float(B9), tmp_1$) \ PRINT "THE FEDERATION IS MAINTAINING"; tmp_1$; "STARBASE"; X$; " IN THE GALAXY"GOTO 56908010 PRINT "YOUR STUPIDITY HAS LEFT YOU ON YOUR ON IN"PRINT "  THE GALAXY -- YOU HAVE NO STARBASES LEFT!"GOTO 5690(* TORPEDO, BASE NAV, D/D CALCULATOR *)8070 IF K3 <= 0.0 THEN 4270X$ := ""IF K3 > 1.0 THEN  X$ := "S"ENDIFPRINT "FROM ENTERPRISE TO KLINGON BATTLE CRUSER"; X$  H8 := 0FOR I = 1.0 TO 3.0  IF arr_K(INT(I), 3.0) <= 0.0 THEN 8480  W1 := arr_K(INT(I), 1.0)  X := arr_K(INT(I), 2.0)8120   C1 := S1  A := S2  GOTO 82208150   PRINT "DIRECTION/DISTANCE CALCULATOR:"  run ecb_str(Q1, tmp_1$) \ run ecb_str(Q2, tmp_2$) \ run ecb_str(S1, tmp_3$) \ run ecb_str(S2, tmp_4$) \ PRINT "YOU ARE AT QUADRANT "; tmp_1$; ","; tmp_2$; " SECTOR "; tmp_3$; ","; tmp_4$  PRINT "PLEASE ENTER"RUN _ecb_input_prefix_t \ INPUT "  INITIAL COORDINATES (X,Y)? ", C1, A \ RUN _ecb_input_suffix_t  RUN _ecb_input_prefix_t \ INPUT "  FINAL COORDINATES (X,Y)? ", W1, X \ RUN _ecb_input_suffix_t8220   X := X - A  A := C1 - W1  IF X < 0.0 THEN 8350  IF A < 0.0 THEN 8410  IF X > 0.0 THEN 8280  IF A = 0.0 THEN    C1 := 5.0    GOTO 8290ENDIF8280   C1 := 1.08290   IF ABS(A) <= ABS(X) THEN 8330  PRINT "DIRECTION ="; C1 + (((ABS(A) - ABS(X)) + ABS(A)) / ABS(A))  GOTO 84608330   PRINT "DIRECTION ="; C1 + (ABS(A) / ABS(X))  GOTO 84608350   IF A > 0.0 THEN    C1 := 3.0    GOTO 8420ENDIF  IF X <> 0.0 THEN    C1 := 5.0    GOTO 8290ENDIF8410   C1 := 7.08420   IF ABS(A) >= ABS(X) THEN 8450  PRINT "DIRECTION ="; C1 + (((ABS(X) - ABS(A)) + ABS(X)) / ABS(X))  GOTO 84608450   PRINT "DIRECTION ="; C1 + (ABS(X) / ABS(A))8460   run ecb_str(SQR(X ^ 2.0 + A ^ 2.0), tmp_1$) \ PRINT "DISTANCE ="; tmp_1$  IF H8 = 1.0 THEN 19908480 NEXT IGOTO 19908500 IF B3 <> 0.0 THEN  PRINT "FROM ENTERPRISE TO STARBASE:"  W1 := B4  X := B5  GOTO 8120ENDIFPRINT "MR. SPOCK REPORTS,  'SENSORS SHOW NO STARBASES IN THIS";PRINT " QUADRANT.'"GOTO 1990(* FIND EMPTY PLACE IN QUADRANT (FOR THINGS) *)8590 fnR_1 := 1 \ RUN ecb_int(RND(fnR_1) * 7.98 + 1.01, tmp_1) \ R1 := tmp_1fnR_2 := 1 \ RUN ecb_int(RND(fnR_2) * 7.98 + 1.01, tmp_1) \ R2 := tmp_1A$ := "   "Z1 := R1Z2 := R2GOSUB 8830IF Z3 = 0.0 THEN 8590RETURN(* INSERT IN STRING ARRAY FOR QUADRANT *)8670 RUN ecb_int(Z2 - 0.5, tmp_1) \ RUN ecb_int(Z1 - 0.5, tmp_2) \ S8 := tmp_1 * 3.0 + tmp_2 * 24.0 + 1.0IF LEN(A$) <> 3.0 THEN  PRINT "ERROR"  STOPENDIFIF S8 = 1.0 THEN  Q$ := A$ + RIGHT$(Q$, 189.0)  RETURNENDIFIF S8 = 190.0 THEN  Q$ := LEFT$(Q$, 189.0) + A$  RETURNENDIFQ$ := LEFT$(Q$, INT(S8 - 1.0)) + A$ + RIGHT$(Q$, INT(190.0 - S8))RETURN(* PRINTS DEVICE NAME *)8790 ON INT(R1) GOTO 8792, 8794, 8796, 8798, 8800, 8802, 8804, 88068792 G2$ := "WARP ENGINES"RETURN8794 G2$ := "SHORT RANGE SENSORS"RETURN8796 G2$ := "LONG RANGE SENSORS"RETURN8798 G2$ := "PHASER CONTROL"RETURN8800 G2$ := "PHOTON TUBES"RETURN8802 G2$ := "DAMAGE CONTROL"RETURN8804 G2$ := "SHIELD CONTROL"RETURN8806 G2$ := "LIBRARY-COMPUTER"RETURN(* STRING COMPARISON IN QUADRANT ARRAY *)8830 RUN ecb_int(Z1 + 0.5, Z1)RUN ecb_int(Z2 + 0.5, Z2)S8 := (Z2 - 1.0) * 3.0 + (Z1 - 1.0) * 24.0 + 1.0Z3 := 0IF MID$(Q$, INT(S8), 3.0) <> A$ THEN  RETURNENDIFZ3 := 1RETURN(* QUADRANT NAME IN G2$ FROM Z4,Z5 (=Q1,Q2) *)(* CALL WITH G5=1 TO GET REGION NAME ONLY *)9030 IF Z5 <= 4.0 THEN  ON INT(Z4) GOTO 9040, 9050, 9060, 9070, 9080, 9090, 9100, 9110ENDIFGOTO 91209040 G2$ := "ANTARES"GOTO 92109050 G2$ := "RIGEL"GOTO 92109060 G2$ := "PROCYON"GOTO 92109070 G2$ := "VEGA"GOTO 92109080 G2$ := "CANOPUS"GOTO 92109090 G2$ := "ALTAIR"GOTO 92109100 G2$ := "SAGITTARIUS"GOTO 92109110 G2$ := "POLLUX"GOTO 92109120 ON INT(Z4) GOTO 9130, 9140, 9150, 9160, 9170, 9180, 9190, 92009130 G2$ := "SIRIUS"GOTO 92109140 G2$ := "DENEB"GOTO 92109150 G2$ := "CAPELLA"GOTO 92109160 G2$ := "BETELGEUSE"GOTO 92109170 G2$ := "ALDEBARAN"GOTO 92109180 G2$ := "REGULUS"GOTO 92109190 G2$ := "ARCTURUS"GOTO 92109200 G2$ := "SPICA"9210 IF G5 <> 1.0 THEN  ON INT(Z5) GOTO 9230, 9240, 9250, 9260, 9230, 9240, 9250, 9260ENDIFRETURN9230 G2$ := G2$ + " I"RETURN9240 G2$ := G2$ + " II"RETURN9250 G2$ := G2$ + " III"RETURN9260 G2$ := G2$ + " IV"RETURN