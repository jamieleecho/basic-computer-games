procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure bullfightbase 0DIM I, Q, Z, Z1, fnC_1, fnD_1: INTEGERA := 0.0A$ := ""B := 0.0B$ := ""C := 0.0E := 0.0F := 0.0H := 0.0I := 0K := 0.0L := 0.0M := 0.0Q := 0T := 0.0Z := 0Z$ := ""Z1 := 0DIM arr_D(11)FOR tmp_1 = 0 TO 10 \ arr_D(tmp_1) := 0 \ NEXT tmp_1type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(35.0); "BULL"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"(* DEF FNA(K)=INT(RND(1)*2+1) *)PRINT PRINT PRINT L := 1.0PRINT "DO YOU WANT INSTRUCTIONS";RUN _ecb_input_prefix_t \ INPUT "? ", Z$ \ RUN _ecb_input_suffix_tIF Z$ = "NO" THEN 400PRINT "HELLO, ALL YOU BLOODLOVERS AND AFICIONADOS."PRINT "HERE IS YOUR BIG CHANCE TO KILL A BULL."PRINT PRINT "ON EACH PASS OF THE BULL, YOU MAY TRY"PRINT "0 - VERONICA (DANGEROUS INSIDE MOVE OF THE CAPE)"PRINT "1 - LESS DANGEROUS OUTSIDE MOVE OF THE CAPE"PRINT "2 - ORDINARY SWIRL OF THE CAPE."PRINT PRINT "INSTEAD OF THE ABOVE, YOU MAY TRY TO KILL THE BULL"PRINT "ON ANY TURN: 4 (OVER THE HORNS), 5 (IN THE CHEST)."PRINT "BUT IF I WERE YOU,"PRINT "I WOULDN'T TRY IT BEFORE THE SEVENTH PASS."PRINT PRINT "THE CROWD WILL DETERMINE WHAT AWARD YOU DESERVE"PRINT "(POSTHUMOUSLY IF NECESSARY)."PRINT "THE BRAVER YOU ARE, THE BETTER THE AWARD YOU RECEIVE."PRINT PRINT "THE BETTER THE JOB THE PICADORES AND TOREADORES DO,"PRINT "THE BETTER YOUR CHANCES ARE."400 PRINT PRINT arr_D(5.0) := 1.0arr_D(4.0) := 1.0DIM arr_L$(6)FOR tmp_1 = 0 TO 5 \ arr_L$(tmp_1) := "" \ NEXT tmp_1RUN ecb_int(RND(1.0) * 5.0 + 1.0, A)FOR I = 1 TO 5  READ arr_L$(I)NEXT IDATA "SUPERB", "GOOD", "FAIR", "POOR", "AWFUL"PRINT "YOU HAVE DRAWN A "; arr_L$(INT(A)); " BULL."IF A > 4.0 THEN 530IF A < 2.0 THEN 550GOTO 570530 PRINT "YOU'RE LUCKY."GOTO 570550 PRINT "GOOD LUCK.  YOU'LL NEED IT."PRINT 570 PRINT A$ := "PICADO"B$ := "RES"GOSUB 1610arr_D(1.0) := CA$ := "TOREAD"B$ := "ORES"GOSUB 1610arr_D(2.0) := C660 PRINT PRINT IF Z = 1.0 THEN 1310arr_D(3.0) := arr_D(3.0) + 1.0run ecb_str(arr_D(3.0), tmp_1$) \ PRINT "PASS NUMBER"; tmp_1$IF arr_D(3.0) < 3.0 THEN 760PRINT "HERE COMES THE BULL.  TRY FOR A KILL";GOSUB 1930IF Z1 = 1.0 THEN 1130PRINT "CAPE MOVE";GOTO 800760 PRINT "THE BULL IS CHARGING AT YOU!  YOU ARE THE MATADOR--"PRINT "DO YOU WANT TO KILL THE BULL";GOSUB 1930IF Z1 = 1.0 THEN 1130PRINT "WHAT MOVE DO YOU MAKE WITH THE CAPE";800 RUN _ecb_input_prefix_t \ INPUT "? ", E \ RUN _ecb_input_suffix_tRUN ecb_int(ABS(E), tmp_1) \ IF E <> tmp_1 THEN 830IF E < 3.0 THEN 850830 PRINT "DON'T PANIC, YOU IDIOT!  PUT DOWN A CORRECT NUMBER"GOTO 800850 (* *)IF E = 0.0 THEN 920IF E = 1.0 THEN 900M := 0.5GOTO 930900 M := 2.0GOTO 930920 M := 3.0930 L := L + MF := (6.0 - A + M / 10.0) * RND(1.0) / ((arr_D(1.0) + arr_D(2.0) + arr_D(3.0) / 10.0) * 5.0)IF F < 0.51 THEN 660960 PRINT "THE BULL HAS GORED YOU!"970 fnA_1 := 0.0 \ RUN ecb_int(RND(1.0) * 2.0 + 1.0, tmp_1) \ ON tmp_1 GOTO 980, 1010980 PRINT "YOU ARE DEAD."arr_D(4.0) := 1.5GOTO 13101010 PRINT "YOU ARE STILL ALIVE."PRINT PRINT "DO YOU RUN FROM THE RING";GOSUB 1930IF Z1 = 2.0 THEN 1070PRINT "COWARD"arr_D(4.0) := 0.0GOTO 13101070 PRINT "YOU ARE BRAVE.  STUPID, BUT BRAVE."fnA_1 := 0.0 \ RUN ecb_int(RND(1.0) * 2.0 + 1.0, tmp_1) \ ON tmp_1 GOTO 1090, 11101090 arr_D(4.0) := 2.0GOTO 6601110 PRINT "YOU ARE GORED AGAIN!"GOTO 9701130 (* *)Z := 1PRINT PRINT "IT IS THE MOMENT OF TRUTH."PRINT PRINT "HOW DO YOU TRY TO KILL THE BULL";RUN _ecb_input_prefix_t \ INPUT "? ", H \ RUN _ecb_input_suffix_tIF H = 4.0 THEN 1230IF H = 5.0 THEN 1230PRINT "YOU PANICKED.  THE BULL GORED YOU."GOTO 9701230 K := (6.0 - A) * 10.0 * RND(1.0) / ((arr_D(1.0) + arr_D(2.0)) * 5.0 * arr_D(3.0))IF H = 4.0 THEN 1290IF K > 0.2 THEN 9601260 PRINT "YOU KILLED THE BULL!"arr_D(5.0) := 2.0GOTO 13201290 IF K > 0.8 THEN 960GOTO 12601310 PRINT 1320 PRINT PRINT IF arr_D(4.0) <> 0.0 THEN 1390PRINT "THE CROWD BOOS FOR TEN MINUTES.  IF YOU EVER DARE TO SHOW"PRINT "YOUR FACE IN A RING AGAIN, THEY SWEAR THEY WILL KILL YOU--"PRINT "UNLESS THE BULL DOES FIRST."GOTO 15801390 (* DEF FNC(Q)=FND(Q)*RND(1) *)(* DEF FND(Q)=(4.5+L/6-(D(1)+D(2))*2.5+4*D(4)+2*D(5)-D(3)^2/120-A) *)IF arr_D(4.0) <> 2.0 THEN 1430PRINT "THE CROWD CHEERS WILDLY!"GOTO 14501430 IF arr_D(5.0) <> 2.0 THEN 1450PRINT "THE CROWD CHEERS!"PRINT 1450 PRINT "THE CROWD AWARDS YOU"fnC_1 := Q \ fnD_1 := fnC_1 \ IF ((4.5 + L / 6.0 - (arr_D(1.0) + arr_D(2.0)) * 2.5 + 4.0 * arr_D(4.0) + 2.0 * arr_D(5.0) - arr_D(3.0) ^ 2.0 / 120.0 - A) * RND(1.0)) < 2.4 THEN 1570fnC_1 := Q \ fnD_1 := fnC_1 \ IF ((4.5 + L / 6.0 - (arr_D(1.0) + arr_D(2.0)) * 2.5 + 4.0 * arr_D(4.0) + 2.0 * arr_D(5.0) - arr_D(3.0) ^ 2.0 / 120.0 - A) * RND(1.0)) < 4.9 THEN 1550fnC_1 := Q \ fnD_1 := fnC_1 \ IF ((4.5 + L / 6.0 - (arr_D(1.0) + arr_D(2.0)) * 2.5 + 4.0 * arr_D(4.0) + 2.0 * arr_D(5.0) - arr_D(3.0) ^ 2.0 / 120.0 - A) * RND(1.0)) < 7.4 THEN 1520PRINT "OLE!  YOU ARE 'MUY HOMBRE'!! OLE!  OLE!"GOTO 15801520 PRINT "BOTH EARS OF THE BULL!"PRINT "OLE!"GOTO 15801550 PRINT "ONE EAR OF THE BULL."GOTO 15801570 PRINT "NOTHING AT ALL."1580 PRINT PRINT "ADIOS"PRINT PRINT PRINT GOTO 20301610 B := 3.0 / A * RND(1.0)IF B < 0.37 THEN 1740IF B < 0.5 THEN 1720IF B < 0.63 THEN 1700IF B < 0.87 THEN 1680C := 0.1GOTO 17501680 C := 0.2GOTO 17501700 C := 0.3GOTO 17501720 C := 0.4GOTO 17501740 C := 0.51750 RUN ecb_int(10.0 * C + 0.2, T)PRINT "THE "; A$; B$; " DID A "; arr_L$(INT(T)); " JOB."IF 4.0 > T THEN 1900IF 5.0 = T THEN 1870fnA_1 := K \ RUN ecb_int(RND(1.0) * 2.0 + 1.0, tmp_1) \ ON tmp_1 GOTO 1830, 1850IF A$ = "TOREAD" THEN 1820PRINT "ONE OF THE HORSES OF THE "; A$; B$; " WAS KILLED."1820 fnA_1 := K \ RUN ecb_int(RND(1.0) * 2.0 + 1.0, tmp_1) \ ON tmp_1 GOTO 1830, 18501830 PRINT "ONE OF THE "; A$; B$; " WAS KILLED."GOTO 19001850 PRINT "NO "; A$; B$; " WERE KILLED."GOTO 19001870 IF A$ = "TOREAD" THEN 1890fnA_1 := K \ RUN ecb_int(RND(1.0) * 2.0 + 1.0, tmp_1) \ run ecb_str(tmp_1, tmp_1$) \ PRINT tmp_1$; "OF THE HORSES OF THE "; A$; B$; " KILLED."1890 fnA_1 := K \ RUN ecb_int(RND(1.0) * 2.0 + 1.0, tmp_1) \ run ecb_str(tmp_1, tmp_1$) \ PRINT tmp_1$; "OF THE "; A$; B$; " KILLED."1900 PRINT RETURN(* *)1930 RUN _ecb_input_prefix_t \ INPUT "? ", A$ \ RUN _ecb_input_suffix_tIF A$ = "YES" THEN 1990IF A$ = "NO" THEN 2010PRINT "INCORRECT ANSWER - - PLEASE TYPE 'YES' OR 'NO'."GOTO 19301990 Z1 := 1GOTO 20202010 Z1 := 22020 RETURN2030 END