procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure aceyduceybase 0DIM A, B, C, N: INTEGERA := 0A$ := ""B := 0C := 0M := 0.0N := 0Q := 0.0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(27.0); "ACEY DUCEY CARD GAME"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT "ACEY-DUCEY IS PLAYED IN THE FOLLOWING MANNER "PRINT "THE DEALER (COMPUTER) DEALS TWO CARDS FACE UP"PRINT "YOU HAVE AN OPTION TO BET OR NOT BET DEPENDING"PRINT "ON WHETHER OR NOT YOU FEEL THE CARD WILL HAVE"PRINT "A VALUE BETWEEN THE FIRST TWO."PRINT "IF YOU DO NOT WANT TO BET, INPUT A 0"N := 100110 Q := 100.0120 run ecb_str(Q, tmp_1$) \ PRINT "YOU NOW HAVE "; tmp_1$; " DOLLARS."PRINT GOTO 260210 Q := Q + MGOTO 120240 Q := Q - MGOTO 120260 PRINT "HERE ARE YOUR NEXT TWO CARDS: "270 RUN ecb_int(14.0 * RND(1.0), tmp_1) \ A := tmp_1 + 2IF A < 2.0 THEN 270IF A > 14.0 THEN 270300 RUN ecb_int(14.0 * RND(1.0), tmp_1) \ B := tmp_1 + 2IF B < 2.0 THEN 300IF B > 14.0 THEN 300IF A >= B THEN 270IF A < 11.0 THEN 400IF A = 11.0 THEN 420IF A = 12.0 THEN 440IF A = 13.0 THEN 460IF A = 14.0 THEN 480400 run ecb_str(float(A), tmp_1$) \ PRINT tmp_1$GOTO 500420 PRINT "JACK"GOTO 500440 PRINT "QUEEN"GOTO 500460 PRINT "KING"GOTO 500480 PRINT "ACE"500 IF B < 11.0 THEN 550IF B = 11.0 THEN 570IF B = 12.0 THEN 590IF B = 13.0 THEN 610IF B = 14.0 THEN 630550 run ecb_str(float(B), tmp_1$) \ PRINT tmp_1$GOTO 650570 PRINT "JACK"GOTO 650590 PRINT "QUEEN"GOTO 650610 PRINT "KING"GOTO 650630 PRINT "ACE"PRINT 650 PRINT RUN _ecb_input_prefix_t \ INPUT "WHAT IS YOUR BET? ", M \ RUN _ecb_input_suffix_tIF M <> 0.0 THEN 680PRINT "CHICKEN!!"PRINT GOTO 260680 IF M <= Q THEN 730PRINT "SORRY, MY FRIEND, BUT YOU BET TOO MUCH."run ecb_str(Q, tmp_1$) \ PRINT "YOU HAVE ONLY "; tmp_1$; " DOLLARS TO BET."GOTO 650730 RUN ecb_int(14.0 * RND(1.0), tmp_1) \ C := tmp_1 + 2IF C < 2.0 THEN 730IF C > 14.0 THEN 730IF C < 11.0 THEN 810IF C = 11.0 THEN 830IF C = 12.0 THEN 850IF C = 13.0 THEN 870IF C = 14.0 THEN 890810 run ecb_str(float(C), tmp_1$) \ PRINT tmp_1$GOTO 910830 PRINT "JACK"GOTO 910850 PRINT "QUEEN"GOTO 910870 PRINT "KING"GOTO 910890 PRINT "ACE"PRINT 910 IF C > A THEN 930GOTO 970930 IF C >= B THEN 970PRINT "YOU WIN!!!"GOTO 210970 PRINT "SORRY, YOU LOSE"IF M < Q THEN 240PRINT PRINT PRINT "SORRY, FRIEND, BUT YOU BLEW YOUR WAD."PRINT PRINT RUN _ecb_input_prefix_t \ INPUT "TRY AGAIN (YES OR NO)? ", A$ \ RUN _ecb_input_suffix_tPRINT PRINT IF A$ = "YES" THEN 110PRINT "O.K., HOPE YOU HAD FUN!"END