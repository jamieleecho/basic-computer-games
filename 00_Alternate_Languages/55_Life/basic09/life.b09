procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure lifebase 0DIM C, G, I9, L, P: INTEGERC := 0G := 0I := 0.0I9 := 0J := 0.0L := 0P := 0X := 0.0X1 := 0.0X2 := 0.0X3 := 0.0X4 := 0.0Y := 0.0Y1 := 0.0Y2 := 0.0Y3 := 0.0Y4 := 0.0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(35.0); "LIFE"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT PRINT "ENTER YOUR PATTERN:"X1 := 1.0Y1 := 1.0X2 := 24.0Y2 := 70.0DIM arr_B$(25)FOR tmp_1 = 0 TO 24 \ arr_B$(tmp_1) := "" \ NEXT tmp_1DIM arr_A(25, 71): INTEGERFOR tmp_1 = 0 TO 24 \ FOR tmp_2 = 0 TO 70 \ arr_A(tmp_1, tmp_2) := 0 \ NEXT tmp_2 \ NEXT tmp_1C := 130 RUN _ecb_input_prefix_t \ INPUT "? ", arr_B$(C) \ RUN _ecb_input_suffix_tIF arr_B$(C) = "DONE" THEN  arr_B$(C) := ""  GOTO 80ENDIFIF LEFT$(arr_B$(C), 1.0) = "." THEN  arr_B$(C) := " " + RIGHT$(arr_B$(C), LEN(arr_B$(C)) - 1.0)ENDIFC := C + 1GOTO 3080 C := C - 1L := 0FOR X = 1.0 TO C - 1.0  IF LEN(arr_B$(INT(X))) > L THEN    L := LEN(arr_B$(INT(X)))ENDIFNEXT XX1 := 11.0 - C / 2.0Y1 := 33.0 - L / 2.0FOR X = 1.0 TO C  FOR Y = 1.0 TO LEN(arr_B$(INT(X)))    IF MID$(arr_B$(INT(X)), INT(Y), 1.0) <> " " THEN      arr_A(INT(X1 + X), INT(Y1 + Y)) := 1      P := P + 1ENDIF  NEXT YNEXT XPRINT PRINT PRINT 210 run ecb_str(float(G), tmp_1$) \ run ecb_str(float(P), tmp_2$) \ PRINT "GENERATION:"; tmp_1$, "POPULATION:"; tmp_2$;IF I9 <> 0.0 THEN  PRINT "INVALID!";ENDIFX3 := 24.0Y3 := 70.0X4 := 1.0Y4 := 1.0P := 0G := G + 1FOR X = 1.0 TO X1 - 1.0PRINT NEXT XFOR X = X1 TO X2  PRINT   FOR Y = Y1 TO Y2    IF arr_A(INT(X), INT(Y)) = 2.0 THEN      arr_A(INT(X), INT(Y)) := 0      GOTO 270ENDIF    IF arr_A(INT(X), INT(Y)) = 3.0 THEN      arr_A(INT(X), INT(Y)) := 1      GOTO 261ENDIF    IF arr_A(INT(X), INT(Y)) <> 1.0 THEN 270261     PRINT TAB(INT(Y) + 1.0); "*";    IF X < X3 THEN      X3 := XENDIF    IF X > X4 THEN      X4 := XENDIF    IF Y < Y3 THEN      Y3 := YENDIF    IF Y > Y4 THEN      Y4 := YENDIF270   NEXT YNEXT XFOR X = X2 + 1.0 TO 24.0PRINT NEXT XX1 := X3X2 := X4Y1 := Y3Y2 := Y4IF X1 < 3.0 THEN  X1 := 3.0  I9 := -1ENDIFIF X2 > 22.0 THEN  X2 := 22.0  I9 := -1ENDIFIF Y1 < 3.0 THEN  Y1 := 3.0  I9 := -1ENDIFIF Y2 > 68.0 THEN  Y2 := 68.0  I9 := -1ENDIFP := 0FOR X = X1 - 1.0 TO X2 + 1.0  FOR Y = Y1 - 1.0 TO Y2 + 1.0    C := 0    FOR I = X - 1.0 TO X + 1.0      FOR J = Y - 1.0 TO Y + 1.0        IF arr_A(INT(I), INT(J)) = 1.0 OR arr_A(INT(I), INT(J)) = 2.0 THEN          C := C + 1ENDIF      NEXT J    NEXT I    IF arr_A(INT(X), INT(Y)) = 0.0 THEN 610    IF C < 3.0 OR C > 4.0 THEN      arr_A(INT(X), INT(Y)) := 2      GOTO 600ENDIF    P := P + 1600     GOTO 620610     IF C = 3.0 THEN      arr_A(INT(X), INT(Y)) := 3      P := P + 1ENDIF620   NEXT YNEXT XX1 := X1 - 1.0Y1 := Y1 - 1.0X2 := X2 + 1.0Y2 := Y2 + 1.0GOTO 210END