procedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure calendarbase 0DIM D, G, I, N, W: INTEGERD := 0D2 := 0.0G := 0I := 0N := 0S := 0.0W := 0type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(33.0); "CALENDAR"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT (*     VALUES FOR 1979 - SEE NOTES *)DIM arr_M(13)FOR tmp_1 = 0 TO 12 \ arr_M(tmp_1) := 0 \ NEXT tmp_1FOR I = 1 TO 6PRINT CHR$(10.0);NEXT ID := -1(* 1979 STARTS ON MONDAY (0=SUN, -1=MON, -2=TUES...) *)S := 0.0(*     READ DAYS OF EACH MONTH *)FOR N = 0 TO 12READ arr_M(N)NEXT N(* *)FOR N = 1 TO 12  PRINT   PRINT   S := S + arr_M(N - 1.0)  run ecb_str(S, tmp_1$) \ PRINT "**"; tmp_1$; TAB(8.0);FOR I = 1 TO 18  PRINT "*";  NEXT I  ON N GOTO 230, 240, 250, 260, 270, 280, 290, 300, 310, 320, 330, 340230   PRINT " JANUARY ";  GOTO 350240   PRINT " FEBRUARY";  GOTO 350250   PRINT "  MARCH  ";  GOTO 350260   PRINT "  APRIL  ";  GOTO 350270   PRINT "   MAY   ";  GOTO 350280   PRINT "   JUNE  ";  GOTO 350290   PRINT "   JULY  ";  GOTO 350300   PRINT "  AUGUST ";  GOTO 350310   PRINT "SEPTEMBER";  GOTO 350320   PRINT " OCTOBER ";  GOTO 350330   PRINT " NOVEMBER";  GOTO 350340   PRINT " DECEMBER";350 FOR I = 1 TO 18  PRINT "*";  NEXT I  PRINT 365.0 - S; "**";(*   366-S;     ON LEAP YEARS *)  PRINT CHR$(10.0)  PRINT "     S       M       T       W";  PRINT "       T       F       S"  PRINT FOR I = 1 TO 59  PRINT "*";  NEXT I(* *)  FOR W = 1 TO 6    PRINT CHR$(10.0)    PRINT TAB(5.0)(* *)    FOR G = 1 TO 7      D := D + 1      D2 := D - S      IF D2 > arr_M(N) THEN 580      IF D2 > 0.0 THEN        run ecb_str(D2, tmp_1$) \ PRINT tmp_1$;ENDIF      PRINT TAB((4.0 + 8.0 * G) + 1.0);    NEXT G(* *)    IF D2 = arr_M(N) THEN 590  NEXT W(* *)580   D := D - G590 NEXT N(* *)FOR I = 1 TO 6PRINT CHR$(10.0);NEXT IDATA 0.0, 31.0, 28.0, 31.0, 30.0, 31.0, 30.0, 31.0, 31.0, 30.0, 31.0, 30.0, 31.0(*  0,31,29,  ..., ON LEAP YEARS *)END