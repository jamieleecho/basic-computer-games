procedure _ecb_input_prefix_t(* Terminal mode: like _ecb_input_prefix without the cursor color *)SHELL("tmode eko=1")procedure _ecb_input_suffix_t(* Terminal mode: like _ecb_input_suffix without the cursor color *)SHELL("tmode eko=0")procedure ecb_intparam v: real(* Out *)param retval: realif v >= 0 then    retval = int(v)else    retval = int(v - 0.999999999)endifprocedure ecb_strparam valin: real(* Out *)param valout: stringvalout = str$(valin)if mid$(valout, len(valout), 1) = "." then    valout = " " + left$(valout, len(valout) - 1) + " "else    if valout = ".0" then        valout = " 0 "    else        valout = " " + valout + " "    endifendifprocedure civilwarbase 0DIM I, I1, I2, L, N, S, S0, U, U2, W, W0, Z: INTEGERA := 0.0B$ := ""C$ := ""C1 := 0.0C2 := 0.0C5 := 0.0C6 := 0.0D := 0.0E := 0.0E2 := 0.0F := 0.0F1 := 0.0I := 0I1 := 0I2 := 0L := 0M := 0.0M1 := 0.0M2 := 0.0M3 := 0.0M4 := 0.0M5 := 0.0M6 := 0.0N := 0O := 0.0O2 := 0.0P1 := 0.0P2 := 0.0Q1 := 0.0Q2 := 0.0R := 0.0R1 := 0.0R2 := 0.0S := 0S0 := 0T1 := 0.0T2 := 0.0U := 0U2 := 0W := 0W0 := 0X$ := ""Y := 0.0Y1 := 0.0Y2 := 0.0Z := 0DIM arr_B(11)FOR tmp_1 = 0 TO 10 \ arr_B(tmp_1) := 0 \ NEXT tmp_1DIM arr_D(11): INTEGERFOR tmp_1 = 0 TO 10 \ arr_D(tmp_1) := 0 \ NEXT tmp_1DIM arr_F(11)FOR tmp_1 = 0 TO 10 \ arr_F(tmp_1) := 0 \ NEXT tmp_1DIM arr_H(11)FOR tmp_1 = 0 TO 10 \ arr_H(tmp_1) := 0 \ NEXT tmp_1DIM arr_O(11)FOR tmp_1 = 0 TO 10 \ arr_O(tmp_1) := 0 \ NEXT tmp_1type display_t = tpth, vpth, wpth, hpth, pal(16), blnk, undrln, bck, fore, brdr, hbck, hfore, hscl, hpy, hagl, hdsc: byte; hpx: integerdim display: display_tdim erno: realerno := -1TYPE play_t=oct,octo,lnt,tne,vol,dot:BYTEDIM play: play_tplay.oct := 3play.octo := 0play.lnt := 4play.tne := 2play.vol := 15play.dot := 0PRINT TAB(27.0); "CIVIL WAR"PRINT TAB(16.0); "CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY"PRINT PRINT PRINT (* ORIGINAL GAME DESIGN: CRAM, GOODIE, HIBBARD LEXINGTON H.S. *)(* MODIFICATIONS: G. PAUL, R. HESS (TIES), 1973 *)DIM arr_C$(15)FOR tmp_1 = 0 TO 14 \ arr_C$(tmp_1) := "" \ NEXT tmp_1DIM arr_S(5): INTEGERFOR tmp_1 = 0 TO 4 \ arr_S(tmp_1) := 0 \ NEXT tmp_1DIM arr_M1(15), arr_M2(15), arr_C1(15), arr_C2(15), arr_M(15)FOR tmp_1 = 0 TO 14 \ arr_M1(tmp_1) := 0 \ NEXT tmp_1FOR tmp_1 = 0 TO 14 \ arr_M2(tmp_1) := 0 \ NEXT tmp_1FOR tmp_1 = 0 TO 14 \ arr_C1(tmp_1) := 0 \ NEXT tmp_1FOR tmp_1 = 0 TO 14 \ arr_C2(tmp_1) := 0 \ NEXT tmp_1FOR tmp_1 = 0 TO 14 \ arr_M(tmp_1) := 0 \ NEXT tmp_1(* UNION INFO ON LIKELY CONFEDERATE STRATEGY *)arr_S(1) := 25arr_S(2) := 25arr_S(3) := 25arr_S(4) := 25(* READ HISTORICAL DATA. *)FOR D = 1.0 TO 14.0  READ arr_C$(INT(D)), arr_M1(INT(D)), arr_M2(INT(D)), arr_C1(INT(D)), arr_C2(INT(D)), arr_M(INT(D))NEXT DLET D := RND(-1.0)PRINT PRINT "DO YOU WANT INSTRUCTIONS";110 RUN _ecb_input_prefix_t \ INPUT "? ", X$ \ RUN _ecb_input_suffix_tIF X$ = "YES" THEN 160IF X$ = "NO" THEN 370PRINT "YES OR NO -- ";GOTO 110160 PRINT PRINT PRINT PRINT PRINT "THIS IS A CIVIL WAR SIMULATION."PRINT "TO PLAY TYPE A RESPONSE WHEN THE COMPUTER ASKS."PRINT "REMEMBER THAT ALL FACTORS ARE INTERRELATED AND THAT YOUR"PRINT "RESPONSES COULD CHANGE HISTORY. FACTS AND FIGURES USED ARE"PRINT "BASED ON THE ACTUAL OCCURRENCE. MOST BATTLES TEND TO RESULT"PRINT "AS THEY DID IN THE CIVIL WAR, BUT IT ALL DEPENDS ON YOU!!"PRINT PRINT "THE OBJECT OF THE GAME IS TO WIN AS MANY BATTLES AS ";PRINT "POSSIBLE."PRINT PRINT "YOUR CHOICES FOR DEFENSIVE STRATEGY ARE:"PRINT "        (1) ARTILLERY ATTACK"PRINT "        (2) FORTIFICATION AGAINST FRONTAL ATTACK"PRINT "        (3) FORTIFICATION AGAINST FLANKING MANEUVERS"PRINT "        (4) FALLING BACK"PRINT " YOUR CHOICES FOR OFFENSIVE STRATEGY ARE:"PRINT "        (1) ARTILLERY ATTACK"PRINT "        (2) FRONTAL ATTACK"PRINT "        (3) FLANKING MANEUVERS"PRINT "        (4) ENCIRCLEMENT"PRINT "YOU MAY SURRENDER BY TYPING A '5' FOR YOUR STRATEGY."370 PRINT PRINT PRINT PRINT "ARE THERE TWO GENERALS PRESENT ";380 PRINT "(ANSWER YES OR NO)";RUN _ecb_input_prefix_t \ INPUT "? ", B$ \ RUN _ecb_input_suffix_tIF B$ = "YES" THEN 430IF B$ <> "NO" THEN 380PRINT PRINT "YOU ARE THE CONFEDERACY.   GOOD LUCK!"PRINT 430 LET D := 1.0IF B$ <> "YES" THEN 460LET D := 2.0460 PRINT "SELECT A BATTLE BY TYPING A NUMBER FROM 1 TO 14 ON"PRINT "REQUEST.  TYPE ANY OTHER NUMBER TO END THE SIMULATION."PRINT "BUT '0' BRINGS BACK EXACT PREVIOUS BATTLE SITUATION"PRINT "ALLOWING YOU TO REPLAY IT"PRINT PRINT "NOTE: A NEGATIVE FOOD$ ENTRY CAUSES THE PROGRAM TO "PRINT "USE THE ENTRIES FROM THE PREVIOUS BATTLE"PRINT PRINT "AFTER REQUESTING A BATTLE, DO YOU WISH ";PRINT "BATTLE DESCRIPTIONS ";560 PRINT "(ANSWER YES OR NO)";RUN _ecb_input_prefix_t \ INPUT "? ", X$ \ RUN _ecb_input_suffix_tIF X$ = "YES" THEN 600IF X$ <> "NO" THEN 560600 L := 0W := 0R1 := 0.0Q1 := 0.0M3 := 0.0M4 := 0.0P1 := 0.0P2 := 0.0T1 := 0.0T2 := 0.0arr_F(2.0) := 0.0arr_H(2.0) := 0.0arr_B(2.0) := 0.0R2 := 0.0Q2 := 0.0C6 := 0.0F := 0.0W0 := 0Y := 0.0Y2 := 0.0U := 0U2 := 0620 PRINT PRINT PRINT PRINT "WHICH BATTLE DO YOU WISH TO SIMULATE";RUN _ecb_input_prefix_t \ INPUT "? ", A \ RUN _ecb_input_suffix_tIF A <> 0.0 THEN 660IF R <> 0.0 THEN 1140660 IF A <= 0.0 THEN 2860IF A >= 15.0 THEN 2860LET C$ := arr_C$(INT(A))LET M1 := arr_M1(INT(A))LET M2 := arr_M2(INT(A))LET C1 := arr_C1(INT(A))LET C2 := arr_C2(INT(A))LET M := arr_M(INT(A))LET U := 0(*  INFLATION CALC *)LET I1 := 10 + (L - W) * 2LET I2 := 10 + (W - L) * 2(* - MONEY AVAILABLE *)RUN ecb_int((M1 * (100.0 - I1) / 2000.0) * (1.0 + (R1 - Q1) / (R1 + 1.0)) + 0.5, tmp_1) \ LET arr_D(1) := 100 * tmp_1RUN ecb_int(M2 * (100.0 - I2) / 2000.0 + 0.5, tmp_1) \ LET arr_D(2) := 100 * tmp_1IF B$ <> "YES" THEN 1050RUN ecb_int((M2 * (100.0 - I2) / 2000.0) * (1.0 + (R2 - Q2) / (R2 + 1.0)) + 0.5, tmp_1) \ LET arr_D(2) := 100 * tmp_11050 (* - MEN   AVAILABLE *)RUN ecb_int(M1 * (1.0 + (P1 - T1) / (M3 + 1.0)), M5)RUN ecb_int(M2 * (1.0 + (P2 - T2) / (M4 + 1.0)), M6)LET F1 := 5.0 * M1 / 6.0PRINT PRINT PRINT PRINT PRINT PRINT "THIS IS THE BATTLE OF "; C$IF X$ = "NO" THEN 1150IF A > 11.0 THEN 1130ON INT(A) GOTO 3580, 3620, 3650, 3690, 3720, 3750, 3780, 3800, 3830, 3860, 38901130 ON INT(A - 11.0) GOTO 3920, 3950, 39801140 PRINT C$; " INSTANT REPLAY"1150 PRINT PRINT " ", "CONFEDERACY", " UNION"run ecb_str(M5, tmp_1$) \ run ecb_str(M6, tmp_2$) \ PRINT "MEN", " "; tmp_1$, " "; tmp_2$run ecb_str(float(arr_D(1)), tmp_1$) \ run ecb_str(float(arr_D(2)), tmp_2$) \ PRINT "MONEY", "$"; tmp_1$, "$"; tmp_2$run ecb_str(float(I2), tmp_1$) \ PRINT "INFLATION", " "; I1 + 15.0; "%", " "; tmp_1$; "%"PRINT (* - ONLY IN PRINTOUT IS CONFED INFLATION = I1+15% *)(* - IF TWO GENERALS, INPUT CONFED. FIRST *)FOR I = 1 TO D  IF B$ <> "YES" THEN 1260  IF I = 2.0 THEN 1260  PRINT "CONFEDERATE GENERAL---";1260   PRINT "HOW MUCH DO YOU WISH TO SPEND FOR"1270   PRINT " - FOOD......";  RUN _ecb_input_prefix_t \ INPUT "? ", F \ RUN _ecb_input_suffix_t  IF F >= 0.0 THEN 1360  IF R1 <> 0.0 THEN 1330  PRINT "NO PREVIOUS ENTRIES"  GOTO 12701330   PRINT "ASSUME YOU WANT TO KEEP SAME ALLOCATIONS"  PRINT   GOTO 15101360   LET arr_F(I) := F1370   PRINT " - SALARIES..";  RUN _ecb_input_prefix_t \ INPUT "? ", arr_H(I) \ RUN _ecb_input_suffix_t  LET N := 1  IF arr_H(I) < 0.0 THEN 14901410   PRINT " - AMMUNITION";  RUN _ecb_input_prefix_t \ INPUT "? ", arr_B(I) \ RUN _ecb_input_suffix_t  LET N := 2  IF arr_B(I) < 0.0 THEN 1490  PRINT   IF arr_F(I) + arr_H(I) + arr_B(I) <= arr_D(I) THEN 1510  run ecb_str(float(arr_D(I)), tmp_1$) \ PRINT "THINK AGAIN! YOU HAVE ONLY $"; tmp_1$  GOTO 12701490   PRINT "NEGATIVE VALUES NOT ALLOWED."  ON N GOTO 1370, 14101510   IF B$ <> "YES" THEN 1550  IF I = 2.0 THEN 1550  PRINT "UNION GENERAL---";NEXT I1550 FOR Z = 1 TO D  IF B$ <> "YES" THEN 1620  ON Z GOTO 1580, 16001580   PRINT "CONFEDERATE ";  GOTO 16201600   PRINT "      UNION ";(* - FIND MORALE *)1620   LET O := ((2.0 * arr_F(Z) ^ 2.0 + arr_H(Z) ^ 2.0) / F1 ^ 2.0 + 1.0)  IF O < 10.0 THEN 1660  PRINT "MORALE IS HIGH"  GOTO 17001660   IF O < 5.0 THEN 1690  PRINT "MORALE IS FAIR"  GOTO 17001690   PRINT "MORALE IS POOR"1700   IF B$ <> "YES" THEN 1760  LET arr_O(Z) := ONEXT ZLET O2 := arr_O(2.0)LET O := arr_O(1.0)PRINT "CONFEDERATE GENERAL---";1760 (* - ACTUAL OFF/DEF BATTLE SITUATION *)IF M <> 3.0 THEN 1800PRINT "YOU ARE ON THE OFFENSIVE"GOTO 18401800 IF M <> 1.0 THEN 1830PRINT "YOU ARE ON THE DEFENSIVE"GOTO 18401830 PRINT "BOTH SIDES ARE ON THE OFFENSIVE "1840 PRINT (* - CHOOSE STRATEGIES *)IF B$ <> "YES" THEN 1910FOR I = 1 TO 2  ON I GOTO 1890, 19201890   PRINT "CONFEDERATE STRATEGY ";  GOTO 19201910   PRINT "YOUR STRATEGY ";1920   RUN _ecb_input_prefix_t \ INPUT "? ", Y \ RUN _ecb_input_suffix_t  IF ABS(Y - 3.0) < 3.0 THEN 1960  run ecb_str(Y, tmp_1$) \ PRINT "STRATEGY"; tmp_1$; "NOT ALLOWED."  GOTO 19101960   IF B$ = "YES" THEN 2000  IF Y = 5.0 THEN 2830  GOSUB 3110  GOTO 21702000   IF I = 2.0 THEN 2040  LET Y1 := Y2020   PRINT "UNION STRATEGY ";NEXT I2040 LET Y2 := YLET Y := Y1IF Y2 = 5.0 THEN 2020(* : SIMULATED LOSSES-NORTH *)LET C6 := (2.0 * C2 / 5.0) * (1.0 + 1.0 / (2.0 * (ABS(Y2 - Y) + 1.0)))LET C6 := C6 * (1.28 + (5.0 * M2 / 6.0) / (arr_B(2.0) + 1.0))RUN ecb_int(C6 * (1.0 + 1.0 / O2) + 0.5, C6)(* - IF LOSS > MEN PRESENT, RESCALE LOSSES *)LET E2 := 100.0 / O2RUN ecb_int(C6 + E2, tmp_1) \ IF tmp_1 < M6 THEN 2190RUN ecb_int(13.0 * M6 / 20.0, C6)LET E2 := 7.0 * C6 / 13.0LET U2 := 12170 (* - CALCULATE SIMULATED LOSSES *)PRINT 2190 PRINT PRINT PRINT "", "CONFEDERACY", "UNION"LET C5 := (2.0 * C1 / 5.0) * (1.0 + 1.0 / (2.0 * (ABS(Y2 - Y) + 1.0)))RUN ecb_int(C5 * (1.0 + 1.0 / O) * (1.28 + F1 / (arr_B(1.0) + 1.0)) + 0.5, C5)LET E := 100.0 / OIF C5 + 100.0 / O < M1 * (1.0 + (P1 - T1) / (M3 + 1.0)) THEN 2270RUN ecb_int(13.0 * M1 / 20.0 * (1.0 + (P1 - T1) / (M3 + 1.0)), C5)LET E := 7.0 * C5 / 13.0LET U := 12270 IF D = 1.0 THEN 25002280 run ecb_str(C5, tmp_1$) \ run ecb_str(C6, tmp_2$) \ PRINT "CASUALTIES", tmp_1$, tmp_2$RUN ecb_int(E, tmp_1) \ run ecb_str(tmp_1, tmp_1$) \ RUN ecb_int(E2, tmp_2) \ run ecb_str(tmp_2, tmp_2$) \ PRINT "DESERTIONS", tmp_1$, tmp_2$PRINT IF B$ <> "YES" THEN 2530PRINT "COMPARED TO THE ACTUAL CASUALTIES AT "; C$RUN ecb_int(100.0 * (C5 / C1) + 0.5, tmp_1) \ run ecb_str(tmp_1, tmp_1$) \ PRINT "CONFEDERATE:"; tmp_1$; "% OF THE ORIGINAL"RUN ecb_int(100.0 * (C6 / C2) + 0.5, tmp_1) \ run ecb_str(tmp_1, tmp_1$) \ PRINT "UNION:      "; tmp_1$; "% OF THE ORIGINAL"PRINT (* - 1 WHO WON *)IF U <> 1.0 THEN 2380IF U2 = 1.0 THEN 24602380 IF U = 1.0 THEN 2420IF U2 = 1.0 THEN 2440IF C5 + E = C6 + E2 THEN 2460IF C5 + E < C6 + E2 THEN 24402420 PRINT "THE UNION WINS "; C$GOTO 26002440 PRINT "THE CONFEDERACY WINS "; C$GOTO 26602460 PRINT "BATTLE OUTCOME UNRESOLVED"LET W0 := W0 + 1IF A = 0.0 THEN 2790GOTO 26802500 RUN ecb_int(17.0 * C2 * C1 / (C5 * 20.0), C6)LET E2 := 5.0 * OGOTO 22802530 RUN ecb_int(100.0 * (C5 / C1) + 0.5, tmp_1) \ run ecb_str(tmp_1, tmp_1$) \ PRINT "YOUR CASUALTIES WERE "; tmp_1$; "% OF "PRINT "THE ACTUAL CASUALTIES AT "; C$PRINT (* - FIND WHO WON *)IF U = 1.0 THEN 2590IF C5 + E < 17.0 * C2 * C1 / (C5 * 20.0) + 5.0 * O THEN 26302590 PRINT "YOU LOSE "; C$2600 IF A = 0.0 THEN 2790LET L := L + 1GOTO 26802630 PRINT "YOU WIN "; C$(* - CUMULATIVE BATTLE FACTORS WHICH ALTER HISTORICAL *)(*  RESOURCES AVAILABLE.IF A REPLAY DON'T UPDATE. *)2660 IF A = 0.0 THEN 2790LET W := W + 12680 LET T1 := T1 + C5 + ELET T2 := T2 + C6 + E2LET P1 := P1 + C1LET P2 := P2 + C2LET Q1 := Q1 + (arr_F(1.0) + arr_H(1.0) + arr_B(1.0))LET Q2 := Q2 + (arr_F(2.0) + arr_H(2.0) + arr_B(2.0))LET R1 := R1 + M1 * (100.0 - I1) / 20.0LET R2 := R2 + M2 * (100.0 - I2) / 20.0LET M3 := M3 + M1LET M4 := M4 + M2GOSUB 33002790 U := 0U2 := 0PRINT "---------------"GOTO 620(*------FINISH OFF *)2830 PRINT "THE CONFEDERACY HAS SURRENDERED"GOTO 2860PRINT "THE UNION HAS SURRENDERED."2860 PRINT PRINT PRINT PRINT PRINT PRINT PRINT "THE CONFEDERACY ";run ecb_str(float(W), tmp_1$) \ run ecb_str(float(L), tmp_2$) \ PRINT "HAS WON "; tmp_1$; " BATTLES AND LOST "; tmp_2$IF Y = 5.0 THEN 2940IF Y2 = 5.0 THEN 2920IF W <= L THEN 2940IF Y = 5.0 THEN 29402920 PRINT "THE CONFEDERACY HAS WON THE WAR"GOTO 29502940 PRINT "THE UNION HAS WON THE WAR"2950 PRINT IF R1 = 0.0 THEN 3100PRINT "FOR THE "; W + L + W0; " BATTLES FOUGHT (EXCLUDING RERUNS)"PRINT " ", " ", " ";PRINT "CONFEDERACY", " UNION"RUN ecb_int(P1 + 0.5, tmp_1) \ run ecb_str(tmp_1, tmp_1$) \ RUN ecb_int(P2 + 0.5, tmp_2) \ run ecb_str(tmp_2, tmp_2$) \ PRINT "HISTORICAL LOSSES", tmp_1$, tmp_2$RUN ecb_int(T1 + 0.5, tmp_1) \ run ecb_str(tmp_1, tmp_1$) \ RUN ecb_int(T2 + 0.5, tmp_2) \ run ecb_str(tmp_2, tmp_2$) \ PRINT "SIMULATED LOSSES", tmp_1$, tmp_2$PRINT RUN ecb_int(100.0 * (T1 / P1) + 0.5, tmp_1) \ run ecb_str(tmp_1, tmp_1$) \ RUN ecb_int(100.0 * (T2 / P2) + 0.5, tmp_2) \ run ecb_str(tmp_2, tmp_2$) \ PRINT "    % OF ORIGINAL", tmp_1$, tmp_2$IF B$ = "YES" THEN 3100PRINT PRINT "UNION INTELLIGENCE SUGGESTS THAT THE SOUTH USED "PRINT "STRATEGIES 1, 2, 3, 4 IN THE FOLLOWING PERCENTAGES"run ecb_str(float(arr_S(1)), tmp_1$) \ run ecb_str(float(arr_S(2)), tmp_2$) \ run ecb_str(float(arr_S(3)), tmp_3$) \ run ecb_str(float(arr_S(4)), tmp_4$) \ PRINT tmp_1$; tmp_2$; tmp_3$; tmp_4$(*--------------------------------- *)3100 STOP3110 (* - UNION STRATEGY IS COMPUTER CHOSEN *)PRINT "UNION STRATEGY IS ";IF A <> 0.0 THEN 31803140 RUN _ecb_input_prefix_t \ INPUT "? ", Y2 \ RUN _ecb_input_suffix_tIF Y2 <= 0.0 THEN 3160IF Y2 < 5.0 THEN 32903160 PRINT "ENTER 1 , 2 ,3 , OR 4 (USUALLY PREVIOUS UNION STRATEGY)"GOTO 31403180 LET S0 := 0LET R := 100.0 * RND(0.0)FOR I = 1 TO 4  LET S0 := S0 + arr_S(I)(* - IF ACTUAL STRATEGY INFO IS IN PROGRAM DATA STATEMENTS *)(*   THEN R-100 IS EXTRA WEIGHT GIVEN TO THAT STATEGY. *)  IF R < S0 THEN 3270NEXT I(* - IF ACTUAL STRAT. IN,THEN HERE IS Y2= HIST. STRAT. *)3270 LET Y2 := Irun ecb_str(Y2, tmp_1$) \ PRINT tmp_1$3290 RETURN3300 (* LEARN  PRESENT STRATEGY, START FORGETTING OLD ONES *)(* - PRESENT STRATEGY OF SOUTH GAINS 3*S, OTHERS LOSE S *)(*   PROBABILITY POINTS, UNLESS A STRATEGY FALLS BELOW 5%. *)LET S := 3LET S0 := 0FOR I = 1 TO 4  IF arr_S(I) <= 5.0 THEN 3390  LET arr_S(I) := arr_S(I) - S  LET S0 := S0 + S3390 NEXT ILET arr_S(INT(Y)) := arr_S(INT(Y)) + S0RETURN(* - HISTORICAL DATA...CAN ADD MORE (STRAT.,ETC) BY INSERTING *)(*   DATA STATEMENTS AFTER APPRO. INFO, AND ADJUSTING READ *)DATA "BULL RUN", 18000.0, 18500.0, 1967.0, 2708.0, 1.0DATA "SHILOH", 40000.0, 44894.0, 10699.0, 13047.0, 3.0DATA "SEVEN DAYS", 95000.0, 115000.0, 20614.0, 15849.0, 3.0DATA "SECOND BULL RUN", 54000.0, 63000.0, 10000.0, 14000.0, 2.0DATA "ANTIETAM", 40000.0, 50000.0, 10000.0, 12000.0, 3.0DATA "FREDERICKSBURG", 75000.0, 120000.0, 5377.0, 12653.0, 1.0DATA "MURFREESBORO", 38000.0, 45000.0, 11000.0, 12000.0, 1.0DATA "CHANCELLORSVILLE", 32000.0, 90000.0, 13000.0, 17197.0, 2.0DATA "VICKSBURG", 50000.0, 70000.0, 12000.0, 19000.0, 1.0DATA "GETTYSBURG", 72500.0, 85000.0, 20000.0, 23000.0, 3.0DATA "CHICKAMAUGA", 66000.0, 60000.0, 18000.0, 16000.0, 2.0DATA "CHATTANOOGA", 37000.0, 60000.0, 36700.0, 5800.0, 2.0DATA "SPOTSYLVANIA", 62000.0, 110000.0, 17723.0, 18000.0, 2.0DATA "ATLANTA", 65000.0, 100000.0, 8500.0, 3700.0, 1.03580 PRINT "JULY 21, 1861.  GEN. BEAUREGARD, COMMANDING THE SOUTH, MET"PRINT "UNION FORCES WITH GEN. MCDOWELL IN A PREMATURE BATTLE AT"PRINT "BULL RUN. GEN. JACKSON HELPED PUSH BACK THE UNION ATTACK."GOTO 11503620 PRINT "APRIL 6-7, 1862.  THE CONFEDERATE SURPRISE ATTACK AT"PRINT "SHILOH FAILED DUE TO POOR ORGANIZATION."GOTO 11503650 PRINT "JUNE 25-JULY 1, 1862.  GENERAL LEE (CSA) UPHELD THE"PRINT "OFFENSIVE THROUGHOUT THE BATTLE AND FORCED GEN. MCCLELLAN"PRINT "AND THE UNION FORCES AWAY FROM RICHMOND."GOTO 11503690 PRINT "AUG 29-30, 1862.  THE COMBINED CONFEDERATE FORCES UNDER";PRINT " LEE"PRINT "AND JACKSON DROVE THE UNION FORCES BACK INTO WASHINGTON."GOTO 11503720 PRINT "SEPT 17, 1862.  THE SOUTH FAILED TO INCORPORATE MARYLAND"PRINT "INTO THE CONFEDERACY."GOTO 11503750 PRINT "DEC 13, 1862.  THE CONFEDERACY UNDER LEE SUCCESSFULLY"PRINT "REPULSED AN ATTACK BY THE UNION UNDER GEN. BURNSIDE."GOTO 11503780 PRINT "DEC 31, 1862.  THE SOUTH UNDER GEN. BRAGG WON A CLOSE ";PRINT "BATTLE."GOTO 11503800 PRINT "MAY 1-6, 1863.  THE SOUTH HAD A COSTLY VICTORY AND LOST"PRINT "ONE OF THEIR OUTSTANDING GENERALS, 'STONEWALL' JACKSON."GOTO 11503830 PRINT "JULY 4, 1863.  VICKSBURG WAS A COSTLY DEFEAT FOR THE SOUTH"PRINT "BECAUSE IT GAVE THE UNION ACCESS TO THE MISSISSIPPI."GOTO 11503860 PRINT "JULY 1-3, 1863.  A SOUTHERN MISTAKE BY GEN. LEE AT ";PRINT "GETTYSBURG"PRINT "COST THEM ONE OF THE MOST CRUCIAL BATTLES OF THE WAR."GOTO 11503890 PRINT "SEPT. 15, 1863. CONFUSION IN A FOREST NEAR CHICKAMAUGA LED"PRINT "TO A COSTLY SOUTHERN VICTORY."GOTO 11503920 PRINT "NOV. 25, 1863. AFTER THE SOUTH HAD SIEGED GEN. ROSENCRANS'"PRINT "ARMY FOR THREE MONTHS, GEN. GRANT BROKE THE SIEGE."GOTO 11503950 PRINT "MAY 5, 1864.  GRANT'S PLAN TO KEEP LEE ISOLATED BEGAN TO"PRINT "FAIL HERE, AND CONTINUED AT COLD HARBOR AND PETERSBURG."GOTO 11503980 PRINT "AUGUST, 1864.  SHERMAN AND THREE VETERAN ARMIES CONVERGED"PRINT "ON ATLANTA AND DEALT THE DEATH BLOW TO THE CONFEDERACY."GOTO 1150END